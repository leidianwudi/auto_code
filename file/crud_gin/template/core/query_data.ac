// ============================================================================
// query_data.ac — Go(gin+gorm) 查询场景数据构建器
// ----------------------------------------------------------------------------
// 作用（复刻 crud_nest/template/core/query_data.ac 的产出形态，类型换 goType）：
//   从 .jsontable 的查询读模型（selColsEq/selColsLike/selColsGap/selColsSort，
//   ref 支持本表列名或联表路径 joinEnClassPro.目标列）构建查询场景数据：
//     selFields[]       - SelectParams 查询字段（精确/模糊/范围）
//     whereConditions[] - repo getWhereByIn 的 Go 条件块（gorm Where）
//     sortInfo          - 排序信息（sortDesc / orderByDef / 默认排序字段方向）
//
// 数据来源说明：
//   精确/模糊/范围全部为表级键（列级 search 角色已退役，精确=selColsEq）：
//     "selColsEq":   ["user.name"],                    // 精确查询（支持联表 ref）
//     "selColsLike": ["name"],                         // 模糊查询
//     "selColsGap":  ["create_time"],                  // 范围查询（展开 _min/_max）
//     "selColsSort": [["id","DESC"],["user.name","DESC"]]  // 排序
//   联表 ref：joinDefs 由 main_api 预加工传入（有效 ManyToOne 条目），
//   联表列在 WHERE/ORDER 中以 `引用名`.`列` 限定。
// ============================================================================

import { FieldDef, Param, zeroKindOfGoType, mapTypeToGo, sanitizeGoComment, tabChar } from "param_go.ac";
import { snakeToPascal } from "../../../tool/tool_str.ac";

/// @brief 查询字段定义（SelectParams 字段列表元素）
export class SelFieldDef {
  let name: String = "";        // 查询参数名（gap 字段为 col_min / col_max；联表列为别名 pro_col）
  let baseName: String = "";    // 基础列名（gap 展开后语义用原列 ref；联表列 = pro.col）
  let sqlCol: String = "";      // SQL 列限定（本表 `col` 或 join 时 `t`.`col`；联表 `pro`.`col`）
  let comment: String = "";     // 字段注释
  let goName: String = "";      // 导出驼峰（如 create_time_min → CreateTimeMin）
  let goType: String = "";      // Go 基础类型
  let declType: String = "";    // SelectParams 声明类型（time→*time.Time、bool→*bool）
  let kind: String = "";        // 零值判断类别：string / number / ptr
  let isLike: Bool = false;     // 是否模糊查询（LIKE %x%）
  let isGap: Bool = false;      // 是否范围查询（selColsGap 生成 base_min/base_max 两个字段）
}

/// @brief 排序信息结果（buildSortInfo 的返回值）
export class SortInfoResult {
  let sortDesc: String = "";            // 排序描述，如 "排序字段:id, create_time"
  let orderByDef: String = "";          // 排序字面量串，如 "'id': 'DESC', 'create_time': 'DESC'"（预留）
  let defaultOrderField: String = "";   // 默认排序 ref，如 "id" / "user.name"
  let defaultOrderSql: String = "";     // 默认排序 SQL 列限定，如 "`id`" / "`user`.`name`"
  let defaultOrderDir: String = "";     // 默认排序方向，如 "DESC"
}

/// @brief 查询场景数据构建器（无 DB，全部来自 .jsontable 配置）
export class QueryData {
  /// true = split 布局：过滤字段全指针 + 条件走 common.Where*（nil 不加条件）
  let pointerMode: Bool = false;

  // ------------------------------------------------------------------------
  // 构建 selFields 数组（SelectParams 查询字段列表）
  //
  // 逻辑（顺序与 Nest 版一致，先到先得，重复字段跳过）：
  //   1. json.selColsEq 列 → 精确查询（isLike=false）
  //   2. json.selColsLike 列 → 模糊查询（isLike=true）
  //   3. json.selColsGap 列 → 范围查询，每列展开为 _min/_max 两个字段
  // ref 形态：
  //   - 本表列名（"name"）：field 来自 param，sqlCol = hasJoin ? `t`.`name` : `name`
  //   - 联表路径（"user.name"）：joinDefs 中按引用名定位目标表列，
  //     构造虚拟 FieldDef（goType 由目标列 mysqlType 映射），sqlCol = `user`.`name`，
  //     查询参数名 = 别名 user_name（与列表平铺返回键一致）
  // 说明：
  //   - 查询参数声明类型：time.Time → *time.Time、bool → *bool（零值无法区分
  //     "未传"），其余类型保持原样（零值即"未过滤"）
  //   - datatypes.JSON 列不支持普通条件查询，跳过并提示
  // ------------------------------------------------------------------------
  function buildSelFields(json: Object, param: Param, joinDefs: Object[], hasJoin: Bool): SelFieldDef[] {
    let selFields: SelFieldDef[] = [];
    let selFieldNames: String[] = [];

    // ── 1. 精确查询：表级 selColsEq（[{ref,visible}]，支持联表 ref）─────
    //      visible=false 后端条件照常生成（API 能力保留），仅前端不渲染
    if (json.selColsEq != null) {
      for (qc in json.selColsEq) {
        let ref: String = qc["ref"];
        if (ref == null || ref == "") {
          continue;
        }
        if (this.containsName(selFieldNames, ref)) {
          continue;
        }
        let resolved: Object = this.resolveRef(ref, param, joinDefs, hasJoin);
        if (resolved == null) {
          continue;  // 无法解析已在 resolveRef 内报错
        }
        let field: FieldDef = resolved["field"];
        if (field.zeroKind == "skip") {
          printLog("提示：列 '" + ref + "' 为 JSON 类型，不支持普通条件查询，已跳过查询字段生成");
          continue;
        }
        let sf: SelFieldDef = this.makeSelField(resolved["name"], field, resolved["sqlCol"], ref);
        selFields.append(sf);
        selFieldNames.append(sf.name);
      }
    }

    // ── 2. 模糊查询：表级 selColsLike（[{ref,visible}]，精确优先）─────
    if (json.selColsLike != null) {
      for (qc in json.selColsLike) {
        let ref: String = qc["ref"];
        if (ref == null || ref == "") {
          continue;
        }
        if (this.containsName(selFieldNames, ref)) {
          continue;
        }
        let resolved: Object = this.resolveRef(ref, param, joinDefs, hasJoin);
        if (resolved == null) {
          continue;
        }
        let field: FieldDef = resolved["field"];
        if (field.zeroKind == "skip" || field.goType != "string") {
          printLog("提示：列 '" + ref + "' 非字符串类型，不支持模糊查询，已按精确查询生成");
        }
        let sf: SelFieldDef = this.makeSelField(resolved["name"], field, resolved["sqlCol"], ref);
        sf.isLike = field.goType == "string";
        if (sf.isLike) {
          sf.comment = sf.comment + "（模糊）";  // split 布局黄金注释约定
        }
        selFields.append(sf);
        selFieldNames.append(sf.name);
      }
    }

    // ── 3. 范围查询：表级 selColsGap（[{ref,visible}]），每列展开 _min/_max ─
    //      仅支持时间（*time.Time）与数值类型；说明同 Nest 版：不生成 base 字段，
    //      若还需精确查询请把该列同时配置进 selColsEq
    if (json.selColsGap != null) {
      for (qc in json.selColsGap) {
        let ref: String = qc["ref"];
        if (ref == null || ref == "") {
          continue;
        }
        if (this.containsName(selFieldNames, ref)) {
          continue;
        }
        let resolved: Object = this.resolveRef(ref, param, joinDefs, hasJoin);
        if (resolved == null) {
          continue;
        }
        let field: FieldDef = resolved["field"];
        let isTime = field.goType == "time.Time";
        let isNum = field.zeroKind == "number";
        if (!isTime && !isNum) {
          printLog("提示：列 '" + ref + "' 非时间/数值类型，不支持范围查询，已跳过");
          continue;
        }
        // 起始字段：create_time_min / user_name_min
        let sfMin: SelFieldDef = this.makeSelField(resolved["name"] + "_min", field, resolved["sqlCol"], ref);
        sfMin.comment = field.comment + "（起始）";
        sfMin.isGap = true;
        if (isTime) {
          sfMin.declType = "*time.Time";
        }
        selFields.append(sfMin);
        selFieldNames.append(sfMin.name);

        // 结束字段：create_time_max / user_name_max
        let sfMax: SelFieldDef = this.makeSelField(resolved["name"] + "_max", field, resolved["sqlCol"], ref);
        sfMax.comment = field.comment + "（结束）";
        sfMax.isGap = true;
        if (isTime) {
          sfMax.declType = "*time.Time";
        }
        selFields.append(sfMax);
        selFieldNames.append(sfMax.name);
      }
    }

    return selFields;
  }

  // ------------------------------------------------------------------------
  // 构建 sortInfo（排序信息）
  //
  // 输入：json.selColsSort
  //   - 推荐数组格式：[["id","DESC"],["user.name","DESC"]]（保证书写顺序）
  //   - 兼容对象格式：{"id":"DESC","create_time":"DESC"}
  // 输出：sortDesc / orderByDef / defaultOrderField / defaultOrderSql / defaultOrderDir
  //   无配置时默认按主键 DESC（primaryName 传入，避免表主键不叫 id 时排序失效）
  // ------------------------------------------------------------------------
  function buildSortInfo(json: Object, param: Param, primaryName: String, joinDefs: Object[], hasJoin: Bool): SortInfoResult {
    let sortRefs: String[] = [];
    let sortVals: String[] = [];
    if (json.selColsSort != null) {
      let sortArr: Object = json.selColsSort;
      if (sortArr.length) {
        // 数组格式：[["id","DESC"],...]
        for (pair in sortArr) {
          sortRefs.append(pair[0]);
          sortVals.append(pair[1]);
        }
      } else {
        // 对象格式（兼容旧配置）：{"id":"DESC"}
        for (sortKey in sortArr) {
          sortRefs.append(sortKey);
          sortVals.append(sortArr[sortKey]);
        }
      }
    }

    let result: SortInfoResult = new SortInfoResult();
    // 排序描述：排序字段:id, create_time
    let desc: String = "排序字段:";
    let keyLen = sortRefs.length;
    for (let i = 0; i < keyLen; i = i + 1) {
      if (i > 0) {
        desc = desc + ",";
      }
      desc = desc + " " + sortRefs[i];
    }
    result.sortDesc = desc;

    // 排序字面量串（预留数据，形态与 Nest orderByDef 一致）
    let parts: String[] = [];
    for (let j = 0; j < keyLen; j = j + 1) {
      parts.append("'" + sortRefs[j] + "': '" + sortVals[j] + "'");
    }
    result.orderByDef = parts.join(", ");

    // 默认排序（取第一个键值对；无配置回退主键 DESC）
    if (keyLen > 0) {
      result.defaultOrderField = sortRefs[0];
      result.defaultOrderDir = sortVals[0];
    } else {
      result.defaultOrderField = primaryName;
      result.defaultOrderDir = "DESC";
    }
    // 默认排序 SQL 列限定（联表 ref → `pro`.`col`；本表列 join 时加 `t.` 前缀）
    result.defaultOrderSql = this.refToSql(result.defaultOrderField, param, joinDefs, hasJoin);
    return result;
  }

  // ------------------------------------------------------------------------
  // 构建 whereConditions 数组（repo getWhereByIn 的 Go 条件块）
  //
  // 每个元素为一段完整 Go 代码（含缩进，多行字符串），模板逐段原样输出：
  //   精确：  if sel.Name != "" {
  //             db = db.Where("`name` = ?", sel.Name)
  //           }
  //   模糊：  if sel.Name != "" {
  //             db = db.Where("`name` LIKE ?", "%"+sel.Name+"%")
  //           }
  //   范围：  由 _min 字段生成 >= / <= 两条（_max 不单独生成，同 Nest 版）
  // 列引用取 sf.sqlCol（联表 ref → `pro`.`col`；主表 join 时 `t`.`col`）
  // ------------------------------------------------------------------------
  function buildWhereConditions(selFields: SelFieldDef[]): String[] {
    let conditions: String[] = [];
    for (sf in selFields) {
      // 范围查询：只由 _min 字段生成一对 >= / <= 条件
      if (sf.isGap) {
        if (!sf.name.endsWith("_min")) {
          continue;
        }
        let col: String = sf.sqlCol;
        if (sf.kind == "ptr") {
          // 时间范围：*time.Time 判 nil
          conditions.append("  if sel." + sf.goName + " != nil {\n"
            + "    db = db.Where(\"" + col + " >= ?\", sel." + sf.goName + ")\n"
            + "  }");
          conditions.append("  if sel." + this.goNameMaxOf(sf) + " != nil {\n"
            + "    db = db.Where(\"" + col + " <= ?\", sel." + this.goNameMaxOf(sf) + ")\n"
            + "  }");
        } else {
          // 数值范围：零值即未过滤
          conditions.append("  if sel." + sf.goName + " != 0 {\n"
            + "    db = db.Where(\"" + col + " >= ?\", sel." + sf.goName + ")\n"
            + "  }");
          conditions.append("  if sel." + this.goNameMaxOf(sf) + " != 0 {\n"
            + "    db = db.Where(\"" + col + " <= ?\", sel." + this.goNameMaxOf(sf) + ")\n"
            + "  }");
        }
        continue;
      }

      let col: String = sf.sqlCol;
      if (sf.isLike) {
        // 模糊查询（仅字符串字段会置 isLike）
        conditions.append("  if sel." + sf.goName + " != \"\" {\n"
          + "    db = db.Where(\"" + col + " LIKE ?\", \"%\"+sel." + sf.goName + "+\"%\")\n"
          + "  }");
        continue;
      }
      // 精确查询：按零值类别生成
      if (sf.kind == "string") {
        conditions.append("  if sel." + sf.goName + " != \"\" {\n"
          + "    db = db.Where(\"" + col + " = ?\", sel." + sf.goName + ")\n"
          + "  }");
      } else if (sf.kind == "number") {
        conditions.append("  if sel." + sf.goName + " != 0 {\n"
          + "    db = db.Where(\"" + col + " = ?\", sel." + sf.goName + ")\n"
          + "  }");
      } else if (sf.kind == "ptr") {
        if (sf.goType == "bool") {
          // *bool 解引用传值
          conditions.append("  if sel." + sf.goName + " != nil {\n"
            + "    db = db.Where(\"" + col + " = ?\", *sel." + sf.goName + ")\n"
            + "  }");
        } else {
          // *time.Time 直接传指针
          conditions.append("  if sel." + sf.goName + " != nil {\n"
            + "    db = db.Where(\"" + col + " = ?\", sel." + sf.goName + ")\n"
            + "  }");
        }
      }
    }
    return conditions;
  }

  // ------------------------------------------------------------------------
  // split 布局条件块：过滤字段全指针，nil = 不加条件；条件走 common.Where*
  //   - 精确：common.WhereEq(db, ColXxx, *sel.Xxx)（time 直接传指针）
  //   - 模糊：common.WhereLike(db, ColXxx, *sel.Xxx)
  //   - 范围：_min → WhereGte，_max → WhereLte（time 传指针，数值解引用）
  // 列名常量由 baseName 派生（ColXxx），与 data 层 en_<表>_.go 的常量同名。
  // ------------------------------------------------------------------------
  function buildWhereConditionsPointer(selFields: SelFieldDef[]): String[] {
    let conditions: String[] = [];
    let tb: String = tabChar();
    for (sf in selFields) {
      let colName: String = sf.baseName;
      if (colName == null || colName.indexOf(".") > 0) {
        printLog("提示：split 布局暂不支持联表条件 '" + colName + "'，已跳过");
        continue;
      }
      let colConst: String = "Col" + snakeToPascal(colName);
      if (sf.isGap) {
        // 范围：只由 _min 字段生成一对 >= / <= 条件
        if (!sf.name.endsWith("_min")) {
          continue;
        }
        let maxGo: String = this.goNameMaxOf(sf);
        let valMin: String = "sel." + sf.goName;
        let valMax: String = "sel." + maxGo;
        if (sf.goType != "time.Time") {
          valMin = "*" + valMin;
          valMax = "*" + valMax;
        }
        conditions.append(tb + "if sel." + sf.goName + " != nil {\n"
          + tb + tb + "db = common.WhereGte(db, " + colConst + ", " + valMin + ")\n"
          + tb + "}");
        conditions.append(tb + "if sel." + maxGo + " != nil {\n"
          + tb + tb + "db = common.WhereLte(db, " + colConst + ", " + valMax + ")\n"
          + tb + "}");
        continue;
      }
      let val: String = "sel." + sf.goName;
      if (sf.goType != "time.Time") {
        val = "*" + val;
      }
      if (sf.isLike) {
        conditions.append(tb + "if sel." + sf.goName + " != nil {\n"
          + tb + tb + "db = common.WhereLike(db, " + colConst + ", " + val + ")\n"
          + tb + "}");
      } else {
        conditions.append(tb + "if sel." + sf.goName + " != nil {\n"
          + tb + tb + "db = common.WhereEq(db, " + colConst + ", " + val + ")\n"
          + tb + "}");
      }
    }
    return conditions;
  }

  // ------------------------------------------------------------------------
  // 内部工具：由列 FieldDef 构建 SelFieldDef（查询参数声明类型在此定型）
  //   name  查询参数名（本表列名 / 联表别名 pro_col / gap 展开名）
  //   field 列定义（联表 ref 为 resolveRef 构造的虚拟 FieldDef）
  //   sqlCol SQL 列限定（`col` / `t`.`col` / `pro`.`col`）
  //   ref   原始引用（注释与 baseName 用，联表为 pro.col）
  // ------------------------------------------------------------------------
  function makeSelField(name: String, field: FieldDef, sqlCol: String, ref: String): SelFieldDef {
    let sf: SelFieldDef = new SelFieldDef();
    sf.name = name;
    sf.baseName = ref;
    sf.sqlCol = sqlCol;
    sf.comment = field.comment;
    sf.goType = field.goType;
    sf.goName = snakeToPascal(name);
    sf.kind = zeroKindOfGoType(field.goType);
    // 查询参数声明类型：time/bool 用指针（零值无法区分"未传"），其余保持；
    // split 布局下全部过滤字段用指针（nil=不加条件，非 nil 含 0/空串也筛）
    if (this.pointerMode) {
      sf.declType = (field.goType == "datatypes.JSON") ? field.goType : "*" + field.goType;
    } else {
      sf.declType = (field.goType == "time.Time" || field.goType == "bool")
                        ? "*" + field.goType
                        : field.goType;
    }
    return sf;
  }

  // ------------------------------------------------------------------------
  // 内部工具：解析查询 ref（本表列名 或 联表路径 pro.col）
  //   返回 {field: FieldDef, name: 参数名, sqlCol: SQL 列限定}；无法解析返回 null
  //   - 本表列：field=param 中的列，name=列名，sqlCol=hasJoin ? `t`.`col` : `col`
  //   - 联表列：joinDefs 中按引用名找目标表列，构造虚拟 FieldDef
  //     （goType 由目标列 mysqlType 映射），name=别名 pro_col，sqlCol=`pro`.`col`
  //   - 解析失败 printError 并返回 null（与设计器校验同源，fail-fast 单个 ref）
  // ------------------------------------------------------------------------
  function resolveRef(ref: String, param: Param, joinDefs: Object[], hasJoin: Bool): Object {
    if (ref == null || ref == "") {
      return null;
    }
    let dot: Number = ref.indexOf(".");
    if (dot <= 0) {
      // 本表列
      let field: FieldDef = this.findField(param, ref);
      if (field == null) {
        printLog("警告：查询 ref '" + ref + "' 在表 " + param.tableName + " 中不存在，已跳过");
        return null;
      }
      let sqlCol: String = "`" + ref + "`";
      if (hasJoin) {
        sqlCol = "`t`.`" + ref + "`";
      }
      return { field: field, name: ref, sqlCol: sqlCol };
    }
    // 联表路径 pro.col
    let pro: String = ref.substring(0, dot);
    let col: String = ref.substring(dot + 1);
    if (col == "") {
      printLog("警告：查询 ref '" + ref + "' 缺少目标列名，已跳过");
      return null;
    }
    let joinDef: Object = this.findJoin(joinDefs, pro);
    if (joinDef == null) {
      printLog("警告：查询 ref '" + ref + "' 的引用名 '" + pro +
               "' 未声明为启用的 ManyToOne 联表，已跳过");
      return null;
    }
    let tcol: Object = this.targetColOf(joinDef["target"], col);
    if (tcol == null) {
      printLog("警告：查询 ref '" + ref + "' 的目标列 '" + col + "' 在联表 " +
               joinDef["joinEnClass"] + " 中不存在，已跳过");
      return null;
    }
    // 虚拟 FieldDef：类型由目标列 mysqlType 映射；LEFT JOIN 无匹配为 NULL，
    // 查询参数按基础类型处理（declType 由 makeSelField 规则定型）
    let field: FieldDef = new FieldDef();
    field.name = col;
    field.comment = sanitizeGoComment(tcol["comment"]);
    field.colType = tcol["mysqlType"];
    field.unsigned = (tcol["unsigned"] == true);
    field.goType = mapTypeToGo(field.colType, field.unsigned);
    field.goName = snakeToPascal(col);
    field.zeroKind = zeroKindOfGoType(field.goType);
    let alias: String = pro + "_" + col;
    return { field: field, name: alias, sqlCol: "`" + pro + "`.`" + col + "`" };
  }

  // ------------------------------------------------------------------------
  // 内部工具：排序 ref → SQL 列限定（不存在的 ref 回退主键由调用方兜底，
  //   这里联表 ref 解析失败时报错并回退字面量原样，避免静默错排序）
  // ------------------------------------------------------------------------
  function refToSql(ref: String, param: Param, joinDefs: Object[], hasJoin: Bool): String {
    if (ref == null || ref == "") {
      return "`id`";
    }
    let dot: Number = ref.indexOf(".");
    if (dot <= 0) {
      // 本表列（不存在时仍按本表列生成，DDL/生成端已有主键兜底）
      return hasJoin ? "`t`.`" + ref + "`" : "`" + ref + "`";
    }
    let pro: String = ref.substring(0, dot);
    let col: String = ref.substring(dot + 1);
    let joinDef: Object = this.findJoin(joinDefs, pro);
    if (joinDef == null || this.targetColOf(joinDef["target"], col) == null) {
      printLog("警告：排序 ref '" + ref + "' 无法解析（须为本表列名或已启用 ManyToOne 联表的「引用名.目标列」）");
      return "`" + ref + "`";
    }
    return "`" + pro + "`.`" + col + "`";
  }

  // ------------------------------------------------------------------------
  // 内部工具：按引用名查找联表定义（找不到返回 null）
  // ------------------------------------------------------------------------
  function findJoin(joinDefs: Object[], pro: String): Object {
    for (jd in joinDefs) {
      if (jd["pro"] == pro) {
        return jd;
      }
    }
    return null;
  }

  // ------------------------------------------------------------------------
  // 内部工具：在联表目标表配置中按列名查找列（找不到返回 null）
  // ------------------------------------------------------------------------
  function targetColOf(target: Object, colName: String): Object {
    let cols: Object[] = target["columns"];
    if (cols == null) {
      return null;
    }
    for (c in cols) {
      if (c["name"] == colName) {
        return c;
      }
    }
    return null;
  }

  // ------------------------------------------------------------------------
  // 内部工具：按列名查找 FieldDef（找不到返回 null）
  // ------------------------------------------------------------------------
  function findField(param: Param, colName: String): FieldDef {
    for (field in param.fields) {
      if (field.name == colName) {
        return field;
      }
    }
    return null;
  }

  // ------------------------------------------------------------------------
  // 内部工具：判断名字列表是否已包含某列名
  // ------------------------------------------------------------------------
  function containsName(names: String[], colName: String): Bool {
    for (n in names) {
      if (n == colName) {
        return true;
      }
    }
    return false;
  }

  // ------------------------------------------------------------------------
  // 内部工具：由 _min 字段推导 _max 字段的 Go 参数名（CreateTimeMin → CreateTimeMax）
  // ------------------------------------------------------------------------
  function goNameMaxOf(sf: SelFieldDef): String {
    return sf.goName.substring(0, sf.goName.length - 3) + "Max";
  }
}
