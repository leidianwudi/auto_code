/// @file main_api.ac — 通用 Go(gin+gorm) 后端 API 代码生成主逻辑
/// ----------------------------------------------------------------------------
/// 说明：
///   本文件是 crud_gin 后端 API 代码生成的**通用主逻辑**，
///   不包含任何项目相关的参数（输出路径、模板配置）。
///   项目入口脚本（如 file/go_pure/<项目>/<项目>.ac，plan 5.3）只需定义项目
///   参数并调用 generateApiMain()。
///
///   与 crud_nest 链的本质区别：**生成期不连数据库**。
///   .jsontable 是唯一事实源（表设计器产出，含完整列定义与前端角色），
///   本脚本只读配置，不调 db.tableSchema / db.query。
///
///   整体流程（从 .jsontable 到 Go 文件）：
///     ┌────────────┐  columns   ┌──────────┐   tplData   ┌───────────┐
///     │ .jsontable │ ─────────► │  Param   │ ──────────► │ en/in/repo│
///     │ tables[]   │  列定义     │ (加工器) │   渲染数据   │ /svc/hdl  │
///     └────────────┘            └──────────┘             └─────┬─────┘
///                                             renderTpl()      ▼
///                                              internal/{model,repository,...}/*.go
///
/// 接收的项目参数（params 对象）：
///   - goBasePath     Go 项目根目录（internal/... 写到这里）；
///                    省略时用 .jsontable 的 meta.goBasePath
///   - jsonTablePath  可选，.jsontable 配置文件绝对路径；
///                    省略时收集勾选文件中的 .jsontable
///   - routerFilePath 可选，路由注册文件路径；
///                    缺省 {goBasePath}/internal/router/router_.go
///   - genGlobalEnum  可选，false 跳过全局枚举收集（缺省/true 收集）
///   - templates      可选，模板配置数组（省略时使用本文件默认模板）
///
/// 默认模板路径假设入口脚本位于 file/go_pure/<项目>/（与 crud_nest 链
/// "入口在 file/crud_nest/<项目>/" 的约定平行）。
/// ----------------------------------------------------------------------------

import { Param, FieldDef, buildGoImports, escapeGoStr, sanitizeGoComment } from "./core/param_go.ac";
import { QueryData, SelFieldDef } from "./core/query_data.ac";
import { updateRouterFile } from "./go_module.ac";
import { snakeToPascal, isNumericStr } from "../../tool/tool_str.ac";
import { findGlobalEnumFiles, mergeGlobalEnumFiles } from "../../tool/tool_global_enum.ac";
import { dirnameOf, findProjPath } from "../../tool/tool_jsontable.ac";

/// @brief 模板配置（一个模板对应一个生成的代码文件）
class TemplateConfig {
  let tpl: String = "";  // 模板文件路径（相对入口脚本目录）
  let out: String = "";  // 输出文件路径模板，用 {key} 占位符从 tplData 取值
}

/// @brief 生成 Go 后端 API 代码
/// @param params 项目参数对象（见文件头说明）
/// @return 实际写入磁盘的文件数量
export function generateApiMain(params: Object): Number {
  // 统计实际写入磁盘的文件数量（writeFile 成功时 +1），返回给入口脚本汇总输出
  let generatedFileCount: Number = 0;

  // ── 1. .jsontable 配置文件收集 ─────────────────────────────────────
  //      优先级：params.jsonTablePaths（文件数组，与前端链对称）
  //            > params.jsonTablePath（单文件）
  //            > 收集 tree.config 勾选文件中的 .jsontable（限定本项目目录）
  let jsonFiles: String[] = [];
  let jtpArr: String[] = params["jsonTablePaths"];
  if (jtpArr != null) {
    let jaLen = jtpArr.length;
    for (let ja = 0; ja < jaLen; ja = ja + 1) {
      jsonFiles.append(jtpArr[ja].replace("\\", "/"));
    }
  }
  if (jsonFiles.length == 0) {
    let jsonTablePath: String = params["jsonTablePath"];
    if (jsonTablePath != null && jsonTablePath.length > 0) {
      jsonFiles.append(jsonTablePath);
    }
  }
  if (jsonFiles.length == 0) {
    let checked: String[] = getCheckedFiles(scriptDir());
    for (f in checked) {
      if (f.endsWith(".jsontable")) {
        jsonFiles.append(f);
      }
    }
  }
  if (jsonFiles.length == 0) {
    printError("错误：未找到 .jsontable 配置（请配置 params.jsonTablePaths / jsonTablePath，或在项目目录勾选 .jsontable 文件）");
    return 0;
  }
  printLog("jsontable files: " + jsonFiles.length + " 份");

  // ── 1.5 检查配置文件是否同名不同路径（文件重复）──────────────────
  //      同名 .jsontable 同时参与生成会导致表重复定义，应报错并中止
  let seenBases: String[] = [];
  let dupFiles: String[] = [];
  for (chk in jsonFiles) {
    let base: String = basename(chk);
    let seen: Bool = false;
    for (sb in seenBases) {
      if (sb == base) { seen = true; }
    }
    if (seen) {
      dupFiles.push(base);
    } else {
      seenBases.push(base);
    }
  }
  if (dupFiles.length > 0) {
    printError("错误：配置文件存在同名不同路径（文件重复），请取消勾选其中一个后重新执行：");
    for (d in dupFiles) {
      printError("  - " + d);
    }
    return 0;
  }

  // ── 2. 读取 .jsontable：单表新格式逐文件收集 + 项目 meta ────────────
  //      一文件一表：每份 { table: {...} } 一张表（翻译表内嵌在表的 i18n 配置）；
  //      共享 meta 在同目录 project.jsontableproj（params.projPath 显式指定
  //      优先，否则从第一份 .jsontable 所在目录向上查找）；
  //      表名重复在 4 节预扫描中报错去重
  let tables: Object[] = [];
  let metaGoBasePath: String = "";
  let projPath: String = params["projPath"];
  if (projPath == null || projPath.length == 0) {
    projPath = findProjPath(dirnameOf(jsonFiles[0]), 3);
  }
  if (projPath != null && projPath.length > 0) {
    let projJson: Object = readJson(projPath);
    if (projJson == null) {
      printError("错误：项目 meta 文件读取失败: " + projPath);
      return 0;
    }
    let projMeta: Object = projJson["meta"];
    if (projMeta != null && projMeta["goBasePath"] != null) {
      metaGoBasePath = projMeta["goBasePath"];
    }
    printLog("项目 meta: " + projPath);
  } else {
    printLog("未找到 project.jsontableproj（meta.goBasePath 回退 params.goBasePath）");
  }
  for (file in jsonFiles) {
    let fileJson: Object = readJson(file);
    if (fileJson == null) {
      printError("错误：.jsontable 读取失败: " + file);
      return 0;
    }
    if (fileJson["tables"] != null) {
      printError("错误：旧多表格式（含 tables 键）: " + file);
      printError("      请先运行 file/tools/split_jsontable.ac 拆分为一文件一表新格式");
      return 0;
    }
    let t: Object = fileJson["table"];
    if (t == null) {
      printError("错误：.jsontable 缺少顶层 table 键: " + file);
      return 0;
    }
    tables.append(t);
  }
  printLog("tables count: " + tables.length);

  // ── 3. goBasePath 与模块名 ─────────────────────────────────────────
  //      goBasePath：params 优先（兼容 basePath 键名），缺省回退 meta.goBasePath
  let goBasePath: String = params["goBasePath"];
  if (goBasePath == null || goBasePath.length == 0) {
    goBasePath = params["basePath"];
  }
  if (goBasePath == null || goBasePath.length == 0) {
    goBasePath = metaGoBasePath;
  }
  if (goBasePath == null || goBasePath.length == 0) {
    printError("错误：未配置 goBasePath（params.goBasePath 与 .jsontable meta.goBasePath 均为空）");
    return 0;
  }
  goBasePath = goBasePath.replace("\\", "/");

  // 模块名：读 go.mod 的 module 行（生成 import 前缀 {moduleName}/internal/...）；
  // 无 go.mod 时无法确定 import 路径 → 报错并跳过全部表生成
  let moduleName: String = readGoModuleName(goBasePath);
  if (moduleName == "") {
    printError("错误：go.mod 不存在或缺 module 行，跳过全部表生成: " + goBasePath + "/go.mod");
    return 0;
  }
  let modulePath: String = moduleName + "/internal/model";
  let repoPath: String = moduleName + "/internal/repository";
  let svcPath: String = moduleName + "/internal/service";
  let hdlPath: String = moduleName + "/internal/handler";
  printLog("Go 项目: " + goBasePath + "（module: " + moduleName + "）");

  // ── 3.5 全局枚举收集（tool_global_enum.ac 直接复用）────────────────
  //      两级作用域（就近在前）合并 .jsonglobalenum。
  //      Go 链不生成公共枚举文件，只构建 name → 定义 查找表：
  //      表配置 globalEnumCols 命中的列在 {model}_enum.go 里生成 Go const 块
  //      （跨表同名 const 只生成一次，见 5.5 节）
  let globalEnumDefs: Object = {};
  let emittedGlobalEnums: Object = {};  // 本次运行已生成 const 的全局枚举名
  if (params["genGlobalEnum"] != false) {
    let geFiles: String[] = findGlobalEnumFiles(scriptDir());
    if (geFiles.length > 0) {
      printLog("global enum files: " + geFiles.length + " 份（就近优先合并）");
      let geJson: Object = mergeGlobalEnumFiles(geFiles);
      let geList: Object[] = geJson["enums"];
      for (ge in geList) {
        globalEnumDefs[ge["name"]] = ge;
      }
    } else {
      printLog("未找到 global_enum.jsonglobalenum，跳过全局枚举收集");
    }
  } else {
    printLog("genGlobalEnum=false，跳过全局枚举收集");
  }

  // ── 4. 预扫描：i18n 引用标记 + 表名/模型名去重 ──────────────────────
  //      被某表 i18n.table 引用的表（如 shop0）只生成实体文件，
  //      跳过 repo/service/handler/router 生成（翻译表是主表从属）
  let i18nRefs: Object = {};
  let tablesByName: Object = {};   // tableName → 表配置（i18n 翻译表列定义查找用）
  let tablesByModel: Object = {};  // modelName → 表配置（joinTable 联表目标定位用）
  let genTables: Object[] = [];    // 去重后的待生成表配置
  for (t in tables) {
    let tn: String = t["tableName"];
    if (tn == null || tn.length == 0) {
      printError("错误：.jsontable 存在缺少 tableName 的表配置，已跳过");
      continue;
    }
    if (tablesByName[tn] != null) {
      printError("错误：表 '" + tn + "' 在 .jsontable 中重复定义，后者已跳过");
      continue;
    }
    tablesByName[tn] = t;
    // modelName 缺省回退 tableName（与 6.1 主循环推导一致）；重复 modelName 报错
    let mn: String = t["modelName"];
    if (mn == null || mn.length == 0) {
      mn = tn;
    }
    if (tablesByModel[mn] != null) {
      printError("错误：modelName '" + mn + "' 重复定义，联表 joinEnClass 无法唯一定位，后者已跳过");
      continue;
    }
    tablesByModel[mn] = t;
    genTables.append(t);
    let i18nCfg: Object = t["i18n"];
    if (i18nCfg != null && i18nCfg["table"] != null) {
      i18nRefs[i18nCfg["table"]] = true;
    }
  }

  // ── 5. 模板配置：一个模板对应一个生成的代码文件 ───────────────────
  //      覆盖层（en/in/repo_/svc_/hdl_）每次重新生成；
  //      手改层（repo/svc/hdl）由模板内 fileExists(outputPath) 守卫，只在首次生成
  let templates: TemplateConfig[] = params["templates"];
  if (templates == null) {
    templates = [
      { tpl: "../../crud_gin/template/model/en.tpl",      out: "{goBasePath}/internal/model/en_{tableName}.go" },
      { tpl: "../../crud_gin/template/model/in.tpl",      out: "{goBasePath}/internal/model/{tableName}_in.go" },
      { tpl: "../../crud_gin/template/repo/repo_.tpl",    out: "{goBasePath}/internal/repository/{tableName}_.go" },
      { tpl: "../../crud_gin/template/repo/repo.tpl",     out: "{goBasePath}/internal/repository/{tableName}.go" },
      { tpl: "../../crud_gin/template/service/svc_.tpl",  out: "{goBasePath}/internal/service/{tableName}_.go" },
      { tpl: "../../crud_gin/template/service/svc.tpl",   out: "{goBasePath}/internal/service/{tableName}.go" },
      { tpl: "../../crud_gin/template/handler/hdl_.tpl",  out: "{goBasePath}/internal/handler/{tableName}_.go" },
      { tpl: "../../crud_gin/template/handler/hdl.tpl",   out: "{goBasePath}/internal/handler/{tableName}.go" }
    ];
  }
  // 枚举/路由模板路径（支持 params 覆盖，相对入口脚本目录）
  let enumTplPath: String = params["enumTpl"];
  if (enumTplPath == null || enumTplPath.length == 0) {
    enumTplPath = "../../crud_gin/template/model/enum.tpl";
  }
  let routerTplPath: String = params["routerTpl"];
  if (routerTplPath == null || routerTplPath.length == 0) {
    routerTplPath = "../../crud_gin/template/router.tpl";
  }

  // 收集路由注册函数（渲染文本），全部表生成完后幂等注入 router_.go
  let routes: Object[] = [];
  // 配置缺陷被跳过的表数量（结束时报错汇总）
  let missingTableCount: Number = 0;

  // ── 6. 对每张表执行一次完整的生成流程 ──────────────────────────────
  for (json in genTables) {
    let tableName: String = json["tableName"];
    let modelName: String = json["modelName"];
    if (modelName == null || modelName.length == 0) {
      modelName = tableName;  // 模型名缺省回退表名
    }
    let tableComment: String = sanitizeGoComment(json["tableComment"]);

    // ── 6.1 列定义校验（生成期不连库，无列 = 无从生成）────────────
    let columns: Object[] = json["columns"];
    if (columns == null || columns.length == 0) {
      printError("错误：表 '" + tableName + "' 无列定义（columns 为空），已跳过生成");
      missingTableCount = missingTableCount + 1;
      continue;
    }
    printLog("[" + tableName + "] columns count: " + columns.length);

    // ── 6.2 翻译表分支：被 i18n 引用的表只生成实体文件 ─────────────
    //      跳过 repo/service/handler/router 生成（其 CRUD 由主表 repo 的
    //      i18n 辅助方法承接，翻译表不需要独立接口）
    if (i18nRefs[tableName] == true) {
      printLog("表 '" + tableName + "' 为 i18n 翻译表（被引用），只生成实体文件，跳过 repo/service/handler/router 生成");
      let iParam: Param = new Param();
      iParam.setTableData(json);
      let iTplData: Object = buildEntityData(iParam);
      let iOutPath: String = formatPath("{goBasePath}/internal/model/en_{tableName}.go", {
        goBasePath: goBasePath,
        tableName: tableName
      });
      let iEntityTpl: String = entityTplPath(templates);
      if (iEntityTpl != "") {
        let iResult = renderTpl(iEntityTpl, iTplData);
        if (iResult) {
          let iOk: Bool = writeFile(iOutPath, iResult);
          if (iOk) {
            generatedFileCount = generatedFileCount + 1;
          }
          printLog("生成文件: " + iOutPath);
        }
      }
      continue;
    }

    // ── 6.3 Param 加工：.jsontable 列 → goType/标签/参数字段集 ────
    let param: Param = new Param();
    param.setTableData(json);
    // SelectById/Update/Delete 依赖主键，无主键的表无法生成 CRUD
    if (param.primaryField == null) {
      printError("错误：表 '" + tableName + "' 未声明主键列（isPrimary），已跳过生成");
      missingTableCount = missingTableCount + 1;
      continue;
    }
    printLog("[" + tableName + "] fields count: " + param.fields.length);

    // ── 6.4 联表加工（joinTable → joinDefs + 平铺字段 + JOIN/SELECT 片段）──
    //      joinEnClass/joinEnClassPro/joinType/isJoinRelations 沿用旧 .json 命名；
    //      joinFk=本表外键列，joinPk=目标主键列（缺省 id）。
    //      ManyToOne → 列表 LEFT/INNER JOIN + 联表列平铺（返回键 = 引用名_列名）；
    //      OneToMany → 详情聚合 v1 未支持，打印提示跳过。
    let joinDefs: Object[] = [];   // 有效 ManyToOne 条目 {pro, fk, pk, target, joinEnClass}
    let joinCfgs: Object[] = json["joinTable"];
    if (joinCfgs != null) {
      for (jc in joinCfgs) {
        if (jc["isJoinRelations"] == false) {
          continue;  // 未启用条目不生效（旧 .json 同名约定）
        }
        let jt: String = (jc["joinType"] != null && jc["joinType"] != "") ? jc["joinType"] : "ManyToOne";
        let pro: String = jc["joinEnClassPro"];
        let cls: String = jc["joinEnClass"];
        if (pro == null || pro == "" || cls == null || cls == "") {
          printError("错误：表 '" + tableName + "' 联表缺少 joinEnClassPro/joinEnClass，该条目已跳过");
          continue;
        }
        if (jt == "OneToMany") {
          printLog("提示：表 '" + tableName + "' 联表 '" + pro + "' 为 OneToMany（详情聚合），" +
                   "第一版未支持，已跳过（详情子列表请用子表独立接口）");
          continue;
        }
        if (jt != "ManyToOne") {
          printError("错误：表 '" + tableName + "' 联表 '" + pro + "' 的 joinType '" + jt +
                     "' 仅支持 ManyToOne/OneToMany，该条目已跳过");
          continue;
        }
        // 引用名不得与主表列名冲突（平铺返回键 pro_col 与主表列冲突在 ref 收集时校验）
        let proClash: Bool = false;
        for (pf in param.fields) {
          if (pf.name == pro) { proClash = true; }
        }
        if (proClash) {
          printError("错误：表 '" + tableName + "' 联表引用名 '" + pro +
                     "' 与主表列名冲突，该条目已跳过");
          continue;
        }
        // 引用名去重（Go 同结构体字段/SQL 别名禁重复）
        let proDup: Bool = false;
        for (jd in joinDefs) {
          if (jd["pro"] == pro) { proDup = true; }
        }
        if (proDup) {
          printError("错误：表 '" + tableName + "' 联表引用名 '" + pro + "' 重复，该条目已跳过");
          continue;
        }
        // 外键列（ManyToOne 必填，∈ 主表列）
        let fk: String = jc["joinFk"];
        let fkField: FieldDef = null;
        for (pf in param.fields) {
          if (pf.name == fk) { fkField = pf; }
        }
        if (fkField == null) {
          printError("错误：表 '" + tableName + "' 联表 '" + pro + "' 的外键列 joinFk('" +
                     (fk == null ? "" : fk) + "') 不在主表列中，该条目已跳过");
          continue;
        }
        // 目标表按 modelName 定位（joinEnClass 填目标表模型名）
        let target: Object = tablesByModel[cls];
        if (target == null) {
          printError("错误：表 '" + tableName + "' 联表 '" + pro + "' 的目标 '" + cls +
                     "' 不在本文件 tables[] 中（joinEnClass 填目标表模型名），该条目已跳过");
          continue;
        }
        // 主键列（缺省 id，∈ 目标表列）
        let pk: String = (jc["joinPk"] != null && jc["joinPk"] != "") ? jc["joinPk"] : "id";
        let pkOk: Bool = false;
        let tcols: Object[] = target["columns"];
        for (tc in tcols) {
          if (tc["name"] == pk) { pkOk = true; }
        }
        if (!pkOk) {
          printError("错误：表 '" + tableName + "' 联表 '" + pro + "' 的主键列 joinPk('" +
                     pk + "') 不在目标表 " + cls + " 中，该条目已跳过");
          continue;
        }
        joinDefs.append({ pro: pro, fk: fk, pk: pk, target: target, joinEnClass: cls });
      }
    }
    let hasJoin: Bool = (joinDefs.length > 0);

    // ── 6.4b 查询场景数据（复刻 query_data.ac 产出形态，类型换 goType）──
    //      selFields       - SelectParams 查询字段（selColsEq + selColsLike/Gap，支持联表 ref）
    //      sortInfo        - 排序信息（selColsSort，缺省主键 DESC；联表 ref → `pro`.`col`）
    //      whereConditions - repo getWhereByIn 的 Go 条件块
    let queryData: QueryData = new QueryData();
    let selFields: SelFieldDef[] = queryData.buildSelFields(json, param, joinDefs, hasJoin);
    let sortInfo = queryData.buildSortInfo(json, param, param.primaryField.name, joinDefs, hasJoin);
    let whereConditions: String[] = queryData.buildWhereConditions(selFields);

    // ── 6.4c 联表平铺字段与 JOIN/SELECT 片段（按 ref 使用集按需生成）─────
    //      被 selCols/selColsEq/Like/Gap/Sort 引用的联表 ref 才生成平铺字段
    //      （实体非 DB 列 gorm:"column:别名;->" 只读，SELECT 时 AS 别名自动扫描）；
    //      LEFT JOIN 无匹配为 NULL → 平铺字段一律指针类型
    let joinFlatFields: FieldDef[] = [];   // 实体平铺字段（返回键 = 引用名_列名）
    let joinSelectParts: String[] = [];    // SELECT 片段（`pro`.`col` AS `pro_col`）
    let joinClauses: String[] = [];        // JOIN 子句（每有效联表一条）
    for (jd in joinDefs) {
      let joinKind: String = "LEFT JOIN";
      // joinKind 固定 LEFT（inner 语义未开放配置；LEFT 保证主表数据不丢）
      joinClauses.append(joinKind + " `" + jd["target"]["tableName"] + "` `" + jd["pro"] +
                         "` ON `" + jd["pro"] + "`.`" + jd["pk"] + "` = `t`.`" + jd["fk"] + "`");
    }
    // ref 收集：selCols[].ref + selColsEq/Like/Gap（[{ref,visible}]）+ selColsSort 键中带点的
    let usedJoinRefs: String[] = [];
    let selColCfgs: Object[] = json["selCols"];
    if (selColCfgs != null) {
      for (sc in selColCfgs) {
        let r: String = sc["ref"];
        if (r != null && r.indexOf(".") > 0 && !usedJoinRefs.includes(r)) {
          usedJoinRefs.append(r);
        }
      }
    }
    let eqCfgs: Object[] = json["selColsEq"];
    let gapCfgs: Object[] = json["selColsGap"];
    let likeCfgs: Object[] = json["selColsLike"];
    let sortCfg: Object = json["selColsSort"];
    for (qc in eqCfgs) {
      let r: String = qc["ref"];
      if (r != null && r.indexOf(".") > 0 && !usedJoinRefs.includes(r)) { usedJoinRefs.append(r); }
    }
    for (qc in gapCfgs) {
      let r: String = qc["ref"];
      if (r != null && r.indexOf(".") > 0 && !usedJoinRefs.includes(r)) { usedJoinRefs.append(r); }
    }
    for (qc in likeCfgs) {
      let r: String = qc["ref"];
      if (r != null && r.indexOf(".") > 0 && !usedJoinRefs.includes(r)) { usedJoinRefs.append(r); }
    }
    if (sortCfg != null && sortCfg.length) {
      for (pair in sortCfg) {
        let r: String = pair[0];
        if (r != null && r.indexOf(".") > 0 && !usedJoinRefs.includes(r)) { usedJoinRefs.append(r); }
      }
    }
    // 解析使用集 → 平铺字段（别名冲突/目标列缺失报错跳过，与设计器校验同源）
    for (ref in usedJoinRefs) {
      let dot: Number = ref.indexOf(".");
      let pro: String = ref.substring(0, dot);
      let col: String = ref.substring(dot + 1);
      let jd: Object = null;
      for (d in joinDefs) {
        if (d["pro"] == pro) { jd = d; }
      }
      if (jd == null) {
        printError("错误：表 '" + tableName + "' 读模型引用 '" + ref +
                   "' 的引用名未声明为启用的 ManyToOne 联表，该列已跳过");
        continue;
      }
      let tcol: Object = null;
      let tcols2: Object[] = jd["target"]["columns"];
      for (tc in tcols2) {
        if (tc["name"] == col) { tcol = tc; }
      }
      if (tcol == null) {
        printError("错误：表 '" + tableName + "' 读模型引用 '" + ref + "' 的目标列在联表 " +
                   jd["joinEnClass"] + " 中不存在，该列已跳过");
        continue;
      }
      let alias: String = pro + "_" + col;
      // 别名不得与主表列名/已生成别名冲突（同键覆盖会静默错数据）
      let aliasClash: Bool = false;
      for (pf in param.fields) {
        if (pf.name == alias) { aliasClash = true; }
      }
      for (ff in joinFlatFields) {
        if (ff.name == alias) { aliasClash = true; }
      }
      if (aliasClash) {
        printError("错误：表 '" + tableName + "' 联表别名 '" + alias + "'（ref " + ref +
                   "）与主表列名或其它联表别名冲突，该列已跳过");
        continue;
      }
      let ff: FieldDef = new FieldDef();
      ff.name = alias;
      ff.comment = sanitizeGoComment(tcol["comment"]);
      ff.colType = tcol["mysqlType"];
      ff.unsigned = (tcol["unsigned"] == true);
      ff.goType = mapTypeToGo(ff.colType, ff.unsigned);
      ff.goName = snakeToPascal(alias);
      // LEFT JOIN 无匹配为 NULL → 一律指针类型；只读列（JOIN SELECT 自动扫描填充）
      ff.declType = "*" + ff.goType;
      ff.ptrType = "*" + ff.goType;
      ff.isPtr = true;
      ff.gormTag = "gorm:\"column:" + alias + ";->\"";
      ff.jsonTag = "json:\"" + alias + "\"";
      joinFlatFields.append(ff);
      joinSelectParts.append("`" + pro + "`.`" + col + "` AS `" + alias + "`");
    }
    let hasJoinFlat: Bool = (joinSelectParts.length > 0);
    let joinSelectStr: String = "`t`.*";
    if (hasJoinFlat) {
      joinSelectStr = joinSelectStr + ", " + joinSelectParts.join(", ");
    }

    // ── 6.4d 唯一性预检（indexes[].unique 自动推导）───────────────────
    //      每个 unique 索引组生成 Insert/Update 前置查重块（Update 排除自身主键）；
    //      并发窗口由 DB 唯一索引兜底，此处提升错误可读性。可空列 NULL 不互斥
    //      （NULL = NULL 永假），天然跳过未传值。
    let uniqInsChecks: String[] = [];
    let uniqUpdChecks: String[] = [];
    let idxCfgs: Object[] = json["indexes"];
    if (idxCfgs != null) {
      for (ix in idxCfgs) {
        if (ix["unique"] != true) { continue; }
        let ucols: String[] = ix["cols"];
        if (ucols == null || ucols.length == 0) { continue; }
        // 组内列须都在主表（跨表/缺列的唯一索引组跳过）
        let allExist: Bool = true;
        for (c in ucols) {
          let found: Bool = false;
          for (pf in param.fields) {
            if (pf.name == c) { found = true; }
          }
          if (!found) { allExist = false; }
        }
        if (!allExist) {
          printLog("警告：唯一索引 '" + ix["name"] + "' 含主表不存在的列，跳过唯一性预检生成");
          continue;
        }
        let whereStr: String = "";
        let argsStr: String = "";
        let firstC: Bool = true;
        for (c in ucols) {
          if (!firstC) {
            whereStr = whereStr + " AND ";
            argsStr = argsStr + ", ";
          }
          firstC = false;
          whereStr = whereStr + "`" + c + "` = ?";
          argsStr = argsStr + "data." + snakeToPascal(c);
        }
        let dupMsg: String = "duplicate: " + ix["name"] + "(" + ucols.join(",") + ")";
        // Insert 前置查重（返回签名 0, err）
        uniqInsChecks.append(
          "  {\n"
          + "    var cnt int64\n"
          + "    if err := db.Model(&model." + param.entityClass + "{}).Where(\"" + whereStr + "\", " + argsStr + ").Count(&cnt).Error; err != nil {\n"
          + "      return 0, err\n"
          + "    }\n"
          + "    if cnt > 0 {\n"
          + "      return 0, errors.New(\"" + escapeGoStr(dupMsg) + "\")\n"
          + "    }\n"
          + "  }");
        // Update 前置查重（额外排除自身主键）
        uniqUpdChecks.append(
          "  {\n"
          + "    var cnt int64\n"
          + "    if err := db.Model(&model." + param.entityClass + "{}).Where(\"" + whereStr + "\", " + argsStr + ").Where(\"`" + param.primaryField.name + "` <> ?\", data." + param.primaryField.goName + ").Count(&cnt).Error; err != nil {\n"
          + "      return 0, err\n"
          + "    }\n"
          + "    if cnt > 0 {\n"
          + "      return 0, errors.New(\"" + escapeGoStr(dupMsg) + "\")\n"
          + "    }\n"
          + "  }");
        printLog("[" + tableName + "] 唯一索引 '" + ix["name"] + "' 生成 Insert/Update 唯一性预检");
      }
    }
    let hasUniqCheck: Bool = (uniqInsChecks.length > 0);

    // ── 6.5 枚举数据（表级 enums 节点 + globalEnumCols 全局枚举列）──
    let enums: Object[] = buildTableEnums(json, param, globalEnumDefs, emittedGlobalEnums);
    let hasEnums: Bool = (enums.length > 0);

    // ── 6.6 i18n 多语言配置处理 ────────────────────────────────────
    //      json 配置 i18n 节点时生成"主表 + 翻译表"多语言 API：
    //        - 翻译表必须也在 tables[] 中（生成期不连库，列定义来自配置），
    //          其实体文件由 6.2 翻译表分支生成（只生成实体）
    //        - 查询平铺当前语言文本（缺失回退 defaultLang），详情附全语言 map
    //        - 写入事务内 upsert 翻译行（依赖翻译表 uk(extKey, langKey) 唯一键）
    //      i18n 格式：{ table: 'shop0', extKey: 'ext_id', langKey: 'lang',
    //                   fields: ['name','intro'], defaultLang: 'zh' }
    let hasI18n: Bool = false;
    let i18nEntityClass: String = "";
    let i18nEntityClassFile: String = "";
    let i18nExtKey: String = "";
    let i18nLangKey: String = "";
    let i18nExtGoName: String = "";      // 外键列导出名（UpsertI18n 赋值用）
    let i18nLangGoName: String = "";     // 语言列导出名（GetI18nMap 取键用）
    let i18nExtGoType: String = "int64"; // 外键列 Go 类型（辅助方法签名用）
    let i18nDefaultLang: String = "zh";
    let i18nFlatFields: FieldDef[] = []; // 平铺进主表返回结构的翻译字段
    let i18nMapType: String = "";        // 全语言翻译 map 类型名，如 ShopI18nMap
    let i18nColsStr: String = "";        // UpsertI18n DoUpdates 列清单（"name", "intro"）
    let i18nCfg: Object = json["i18n"];
    if (i18nCfg != null) {
      let i18nTable: String = i18nCfg["table"];
      let iTableDef: Object = tablesByName[i18nTable];
      if (iTableDef == null) {
        printError("错误：i18n 翻译表 '" + i18nTable + "' 不在 .jsontable tables[] 中" +
                   "（Go 链生成期不连库，翻译表列定义必须进配置），主表 " + tableName + " 的 i18n 配置被跳过");
      } else {
        // 用 Param 加工翻译表配置（复用全部字段映射逻辑，得 Shop0 与字段/goType）
        let iParam: Param = new Param();
        iParam.setTableData(iTableDef);
        i18nEntityClass = iParam.entityClass;
        i18nEntityClassFile = "en_" + i18nTable;

        // extKey / langKey 列存在性校验（写入与查询都依赖这两列）
        i18nExtKey = i18nCfg["extKey"];
        i18nLangKey = i18nCfg["langKey"];
        let extField: FieldDef = null;
        let langField: FieldDef = null;
        for (f in iParam.fields) {
          if (f.name == i18nExtKey) { extField = f; }
          if (f.name == i18nLangKey) { langField = f; }
        }
        if (extField == null || langField == null) {
          printError("错误：i18n 配置的 extKey('" + i18nExtKey + "') 或 langKey('" + i18nLangKey +
                     "') 列在翻译表 " + i18nTable + " 中不存在，i18n 配置被跳过");
        } else {
          i18nExtGoName = extField.goName;
          i18nLangGoName = langField.goName;
          i18nExtGoType = extField.goType;

          // defaultLang：语言回退目标（查询不到当前语言时用它的文本）
          if (i18nCfg["defaultLang"] != null && i18nCfg["defaultLang"] != "") {
            i18nDefaultLang = i18nCfg["defaultLang"];
          }
          // langFrom：v1 仅支持 body（语言码放请求体），配 header 时提示
          if (i18nCfg["langFrom"] == "header") {
            printLog("提示：i18n.langFrom=header 第一版未支持，已按 body.lang 生成（语言码放请求体）");
          }

          // 平铺字段收集：fields 中每列必须在翻译表中存在，且不与主表列重名
          //   与主表重名时平铺会覆盖主表数据 → 报错跳过 i18n
          let fieldCfg: String[] = i18nCfg["fields"];
          let i18nInvalid: Bool = false;
          for (fname in fieldCfg) {
            let found: FieldDef = null;
            for (f in iParam.fields) {
              if (f.name == fname) { found = f; break; }
            }
            if (found == null) {
              printError("错误：i18n.fields 中的列 '" + fname + "' 在翻译表 " + i18nTable + " 中不存在，i18n 配置被跳过");
              i18nInvalid = true;
              break;
            }
            for (mf in param.fields) {
              if (mf.name == fname) {
                printError("错误：i18n.fields 中的列 '" + fname + "' 与主表 " + tableName +
                           " 的列重名，平铺会覆盖主表数据，i18n 配置被跳过");
                i18nInvalid = true;
                break;
              }
            }
            if (i18nInvalid) { break; }
            // 平铺字段：主表实体里的非 DB 列（gorm:"-"），类型/标签取翻译列
            let ff: FieldDef = new FieldDef();
            ff.name = found.name;
            ff.comment = found.comment;
            ff.goType = found.goType;
            ff.declType = found.declType;
            ff.goName = found.goName;
            ff.gormTag = "gorm:\"-\"";
            ff.jsonTag = found.jsonTag;
            i18nFlatFields.append(ff);
          }

          if (!i18nInvalid) {
            hasI18n = true;
            i18nMapType = param.entityClass + "I18nMap";
            // UpsertI18n 的 DoUpdates 列清单（"name", "intro"）
            let firstCol: Bool = true;
            for (iff in i18nFlatFields) {
              if (firstCol) {
                firstCol = false;
              } else {
                i18nColsStr = i18nColsStr + ", ";
              }
              i18nColsStr = i18nColsStr + "\"" + iff.name + "\"";
            }
          }
        }
      }
    }

    // ── 6.7 组装传给模板的数据对象 tplData ────────────────────
    //      模板中的所有 ${变量名} 都从这里取值
    let tplData: Object = {};
    // 顶层标识
    tplData["moduleName"] = moduleName;
    tplData["modelName"] = modelName;
    tplData["tableName"] = param.tableName;
    tplData["tableComment"] = param.tableDesc;
    tplData["modulePath"] = modulePath;   // import 前缀：{moduleName}/internal/model 形态
    tplData["repoPath"] = repoPath;
    tplData["svcPath"] = svcPath;
    tplData["hdlPath"] = hdlPath;
    // 类名/文件名族（Go 结构体名与文件名均由表名派生）
    tplData["entityClass"] = param.entityClass;                      // 如 Shop
    tplData["repoClass"] = param.entityClass + "Repo";               // 如 ShopRepo
    tplData["serviceClass"] = param.entityClass + "Service";         // 如 ShopService
    tplData["handlerClass"] = param.entityClass + "Handler";         // 如 ShopHandler
    tplData["selClass"] = param.entityClass + "SelectParams";        // 如 ShopSelectParams
    tplData["insClass"] = param.entityClass + "InsertParams";        // 如 ShopInsertParams
    tplData["updClass"] = param.entityClass + "UpdateParams";        // 如 ShopUpdateParams
    // 主键信息（SelectById/Update/Delete 与各处定位用）
    tplData["idGoType"] = param.primaryField.goType;
    tplData["idGoName"] = param.primaryField.goName;
    tplData["idColName"] = param.primaryField.name;
    // 字段族
    tplData["fields"] = param.fields;          // 实体字段循环
    tplData["insFields"] = param.insFields;    // InsertParams 字段循环
    tplData["updFields"] = param.updFields;    // UpdateParams 字段循环
    tplData["selFields"] = selFields;          // SelectParams 查询字段循环
    tplData["whereConditions"] = whereConditions;  // getWhereByIn 条件块循环
    tplData["sortDesc"] = sortInfo.sortDesc;              // 排序描述（注释用）
    tplData["orderByDef"] = sortInfo.orderByDef;          // 排序字面量串（预留）
    tplData["defaultOrderField"] = sortInfo.defaultOrderField;  // 默认排序 ref
    tplData["defaultOrderSql"] = sortInfo.defaultOrderSql;      // 默认排序 SQL 列限定
    tplData["defaultOrderDir"] = sortInfo.defaultOrderDir;      // 默认排序方向
    // 联表数据（hasJoin 时 SelectByIn 走 Table+Joins+Select 平铺）
    tplData["hasJoin"] = hasJoin;
    tplData["joinClauses"] = joinClauses;      // JOIN 子句循环（LEFT JOIN ... ON ...）
    tplData["joinSelectStr"] = joinSelectStr;  // SELECT 串（`t`.*, `pro`.`col` AS `pro_col`...）
    tplData["hasJoinFlat"] = hasJoinFlat;
    tplData["joinFlatFields"] = joinFlatFields;  // 实体平铺只读字段循环
    // 唯一性预检（indexes[].unique 自动推导；Insert/Update 各一组前置查重块）
    tplData["hasUniqCheck"] = hasUniqCheck;
    tplData["uniqInsChecks"] = uniqInsChecks;
    tplData["uniqUpdChecks"] = uniqUpdChecks;
    // 枚举数据
    tplData["enums"] = enums;              // ${each enum in enums} 循环
    tplData["hasEnums"] = hasEnums;        // ${if hasEnums} 是否生成枚举文件
    // i18n 数据
    tplData["hasI18n"] = hasI18n;
    tplData["i18nEntityClass"] = i18nEntityClass;
    tplData["i18nEntityClassFile"] = i18nEntityClassFile;
    tplData["i18nExtKey"] = i18nExtKey;
    tplData["i18nLangKey"] = i18nLangKey;
    tplData["i18nExtGoName"] = i18nExtGoName;
    tplData["i18nLangGoName"] = i18nLangGoName;
    tplData["i18nExtGoType"] = i18nExtGoType;
    tplData["i18nDefaultLang"] = i18nDefaultLang;
    tplData["i18nFlatFields"] = i18nFlatFields;
    tplData["i18nMapType"] = i18nMapType;
    tplData["i18nColsStr"] = i18nColsStr;

    // import 块（文本预拼，模板直接 ${xxxImports} 输出）
    tplData["entityImports"] = buildEntityImports(param, i18nFlatFields, joinFlatFields);
    tplData["inImports"] = buildInImports(param, selFields);
    let repoExt: String[] = [];
    repoExt.append("gorm.io/gorm");
    if (hasI18n) {
      repoExt.append("gorm.io/gorm/clause");
    }
    repoExt.append(modulePath);
    let repoStd: String[] = [];
    if (hasUniqCheck) {
      repoStd.append("errors");
    }
    tplData["repoImports"] = buildGoImports(repoStd, repoExt);
    let svcExt: String[] = [];
    svcExt.append("gorm.io/gorm");
    svcExt.append(modulePath);
    svcExt.append(repoPath);
    tplData["svcImports"] = buildGoImports([], svcExt);
    let hdlStd: String[] = [];
    hdlStd.append("net/http");
    let hdlExt: String[] = [];
    hdlExt.append("github.com/gin-gonic/gin");
    hdlExt.append(modulePath);
    hdlExt.append(svcPath);
    tplData["hdlImports"] = buildGoImports(hdlStd, hdlExt);

    // ── 6.8 遍历模板配置，逐个渲染并写入文件 ──────────────────
    //      每个模板 cfg 的输出路径由 cfg.out 模板 + formatPath 替换得到；
    //      手改层模板内部用 ${if !fileExists(outputPath)} 守卫，存在即跳过
    for (cfg in templates) {
      let outPath: String = formatPath(cfg.out, {
        goBasePath: goBasePath,
        tableName: param.tableName,
        modelName: modelName
      });
      tplData["outputPath"] = outPath;  // 供模板内的 fileExists(outputPath) 守卫使用

      // 核心：调用模板引擎，把 tpl 中的 ${变量名} 替换为实际值
      let result = renderTpl(cfg.tpl, tplData);

      // 渲染成功 → 写入磁盘（手改层已存在时模板返回空串，不写）
      if (result) {
        let writeOk: Bool = writeFile(outPath, result);
        if (writeOk) {
          generatedFileCount = generatedFileCount + 1;
        }
        printLog("生成文件: " + outPath);
      }
    }

    // ── 6.9 枚举文件（无枚举不生成）───────────────────────────
    if (hasEnums) {
      let enumOutPath: String = formatPath("{goBasePath}/internal/model/{tableName}_enum.go", {
        goBasePath: goBasePath,
        tableName: param.tableName
      });
      let enumResult = renderTpl(enumTplPath, tplData);
      if (enumResult) {
        let enumOk: Bool = writeFile(enumOutPath, enumResult);
        if (enumOk) {
          generatedFileCount = generatedFileCount + 1;
        }
        printLog("生成文件: " + enumOutPath);
      }
    }

    // ── 6.10 路由注册函数（渲染文本收集，循环结束后统一注入）──
    let routerResult = renderTpl(routerTplPath, tplData);
    if (routerResult) {
      routes.push({
        funcName: "Register" + param.entityClass + "Routes",
        rendered: routerResult,
        hdlPath: hdlPath
      });
    }
  }  // end for (json in genTables)

  // ── 7. router_.go 幂等注入（照 app_module.ac 模式，整行匹配去重）──
  //      把本次生成的注册函数追加进 internal/router/router_.go 的
  //      {autocode:routes} 标记区；已存在的函数自动跳过
  let routerFilePath: String = params["routerFilePath"];
  if (routerFilePath == null || routerFilePath.length == 0) {
    routerFilePath = goBasePath + "/internal/router/router_.go";
  }
  updateRouterFile(routerFilePath, routes);

  // ── 8. 汇总 ────────────────────────────────────────────────────────
  if (missingTableCount > 0) {
    printError("警告：共 " + missingTableCount + " 张表因配置缺陷被跳过（详见上方红色错误）");
  }
  printLog("--- 代码生成结束，共生成 " + generatedFileCount + " 个文件 ---");
  return generatedFileCount;
}

/// @brief 从 Go 项目根的 go.mod 读取 module 名
/// @param goBasePath Go 项目根目录
/// @return module 名（如 shop_api）；文件不存在/缺 module 行返回空串
export function readGoModuleName(goBasePath: String): String {
  let goModPath: String = goBasePath + "/go.mod";
  if (!fileExists(goModPath)) {
    return "";
  }
  let content: String = readFile(goModPath);
  if (content == null || content.length == 0) {
    return "";
  }
  let lines: String[] = content.split("\n");
  for (line in lines) {
    let t: String = line.trim();
    if (t.startsWith("module ")) {
      // 取 "module " 前缀之后的模块路径（首格后的内容）
      return t.substring(7).trim();
    }
  }
  return "";
}

/// @brief 从模板配置数组中取出实体模板路径（翻译表分支复用 en.tpl）
/// @param templates 模板配置数组
/// @return 实体模板路径；找不到返回空串（调用方按空跳过渲染）
export function entityTplPath(templates: TemplateConfig[]): String {
  for (cfg in templates) {
    if (cfg.tpl.indexOf("en.tpl") >= 0) {
      return cfg.tpl;
    }
  }
  return "";
}

/// @brief 构建主表实体文件的 import 块（含 i18n/联表平铺字段的类型探测）
/// @param param 已加工的表参数
/// @param flatFields i18n 平铺字段（可能引入 time/datatypes 类型）
/// @param joinFlat 联表平铺字段（可能引入 time/datatypes 类型）
/// @return 完整 import 块文本（无导入时为空串）
export function buildEntityImports(param: Param, flatFields: FieldDef[], joinFlat: FieldDef[]): String {
  let needTime: Bool = param.hasTimeField;
  let needDatatypes: Bool = param.hasJsonField;
  for (ff in flatFields) {
    if (ff.goType == "time.Time") { needTime = true; }
    if (ff.goType == "datatypes.JSON") { needDatatypes = true; }
  }
  for (ff in joinFlat) {
    if (ff.goType == "time.Time") { needTime = true; }
    if (ff.goType == "datatypes.JSON") { needDatatypes = true; }
  }
  let std: String[] = [];
  let ext: String[] = [];
  if (needTime) { std.append("time"); }
  if (needDatatypes) { ext.append("gorm.io/datatypes"); }
  return buildGoImports(std, ext);
}

/// @brief 构建请求结构文件（{model}_in.go）的 import 块
/// @param param 已加工的表参数（insFields/updFields 扫描）
/// @param selFields 查询字段（声明类型可能为 *time.Time）
/// @return 完整 import 块文本（无导入时为空串）
export function buildInImports(param: Param, selFields: SelFieldDef[]): String {
  let needTime: Bool = false;
  let needDatatypes: Bool = false;
  for (f in param.insFields) {
    if (f.declType.includes("time.Time")) { needTime = true; }
    if (f.declType.includes("datatypes.JSON")) { needDatatypes = true; }
  }
  for (f in param.updFields) {
    if (f.declType.includes("time.Time")) { needTime = true; }
    if (f.declType.includes("datatypes.JSON")) { needDatatypes = true; }
  }
  for (sf in selFields) {
    if (sf.declType.includes("time.Time")) { needTime = true; }
  }
  let std: String[] = [];
  let ext: String[] = [];
  if (needTime) { std.append("time"); }
  if (needDatatypes) { ext.append("gorm.io/datatypes"); }
  return buildGoImports(std, ext);
}

/// @brief 构建翻译实体文件（en.tpl）的模板数据（主表实体直接用 tplData，无需本函数）
/// @param param 已加工的翻译表参数
/// @return tplData：{entityClass, tableName, tableComment, fields, entityImports, hasI18n}
export function buildEntityData(param: Param): Object {
  let d: Object = {};
  d["entityClass"] = param.entityClass;
  d["tableName"] = param.tableName;
  d["tableComment"] = param.tableDesc;
  d["fields"] = param.fields;
  d["hasI18n"] = false;  // 翻译实体自身无 i18n 块
  let std: String[] = [];
  let ext: String[] = [];
  if (param.hasTimeField) { std.append("time"); }
  if (param.hasJsonField) { ext.append("gorm.io/datatypes"); }
  d["entityImports"] = buildGoImports(std, ext);
  return d;
}

/// @brief 构建表枚举数据：globalEnumCols 全局枚举列 + 表级 enums 节点
/// @param table .jsontable 表配置
/// @param param 已加工的表参数（列注释回退用）
/// @param globalEnumDefs 全局枚举查找表（name → 定义）
/// @param emitted 本次运行已生成 const 的全局枚举名（跨表去重，Go 同包禁重复）
/// @return enums 数组，每项 {enumName, columnName, comment, mapKeyType, items}
export function buildTableEnums(table: Object, param: Param, globalEnumDefs: Object, emitted: Object): Object[] {
  let enums: Object[] = [];

  // ── 1. 全局枚举列：globalEnumCols 命中 .jsonglobalenum ──────────
  //      命中列在 {model}_enum.go 生成 Go const 块 + Map；
  //      同一全局枚举本次运行只生成一份（Go 同包不允许重复 const 定义）
  let geCols: String[] = table["globalEnumCols"];
  if (geCols != null) {
    for (gcol in geCols) {
      let gDef: Object = globalEnumDefs[gcol];
      if (gDef == null) {
        printError("警告：表 " + table.tableName + " 的 globalEnumCols 引用的全局枚举 '" +
                   gcol + "' 不存在（.jsonglobalenum 未定义），该列不生成枚举");
        continue;
      }
      let geName: String = gDef["enumName"];
      if (emitted[geName] == true) {
        printLog("全局枚举 " + geName + " 已在本次运行生成过 const，跳过重复生成（表 " + table.tableName + "）");
        continue;
      }
      emitted[geName] = true;
      enums.append(buildEnumEntry(geName, gcol, gDef["remark"], gDef["options"]));
    }
  }

  // ── 2. 表级枚举：tables[].enums 节点（配置事实源，生成期不连库）──
  //      格式：{"enums":[{"column":"status","comment":"状态",
  //              "items":[{"key":"enable","label":"启用","value":"1","valueType":"number"}]}]}
  //      枚举名：Enum + 表帕斯卡 + 列帕斯卡（如 shop.status → EnumShopStatus）
  let tableEnums: Object[] = table["enums"];
  if (tableEnums != null) {
    for (te in tableEnums) {
      let colName: String = te["column"];
      if (colName == null || colName.length == 0) {
        printLog("警告：表 " + table.tableName + " 的表级枚举缺少 column，已跳过");
        continue;
      }
      let enumName: String = "Enum" + param.entityClass + snakeToPascal(colName);
      // 枚举说明缺省回退列注释
      let comment: String = te["comment"];
      if (comment == null || comment.length == 0) {
        comment = "";
        for (f in param.fields) {
          if (f.name == colName) { comment = f.comment; }
        }
      }
      enums.append(buildEnumEntry(enumName, colName, comment, te["items"]));
    }
  }
  return enums;
}

/// @brief 把枚举原始选项加工成模板数据项（表级枚举与全局枚举共用）
/// @param enumName 枚举名（Go const 前缀，如 EnumShopStatus）
/// @param columnName 列名（注释定位用）
/// @param comment 枚举说明
/// @param rawItems 原始选项数组 [{key,label,value,valueType}]
/// @return {enumName, columnName, comment, mapKeyType, items:[{key,label,valueStr}]}
///   值字面量：valueType=number → 数字字面量（map 键 int）；其余 → 双引号字符串
export function buildEnumEntry(enumName: String, columnName: String, comment: String, rawItems: Object[]): Object {
  let items: Object[] = [];
  let mapKeyType: String = "string";
  let first: Bool = true;
  if (rawItems != null) {
    for (o in rawItems) {
      // 成员名：key 转帕斯卡，缺省按序号兜底（opt_1 / opt_2 ...）
      let itemKey: String = o["key"];
      if (itemKey == null || itemKey == "") {
        itemKey = "opt_" + (items.length + 1);
      }
      // 实际值（null 兜底为空串，防止拼接出 "null" 字样）
      let rawValue: String = "";
      if (o["value"] != null) {
        rawValue = "" + o["value"];
      }
      // 值字面量：number 类型不带引号，字符串带双引号（Go 转义）
      let valueStr: String = "\"" + escapeGoStr(rawValue) + "\"";
      if (o["valueType"] == "number") {
        valueStr = rawValue;
      }
      // map 键类型按首项取值类别判定
      if (first) {
        if (o["valueType"] == "number" && isNumericStr(rawValue)) {
          mapKeyType = "int";
        }
        first = false;
      }
      items.append({
        key: snakeToPascal(itemKey),
        label: sanitizeGoComment(o["label"]),
        valueStr: valueStr
      });
    }
  }
  return {
    enumName: enumName,
    columnName: columnName,
    comment: sanitizeGoComment(comment),
    mapKeyType: mapKeyType,
    items: items
  };
}
