/// @file main_api.ac — 通用 Go(gin+gorm) 后端 API 代码生成主逻辑
/// ----------------------------------------------------------------------------
/// 说明：
///   本文件是 crud_gin 后端 API 代码生成的**通用主逻辑**，
///   不包含任何项目相关的参数（输出路径、模板配置）。
///   项目入口脚本（如 file/go_pure/<项目>/<项目>.ac，plan 5.3）只需定义项目
///   参数并调用 generateApiMain()。
///
///   与 crud_nest 链的本质区别：**生成期不连数据库**。
///   .jsontable 是唯一事实源（表设计器产出，含完整列定义与前端角色），
///   本脚本只读配置，不调 db.tableSchema / db.query。
///
///   整体流程（从 .jsontable 到 Go 文件）：
///     ┌────────────┐  columns   ┌──────────┐   tplData   ┌───────────┐
///     │ .jsontable │ ─────────► │  Param   │ ──────────► │ en/in/repo│
///     │ tables[]   │  列定义     │ (加工器) │   渲染数据   │ /svc/hdl  │
///     └────────────┘            └──────────┘             └─────┬─────┘
///                                             renderTpl()      ▼
///                                              modules/<moduleDir>/{model,dto,...}/*.go
///
/// 接收的项目参数（params 对象）：
///   - goBasePath     Go 项目根目录（modules/... 写到这里）；
///                    省略时用 .jsontable 的 meta.goBasePath
///   - jsonTablePath  可选，.jsontable 配置文件绝对路径；
///                    省略时收集勾选文件中的 .jsontable
///   - genGlobalEnum  可选，false 跳过全局枚举收集（缺省/true 收集）
///   - templates      可选，模板配置数组（省略时使用本文件默认模板）
///
/// 输出布局（对齐 gin-vue-admin 式模块化架子）：
///   modules/<moduleDir>/{model,dto,repo,service,handler,router}.go
///   + {tableName}_custom.go 自定义层（仅首次生成，fileExists 守卫）
///   moduleDir 缺省 <tableName>/<tableName>，系统表可在 .jsontable 配
///   moduleDir（如 sys/menu）与手写架子目录对齐；包名 = 目录末段。
///   路由集中注册：生成器独占 {goBasePath}/router/routes_.go，每次生成
///   按 modules/{admin,app} 树扫描 *_router_.go 生成覆盖件并整体重写（幂等，
///   见 regenRouteRegistration）；手写模块与 RegisterCustomRoutes 钩子仍在
///   router/router.go 手动注册。旧版 modules/<moduleDir> 自包含 router.go
///   链（params.templates 缺省时）不在扫描范围，仍走集中注册提醒清单。
/// ----------------------------------------------------------------------------

import { Param, FieldDef, buildGoImports, escapeGoStr, sanitizeGoComment, tabChar } from "./core/param_go.ac";
import { QueryData, SelFieldDef } from "./core/query_data.ac";
import { snakeToPascal, snakeToCamel, isNumericStr } from "../../tool/tool_str.ac";
import { findGlobalEnumFiles, mergeGlobalEnumFiles } from "../../tool/tool_global_enum.ac";
import { dirnameOf, findProjPath, relDirUnder } from "../../tool/tool_jsontable.ac";

/// @brief 模板配置（一个模板对应一个生成的代码文件）
class TemplateConfig {
  let tpl: String = "";  // 模板文件路径（相对入口脚本目录）
  let out: String = "";  // 输出文件路径模板，用 {key} 占位符从 tplData 取值
}

// ═══════════════════════════════════════════════════════════════════════════
// 〇、生成覆盖守卫（防手写文件被误覆盖）
// ═══════════════════════════════════════════════════════════════════════════

/// @brief 生成覆盖守卫：目标文件已存在但缺少 AutoCode 生成标记时跳过覆盖
/// @param path 输出文件路径
/// @return true=可写入（文件不存在，或内容含生成标记属于本生成器产物）；
///         false=跳过写入（已输出红字提示，疑似用户手写文件）
/// 检测标记取两条生成链模板头注释的公共子串：
///   vue 链"//此文件为AutoCode编译器生成，请勿手动修改"、
///   Go 链"// 此代码为AutoCode编译器生成，请勿手动修改"
export function canOverwriteGenerated(path: String): Bool {
  if (!fileExists(path)) {
    return true;
  }
  let old: String = readFile(path);
  if (old.indexOf("AutoCode编译器生成") >= 0) {
    return true;
  }
  printError("跳过覆盖: " + path + "（已存在但缺少 AutoCode 生成标记，疑似手写文件；确认要覆盖请先删除该文件再重新生成）");
  return false;
}

/// @brief 生成 Go 后端 API 代码
/// @param params 项目参数对象（见文件头说明）
/// @return 实际写入磁盘的文件数量
export function generateApiMain(params: Object): Number {
  // 统计实际写入磁盘的文件数量（writeFile 成功时 +1），返回给入口脚本汇总输出
  let generatedFileCount: Number = 0;

  // ── 1. .jsontable 配置文件收集 ─────────────────────────────────────
  //      优先级：params.jsonTablePaths（文件数组，与前端链对称）
  //            > params.jsonTablePath（单文件）
  //            > 收集 tree.config 勾选文件中的 .jsontable（限定本项目目录）
  let jsonFiles: String[] = [];
  let jtpArr: String[] = params["jsonTablePaths"];
  if (jtpArr != null) {
    let jaLen = jtpArr.length;
    for (let ja = 0; ja < jaLen; ja = ja + 1) {
      jsonFiles.append(jtpArr[ja].replace("\\", "/"));
    }
  }
  if (jsonFiles.length == 0) {
    let jsonTablePath: String = params["jsonTablePath"];
    if (jsonTablePath != null && jsonTablePath.length > 0) {
      jsonFiles.append(jsonTablePath);
    }
  }
  if (jsonFiles.length == 0) {
    let checked: String[] = getCheckedFiles(scriptDir());
    for (f in checked) {
      if (f.endsWith(".jsontable")) {
        jsonFiles.append(f);
      }
    }
  }
  if (jsonFiles.length == 0) {
    printError("错误：未找到 .jsontable 配置（请配置 params.jsonTablePaths / jsonTablePath，或在项目目录勾选 .jsontable 文件）");
    return 0;
  }
  printLog("jsontable files: " + jsonFiles.length + " 份");

  // ── 1.5 检查配置文件是否同名不同路径（文件重复）──────────────────
  //      同名 .jsontable 同时参与生成会导致表重复定义，应报错并中止
  let seenBases: String[] = [];
  let dupFiles: String[] = [];
  for (chk in jsonFiles) {
    let base: String = basename(chk);
    let seen: Bool = false;
    for (sb in seenBases) {
      if (sb == base) { seen = true; }
    }
    if (seen) {
      dupFiles.push(base);
    } else {
      seenBases.push(base);
    }
  }
  if (dupFiles.length > 0) {
    printError("错误：配置文件存在同名不同路径（文件重复），请取消勾选其中一个后重新执行：");
    for (d in dupFiles) {
      printError("  - " + d);
    }
    return 0;
  }

  // ── 2. 读取 .jsontable：单表新格式逐文件收集 + 项目 meta ────────────
  //      一文件一表：每份 { table: {...} } 一张表（翻译表内嵌在表的 i18n 配置）；
  //      共享 meta 在同目录 project.acproj（params.projPath 显式指定
  //      优先，否则从第一份 .jsontable 所在目录向上查找）；
  //      表名重复在 4 节预扫描中报错去重
  let tables: Object[] = [];
  let metaGoBasePath: String = "";
  let projPath: String = params["projPath"];
  if (projPath == null || projPath.length == 0) {
    projPath = findProjPath(dirnameOf(jsonFiles[0]), 3);
  }
  if (projPath != null && projPath.length > 0) {
    let projJson: Object = readJson(projPath);
    if (projJson == null) {
      printError("错误：项目 meta 文件读取失败: " + projPath);
      return 0;
    }
    let projMeta: Object = projJson["meta"];
    if (projMeta != null && projMeta["goBasePath"] != null) {
      metaGoBasePath = projMeta["goBasePath"];
    }
    printLog("项目 meta: " + projPath);
  } else {
    printLog("未找到 project.acproj（meta.goBasePath 回退 params.goBasePath）");
  }
  for (file in jsonFiles) {
    let fileJson: Object = readJson(file);
    if (fileJson == null) {
      printError("错误：.jsontable 读取失败: " + file);
      return 0;
    }
    if (fileJson["tables"] != null) {
      printError("错误：旧多表格式（含 tables 键）: " + file);
      printError("      请先运行 file/tools/split_jsontable.ac 拆分为一文件一表新格式");
      return 0;
    }
    let t: Object = fileJson["table"];
    if (t == null) {
      printError("错误：.jsontable 缺少顶层 table 键: " + file);
      return 0;
    }
    // 目录结构 = 模块结构：记录相对扫描根（入口脚本目录）的目录段，
    // 供 moduleDir 缺省推导（4 节预扫描）；不在扫描根下时为 ""（回退旧缺省）
    t["_relDir"] = relDirUnder(file, scriptDir());
    tables.append(t);
  }
  printLog("tables count: " + tables.length);

  // ── 2.5 i18n 翻译表派生：启用 i18n 且无显式翻译表配置时按惯例派生 ────
  //      派生规则见 deriveI18nTable（与 C++ json_table_model.cpp 镜像）；
  //      显式 {table}0.jsontable 存在时优先（用户完全控制权），仅缺省时派生。
  //      派生表与显式表同路进入 4 节预扫描（i18nRefs 标记 → 只生成实体）
  let explicitNames: Object = {};
  for (t in tables) {
    explicitNames[t["tableName"]] = true;
  }
  let derivedTables: Object[] = [];
  for (t in tables) {
    let cfg: Object = t["i18n"];
    if (cfg == null || cfg["table"] == null || cfg["table"].length == 0) {
      continue;
    }
    if (explicitNames[cfg["table"]] == true) {
      continue;
    }
    let d: Object = deriveI18nTable(t);
    printLog("i18n 翻译表 '" + d["tableName"] + "' 无显式配置，已从主表 '" + t["tableName"] + "' 派生");
    derivedTables.append(d);
  }
  for (d in derivedTables) {
    tables.append(d);
  }
  if (derivedTables.length > 0) {
    printLog("tables count（含派生）: " + tables.length);
  }

  // ── 3. goBasePath 与模块名 ─────────────────────────────────────────
  //      goBasePath：params 优先（兼容 basePath 键名），缺省回退 meta.goBasePath
  let goBasePath: String = params["goBasePath"];
  if (goBasePath == null || goBasePath.length == 0) {
    goBasePath = params["basePath"];
  }
  if (goBasePath == null || goBasePath.length == 0) {
    goBasePath = metaGoBasePath;
  }
  if (goBasePath == null || goBasePath.length == 0) {
    printError("错误：未配置 goBasePath（params.goBasePath 与 .jsontable meta.goBasePath 均为空）");
    return 0;
  }
  goBasePath = goBasePath.replace("\\", "/");

  // 模块名：读 go.mod 的 module 行（生成架子包 import 前缀，如 {moduleName}/common）；
  // 无 go.mod 时无法确定 import 路径 → 报错并跳过全部表生成
  let moduleName: String = readGoModuleName(goBasePath);
  if (moduleName == "") {
    printError("错误：go.mod 不存在或缺 module 行，跳过全部表生成: " + goBasePath + "/go.mod");
    return 0;
  }
  // 架子公共包 import 路径（响应统一走 common.OK/Fail，路由挂 middleware.JWTAuth）
  let commonPath: String = moduleName + "/common";
  let middlewarePath: String = moduleName + "/middleware";
  printLog("Go 项目: " + goBasePath + "（module: " + moduleName + "）");

  // ── 3.5 全局枚举收集（tool_global_enum.ac 直接复用）────────────────
  //      两级作用域（就近在前）合并 .jsonglobalenum。
  //      Go 链不生成公共枚举文件，只构建 name → 定义 查找表：
  //      表配置 globalEnumCols 命中的列在 {model}_enum.go 里生成 Go const 块
  //      （跨表同名 const 只生成一次，见 5.5 节）
  let globalEnumDefs: Object = {};
  let emittedGlobalEnums: Object = {};  // 本次运行已生成 const 的全局枚举名
  if (params["genGlobalEnum"] != false) {
    let geFiles: String[] = findGlobalEnumFiles(scriptDir());
    if (geFiles.length > 0) {
      printLog("global enum files: " + geFiles.length + " 份（就近优先合并）");
      let geJson: Object = mergeGlobalEnumFiles(geFiles);
      let geList: Object[] = geJson["enums"];
      for (ge in geList) {
        globalEnumDefs[ge["name"]] = ge;
      }
    } else {
      printLog("未找到 global_enum.jsonglobalenum，跳过全局枚举收集");
    }
  } else {
    printLog("genGlobalEnum=false，跳过全局枚举收集");
  }

  // ── 4. 预扫描：i18n 引用标记 + 表名/模型名去重 + 模块目录预计算 ──────
  //      被某表 i18n.table 引用的表（如 shop0）只生成实体文件，
  //      跳过 repo/service/handler/router 生成（翻译表是主表从属）
  let i18nRefs: Object = {};
  let i18nOwner: Object = {};      // 翻译表名 → 主表表名（翻译实体落主表模块目录用）
  let tablesByName: Object = {};   // tableName → 表配置（i18n 翻译表列定义查找用）
  let tablesByModel: Object = {};  // modelName → 表配置（joinTable 联表目标定位用）
  let genTables: Object[] = [];    // 去重后的待生成表配置
  for (t in tables) {
    let tn: String = t["tableName"];
    if (tn == null || tn.length == 0) {
      printError("错误：.jsontable 存在缺少 tableName 的表配置，已跳过");
      continue;
    }
    if (tablesByName[tn] != null) {
      printError("错误：表 '" + tn + "' 在 .jsontable 中重复定义，后者已跳过");
      continue;
    }
    tablesByName[tn] = t;
    // modelName 缺省回退 tableName（与 6.1 主循环推导一致）；重复 modelName 报错
    let mn: String = t["modelName"];
    if (mn == null || mn.length == 0) {
      mn = tn;
    }
    if (tablesByModel[mn] != null) {
      printError("错误：modelName '" + mn + "' 重复定义，联表 joinEnClass 无法唯一定位，后者已跳过");
      continue;
    }
    tablesByModel[mn] = t;
    // ── 模块目录预计算（modules/<moduleDir>/，包名 = 目录末段）────────
    //    moduleDir 缺省 = .jsontable 相对扫描根的目录段 + 表名
    //    （目录结构 = 模块结构：user/user_ext.jsontable → user/user_ext）；
    //    与扫描根同目录时回退 <tableName>/<tableName>；
    //    系统表可显式配 moduleDir（如 sys/menu）与手写架子目录对齐。
    //    仅允许相对子路径（禁 ..，去首尾斜杠）
    let md: String = t["moduleDir"];
    if (md == null || md.length == 0) {
      let rel: String = t["_relDir"];
      if (rel != null && rel.length > 0) {
        md = rel + "/" + tn;
      } else {
        md = tn + "/" + tn;
      }
    }
    md = md.replace("\\", "/");
    while (md.startsWith("/")) {
      md = md.substring(1);
    }
    while (md.endsWith("/") && md.length > 1) {
      md = md.substring(0, md.length - 1);
    }
    if (md == "" || md.indexOf("..") >= 0) {
      printError("错误：表 '" + tn + "' 的 moduleDir 非法（空或包含 ..），该表已跳过: " + md);
      continue;
    }
    let segs: String[] = md.split("/");
    t["moduleDir"] = md;
    t["pkgName"] = segs[segs.length - 1];
    genTables.append(t);
    let i18nCfg: Object = t["i18n"];
    if (i18nCfg != null && i18nCfg["table"] != null) {
      i18nRefs[i18nCfg["table"]] = true;
      i18nOwner[i18nCfg["table"]] = tn;
    }
  }

  // ── 5. 模板配置：一个模板对应一个生成的代码文件 ───────────────────
  //      覆盖层（model/dto/repo/service/handler/router）每次重新生成；
  //      自定义层 {tableName}_custom.go 由模板内 fileExists(outputPath) 守卫，
  //      仅首次生成（自定义逻辑全写这里，重新生成不会覆盖）
  let templates: TemplateConfig[] = params["templates"];
  if (templates == null) {
    templates = [
      { tpl: "../../crud_gin/template/model/entity.tpl",  out: "{goBasePath}/modules/{moduleDir}/model.go" },
      { tpl: "../../crud_gin/template/model/params.tpl",  out: "{goBasePath}/modules/{moduleDir}/dto.go" },
      { tpl: "../../crud_gin/template/repo/repo.tpl",     out: "{goBasePath}/modules/{moduleDir}/repo.go" },
      { tpl: "../../crud_gin/template/service/svc.tpl",   out: "{goBasePath}/modules/{moduleDir}/service.go" },
      { tpl: "../../crud_gin/template/handler/hdl.tpl",   out: "{goBasePath}/modules/{moduleDir}/handler.go" },
      { tpl: "../../crud_gin/template/router.tpl",        out: "{goBasePath}/modules/{moduleDir}/router.go" },
      { tpl: "../../crud_gin/template/custom.tpl",        out: "{goBasePath}/modules/{moduleDir}/{tableName}_custom.go" }
    ];
  }
  // 枚举/路由模板路径（支持 params 覆盖，相对入口脚本目录）
  let enumTplPath: String = params["enumTpl"];
  if (enumTplPath == null || enumTplPath.length == 0) {
    enumTplPath = "../../crud_gin/template/model/enum.tpl";
  }

  // 集中注册提醒清单（modules/<moduleDir>，生成结束统一打印）
  let regModules: String[] = [];
  // 配置缺陷被跳过的表数量（结束时报错汇总）
  let missingTableCount: Number = 0;

  // ── 6. 对每张表执行一次完整的生成流程 ──────────────────────────────
  for (json in genTables) {
    let tableName: String = json["tableName"];
    let modelName: String = json["modelName"];
    if (modelName == null || modelName.length == 0) {
      modelName = tableName;  // 模型名缺省回退表名
    }
    let tableComment: String = sanitizeGoComment(json["tableComment"]);

    // ── 6.1 列定义校验（生成期不连库，无列 = 无从生成）────────────
    let columns: Object[] = json["columns"];
    if (columns == null || columns.length == 0) {
      printError("错误：表 '" + tableName + "' 无列定义（columns 为空），已跳过生成");
      missingTableCount = missingTableCount + 1;
      continue;
    }
    printLog("[" + tableName + "] columns count: " + columns.length);

    // ── 6.1b 分层布局：data/ + modules/admin/ 新规范 ─────────────
    //      开发期无旧格式包袱，layout 门禁已移除：所有表统一走新布局，
    //      生成逻辑见 generateLayeredTable。
    let layeredModuleDir: String = json["moduleDir"];
    let layeredPkgName: String = json["pkgName"];
    let layeredCount: Number = generateLayeredTable(json, goBasePath, moduleName,
        commonPath, middlewarePath, layeredModuleDir, layeredPkgName,
        globalEnumDefs, emittedGlobalEnums);
    generatedFileCount = generatedFileCount + layeredCount;
    regModules.append(layeredModuleDir);
    continue;

    // ── 6.2 翻译表分支：被 i18n 引用的表只生成实体文件 ─────────────
    //      跳过 repo/service/handler/router 生成（其 CRUD 由主表 repo 的
    //      i18n 辅助方法承接，翻译表不需要独立接口）；
    //      翻译实体落主表模块目录（与主表同包，repo 直接引用类型）
    if (i18nRefs[tableName] == true) {
      let ownerName: String = i18nOwner[tableName];
      if (ownerName == null) {
        ownerName = tableName;
      }
      let ownerTable: Object = tablesByName[ownerName];
      let ownerDir: String = ownerTable["moduleDir"];
      let ownerPkg: String = ownerTable["pkgName"];
      printLog("表 '" + tableName + "' 为 i18n 翻译表（被引用），只生成实体文件（入主表模块 modules/" + ownerDir + "），跳过其余文件生成");
      let iParam: Param = new Param();
      iParam.setTableData(json);
      let iTplData: Object = buildEntityData(iParam);
      iTplData["pkgName"] = ownerPkg;
      let iOutPath: String = formatPath("{goBasePath}/modules/{moduleDir}/en_{tableName}.go", {
        goBasePath: goBasePath,
        tableName: tableName,
        moduleDir: ownerDir
      });
      let iEntityTpl: String = entityTplPath(templates);
      if (iEntityTpl != "") {
        let iResult = renderTpl(iEntityTpl, iTplData);
        if (iResult) {
          if (canOverwriteGenerated(iOutPath)) {
            let iOk: Bool = writeFile(iOutPath, iResult);
            if (iOk) {
              generatedFileCount = generatedFileCount + 1;
            }
            printLog("生成文件: " + iOutPath);
          }
        }
      }
      continue;
    }

    // ── 6.2b 模块目录与包名（预扫描已写入表配置）──────────────────
    let moduleDir: String = json["moduleDir"];
    let pkgName: String = json["pkgName"];
    printLog("[" + tableName + "] module: modules/" + moduleDir + "（package " + pkgName + "）");

    // ── 6.3 Param 加工：.jsontable 列 → goType/标签/参数字段集 ────
    let param: Param = new Param();
    param.setTableData(json);
    // SelectById/Update/Delete 依赖主键，无主键的表无法生成 CRUD
    if (param.primaryField == null) {
      printError("错误：表 '" + tableName + "' 未声明主键列（isPrimary），已跳过生成");
      missingTableCount = missingTableCount + 1;
      continue;
    }
    printLog("[" + tableName + "] fields count: " + param.fields.length);

    // ── 6.4 联表加工（joinTable → joinDefs + 平铺字段 + JOIN/SELECT 片段）──
    //      joinEnClass/joinEnClassPro/joinType/isJoinRelations 沿用旧 .json 命名；
    //      joinFk=本表外键列，joinPk=目标主键列（缺省 id）。
    //      ManyToOne → 列表 LEFT/INNER JOIN + 联表列平铺（返回键 = 引用名_列名）；
    //      OneToMany → 详情聚合 v1 未支持，打印提示跳过。
    let joinDefs: Object[] = [];   // 有效 ManyToOne 条目 {pro, fk, pk, target, joinEnClass}
    let joinCfgs: Object[] = json["joinTable"];
    if (joinCfgs != null) {
      for (jc in joinCfgs) {
        if (jc["isJoinRelations"] == false) {
          continue;  // 未启用条目不生效（旧 .json 同名约定）
        }
        let jt: String = (jc["joinType"] != null && jc["joinType"] != "") ? jc["joinType"] : "ManyToOne";
        let pro: String = jc["joinEnClassPro"];
        let cls: String = jc["joinEnClass"];
        if (pro == null || pro == "" || cls == null || cls == "") {
          printError("错误：表 '" + tableName + "' 联表缺少 joinEnClassPro/joinEnClass，该条目已跳过");
          continue;
        }
        if (jt == "OneToMany") {
          printLog("提示：表 '" + tableName + "' 联表 '" + pro + "' 为 OneToMany（详情聚合），" +
                   "第一版未支持，已跳过（详情子列表请用子表独立接口）");
          continue;
        }
        if (jt != "ManyToOne") {
          printError("错误：表 '" + tableName + "' 联表 '" + pro + "' 的 joinType '" + jt +
                     "' 仅支持 ManyToOne/OneToMany，该条目已跳过");
          continue;
        }
        // 引用名不得与主表列名冲突（平铺返回键 pro_col 与主表列冲突在 ref 收集时校验）
        let proClash: Bool = false;
        for (pf in param.fields) {
          if (pf.name == pro) { proClash = true; }
        }
        if (proClash) {
          printError("错误：表 '" + tableName + "' 联表引用名 '" + pro +
                     "' 与主表列名冲突，该条目已跳过");
          continue;
        }
        // 引用名去重（Go 同结构体字段/SQL 别名禁重复）
        let proDup: Bool = false;
        for (jd in joinDefs) {
          if (jd["pro"] == pro) { proDup = true; }
        }
        if (proDup) {
          printError("错误：表 '" + tableName + "' 联表引用名 '" + pro + "' 重复，该条目已跳过");
          continue;
        }
        // 外键列（ManyToOne 必填，∈ 主表列）
        let fk: String = jc["joinFk"];
        let fkField: FieldDef = null;
        for (pf in param.fields) {
          if (pf.name == fk) { fkField = pf; }
        }
        if (fkField == null) {
          printError("错误：表 '" + tableName + "' 联表 '" + pro + "' 的外键列 joinFk('" +
                     (fk == null ? "" : fk) + "') 不在主表列中，该条目已跳过");
          continue;
        }
        // 目标表按 modelName 定位（joinEnClass 填目标表模型名）
        let target: Object = tablesByModel[cls];
        if (target == null) {
          printError("错误：表 '" + tableName + "' 联表 '" + pro + "' 的目标 '" + cls +
                     "' 不在本文件 tables[] 中（joinEnClass 填目标表模型名），该条目已跳过");
          continue;
        }
        // 主键列（缺省 id，∈ 目标表列）
        let pk: String = (jc["joinPk"] != null && jc["joinPk"] != "") ? jc["joinPk"] : "id";
        let pkOk: Bool = false;
        let tcols: Object[] = target["columns"];
        for (tc in tcols) {
          if (tc["name"] == pk) { pkOk = true; }
        }
        if (!pkOk) {
          printError("错误：表 '" + tableName + "' 联表 '" + pro + "' 的主键列 joinPk('" +
                     pk + "') 不在目标表 " + cls + " 中，该条目已跳过");
          continue;
        }
        joinDefs.append({ pro: pro, fk: fk, pk: pk, target: target, joinEnClass: cls });
      }
    }
    let hasJoin: Bool = (joinDefs.length > 0);

    // ── 6.4b 查询场景数据（复刻 query_data.ac 产出形态，类型换 goType）──
    //      selFields       - SelectParams 查询字段（selColsEq + selColsLike/Gap，支持联表 ref）
    //      sortInfo        - 排序信息（selColsSort，缺省主键 DESC；联表 ref → `pro`.`col`）
    //      whereConditions - repo getWhereByIn 的 Go 条件块
    let queryData: QueryData = new QueryData();
    let selFields: SelFieldDef[] = queryData.buildSelFields(json, param, joinDefs, hasJoin);
    let sortInfo = queryData.buildSortInfo(json, param, param.primaryField.name, joinDefs, hasJoin);
    let whereConditions: String[] = queryData.buildWhereConditions(selFields);

    // ── 6.4c 联表平铺字段与 JOIN/SELECT 片段（按 ref 使用集按需生成）─────
    //      被 selCols/selColsEq/Like/Gap/Sort 引用的联表 ref 才生成平铺字段
    //      （实体非 DB 列 gorm:"column:别名;->" 只读，SELECT 时 AS 别名自动扫描）；
    //      LEFT JOIN 无匹配为 NULL → 平铺字段一律指针类型
    let joinFlatFields: FieldDef[] = [];   // 实体平铺字段（返回键 = 引用名_列名）
    let joinSelectParts: String[] = [];    // SELECT 片段（`pro`.`col` AS `pro_col`）
    let joinClauses: String[] = [];        // JOIN 子句（每有效联表一条）
    for (jd in joinDefs) {
      let joinKind: String = "LEFT JOIN";
      // joinKind 固定 LEFT（inner 语义未开放配置；LEFT 保证主表数据不丢）
      joinClauses.append(joinKind + " `" + jd["target"]["tableName"] + "` `" + jd["pro"] +
                         "` ON `" + jd["pro"] + "`.`" + jd["pk"] + "` = `t`.`" + jd["fk"] + "`");
    }
    // ref 收集：selCols[].ref + selColsEq/Like/Gap（[{ref,visible}]）+ selColsSort 键中带点的
    let usedJoinRefs: String[] = [];
    let selColCfgs: Object[] = json["selCols"];
    if (selColCfgs != null) {
      for (sc in selColCfgs) {
        let r: String = sc["ref"];
        if (r != null && r.indexOf(".") > 0 && !usedJoinRefs.includes(r)) {
          usedJoinRefs.append(r);
        }
      }
    }
    let eqCfgs: Object[] = json["selColsEq"];
    let gapCfgs: Object[] = json["selColsGap"];
    let likeCfgs: Object[] = json["selColsLike"];
    let sortCfg: Object = json["selColsSort"];
    for (qc in eqCfgs) {
      let r: String = qc["ref"];
      if (r != null && r.indexOf(".") > 0 && !usedJoinRefs.includes(r)) { usedJoinRefs.append(r); }
    }
    for (qc in gapCfgs) {
      let r: String = qc["ref"];
      if (r != null && r.indexOf(".") > 0 && !usedJoinRefs.includes(r)) { usedJoinRefs.append(r); }
    }
    for (qc in likeCfgs) {
      let r: String = qc["ref"];
      if (r != null && r.indexOf(".") > 0 && !usedJoinRefs.includes(r)) { usedJoinRefs.append(r); }
    }
    if (sortCfg != null && sortCfg.length) {
      for (pair in sortCfg) {
        let r: String = pair[0];
        if (r != null && r.indexOf(".") > 0 && !usedJoinRefs.includes(r)) { usedJoinRefs.append(r); }
      }
    }
    // 解析使用集 → 平铺字段（别名冲突/目标列缺失报错跳过，与设计器校验同源）
    for (ref in usedJoinRefs) {
      let dot: Number = ref.indexOf(".");
      let pro: String = ref.substring(0, dot);
      let col: String = ref.substring(dot + 1);
      let jd: Object = null;
      for (d in joinDefs) {
        if (d["pro"] == pro) { jd = d; }
      }
      if (jd == null) {
        printError("错误：表 '" + tableName + "' 读模型引用 '" + ref +
                   "' 的引用名未声明为启用的 ManyToOne 联表，该列已跳过");
        continue;
      }
      let tcol: Object = null;
      let tcols2: Object[] = jd["target"]["columns"];
      for (tc in tcols2) {
        if (tc["name"] == col) { tcol = tc; }
      }
      if (tcol == null) {
        printError("错误：表 '" + tableName + "' 读模型引用 '" + ref + "' 的目标列在联表 " +
                   jd["joinEnClass"] + " 中不存在，该列已跳过");
        continue;
      }
      let alias: String = pro + "_" + col;
      // 别名不得与主表列名/已生成别名冲突（同键覆盖会静默错数据）
      let aliasClash: Bool = false;
      for (pf in param.fields) {
        if (pf.name == alias) { aliasClash = true; }
      }
      for (ff in joinFlatFields) {
        if (ff.name == alias) { aliasClash = true; }
      }
      if (aliasClash) {
        printError("错误：表 '" + tableName + "' 联表别名 '" + alias + "'（ref " + ref +
                   "）与主表列名或其它联表别名冲突，该列已跳过");
        continue;
      }
      let ff: FieldDef = new FieldDef();
      ff.name = alias;
      ff.comment = sanitizeGoComment(tcol["comment"]);
      ff.colType = tcol["mysqlType"];
      ff.unsigned = (tcol["unsigned"] == true);
      ff.goType = mapTypeToGo(ff.colType, ff.unsigned);
      ff.goName = snakeToPascal(alias);
      // LEFT JOIN 无匹配为 NULL → 一律指针类型；只读列（JOIN SELECT 自动扫描填充）
      ff.declType = "*" + ff.goType;
      ff.ptrType = "*" + ff.goType;
      ff.isPtr = true;
      ff.gormTag = "gorm:\"column:" + alias + ";->\"";
      ff.jsonTag = "json:\"" + alias + "\"";
      joinFlatFields.append(ff);
      joinSelectParts.append("`" + pro + "`.`" + col + "` AS `" + alias + "`");
    }
    let hasJoinFlat: Bool = (joinSelectParts.length > 0);
    let joinSelectStr: String = "`t`.*";
    if (hasJoinFlat) {
      joinSelectStr = joinSelectStr + ", " + joinSelectParts.join(", ");
    }

    // ── 6.4d 唯一性预检（indexes[].unique 自动推导）───────────────────
    //      每个 unique 索引组生成 Insert/Update 前置查重块（Update 排除自身主键）；
    //      并发窗口由 DB 唯一索引兜底，此处提升错误可读性。可空列 NULL 不互斥
    //      （NULL = NULL 永假），天然跳过未传值。
    let uniqInsChecks: String[] = [];
    let uniqUpdChecks: String[] = [];
    let idxCfgs: Object[] = json["indexes"];
    if (idxCfgs != null) {
      for (ix in idxCfgs) {
        if (ix["unique"] != true) { continue; }
        let ucols: String[] = ix["cols"];
        if (ucols == null || ucols.length == 0) { continue; }
        // 组内列须都在主表（跨表/缺列的唯一索引组跳过）
        let allExist: Bool = true;
        for (c in ucols) {
          let found: Bool = false;
          for (pf in param.fields) {
            if (pf.name == c) { found = true; }
          }
          if (!found) { allExist = false; }
        }
        if (!allExist) {
          printLog("警告：唯一索引 '" + ix["name"] + "' 含主表不存在的列，跳过唯一性预检生成");
          continue;
        }
        let whereStr: String = "";
        let argsStr: String = "";
        let firstC: Bool = true;
        for (c in ucols) {
          if (!firstC) {
            whereStr = whereStr + " AND ";
            argsStr = argsStr + ", ";
          }
          firstC = false;
          whereStr = whereStr + "`" + c + "` = ?";
          argsStr = argsStr + "data." + snakeToPascal(c);
        }
        let dupMsg: String = "duplicate: " + ix["name"] + "(" + ucols.join(",") + ")";
        // Insert 前置查重（返回签名 0, err；modules 模式同包，实体类型免 model. 前缀）
        uniqInsChecks.append(
          "  {\n"
          + "    var cnt int64\n"
          + "    if err := db.Model(&" + param.entityClass + "{}).Where(\"" + whereStr + "\", " + argsStr + ").Count(&cnt).Error; err != nil {\n"
          + "      return 0, err\n"
          + "    }\n"
          + "    if cnt > 0 {\n"
          + "      return 0, errors.New(\"" + escapeGoStr(dupMsg) + "\")\n"
          + "    }\n"
          + "  }");
        // Update 前置查重（额外排除自身主键）
        uniqUpdChecks.append(
          "  {\n"
          + "    var cnt int64\n"
          + "    if err := db.Model(&" + param.entityClass + "{}).Where(\"" + whereStr + "\", " + argsStr + ").Where(\"`" + param.primaryField.name + "` <> ?\", data." + param.primaryField.goName + ").Count(&cnt).Error; err != nil {\n"
          + "      return 0, err\n"
          + "    }\n"
          + "    if cnt > 0 {\n"
          + "      return 0, errors.New(\"" + escapeGoStr(dupMsg) + "\")\n"
          + "    }\n"
          + "  }");
        printLog("[" + tableName + "] 唯一索引 '" + ix["name"] + "' 生成 Insert/Update 唯一性预检");
      }
    }
    let hasUniqCheck: Bool = (uniqInsChecks.length > 0);

    // ── 6.5 枚举数据（表级 enums 节点 + globalEnumCols 全局枚举列）──
    let enums: Object[] = buildTableEnums(json, param, globalEnumDefs, emittedGlobalEnums, pkgName);
    let hasEnums: Bool = (enums.length > 0);

    // ── 6.6 i18n 多语言配置处理 ────────────────────────────────────
    //      json 配置 i18n 节点时生成"主表 + 翻译表"多语言 API：
    //        - 翻译表必须也在 tables[] 中（生成期不连库，列定义来自配置），
    //          其实体文件由 6.2 翻译表分支生成（只生成实体）
    //        - 查询平铺当前语言文本（缺失回退 defaultLang），详情附全语言 map
    //        - 写入事务内 upsert 翻译行（依赖翻译表 uk(extKey, langKey) 唯一键）
    //      i18n 格式：{ table: 'shop0', extKey: 'ext_id', langKey: 'lang',
    //                   fields: ['name','intro'], defaultLang: 'zh' }
    let hasI18n: Bool = false;
    let i18nEntityClass: String = "";
    let i18nEntityClassFile: String = "";
    let i18nExtKey: String = "";
    let i18nLangKey: String = "";
    let i18nExtGoName: String = "";      // 外键列导出名（UpsertI18n 赋值用）
    let i18nLangGoName: String = "";     // 语言列导出名（GetI18nMap 取键用）
    let i18nExtGoType: String = "int64"; // 外键列 Go 类型（辅助方法签名用）
    let i18nDefaultLang: String = "zh";
    let i18nFlatFields: FieldDef[] = []; // 平铺进主表返回结构的翻译字段
    let i18nMapType: String = "";        // 全语言翻译 map 类型名，如 ShopI18nMap
    let i18nColsStr: String = "";        // UpsertI18n DoUpdates 列清单（"name", "intro"）
    let i18nCfg: Object = json["i18n"];
    if (i18nCfg != null) {
      let i18nTable: String = i18nCfg["table"];
      let iTableDef: Object = tablesByName[i18nTable];
      if (iTableDef == null) {
        printError("错误：i18n 翻译表 '" + i18nTable + "' 不在 .jsontable tables[] 中" +
                   "（Go 链生成期不连库，翻译表列定义必须进配置），主表 " + tableName + " 的 i18n 配置被跳过");
      } else {
        // 用 Param 加工翻译表配置（复用全部字段映射逻辑，得 Shop0 与字段/goType）
        let iParam: Param = new Param();
        iParam.setTableData(iTableDef);
        i18nEntityClass = iParam.entityClass;
        i18nEntityClassFile = "en_" + i18nTable;

        // extKey / langKey 列存在性校验（写入与查询都依赖这两列）
        i18nExtKey = i18nCfg["extKey"];
        i18nLangKey = i18nCfg["langKey"];
        let extField: FieldDef = null;
        let langField: FieldDef = null;
        for (f in iParam.fields) {
          if (f.name == i18nExtKey) { extField = f; }
          if (f.name == i18nLangKey) { langField = f; }
        }
        if (extField == null || langField == null) {
          printError("错误：i18n 配置的 extKey('" + i18nExtKey + "') 或 langKey('" + i18nLangKey +
                     "') 列在翻译表 " + i18nTable + " 中不存在，i18n 配置被跳过");
        } else {
          i18nExtGoName = extField.goName;
          i18nLangGoName = langField.goName;
          i18nExtGoType = extField.goType;

          // defaultLang：语言回退目标（查询不到当前语言时用它的文本）
          if (i18nCfg["defaultLang"] != null && i18nCfg["defaultLang"] != "") {
            i18nDefaultLang = i18nCfg["defaultLang"];
          }
          // langFrom：v1 仅支持 body（语言码放请求体），配 header 时提示
          if (i18nCfg["langFrom"] == "header") {
            printLog("提示：i18n.langFrom=header 第一版未支持，已按 body.lang 生成（语言码放请求体）");
          }

          // 平铺字段收集：fields 中每列必须在翻译表中存在，且不与主表列重名
          //   与主表重名时平铺会覆盖主表数据 → 报错跳过 i18n
          let fieldCfg: String[] = i18nCfg["fields"];
          let i18nInvalid: Bool = false;
          for (fname in fieldCfg) {
            let found: FieldDef = null;
            for (f in iParam.fields) {
              if (f.name == fname) { found = f; break; }
            }
            if (found == null) {
              printError("错误：i18n.fields 中的列 '" + fname + "' 在翻译表 " + i18nTable + " 中不存在，i18n 配置被跳过");
              i18nInvalid = true;
              break;
            }
            for (mf in param.fields) {
              if (mf.name == fname) {
                printError("错误：i18n.fields 中的列 '" + fname + "' 与主表 " + tableName +
                           " 的列重名，平铺会覆盖主表数据，i18n 配置被跳过");
                i18nInvalid = true;
                break;
              }
            }
            if (i18nInvalid) { break; }
            // 平铺字段：主表实体里的非 DB 列（gorm:"-"），类型/标签取翻译列
            let ff: FieldDef = new FieldDef();
            ff.name = found.name;
            ff.comment = found.comment;
            ff.goType = found.goType;
            ff.declType = found.declType;
            ff.goName = found.goName;
            ff.gormTag = "gorm:\"-\"";
            ff.jsonTag = found.jsonTag;
            i18nFlatFields.append(ff);
          }

          if (!i18nInvalid) {
            hasI18n = true;
            i18nMapType = param.entityClass + "I18nMap";
            // UpsertI18n 的 DoUpdates 列清单（"name", "intro"）
            let firstCol: Bool = true;
            for (iff in i18nFlatFields) {
              if (firstCol) {
                firstCol = false;
              } else {
                i18nColsStr = i18nColsStr + ", ";
              }
              i18nColsStr = i18nColsStr + "\"" + iff.name + "\"";
            }
          }
        }
      }
    }

    // ── 6.7 组装传给模板的数据对象 tplData ────────────────────
    //      模板中的所有 ${变量名} 都从这里取值
    let tplData: Object = {};
    // 顶层标识
    tplData["moduleName"] = moduleName;
    tplData["modelName"] = modelName;
    tplData["tableName"] = param.tableName;
    tplData["tableComment"] = param.tableDesc;
    tplData["moduleDir"] = moduleDir;     // modules/<moduleDir>（预扫描计算）
    tplData["pkgName"] = pkgName;         // 包名 = moduleDir 末段
    tplData["commonPath"] = commonPath;   // 架子 common 包（OK/Fail 响应）
    tplData["middlewarePath"] = middlewarePath;  // 架子 middleware 包（JWTAuth）
    // 类名/文件名族（Go 结构体名与文件名均由表名派生）
    tplData["entityClass"] = param.entityClass;                      // 如 Shop
    tplData["repoClass"] = param.entityClass + "Repo";               // 如 ShopRepo
    tplData["serviceClass"] = param.entityClass + "Service";         // 如 ShopService
    tplData["handlerClass"] = param.entityClass + "Handler";         // 如 ShopHandler
    tplData["selClass"] = param.entityClass + "SelectParams";        // 如 ShopSelectParams
    tplData["insClass"] = param.entityClass + "InsertParams";        // 如 ShopInsertParams
    tplData["updClass"] = param.entityClass + "UpdateParams";        // 如 ShopUpdateParams
    // 主键信息（SelectById/Update/Delete 与各处定位用）
    tplData["idGoType"] = param.primaryField.goType;
    tplData["idGoName"] = param.primaryField.goName;
    tplData["idColName"] = param.primaryField.name;
    // 字段族
    tplData["fields"] = param.fields;          // 实体字段循环
    tplData["insFields"] = param.insFields;    // InsertParams 字段循环
    tplData["updFields"] = param.updFields;    // UpdateParams 字段循环
    tplData["selFields"] = selFields;          // SelectParams 查询字段循环
    tplData["whereConditions"] = whereConditions;  // getWhereByIn 条件块循环
    tplData["sortDesc"] = sortInfo.sortDesc;              // 排序描述（注释用）
    tplData["orderByDef"] = sortInfo.orderByDef;          // 排序字面量串（预留）
    tplData["defaultOrderField"] = sortInfo.defaultOrderField;  // 默认排序 ref
    tplData["defaultOrderSql"] = sortInfo.defaultOrderSql;      // 默认排序 SQL 列限定
    tplData["defaultOrderDir"] = sortInfo.defaultOrderDir;      // 默认排序方向
    // 联表数据（hasJoin 时 SelectByIn 走 Table+Joins+Select 平铺）
    tplData["hasJoin"] = hasJoin;
    tplData["joinClauses"] = joinClauses;      // JOIN 子句循环（LEFT JOIN ... ON ...）
    tplData["joinSelectStr"] = joinSelectStr;  // SELECT 串（`t`.*, `pro`.`col` AS `pro_col`...）
    tplData["hasJoinFlat"] = hasJoinFlat;
    tplData["joinFlatFields"] = joinFlatFields;  // 实体平铺只读字段循环
    // 唯一性预检（indexes[].unique 自动推导；Insert/Update 各一组前置查重块）
    tplData["hasUniqCheck"] = hasUniqCheck;
    tplData["uniqInsChecks"] = uniqInsChecks;
    tplData["uniqUpdChecks"] = uniqUpdChecks;
    // 枚举数据
    tplData["enums"] = enums;              // ${each enum in enums} 循环
    tplData["hasEnums"] = hasEnums;        // ${if hasEnums} 是否生成枚举文件
    // i18n 数据
    tplData["hasI18n"] = hasI18n;
    tplData["i18nEntityClass"] = i18nEntityClass;
    tplData["i18nEntityClassFile"] = i18nEntityClassFile;
    tplData["i18nExtKey"] = i18nExtKey;
    tplData["i18nLangKey"] = i18nLangKey;
    tplData["i18nExtGoName"] = i18nExtGoName;
    tplData["i18nLangGoName"] = i18nLangGoName;
    tplData["i18nExtGoType"] = i18nExtGoType;
    tplData["i18nDefaultLang"] = i18nDefaultLang;
    tplData["i18nFlatFields"] = i18nFlatFields;
    tplData["i18nMapType"] = i18nMapType;
    tplData["i18nColsStr"] = i18nColsStr;

    // import 块（文本预拼，模板直接 ${xxxImports} 输出；modules 模式同包免层间 import）
    tplData["entityImports"] = buildEntityImports(param, i18nFlatFields, joinFlatFields);
    tplData["inImports"] = buildInImports(param, selFields);
    let repoExt: String[] = [];
    repoExt.append("gorm.io/gorm");
    if (hasI18n) {
      repoExt.append("gorm.io/gorm/clause");
    }
    let repoStd: String[] = [];
    if (hasUniqCheck) {
      repoStd.append("errors");
    }
    tplData["repoImports"] = buildGoImports(repoStd, repoExt);
    let svcExt: String[] = [];
    svcExt.append("gorm.io/gorm");
    tplData["svcImports"] = buildGoImports([], svcExt);
    let hdlExt: String[] = [];
    hdlExt.append("github.com/gin-gonic/gin");
    hdlExt.append(commonPath);
    tplData["hdlImports"] = buildGoImports([], hdlExt);
    // router.go（每模块自包含：gin + JWT 中间件 + common）
    let routerExt: String[] = [];
    routerExt.append("github.com/gin-gonic/gin");
    routerExt.append(middlewarePath);
    routerExt.append(commonPath);
    tplData["routerImports"] = buildGoImports([], routerExt);

    // ── 6.8 遍历模板配置，逐个渲染并写入文件 ──────────────────
    //      每个模板 cfg 的输出路径由 cfg.out 模板 + formatPath 替换得到；
    //      自定义层模板内部用 ${if !fileExists(outputPath)} 守卫，存在即跳过
    for (cfg in templates) {
      let outPath: String = formatPath(cfg.out, {
        goBasePath: goBasePath,
        tableName: param.tableName,
        modelName: modelName,
        moduleDir: moduleDir
      });
      tplData["outputPath"] = outPath;  // 供模板内的 fileExists(outputPath) 守卫使用

      // 核心：调用模板引擎，把 tpl 中的 ${变量名} 替换为实际值
      let result = renderTpl(cfg.tpl, tplData);

      // 渲染成功 → 写入磁盘（自定义层已存在时模板返回空串，不写）
      if (result) {
        if (canOverwriteGenerated(outPath)) {
          let writeOk: Bool = writeFile(outPath, result);
          if (writeOk) {
            generatedFileCount = generatedFileCount + 1;
          }
          printLog("生成文件: " + outPath);
        }
      }
    }

    // ── 6.9 枚举文件（无枚举不生成）───────────────────────────
    if (hasEnums) {
      let enumOutPath: String = formatPath("{goBasePath}/modules/{moduleDir}/{tableName}_enum.go", {
        goBasePath: goBasePath,
        tableName: param.tableName,
        moduleDir: moduleDir
      });
      let enumResult = renderTpl(enumTplPath, tplData);
      if (enumResult) {
        if (canOverwriteGenerated(enumOutPath)) {
          let enumOk: Bool = writeFile(enumOutPath, enumResult);
          if (enumOk) {
            generatedFileCount = generatedFileCount + 1;
          }
          printLog("生成文件: " + enumOutPath);
        }
      }
    }

    // ── 6.10 旧版自包含链提醒清单收集（modules/<moduleDir> 模式）──
    regModules.append(moduleDir);
  }  // end for (json in genTables)

  // ── 7. 生成模块路由集中注册 ────────────────────────────────────────
  //      生成器独占 {goBasePath}/router/routes_.go：按 modules/{admin,app}
  //      树扫描 *_router_.go 生成覆盖件并整体重写（幂等），生成模块无需再
  //      手动到 router.go 注册（详见 regenRouteRegistration）
  let regenCount: Number = regenRouteRegistration(goBasePath);
  // 旧版 modules/<moduleDir> 自包含 router.go 链（params.templates 缺省时）
  // 不在扫描范围，仍按清单手动注册
  if (regenCount >= 0 && regModules.length > 0) {
    printLog("── modules/<moduleDir> 旧版自包含路由模块（不在自动注册范围，请手动注册）──");
    for (m in regModules) {
      printLog("  modules/" + m);
    }
  }

  // ── 8. 汇总 ────────────────────────────────────────────────────────
  if (missingTableCount > 0) {
    printError("警告：共 " + missingTableCount + " 张表因配置缺陷被跳过（详见上方红色错误）");
  }
  printLog("--- 代码生成结束，共生成 " + generatedFileCount + " 个文件 ---");
  return generatedFileCount;
}

// ═══════════════════════════════════════════════════════════════════════════
// 生成模块路由集中注册（routes_.go 独占重写；命名遵循 *_ 尾下划线约定，
// 与模块内 *_handler_.go / *_service_.go / *_router_.go 等生成覆盖件一致）
// ═══════════════════════════════════════════════════════════════════════════

/// @brief 重写 {goBasePath}/router/routes_.go（生成器独占文件，整体重写，幂等）
/// @param goBasePath Go 项目根目录
/// @return 注册的生成模块数量；写入失败/找不到 go.mod 返回 -1
/// 扫描 modules/admin 与 modules/app 下全部 *_router_.go 生成覆盖件：
///   - admin 侧注册到 api 组（<pkg>.RegisterRoutes(api)），包名 = 目录末段；
///   - app 侧注册到 appGroup 组，别名 = "app" + 包名帕斯卡（与 admin 侧包名
///     天然不撞，admin/app 同名包在同一 import 块靠别名区分，如 appShop）；
///   - 手写模块（auth/usermgr/upload/app 等）与 RegisterCustomRoutes 钩子
///     不在本文件，仍由 router/router.go 手动注册。
/// 每次生成按目录树整体重算：新增模块自动进入、删除模块重生成后自动移除，
/// 无需人工维护；import 行按扫描顺序（listFilesDeep 已按路径排序）天然有序。
export function regenRouteRegistration(goBasePath: String): Number {
  let root: String = goBasePath.replace("\\", "/");
  while (root.endsWith("/") && root.length > 1) {
    root = root.substring(0, root.length - 1);
  }

  // Go module 名（go.mod 的 module 行）作为 import 前缀，如 shop_api
  let modName: String = readGoModuleName(root);
  if (modName == "") {
    printError("routes_.go 跳过：go.mod 不存在或缺 module 行: " + root + "/go.mod");
    return -1;
  }

  // 两侧扫描：dir → 相对 goBasePath 的模块根；group → 注册目标路由组参数
  let sides: Object[] = [
    { dir: "modules/admin", group: "api" },
    { dir: "modules/app", group: "appGroup", appSide: true }
  ];
  let imports: String[] = [];
  let calls: String[] = [];
  let usedAlias: Object = {};
  let regCount: Number = 0;
  for (s in sides) {
    let scanDir: String = root + "/" + s["dir"];
    if (!fileExists(scanDir)) {
      continue;
    }
    // listFilesDeep 结果已按路径排序，拼接后 import 块有序，gofmt 稳定
    let files: String[] = listFilesDeep(scanDir, "_router_.go");
    for (f in files) {
      // f 形如 user/user_ext/user_ext_router_.go → rel 取所在目录
      let rel: String = relDirUnder(scanDir + "/" + f, scanDir);
      if (rel == "") {
        continue;
      }
      // 包名 = 目录末段（AutoCode模板规范约定）
      let sep: Number = rel.lastIndexOf("/");
      let pkg: String = sep < 0 ? rel : rel.substring(sep + 1);
      let alias: String = pkg;
      if (s["appSide"] == true) {
        alias = "app" + snakeToPascal(pkg);
      }
      // 同名兜底去重（规范下不会发生，防目录异常导致重复别名编译错误）
      if (usedAlias[alias] == true) {
        let n: Number = 2;
        while (usedAlias[alias + n] == true) {
          n = n + 1;
        }
        alias = alias + n;
      }
      usedAlias[alias] = true;
      imports.append(alias + " \"" + modName + "/" + s["dir"] + "/" + rel + "\"");
      // .ac 字符串不支持 \t 转义，缩进用 tabChar()（param_go.ac 提供）
      calls.append(tabChar() + alias + ".RegisterRoutes(" + s["group"] + ")");
      regCount = regCount + 1;
    }
  }

  // 组装文件：生成头第一行 + 空行 + 包注释紧贴 package（对齐生成件风格）
  let nl: String = "\n";
  let content: String = "// 此代码为AutoCode编译器生成，请勿手动修改" + nl + nl;
  content = content + "// Package router 生成模块集中注册件（AutoCode 独占：每次生成按 modules 树整体重写）" + nl;
  content = content + "// - modules/{admin,app}/**/*_router_.go（生成覆盖件）在此自动注册 RegisterRoutes；" + nl;
  content = content + "// - 手写模块与 RegisterCustomRoutes 钩子仍在 router.go 手动注册。" + nl;
  content = content + "package router" + nl + nl;
  content = content + "import (" + nl;
  // gin 单独一组（对齐 router.go 既有风格：三方库与项目模块之间空行分组）
  content = content + tabChar() + "\"github.com/gin-gonic/gin\"" + nl + nl;
  for (imp in imports) {
    content = content + tabChar() + imp + nl;
  }
  content = content + ")" + nl + nl;
  content = content + "// registerGeneratedRoutes 注册全部 AutoCode 生成模块的路由（router.Setup 调用一次）" + nl;
  content = content + "func registerGeneratedRoutes(api *gin.RouterGroup, appGroup *gin.RouterGroup) {" + nl;
  for (c in calls) {
    content = content + c + nl;
  }
  content = content + "}" + nl;

  let outPath: String = root + "/router/routes_.go";
  if (!writeFile(outPath, content)) {
    return -1;
  }
  printLog("生成模块路由集中注册已重写: " + outPath + "（" + regCount + " 个生成模块）");
  return regCount;
}

/// @brief 从启用 i18n 的主表按惯例派生翻译表定义（0 表）
/// @param mainTable 主表配置（含 i18n 节点：table/extKey/langKey/fields）
/// @return 翻译表配置（tableName/modelName/columns/indexes，frontend=false）
/// @note   派生规则与 C++ deriveI18nTable（json_table_model.cpp）互为镜像，修改需同步：
///         id（自增主键，类型随主表主键）+ extKey（类型随主表主键）+
///         langKey（varchar(8)）+ fields（继承主表同名列的类型/注释，
///         主表无此列时回退 varchar(255)）+ created_at/updated_at（datetime 可空）；
///         唯一索引 uk_{extKey}_{langKey}
export function deriveI18nTable(mainTable: Object): Object {
  let cfg: Object = mainTable["i18n"];
  let transName: String = cfg["table"];
  let extKey: String = cfg["extKey"];
  if (extKey == null || extKey.length == 0) {
    extKey = "ext_id";
  }
  let langKey: String = cfg["langKey"];
  if (langKey == null || langKey.length == 0) {
    langKey = "lang";
  }
  // 主表主键列（extKey 与 0 表 id 的类型基准；找不到回退 int unsigned）
  let pkName: String = "id";
  let pkType: String = "int";
  let pkUnsigned: Bool = true;
  let cols: Object[] = mainTable["columns"];
  if (cols != null) {
    for (c in cols) {
      if (c["isPrimary"] == true) {
        pkName = c["name"];
        pkType = c["mysqlType"];
        pkUnsigned = c["unsigned"] == true;
        break;
      }
    }
  }
  // 列定义（id/extKey/langKey/翻译字段/时间戳）
  let newCols: Object[] = [];
  newCols.append({ name: "id", mysqlType: pkType, unsigned: pkUnsigned, nullable: false,
                   isPrimary: true, isAutoInc: true, comment: "自增主键" });
  newCols.append({ name: extKey, mysqlType: pkType, unsigned: pkUnsigned, nullable: false,
                   isPrimary: false, isAutoInc: false,
                   comment: "扩展ID，关联" + mainTable["tableName"] + "." + pkName });
  newCols.append({ name: langKey, mysqlType: "varchar(8)", unsigned: false, nullable: false,
                   isPrimary: false, isAutoInc: false, comment: "语言编码：zh、en、ja" });
  let fields: String[] = cfg["fields"];
  if (fields != null) {
    for (f in fields) {
      let src: Object = null;
      if (cols != null) {
        for (c in cols) {
          if (c["name"] == f) {
            src = c;
            break;
          }
        }
      }
      if (src != null) {
        let fc: String = src["comment"];
        if (fc == null) {
          fc = f;
        }
        newCols.append({ name: f, mysqlType: src["mysqlType"], unsigned: src["unsigned"] == true,
                         nullable: src["nullable"] == true, isPrimary: false, isAutoInc: false,
                         comment: fc });
      } else {
        newCols.append({ name: f, mysqlType: "varchar(255)", unsigned: false, nullable: false,
                         isPrimary: false, isAutoInc: false, comment: f });
      }
    }
  }
  newCols.append({ name: "created_at", mysqlType: "datetime", unsigned: false, nullable: true,
                   isPrimary: false, isAutoInc: false, comment: "创建时间" });
  newCols.append({ name: "updated_at", mysqlType: "datetime", unsigned: false, nullable: true,
                   isPrimary: false, isAutoInc: false, comment: "更新时间" });
  // 唯一索引：一行一种语言
  let idxs: Object[] = [];
  idxs.append({ name: "uk_" + extKey + "_" + langKey, cols: [extKey, langKey], unique: true });
  // 组装翻译表配置
  let transComment: String = "多语言表";
  let mainComment: String = mainTable["tableComment"];
  if (mainComment != null && mainComment.length > 0) {
    transComment = mainComment + "多语言表";
  }
  let t: Object = {
    tableName: transName,
    modelName: transName,
    tableComment: transComment,
    manualUpdateTime: false,
    frontend: false,
    columns: newCols,
    indexes: idxs,
  };
  return t;
}

/// @brief 从 Go 项目根的 go.mod 读取 module 名
/// @param goBasePath Go 项目根目录
/// @return module 名（如 shop_api）；文件不存在/缺 module 行返回空串
export function readGoModuleName(goBasePath: String): String {
  let goModPath: String = goBasePath + "/go.mod";
  if (!fileExists(goModPath)) {
    return "";
  }
  let content: String = readFile(goModPath);
  if (content == null || content.length == 0) {
    return "";
  }
  let lines: String[] = content.split("\n");
  for (line in lines) {
    let t: String = line.trim();
    if (t.startsWith("module ")) {
      // 取 "module " 前缀之后的模块路径（首格后的内容）
      return t.substring(7).trim();
    }
  }
  return "";
}

/// @brief 从模板配置数组中取出实体模板路径（翻译表分支复用 entity.tpl）
/// @param templates 模板配置数组
/// @return 实体模板路径；找不到返回空串（调用方按空跳过渲染）
export function entityTplPath(templates: TemplateConfig[]): String {
  for (cfg in templates) {
    if (cfg.tpl.indexOf("entity.tpl") >= 0) {
      return cfg.tpl;
    }
  }
  return "";
}

/// @brief 构建主表实体文件的 import 块（含 i18n/联表平铺字段的类型探测）
/// @param param 已加工的表参数
/// @param flatFields i18n 平铺字段（可能引入 time/datatypes 类型）
/// @param joinFlat 联表平铺字段（可能引入 time/datatypes 类型）
/// @return 完整 import 块文本（无导入时为空串）
export function buildEntityImports(param: Param, flatFields: FieldDef[], joinFlat: FieldDef[]): String {
  let needTime: Bool = param.hasTimeField;
  let needDatatypes: Bool = param.hasJsonField;
  for (ff in flatFields) {
    if (ff.goType == "time.Time") { needTime = true; }
    if (ff.goType == "datatypes.JSON") { needDatatypes = true; }
  }
  for (ff in joinFlat) {
    if (ff.goType == "time.Time") { needTime = true; }
    if (ff.goType == "datatypes.JSON") { needDatatypes = true; }
  }
  let std: String[] = [];
  let ext: String[] = [];
  if (needTime) { std.append("time"); }
  if (needDatatypes) { ext.append("gorm.io/datatypes"); }
  return buildGoImports(std, ext);
}

/// @brief 构建请求结构文件（{model}_in.go）的 import 块
/// @param param 已加工的表参数（insFields/updFields 扫描）
/// @param selFields 查询字段（声明类型可能为 *time.Time）
/// @return 完整 import 块文本（无导入时为空串）
export function buildInImports(param: Param, selFields: SelFieldDef[]): String {
  let needTime: Bool = false;
  let needDatatypes: Bool = false;
  for (f in param.insFields) {
    if (f.declType.includes("time.Time")) { needTime = true; }
    if (f.declType.includes("datatypes.JSON")) { needDatatypes = true; }
  }
  for (f in param.updFields) {
    if (f.declType.includes("time.Time")) { needTime = true; }
    if (f.declType.includes("datatypes.JSON")) { needDatatypes = true; }
  }
  for (sf in selFields) {
    if (sf.declType.includes("time.Time")) { needTime = true; }
  }
  let std: String[] = [];
  let ext: String[] = [];
  if (needTime) { std.append("time"); }
  if (needDatatypes) { ext.append("gorm.io/datatypes"); }
  return buildGoImports(std, ext);
}

/// @brief 构建翻译实体文件（en.tpl）的模板数据（主表实体直接用 tplData，无需本函数）
/// @param param 已加工的翻译表参数
/// @return tplData：{entityClass, tableName, tableComment, fields, entityImports, hasI18n}
export function buildEntityData(param: Param): Object {
  let d: Object = {};
  d["entityClass"] = param.entityClass;
  d["tableName"] = param.tableName;
  d["tableComment"] = param.tableDesc;
  d["fields"] = param.fields;
  d["hasI18n"] = false;  // 翻译实体自身无 i18n 块
  let std: String[] = [];
  let ext: String[] = [];
  if (param.hasTimeField) { std.append("time"); }
  if (param.hasJsonField) { ext.append("gorm.io/datatypes"); }
  d["entityImports"] = buildGoImports(std, ext);
  return d;
}

/// @brief 构建表枚举数据：globalEnumCols 全局枚举列 + 表级 enums 节点
/// @param table .jsontable 表配置
/// @param param 已加工的表参数（列注释回退用）
/// @param globalEnumDefs 全局枚举查找表（name → 定义）
/// @param emitted 本次运行已生成 const 的全局枚举名（同包去重；键 = pkgName/枚举名，
///        跨包各自生成互不影响）
/// @param pkgName 模块包名（modules 模式每模块独立包，Go const 同包禁重复）
/// @return enums 数组，每项 {enumName, columnName, comment, mapKeyType, items}
export function buildTableEnums(table: Object, param: Param, globalEnumDefs: Object, emitted: Object, pkgName: String): Object[] {
  let enums: Object[] = [];

  // ── 1. 全局枚举列：globalEnumCols 命中 .jsonglobalenum ──────────
  //      命中列在 {model}_enum.go 生成 Go const 块 + Map；
  //      同一全局枚举在同一包内只生成一份（Go 同包不允许重复 const 定义）
  let geCols: String[] = table["globalEnumCols"];
  if (geCols != null) {
    for (gcol in geCols) {
      let gDef: Object = globalEnumDefs[gcol];
      if (gDef == null) {
        printError("警告：表 " + table.tableName + " 的 globalEnumCols 引用的全局枚举 '" +
                   gcol + "' 不存在（.jsonglobalenum 未定义），该列不生成枚举");
        continue;
      }
      let geName: String = gDef["enumName"];
      let dedupKey: String = pkgName + "/" + geName;
      if (emitted[dedupKey] == true) {
        printLog("全局枚举 " + geName + " 已在包 " + pkgName + " 生成过 const，跳过重复生成（表 " + table.tableName + "）");
        continue;
      }
      emitted[dedupKey] = true;
      enums.append(buildEnumEntry(geName, gcol, gDef["remark"], gDef["options"]));
    }
  }

  // ── 2. 表级枚举：tables[].enums 节点（配置事实源，生成期不连库）──
  //      格式：{"enums":[{"column":"status","comment":"状态",
  //              "items":[{"key":"enable","label":"启用","value":"1","valueType":"number"}]}]}
  //      枚举名：Enum + 表帕斯卡 + 列帕斯卡（如 shop.status → EnumShopStatus）
  let tableEnums: Object[] = table["enums"];
  if (tableEnums != null) {
    for (te in tableEnums) {
      let colName: String = te["column"];
      if (colName == null || colName.length == 0) {
        printLog("警告：表 " + table.tableName + " 的表级枚举缺少 column，已跳过");
        continue;
      }
      let enumName: String = "Enum" + param.entityClass + snakeToPascal(colName);
      // 枚举说明缺省回退列注释
      let comment: String = te["comment"];
      if (comment == null || comment.length == 0) {
        comment = "";
        for (f in param.fields) {
          if (f.name == colName) { comment = f.comment; }
        }
      }
      enums.append(buildEnumEntry(enumName, colName, comment, te["items"]));
    }
  }
  return enums;
}

/// @brief 把枚举原始选项加工成模板数据项（表级枚举与全局枚举共用）
/// @param enumName 枚举名（Go const 前缀，如 EnumShopStatus）
/// @param columnName 列名（注释定位用）
/// @param comment 枚举说明
/// @param rawItems 原始选项数组 [{key,label,value,valueType}]
/// @return {enumName, columnName, comment, mapKeyType, items:[{key,label,valueStr}]}
///   值字面量：valueType=number → 数字字面量（map 键 int）；其余 → 双引号字符串
export function buildEnumEntry(enumName: String, columnName: String, comment: String, rawItems: Object[]): Object {
  let items: Object[] = [];
  let mapKeyType: String = "string";
  let first: Bool = true;
  if (rawItems != null) {
    for (o in rawItems) {
      // 成员名：key 转帕斯卡，缺省按序号兜底（opt_1 / opt_2 ...）
      let itemKey: String = o["key"];
      if (itemKey == null || itemKey == "") {
        itemKey = "opt_" + (items.length + 1);
      }
      // 实际值（null 兜底为空串，防止拼接出 "null" 字样）
      let rawValue: String = "";
      if (o["value"] != null) {
        rawValue = "" + o["value"];
      }
      // 值字面量：number 类型不带引号，字符串带双引号（Go 转义）
      let valueStr: String = "\"" + escapeGoStr(rawValue) + "\"";
      if (o["valueType"] == "number") {
        valueStr = rawValue;
      }
      // map 键类型按首项取值类别判定
      if (first) {
        if (o["valueType"] == "number" && isNumericStr(rawValue)) {
          mapKeyType = "int";
        }
        first = false;
      }
      items.append({
        key: snakeToPascal(itemKey),
        label: sanitizeGoComment(o["label"]),
        valueStr: valueStr
      });
    }
  }
  return {
    enumName: enumName,
    columnName: columnName,
    comment: sanitizeGoComment(comment),
    mapKeyType: mapKeyType,
    items: items
  };
}

// ═══════════════════════════════════════════════════════════════════════════
// 分层布局（data/ + modules/admin/，生成件以 `_` 结尾）
// ----------------------------------------------------------------------------
// 由 .jsontable 触发的模块级新布局（data/ + modules/admin/），
// 所有 .jsontable 统一走此流程（开发期无旧格式，layout 门禁已移除）。
// 为保证生成结果与手写黄金文件逐字节一致，结构体/常量/map 的列对齐在这里
// 用 padTo 预渲染成行数组，模板只做逐行输出（不依赖外部 gofmt）。
// ═══════════════════════════════════════════════════════════════════════════

/// @brief 右侧补空格到指定宽度（go fmt 的 tabwriter 对齐用）
export function padTo(s: String, w: Number): String {
  let n: Number = w - s.length;
  if (n <= 0) {
    return s;
  }
  return s + " ".repeat(n);
}

/// @brief 实体结构体字段行（gorm tag + json tag + 注释，三列对齐）
export function buildEnFieldLines(fields: FieldDef[]): String[] {
  let maxName: Number = 0;
  let maxType: Number = 0;
  let maxTag: Number = 0;
  for (f in fields) {
    if (f.goName.length > maxName) { maxName = f.goName.length; }
    if (f.goType.length > maxType) { maxType = f.goType.length; }
    let tl: Number = ("`" + f.gormTag + " " + f.jsonTag + "`").length;
    if (tl > maxTag) { maxTag = tl; }
  }
  let lines: String[] = [];
  for (f in fields) {
    let tag: String = "`" + f.gormTag + " " + f.jsonTag + "`";
    lines.append(tabChar() + padTo(f.goName, maxName) + " " + padTo(f.goType, maxType)
      + " " + padTo(tag, maxTag) + " // " + f.comment);
  }
  return lines;
}

/// @brief InSel 结构体字段行（嵌入 BasePage + 全指针筛选 + Sort，三列对齐）
export function buildSelFieldLines(selFields: SelFieldDef[]): String[] {
  let baseName: String = "common.BasePage";
  let maxName: Number = baseName.length;
  let maxType: Number = 0;
  let maxTag: Number = 0;
  for (sf in selFields) {
    if (sf.goName.length > maxName) { maxName = sf.goName.length; }
    if (sf.declType.length > maxType) { maxType = sf.declType.length; }
    let tl: Number = ("`json:\"" + sf.name + "\"`").length;
    if (tl > maxTag) { maxTag = tl; }
  }
  // Sort 行参与宽度计算
  let sortTag: String = "`json:\"sort\"`";
  if ("Sort".length > maxName) { maxName = "Sort".length; }
  if ("[]string".length > maxType) { maxType = "[]string".length; }
  if (sortTag.length > maxTag) { maxTag = sortTag.length; }

  let lines: String[] = [];
  // 嵌入字段：gofmt 仍保留 type 列宽度，注释落在 type 列之后
  lines.append(tabChar() + padTo(baseName, maxName) + " " + padTo("", maxType) + " // 分页参数");
  for (sf in selFields) {
    let tag: String = "`json:\"" + sf.name + "\"`";
    lines.append(tabChar() + padTo(sf.goName, maxName) + " " + padTo(sf.declType, maxType)
      + " " + padTo(tag, maxTag) + " // " + sf.comment);
  }
  lines.append(tabChar() + padTo("Sort", maxName) + " " + padTo("[]string", maxType)
    + " " + padTo(sortTag, maxTag) + " // 排序字段名（方向由后端白名单写死）");
  return lines;
}

/// @brief InUpd 结构体字段行（Id 值类型 + 其余全指针，三列对齐）
export function buildUpdFieldLines(fields: FieldDef[], idName: String, idType: String): String[] {
  let idTag: String = "`json:\"id\"`";
  let maxName: Number = idName.length;
  let maxType: Number = idType.length;
  let maxTag: Number = idTag.length;
  for (f in fields) {
    if (f.goName.length > maxName) { maxName = f.goName.length; }
    if (f.ptrType.length > maxType) { maxType = f.ptrType.length; }
    let tl: Number = ("`" + f.jsonTag + "`").length;
    if (tl > maxTag) { maxTag = tl; }
  }
  let lines: String[] = [];
  lines.append(tabChar() + padTo(idName, maxName) + " " + padTo(idType, maxType)
    + " " + padTo(idTag, maxTag) + " // 主键：0=新增，>0=更新");
  for (f in fields) {
    let tag: String = "`" + f.jsonTag + "`";
    lines.append(tabChar() + padTo(f.goName, maxName) + " " + padTo(f.ptrType, maxType)
      + " " + padTo(tag, maxTag) + " // " + f.comment);
  }
  return lines;
}

/// @brief Col 常量块行（名称列对齐）
export function buildColLines(fields: FieldDef[]): String[] {
  let maxName: Number = 0;
  for (f in fields) {
    let n: String = "Col" + f.goName;
    if (n.length > maxName) { maxName = n.length; }
  }
  let lines: String[] = [];
  for (f in fields) {
    let n: String = "Col" + f.goName;
    lines.append(tabChar() + padTo(n, maxName) + " = \"" + f.name + "\"");
  }
  return lines;
}

/// @brief 排序白名单 map 行（键列对齐）
export function buildSortEntryLines(cols: String[], dirs: String[]): String[] {
  let maxKey: Number = 0;
  for (let i = 0; i < cols.length; i = i + 1) {
    let k: String = "Col" + snakeToPascal(cols[i]) + ":";
    if (k.length > maxKey) { maxKey = k.length; }
  }
  let lines: String[] = [];
  for (let i = 0; i < cols.length; i = i + 1) {
    let k: String = "Col" + snakeToPascal(cols[i]) + ":";
    lines.append(tabChar() + padTo(k, maxKey) + " \"" + dirs[i] + "\",");
  }
  return lines;
}

/// @brief 生成一张分层布局的表（data/ + modules/admin/）
/// @return 实际写入文件数
export function generateLayeredTable(json: Object, goBasePath: String, moduleName: String,
    commonPath: String, middlewarePath: String, moduleDir: String, pkgName: String,
    globalEnumDefs: Object, emitted: Object): Number {
  let tplDir: String = "../../crud_gin/template";
  let tableName: String = json["tableName"];
  let param: Param = new Param();
  param.setTableData(json);
  if (param.primaryField == null) {
    printError("错误：表 '" + tableName + "' 未声明主键列（isPrimary），已跳过生成");
    return 0;
  }

  let dataDir: String = moduleDir;
  let dataPath: String = moduleName + "/data/" + dataDir;
  let dataAlias: String = "d" + pkgName;
  let idType: String = param.primaryField.goType;
  let idName: String = param.primaryField.goName;
  let idCol: String = param.primaryField.name;

  // ── 查询场景：过滤字段全指针 + common.Where* 条件 ───────────────
  let qd: QueryData = new QueryData();
  qd.pointerMode = true;
  let selFields: SelFieldDef[] = qd.buildSelFields(json, param, [], false);
  let whereConds: String[] = qd.buildWhereConditionsPointer(selFields);

  // ── 排序白名单：selColsSort 顺序（跳过联表 ref）──────────────────
  let sortCols: String[] = [];
  let sortDirs: String[] = [];
  let sortPairs: Object[] = json["selColsSort"];
  if (sortPairs != null) {
    for (pair in sortPairs) {
      let ref: String = pair[0];
      if (ref == null || ref == "" || ref.indexOf(".") > 0) { continue; }
      let dir: String = pair[1];
      if (dir == null || dir == "") { dir = "DESC"; }
      sortCols.append(ref);
      sortDirs.append(dir);
    }
  }
  let sortWhitelistName: String = snakeToCamel(tableName) + "SortWhitelist";
  let sortEntryLines: String[] = buildSortEntryLines(sortCols, sortDirs);

  // ── 预渲染行（逐字节对齐）─────────────────────────────────────
  let enFieldLines: String[] = buildEnFieldLines(param.fields);
  let colLines: String[] = buildColLines(param.fields);
  let selFieldLines: String[] = buildSelFieldLines(selFields);
  let updFieldLines: String[] = buildUpdFieldLines(param.allWritableFields, idName, idType);
  let toEntityLines: String[] = [];
  let toUpdatesLines: String[] = [];
  for (f in param.allWritableFields) {
    toEntityLines.append(tabChar() + "common.CopyNonNil(&e." + f.goName + ", in." + f.goName + ")");
    toUpdatesLines.append(tabChar() + tabChar() + dataAlias + ".Col" + f.goName + ", in." + f.goName + ",");
  }
  // service 结构体两列对齐（DB/Repo）
  let svcName1: String = "DB";
  let svcType1: String = "*gorm.DB";
  let svcName2: String = "Repo";
  let svcType2: String = "*" + dataAlias + "." + param.repoClass;
  let svcMaxName: Number = svcName1.length;
  if (svcName2.length > svcMaxName) { svcMaxName = svcName2.length; }
  let svcMaxType: Number = svcType1.length;
  if (svcType2.length > svcMaxType) { svcMaxType = svcType2.length; }
  let svcFieldLines: String[] = [];
  // 类型列是行尾（无 tag/注释），gofmt 不补尾随空格
  svcFieldLines.append(tabChar() + padTo(svcName1, svcMaxName) + " " + svcType1);
  svcFieldLines.append(tabChar() + padTo(svcName2, svcMaxName) + " " + svcType2);

  // ── import 块 ────────────────────────────────────────────────
  let needTime: Bool = false;
  for (f in param.fields) {
    if (f.goType == "time.Time") { needTime = true; }
  }
  let selNeedTime: Bool = false;
  for (sf in selFields) {
    if (sf.goType == "time.Time") { selNeedTime = true; }
  }
  let tb: String = tabChar();
  let enImports: String = needTime ? "import \"time\"" : "";
  let selImports: String = "";
  if (selNeedTime) {
    selImports = "import (\n" + tb + "\"" + commonPath + "\"\n" + tb + "\"time\"\n)";
  } else {
    selImports = "import \"" + commonPath + "\"";
  }
  let repoImports: String = "import (\n" + tb + "\"" + commonPath + "\"\n\n" + tb
    + "\"gorm.io/gorm\"\n)";
  let updImports: String = "";
  if (needTime) {
    updImports = "import (\n" + tb + "\"time\"\n\n" + tb + "\"" + commonPath + "\"\n"
      + tb + dataAlias + " \"" + dataPath + "\"\n)";
  } else {
    updImports = "import (\n" + tb + "\"" + commonPath + "\"\n" + tb + dataAlias
      + " \"" + dataPath + "\"\n)";
  }
  let hdlImports: String = "import (\n" + tb + "\"github.com/gin-gonic/gin\"\n\n" + tb + "\""
    + commonPath + "\"\n" + tb + dataAlias + " \"" + dataPath + "\"\n)";
  let svcImports: String = "import (\n" + tb + "\"gorm.io/gorm\"\n\n" + tb + dataAlias
    + " \"" + dataPath + "\"\n)";
  let routerImports: String = "import (\n" + tb + "\"github.com/gin-gonic/gin\"\n\n" + tb + "\""
    + commonPath + "\"\n" + tb + "\"" + middlewarePath + "\"\n)";

  // ── C 端只读模块（modules/app）配置 ──────────────────────────
  //      appQuery 缺省 false；appAuth 缺省 user（宁可漏开放、不可误开放）
  let appQuery: Bool = (json["appQuery"] == true);
  let appAuth: String = json["appAuth"];
  if (appAuth == null || appAuth == "") {
    appAuth = "user";
  }
  let appIsPublic: Bool = (appAuth == "public");
  let appPkgComment: String = json["appPkgComment"];
  if (appPkgComment == null || appPkgComment == "") {
    appPkgComment = param.tableDesc
      + (appIsPublic ? " C 端模块（公开只读查询）" : " C 端模块（需登录只读查询）");
  }
  let appRouterMountNote: String = appIsPublic
    ? "本模块生成配置为公开浏览，故不挂 UserAuth。"
    : "本模块生成配置为需登录，已挂 UserAuth。";
  let appRouterAuthNote: String = appIsPublic
    ? "生成配置：公开浏览，未挂 UserAuth"
    : "生成配置：需登录，已挂 UserAuth";
  let appRouterImports: String = "";
  if (appIsPublic) {
    appRouterImports = "import (\n" + tb + "\"github.com/gin-gonic/gin\"\n\n" + tb
      + "\"" + commonPath + "\"\n)";
  } else {
    appRouterImports = "import (\n" + tb + "\"github.com/gin-gonic/gin\"\n\n" + tb
      + "\"" + commonPath + "\"\n" + tb + "\"" + middlewarePath + "\"\n)";
  }

  // ── 包注释文案（表级配置，缺省按表注释兜底）───────────────────
  let dataPkgComment: String = json["dataPkgComment"];
  if (dataPkgComment == null || dataPkgComment == "") {
    dataPkgComment = param.tableDesc + "表共享数据层（admin 端与 app 端复用）";
  }
  let adminPkgComment: String = json["adminPkgComment"];
  if (adminPkgComment == null || adminPkgComment == "") {
    adminPkgComment = param.tableDesc + "管理端模块（CRUD）";
  }

  // ── 枚举（表级 enums + globalEnumCols；与旧链同一加工器）────────
  let enums: Object[] = buildTableEnums(json, param, globalEnumDefs, emitted, pkgName);
  let hasEnums: Bool = (enums.length > 0);

  // ── tplData ──────────────────────────────────────────────────
  let tplData: Object = {};
  tplData["moduleName"] = moduleName;
  tplData["tableName"] = param.tableName;
  tplData["tableComment"] = param.tableDesc;
  tplData["dataDir"] = dataDir;
  tplData["pkgName"] = pkgName;
  tplData["dataPath"] = dataPath;
  tplData["dataAlias"] = dataAlias;
  tplData["commonPath"] = commonPath;
  tplData["middlewarePath"] = middlewarePath;
  tplData["dataPkgComment"] = dataPkgComment;
  tplData["adminPkgComment"] = adminPkgComment;
  tplData["tableClass"] = param.tableClass;
  tplData["enClass"] = param.enClass;
  tplData["selClass"] = param.selClass;
  tplData["updClass"] = param.updClass;
  tplData["repoClass"] = param.repoClass;
  tplData["serviceClass"] = param.serviceClass;
  tplData["handlerClass"] = param.handlerClass;
  tplData["idGoType"] = idType;
  tplData["idGoName"] = idName;
  tplData["idColName"] = idCol;
  tplData["permPrefix"] = tableName;
  tplData["enFieldLines"] = enFieldLines;
  tplData["colLines"] = colLines;
  tplData["selFieldLines"] = selFieldLines;
  tplData["updFieldLines"] = updFieldLines;
  tplData["toEntityLines"] = toEntityLines;
  tplData["toUpdatesLines"] = toUpdatesLines;
  tplData["svcFieldLines"] = svcFieldLines;
  tplData["whereConditions"] = whereConds;
  tplData["sortWhitelistName"] = sortWhitelistName;
  tplData["sortEntryLines"] = sortEntryLines;
  tplData["enImports"] = enImports;
  tplData["selImports"] = selImports;
  tplData["repoImports"] = repoImports;
  tplData["updImports"] = updImports;
  tplData["hdlImports"] = hdlImports;
  tplData["svcImports"] = svcImports;
  tplData["routerImports"] = routerImports;
  tplData["appQuery"] = appQuery;
  tplData["appIsPublic"] = appIsPublic;
  tplData["appPkgComment"] = appPkgComment;
  tplData["appRouterMountNote"] = appRouterMountNote;
  tplData["appRouterAuthNote"] = appRouterAuthNote;
  tplData["appRouterImports"] = appRouterImports;
  tplData["hasEnums"] = hasEnums;
  tplData["enums"] = enums;

  // ── 模板清单（data 读面 → admin 写面 → 首次骨架）──────────────
  let templates: TemplateConfig[] = [
    { tpl: tplDir + "/model/entity.tpl",  out: "{goBasePath}/data/{dataDir}/en_{tableName}_.go" },
    { tpl: tplDir + "/model/in_sel.tpl",  out: "{goBasePath}/data/{dataDir}/in_sel_{tableName}_.go" },
    { tpl: tplDir + "/repo/repo.tpl",     out: "{goBasePath}/data/{dataDir}/{tableName}_repo_.go" },
    // repo 手写扩展件（首次骨架，fileExists 守卫）：自定义查询/统计方法写这里
    { tpl: tplDir + "/repo/repo_ext.tpl", out: "{goBasePath}/data/{dataDir}/{tableName}_repo.go" },
    { tpl: tplDir + "/model/in_upd.tpl",  out: "{goBasePath}/modules/admin/{dataDir}/in_upd_{tableName}_.go" },
    { tpl: tplDir + "/handler/hdl.tpl",   out: "{goBasePath}/modules/admin/{dataDir}/{tableName}_handler_.go" },
    { tpl: tplDir + "/service/svc.tpl",   out: "{goBasePath}/modules/admin/{dataDir}/{tableName}_service_.go" },
    { tpl: tplDir + "/router.tpl",        out: "{goBasePath}/modules/admin/{dataDir}/{tableName}_router_.go" },
    { tpl: tplDir + "/service/svc_write.tpl", out: "{goBasePath}/modules/admin/{dataDir}/{tableName}_service.go" }
  ];

  // C 端只读模块：只生成 selectByIn/selectById 三件（service/handler/router），
  // 永不生成写接口；路由是否挂 UserAuth 由 appAuth 决定
  if (appQuery) {
    templates.append({ tpl: tplDir + "/app/svc.tpl",
      out: "{goBasePath}/modules/app/{dataDir}/{tableName}_service_.go" });
    templates.append({ tpl: tplDir + "/app/hdl.tpl",
      out: "{goBasePath}/modules/app/{dataDir}/{tableName}_handler_.go" });
    templates.append({ tpl: tplDir + "/app/router.tpl",
      out: "{goBasePath}/modules/app/{dataDir}/{tableName}_router_.go" });
  }

  let count: Number = 0;
  for (cfg in templates) {
    let outPath: String = formatPath(cfg.out, {
      goBasePath: goBasePath,
      dataDir: dataDir,
      tableName: param.tableName,
      moduleDir: moduleDir
    });
    tplData["outputPath"] = outPath;
    let result = renderTpl(cfg.tpl, tplData);
    if (result) {
      if (canOverwriteGenerated(outPath)) {
        if (writeFile(outPath, result)) {
          count = count + 1;
        }
        printLog("生成文件: " + outPath);
      }
    }
  }

  // ── 枚举文件（data 层，无枚举不生成）──────────────────────────
  if (hasEnums) {
    let enumOutPath: String = formatPath("{goBasePath}/data/{dataDir}/enum_{tableName}_.go", {
      goBasePath: goBasePath,
      dataDir: dataDir,
      tableName: param.tableName
    });
    let enumResult = renderTpl(tplDir + "/model/enum.tpl", tplData);
    if (enumResult) {
      if (canOverwriteGenerated(enumOutPath)) {
        if (writeFile(enumOutPath, enumResult)) {
          count = count + 1;
        }
        printLog("生成文件: " + enumOutPath);
      }
    }
  }

  printLog("[" + tableName + "] 分层布局：data/" + dataDir + " + modules/admin/" + dataDir);
  return count;
}
