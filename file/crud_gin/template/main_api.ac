/// @file main_api.ac — 通用 Go(gin+gorm) 后端 API 代码生成主逻辑
/// ----------------------------------------------------------------------------
/// 说明：
///   本文件是 crud_gin 后端 API 代码生成的**通用主逻辑**，
///   不包含任何项目相关的参数（输出路径、模板配置）。
///   项目入口脚本（如 file/go_pure/<项目>/<项目>.ac，plan 5.3）只需定义项目
///   参数并调用 generateApiMain()。
///
///   与 crud_nest 链的本质区别：**生成期不连数据库**。
///   .jsontable 是唯一事实源（表设计器产出，含完整列定义与前端角色），
///   本脚本只读配置，不调 db.tableSchema / db.query。
///
///   整体流程（从 .jsontable 到 Go 文件）：
///     ┌────────────┐  columns   ┌──────────┐   tplData   ┌───────────┐
///     │ .jsontable │ ─────────► │  Param   │ ──────────► │ en/in/repo│
///     │ tables[]   │  列定义     │ (加工器) │   渲染数据   │ /svc/hdl  │
///     └────────────┘            └──────────┘             └─────┬─────┘
///                                             renderTpl()      ▼
///                                              data/<表目录>/ + modules/{admin,app}/<表目录>/
///
/// 接收的项目参数（params 对象）：
///   - goBasePath     Go 项目根目录（data/、modules/... 写到这里）；
///                    省略时用 .jsontable 的 meta.goBasePath
///   - jsonTablePath  可选，.jsontable 配置文件绝对路径；
///                    省略时收集勾选文件中的 .jsontable
///   - genGlobalEnum  可选，false 跳过全局枚举收集（缺省/true 收集）
///
/// 输出布局（data 共享层 + 按端分模块）：
///   data/<前缀>/<表>/：en_<表>_.go、in_sel_<表>_.go、<表>_repo_.go（+手写扩展件）
///   modules/{admin,app}/<前缀>/<表>/：in_upd_<表>_.go、handler/service/router 生成件
///   （app 端另含 out_<表>_.go），手写扩展件首次生成骨架、重新生成不覆盖。
///   路由集中注册：生成器独占 {goBasePath}/router/routes_.go，每次生成按
///   modules/{admin,app} 树扫描 *_router_.go 整体重写（幂等，见
///   regenRouteRegistration）；手写模块与 RegisterCustomRoutes 钩子仍在
///   router/router.go 手动注册。
/// ----------------------------------------------------------------------------

import { Param, FieldDef, buildGoImports, escapeGoStr, sanitizeGoComment, tabChar,
         mapTypeToGo, zeroKindOfGoType } from "./core/param_go.ac";
import { QueryData, SelFieldDef } from "./core/query_data.ac";
import { snakeToPascal, snakeToCamel, isNumericStr } from "../../tool/tool_str.ac";
import { findGlobalEnumFiles, mergeGlobalEnumFiles } from "../../tool/tool_global_enum.ac";
import { dirnameOf, findProjPath, relDirUnder } from "../../tool/tool_jsontable.ac";

/// @brief 模板配置（一个模板对应一个生成的代码文件）
class TemplateConfig {
  let tpl: String = "";  // 模板文件路径（相对入口脚本目录）
  let out: String = "";  // 输出文件路径模板，用 {key} 占位符从 tplData 取值
}

// ═══════════════════════════════════════════════════════════════════════════
// 〇、生成覆盖守卫（防手写文件被误覆盖）
// ═══════════════════════════════════════════════════════════════════════════

/// @brief 生成覆盖守卫：目标文件已存在但缺少 AutoCode 生成标记时跳过覆盖
/// @param path 输出文件路径
/// @return true=可写入（文件不存在，或内容含生成标记属于本生成器产物）；
///         false=跳过写入（已输出红字提示，疑似用户手写文件）
/// 检测标记取两条生成链模板头注释的公共子串：
///   vue 链"//此文件为AutoCode编译器生成，请勿手动修改"、
///   Go 链"// 此代码为AutoCode编译器生成，请勿手动修改"
export function canOverwriteGenerated(path: String): Bool {
  if (!fileExists(path)) {
    return true;
  }
  let old: String = readFile(path);
  if (old.indexOf("AutoCode编译器生成") >= 0) {
    return true;
  }
  printError("跳过覆盖: " + path + "（已存在但缺少 AutoCode 生成标记，疑似手写文件；确认要覆盖请先删除该文件再重新生成）");
  return false;
}

/// @brief 生成 Go 后端 API 代码
/// @param params 项目参数对象（见文件头说明）
/// @return 实际写入磁盘的文件数量
export function generateApiMain(params: Object): Number {
  // 统计实际写入磁盘的文件数量（writeFile 成功时 +1），返回给入口脚本汇总输出
  let generatedFileCount: Number = 0;

  // ── 1. .jsontable 配置文件收集 ─────────────────────────────────────
  //      优先级：params.jsonTablePaths（文件数组，与前端链对称）
  //            > params.jsonTablePath（单文件）
  //            > 收集 tree.config 勾选文件中的 .jsontable（限定本项目目录）
  let jsonFiles: String[] = [];
  let jtpArr: String[] = params["jsonTablePaths"];
  if (jtpArr != null) {
    let jaLen = jtpArr.length;
    for (let ja = 0; ja < jaLen; ja = ja + 1) {
      jsonFiles.append(jtpArr[ja].replace("\\", "/"));
    }
  }
  if (jsonFiles.length == 0) {
    let jsonTablePath: String = params["jsonTablePath"];
    if (jsonTablePath != null && jsonTablePath.length > 0) {
      jsonFiles.append(jsonTablePath);
    }
  }
  if (jsonFiles.length == 0) {
    let checked: String[] = getCheckedFiles(scriptDir());
    for (f in checked) {
      if (f.endsWith(".jsontable")) {
        jsonFiles.append(f);
      }
    }
  }
  if (jsonFiles.length == 0) {
    printError("错误：未找到 .jsontable 配置（请配置 params.jsonTablePaths / jsonTablePath，或在项目目录勾选 .jsontable 文件）");
    return 0;
  }
  printLog("jsontable files: " + jsonFiles.length + " 份");

  // ── 1.5 检查配置文件是否同名不同路径（文件重复）──────────────────
  //      同名 .jsontable 同时参与生成会导致表重复定义，应报错并中止
  let seenBases: String[] = [];
  let dupFiles: String[] = [];
  for (chk in jsonFiles) {
    let base: String = basename(chk);
    let seen: Bool = false;
    for (sb in seenBases) {
      if (sb == base) { seen = true; }
    }
    if (seen) {
      dupFiles.push(base);
    } else {
      seenBases.push(base);
    }
  }
  if (dupFiles.length > 0) {
    printError("错误：配置文件存在同名不同路径（文件重复），请取消勾选其中一个后重新执行：");
    for (d in dupFiles) {
      printError("  - " + d);
    }
    return 0;
  }

  // ── 2. 读取 .jsontable：单表新格式逐文件收集 + 项目 meta ────────────
  //      一文件一表：每份 { table: {...} } 一张表（翻译表内嵌在表的 i18n 配置）；
  //      共享 meta 在同目录 project.acproj（params.projPath 显式指定
  //      优先，否则从第一份 .jsontable 所在目录向上查找）；
  //      表名重复在 4 节预扫描中报错去重
  let tables: Object[] = [];
  let metaGoBasePath: String = "";
  let projPath: String = params["projPath"];
  if (projPath == null || projPath.length == 0) {
    projPath = findProjPath(dirnameOf(jsonFiles[0]), 3);
  }
  if (projPath != null && projPath.length > 0) {
    let projJson: Object = readJson(projPath);
    if (projJson == null) {
      printError("错误：项目 meta 文件读取失败: " + projPath);
      return 0;
    }
    let projMeta: Object = projJson["meta"];
    if (projMeta != null && projMeta["goBasePath"] != null) {
      metaGoBasePath = projMeta["goBasePath"];
    }
    printLog("项目 meta: " + projPath);
  } else {
    printLog("未找到 project.acproj（meta.goBasePath 回退 params.goBasePath）");
  }
  for (file in jsonFiles) {
    let fileJson: Object = readJson(file);
    if (fileJson == null) {
      printError("错误：.jsontable 读取失败: " + file);
      return 0;
    }
    if (fileJson["tables"] != null) {
      printError("错误：旧多表格式（含 tables 键）: " + file);
      printError("      请先运行 file/tools/split_jsontable.ac 拆分为一文件一表新格式");
      return 0;
    }
    let t: Object = fileJson["table"];
    if (t == null) {
      printError("错误：.jsontable 缺少顶层 table 键: " + file);
      return 0;
    }
    // 目录结构 = 模块结构：记录相对扫描根（入口脚本目录）的目录段，
    // 供 moduleDir 缺省推导（4 节预扫描）；不在扫描根下时为 ""（回退旧缺省）
    t["_relDir"] = relDirUnder(file, scriptDir());
    tables.append(t);
  }
  printLog("tables count: " + tables.length);

  // ── 2.5 i18n 翻译表派生：启用 i18n 且无显式翻译表配置时按惯例派生 ────
  //      派生规则见 deriveI18nTable（与 C++ json_table_model.cpp 镜像）；
  //      显式 {table}0.jsontable 存在时优先（用户完全控制权），仅缺省时派生。
  //      派生表与显式表同路进入 4 节预扫描（与普通表一样参与生成）
  let explicitNames: Object = {};
  for (t in tables) {
    explicitNames[t["tableName"]] = true;
  }
  let derivedTables: Object[] = [];
  for (t in tables) {
    let cfg: Object = t["i18n"];
    if (cfg == null || cfg["table"] == null || cfg["table"].length == 0) {
      continue;
    }
    if (explicitNames[cfg["table"]] == true) {
      continue;
    }
    let d: Object = deriveI18nTable(t);
    printLog("i18n 翻译表 '" + d["tableName"] + "' 无显式配置，已从主表 '" + t["tableName"] + "' 派生");
    derivedTables.append(d);
  }
  for (d in derivedTables) {
    tables.append(d);
  }
  if (derivedTables.length > 0) {
    printLog("tables count（含派生）: " + tables.length);
  }

  // ── 3. goBasePath 与模块名 ─────────────────────────────────────────
  //      goBasePath：params 优先（兼容 basePath 键名），缺省回退 meta.goBasePath
  let goBasePath: String = params["goBasePath"];
  if (goBasePath == null || goBasePath.length == 0) {
    goBasePath = params["basePath"];
  }
  if (goBasePath == null || goBasePath.length == 0) {
    goBasePath = metaGoBasePath;
  }
  if (goBasePath == null || goBasePath.length == 0) {
    printError("错误：未配置 goBasePath（params.goBasePath 与 .jsontable meta.goBasePath 均为空）");
    return 0;
  }
  goBasePath = goBasePath.replace("\\", "/");

  // 模块名：读 go.mod 的 module 行（生成架子包 import 前缀，如 {moduleName}/common）；
  // 无 go.mod 时无法确定 import 路径 → 报错并跳过全部表生成
  let moduleName: String = readGoModuleName(goBasePath);
  if (moduleName == "") {
    printError("错误：go.mod 不存在或缺 module 行，跳过全部表生成: " + goBasePath + "/go.mod");
    return 0;
  }
  // 架子公共包 import 路径（响应统一走 common.OK/Fail，路由挂 middleware.AdminAuth）
  let commonPath: String = moduleName + "/common";
  let dbPath: String = commonPath + "/db";
  let coinPath: String = commonPath + "/coin";
  let httpxPath: String = commonPath + "/httpx";
  let redisxPath: String = commonPath + "/redisx";
  let middlewarePath: String = moduleName + "/middleware";
  printLog("Go 项目: " + goBasePath + "（module: " + moduleName + "）");

  // ── 3.5 全局枚举收集（tool_global_enum.ac 直接复用）────────────────
  //      两级作用域（就近在前）合并 .jsonglobalenum。
  //      Go 链不生成公共枚举文件，只构建 name → 定义 查找表：
  //      表配置 globalEnumCols 命中的列在 {model}_enum.go 里生成 Go const 块
  //      （跨表同名 const 只生成一次，见 5.5 节）
  let globalEnumDefs: Object = {};
  let emittedGlobalEnums: Object = {};  // 本次运行已生成 const 的全局枚举名
  if (params["genGlobalEnum"] != false) {
    let geFiles: String[] = findGlobalEnumFiles(scriptDir());
    if (geFiles.length > 0) {
      printLog("global enum files: " + geFiles.length + " 份（就近优先合并）");
      let geJson: Object = mergeGlobalEnumFiles(geFiles);
      let geList: Object[] = geJson["enums"];
      for (ge in geList) {
        globalEnumDefs[ge["name"]] = ge;
      }
    } else {
      printLog("未找到 global_enum.jsonglobalenum，跳过全局枚举收集");
    }
  } else {
    printLog("genGlobalEnum=false，跳过全局枚举收集");
  }

  // ── 3.6 i18n 翻译表识别：主表 i18n.table 指向的表（显式或派生）────────
  //      翻译表只生成 data 层（实体/仓储），不生成 admin/app 模块与路由；
  //      其 extKey/langKey/defaultLang/fields 从主表 i18n 节点透传
  let i18nParentOf: Object = {};
  for (t in tables) {
    let icfg: Object = t["i18n"];
    if (icfg != null && icfg["table"] != null && icfg["table"].length > 0) {
      i18nParentOf[icfg["table"]] = t;
    }
  }

  // ── 4. 预扫描：表名/模型名去重 + 模块目录预计算 ────────────────────
  let tablesByName: Object = {};   // tableName → 表配置（i18n 翻译表列定义查找用）
  let tablesByModel: Object = {};  // modelName → 表配置（joinTable 联表目标定位用）
  let genTables: Object[] = [];    // 去重后的待生成表配置
  for (t in tables) {
    let tn: String = t["tableName"];
    if (tn == null || tn.length == 0) {
      printError("错误：.jsontable 存在缺少 tableName 的表配置，已跳过");
      continue;
    }
    if (tablesByName[tn] != null) {
      printError("错误：表 '" + tn + "' 在 .jsontable 中重复定义，后者已跳过");
      continue;
    }
    tablesByName[tn] = t;
    // modelName 缺省回退 tableName（与 6.1 主循环推导一致）；重复 modelName 报错
    let mn: String = t["modelName"];
    if (mn == null || mn.length == 0) {
      mn = tn;
    }
    if (tablesByModel[mn] != null) {
      printError("错误：modelName '" + mn + "' 重复定义，联表 joinEnClass 无法唯一定位，后者已跳过");
      continue;
    }
    tablesByModel[mn] = t;
    // ── 模块目录预计算（modules/<moduleDir>/，包名 = 目录末段）────────
    //    moduleDir 缺省 = .jsontable 相对扫描根的目录段 + 表名
    //    （目录结构 = 模块结构：user/user_ext.jsontable → user/user_ext）；
    //    与扫描根同目录时回退 <tableName>/<tableName>；
    //    系统表可显式配 moduleDir（如 sys/menu）与手写架子目录对齐。
    //    仅允许相对子路径（禁 ..，去首尾斜杠）
    let md: String = t["moduleDir"];
    if (md == null || md.length == 0) {
      let rel: String = t["_relDir"];
      if (rel != null && rel.length > 0) {
        md = rel + "/" + tn;
      } else {
        md = tn + "/" + tn;
      }
    }
    md = md.replace("\\", "/");
    while (md.startsWith("/")) {
      md = md.substring(1);
    }
    while (md.endsWith("/") && md.length > 1) {
      md = md.substring(0, md.length - 1);
    }
    if (md == "" || md.indexOf("..") >= 0) {
      printError("错误：表 '" + tn + "' 的 moduleDir 非法（空或包含 ..），该表已跳过: " + md);
      continue;
    }
    let segs: String[] = md.split("/");
    t["moduleDir"] = md;
    t["pkgName"] = segs[segs.length - 1];
    // i18n 翻译表标记：翻译表依附主表，不单独生成代码包
    let i18nParent: Object = i18nParentOf[tn];
    if (i18nParent != null) {
      t["_i18nTable"] = true;
      t["_i18nEmbedded"] = true;
      t["_i18nParent"] = i18nParent["tableName"];
      let icfg: Object = i18nParent["i18n"];
      t["_i18nExtKey"] = (icfg["extKey"] == null || icfg["extKey"] == "") ? "ext_id" : icfg["extKey"];
      t["_i18nLangKey"] = (icfg["langKey"] == null || icfg["langKey"] == "") ? "lang" : icfg["langKey"];
      t["_i18nDefaultLang"] = (icfg["defaultLang"] == null || icfg["defaultLang"] == "") ? "zh" : icfg["defaultLang"];
      t["_i18nFields"] = icfg["fields"];
      // 只供主表生成期查列定义（不进入 genTables）
      tablesByName[tn] = t;
      continue;
    }
    // moduleDir/pkgName/i18n 标记已补全，回写查找表（对象按值复制，早写会漏掉后补字段）
    tablesByName[tn] = t;
    tablesByModel[mn] = t;
    genTables.append(t);
  }

  // 配置缺陷被跳过的表数量（结束时报错汇总）
  let missingTableCount: Number = 0;

  // ── 6. 对每张表执行一次完整的生成流程 ──────────────────────────────
  for (json in genTables) {
    let tableName: String = json["tableName"];
    let modelName: String = json["modelName"];
    if (modelName == null || modelName.length == 0) {
      modelName = tableName;  // 模型名缺省回退表名
    }

    // ── 6.1 列定义校验（生成期不连库，无列 = 无从生成）────────────
    let columns: Object[] = json["columns"];
    if (columns == null || columns.length == 0) {
      printError("错误：表 '" + tableName + "' 无列定义（columns 为空），已跳过生成");
      missingTableCount = missingTableCount + 1;
      continue;
    }
    printLog("[" + tableName + "] columns count: " + columns.length);

    // ── 6.1b 分层布局：data/ + modules/admin/ 新规范 ─────────────
    //      开发期无旧格式包袱，layout 门禁已移除：所有表统一走新布局，
    //      生成逻辑见 generateLayeredTable。
    let layeredModuleDir: String = json["moduleDir"];
    let layeredPkgName: String = json["pkgName"];
    let layeredCount: Number = generateLayeredTable(json, goBasePath, moduleName,
        commonPath, middlewarePath, layeredModuleDir, layeredPkgName,
        globalEnumDefs, emittedGlobalEnums, tablesByName);
    generatedFileCount = generatedFileCount + layeredCount;
  }  // end for (json in genTables)

  // ── 7. 生成模块路由集中注册 ────────────────────────────────────────
  //      生成器独占 {goBasePath}/router/routes_.go：按 modules/{admin,app}
  //      树扫描 *_router_.go 生成覆盖件并整体重写（幂等），生成模块无需再
  //      手动到 router.go 注册（详见 regenRouteRegistration）
  let regenCount: Number = regenRouteRegistration(goBasePath);

  // ── 8. 汇总 ────────────────────────────────────────────────────────
  if (missingTableCount > 0) {
    printError("警告：共 " + missingTableCount + " 张表因配置缺陷被跳过（详见上方红色错误）");
  }
  printLog("--- 代码生成结束，共生成 " + generatedFileCount + " 个文件 ---");
  return generatedFileCount;
}

// ═══════════════════════════════════════════════════════════════════════════
// 生成模块路由集中注册（routes_.go 独占重写；命名遵循 *_ 尾下划线约定，
// 与模块内 *_handler_.go / *_service_.go / *_router_.go 等生成覆盖件一致）
// ═══════════════════════════════════════════════════════════════════════════

/// @brief 重写 {goBasePath}/router/routes_.go（生成器独占文件，整体重写，幂等）
/// @param goBasePath Go 项目根目录
/// @return 注册的生成模块数量；写入失败/找不到 go.mod 返回 -1
/// 扫描 modules/admin 与 modules/app 下全部 *_router_.go 生成覆盖件：
///   - admin 侧注册到 api 组（<pkg>.RegisterRoutes(api)），包名 = 目录末段；
///   - app 侧注册到 appGroup 组，别名 = "app" + 包名帕斯卡（与 admin 侧包名
///     天然不撞，admin/app 同名包在同一 import 块靠别名区分，如 appShop）；
///   - 手写模块（auth/usermgr/upload/app 等）与 RegisterCustomRoutes 钩子
///     不在本文件，仍由 router/router.go 手动注册。
/// 每次生成按目录树整体重算：新增模块自动进入、删除模块重生成后自动移除，
/// 无需人工维护；import 行按扫描顺序（listFilesDeep 已按路径排序）天然有序。
export function regenRouteRegistration(goBasePath: String): Number {
  let root: String = goBasePath.replace("\\", "/");
  while (root.endsWith("/") && root.length > 1) {
    root = root.substring(0, root.length - 1);
  }

  // Go module 名（go.mod 的 module 行）作为 import 前缀，如 shop_api
  let modName: String = readGoModuleName(root);
  if (modName == "") {
    printError("routes_.go 跳过：go.mod 不存在或缺 module 行: " + root + "/go.mod");
    return -1;
  }

  // 两侧扫描：dir → 相对 goBasePath 的模块根；group → 注册目标路由组参数
  let sides: Object[] = [
    { dir: "modules/admin", group: "api" },
    { dir: "modules/app", group: "appGroup", appSide: true }
  ];
  let imports: String[] = [];
  let calls: String[] = [];
  let usedAlias: Object = {};
  let regCount: Number = 0;
  for (s in sides) {
    let scanDir: String = root + "/" + s["dir"];
    if (!fileExists(scanDir)) {
      continue;
    }
    // listFilesDeep 结果已按路径排序，拼接后 import 块有序，gofmt 稳定
    let files: String[] = listFilesDeep(scanDir, "_router_.go");
    for (f in files) {
      // f 形如 user/user_ext/user_ext_router_.go → rel 取所在目录
      let rel: String = relDirUnder(scanDir + "/" + f, scanDir);
      if (rel == "") {
        continue;
      }
      // 包名 = 目录末段（AutoCode模板规范约定）
      let sep: Number = rel.lastIndexOf("/");
      let pkg: String = sep < 0 ? rel : rel.substring(sep + 1);
      let alias: String = pkg;
      if (s["appSide"] == true) {
        alias = "app" + snakeToPascal(pkg);
      }
      // 同名兜底去重（规范下不会发生，防目录异常导致重复别名编译错误）
      if (usedAlias[alias] == true) {
        let n: Number = 2;
        while (usedAlias[alias + n] == true) {
          n = n + 1;
        }
        alias = alias + n;
      }
      usedAlias[alias] = true;
      imports.append(alias + " \"" + modName + "/" + s["dir"] + "/" + rel + "\"");
      // .ac 字符串不支持 \t 转义，缩进用 tabChar()（param_go.ac 提供）
      calls.append(tabChar() + alias + ".RegisterRoutes(" + s["group"] + ")");
      regCount = regCount + 1;
    }
  }

  // 组装文件：生成头第一行 + 空行 + 包注释紧贴 package（对齐生成件风格）
  let nl: String = "\n";
  let content: String = "// 此代码为AutoCode编译器生成，请勿手动修改" + nl + nl;
  content = content + "// Package router 生成模块集中注册件（AutoCode 独占：每次生成按 modules 树整体重写）" + nl;
  content = content + "// - modules/{admin,app}/**/*_router_.go（生成覆盖件）在此自动注册 RegisterRoutes；" + nl;
  content = content + "// - 手写模块与 RegisterCustomRoutes 钩子仍在 router.go 手动注册。" + nl;
  content = content + "package router" + nl + nl;
  content = content + "import (" + nl;
  // gin 单独一组（对齐 router.go 既有风格：三方库与项目模块之间空行分组）
  content = content + tabChar() + "\"github.com/gin-gonic/gin\"" + nl + nl;
  for (imp in imports) {
    content = content + tabChar() + imp + nl;
  }
  content = content + ")" + nl + nl;
  content = content + "// registerGeneratedRoutes 注册全部 AutoCode 生成模块的路由（router.Setup 调用一次）" + nl;
  content = content + "func registerGeneratedRoutes(api *gin.RouterGroup, appGroup *gin.RouterGroup) {" + nl;
  for (c in calls) {
    content = content + c + nl;
  }
  content = content + "}" + nl;

  let outPath: String = root + "/router/routes_.go";
  if (!writeFile(outPath, content)) {
    return -1;
  }
  printLog("生成模块路由集中注册已重写: " + outPath + "（" + regCount + " 个生成模块）");
  return regCount;
}

/// @brief 从启用 i18n 的主表按惯例派生翻译表定义（0 表）
/// @param mainTable 主表配置（含 i18n 节点：table/extKey/langKey/fields）
/// @return 翻译表配置（tableName/modelName/columns/indexes，frontend=false）
/// @note   派生规则与 C++ deriveI18nTable（json_table_model.cpp）互为镜像，修改需同步：
///         id（自增主键，类型随主表主键）+ extKey（类型随主表主键）+
///         langKey（varchar(8)）+ fields（继承主表同名列的类型/注释，
///         主表无此列时回退 varchar(255)）+ created_at/updated_at（datetime 可空）；
///         唯一索引 uk_{extKey}_{langKey}
export function deriveI18nTable(mainTable: Object): Object {
  let cfg: Object = mainTable["i18n"];
  let transName: String = cfg["table"];
  let extKey: String = cfg["extKey"];
  if (extKey == null || extKey.length == 0) {
    extKey = "ext_id";
  }
  let langKey: String = cfg["langKey"];
  if (langKey == null || langKey.length == 0) {
    langKey = "lang";
  }
  // 主表主键列（extKey 与 0 表 id 的类型基准；找不到回退 int unsigned）
  let pkName: String = "id";
  let pkType: String = "int";
  let pkUnsigned: Bool = true;
  let cols: Object[] = mainTable["columns"];
  if (cols != null) {
    for (c in cols) {
      if (c["isPrimary"] == true) {
        pkName = c["name"];
        pkType = c["mysqlType"];
        pkUnsigned = c["unsigned"] == true;
        break;
      }
    }
  }
  // 列定义（id/extKey/langKey/翻译字段/时间戳）
  let newCols: Object[] = [];
  newCols.append({ name: "id", mysqlType: pkType, unsigned: pkUnsigned, nullable: false,
                   isPrimary: true, isAutoInc: true, comment: "自增主键" });
  newCols.append({ name: extKey, mysqlType: pkType, unsigned: pkUnsigned, nullable: false,
                   isPrimary: false, isAutoInc: false,
                   comment: "扩展ID，关联" + mainTable["tableName"] + "." + pkName });
  newCols.append({ name: langKey, mysqlType: "varchar(8)", unsigned: false, nullable: false,
                   isPrimary: false, isAutoInc: false, comment: "语言编码：zh、en、ja" });
  let fields: String[] = cfg["fields"];
  if (fields != null) {
    for (f in fields) {
      let src: Object = null;
      if (cols != null) {
        for (c in cols) {
          if (c["name"] == f) {
            src = c;
            break;
          }
        }
      }
      if (src != null) {
        let fc: String = src["comment"];
        if (fc == null) {
          fc = f;
        }
        newCols.append({ name: f, mysqlType: src["mysqlType"], unsigned: src["unsigned"] == true,
                         nullable: src["nullable"] == true, isPrimary: false, isAutoInc: false,
                         comment: fc });
      } else {
        newCols.append({ name: f, mysqlType: "varchar(255)", unsigned: false, nullable: false,
                         isPrimary: false, isAutoInc: false, comment: f });
      }
    }
  }
  newCols.append({ name: "created_at", mysqlType: "datetime", unsigned: false, nullable: true,
                   isPrimary: false, isAutoInc: false, comment: "创建时间" });
  newCols.append({ name: "updated_at", mysqlType: "datetime", unsigned: false, nullable: true,
                   isPrimary: false, isAutoInc: false, comment: "更新时间" });
  // 唯一索引：一行一种语言
  let idxs: Object[] = [];
  idxs.append({ name: "uk_" + extKey + "_" + langKey, cols: [extKey, langKey], unique: true });
  // 组装翻译表配置
  let transComment: String = "多语言表";
  let mainComment: String = mainTable["tableComment"];
  if (mainComment != null && mainComment.length > 0) {
    transComment = mainComment + "多语言表";
  }
  let t: Object = {
    tableName: transName,
    modelName: transName,
    tableComment: transComment,
    manualUpdateTime: false,
    frontend: false,
    columns: newCols,
    indexes: idxs,
    // 生成期标记（不落 .jsontable）：翻译表不单独成表生成，
    // 只在主表 data 包内生成一个实体文件（en_{翻译表}_.go）
    _i18nTable: true,
    _i18nEmbedded: true,
    _i18nParent: mainTable["tableName"],
    _i18nExtKey: extKey,
    _i18nLangKey: langKey,
    _i18nDefaultLang: (cfg["defaultLang"] == null || cfg["defaultLang"] == "") ? "zh" : cfg["defaultLang"],
    _i18nFields: cfg["fields"],
  };
  let rel: String = mainTable["_relDir"];
  if (rel != null && rel.length > 0) {
    t["_relDir"] = rel;
  } else {
    // 主表在扫描根目录：翻译表跟主表模块目录同层（如 t → t/t0）
    t["_relDir"] = mainTable["tableName"];
  }
  return t;
}

/// @brief 从 Go 项目根的 go.mod 读取 module 名
/// @param goBasePath Go 项目根目录
/// @return module 名（如 shop_api）；文件不存在/缺 module 行返回空串
export function readGoModuleName(goBasePath: String): String {
  let goModPath: String = goBasePath + "/go.mod";
  if (!fileExists(goModPath)) {
    return "";
  }
  let content: String = readFile(goModPath);
  if (content == null || content.length == 0) {
    return "";
  }
  let lines: String[] = content.split("\n");
  for (line in lines) {
    let t: String = line.trim();
    if (t.startsWith("module ")) {
      // 取 "module " 前缀之后的模块路径（首格后的内容）
      return t.substring(7).trim();
    }
  }
  return "";
}

/// @brief 构建表枚举数据：globalEnumCols 全局枚举列 + 表级 enums 节点
/// @param table .jsontable 表配置
/// @param param 已加工的表参数（列注释回退用）
/// @param globalEnumDefs 全局枚举查找表（name → 定义）
/// @param emitted 本次运行已生成 const 的全局枚举名（同包去重；键 = pkgName/枚举名，
///        跨包各自生成互不影响）
/// @param pkgName 模块包名（modules 模式每模块独立包，Go const 同包禁重复）
/// @return enums 数组，每项 {enumName, columnName, comment, mapKeyType, items}
export function buildTableEnums(table: Object, param: Param, globalEnumDefs: Object, emitted: Object, pkgName: String): Object[] {
  let enums: Object[] = [];

  // ── 1. 全局枚举列：globalEnumCols 命中 .jsonglobalenum ──────────
  //      命中列在 {model}_enum.go 生成 Go const 块 + Map；
  //      同一全局枚举在同一包内只生成一份（Go 同包不允许重复 const 定义）
  let geCols: String[] = table["globalEnumCols"];
  if (geCols != null) {
    for (gcol in geCols) {
      let gDef: Object = globalEnumDefs[gcol];
      if (gDef == null) {
        printError("警告：表 " + table.tableName + " 的 globalEnumCols 引用的全局枚举 '" +
                   gcol + "' 不存在（.jsonglobalenum 未定义），该列不生成枚举");
        continue;
      }
      let geName: String = gDef["enumName"];
      let dedupKey: String = pkgName + "/" + geName;
      if (emitted[dedupKey] == true) {
        printLog("全局枚举 " + geName + " 已在包 " + pkgName + " 生成过 const，跳过重复生成（表 " + table.tableName + "）");
        continue;
      }
      emitted[dedupKey] = true;
      enums.append(buildEnumEntry(geName, gcol, gDef["remark"], gDef["options"]));
    }
  }

  // ── 2. 表级枚举：tables[].enums 节点（配置事实源，生成期不连库）──
  //      格式：{"enums":[{"column":"status","comment":"状态",
  //              "items":[{"key":"enable","label":"启用","value":"1","valueType":"number"}]}]}
  //      枚举名：Enum + 表帕斯卡 + 列帕斯卡（如 shop.status → EnumShopStatus）
  let tableEnums: Object[] = table["enums"];
  if (tableEnums != null) {
    for (te in tableEnums) {
      let colName: String = te["column"];
      if (colName == null || colName.length == 0) {
        printLog("警告：表 " + table.tableName + " 的表级枚举缺少 column，已跳过");
        continue;
      }
      let enumName: String = "Enum" + param.entityClass + snakeToPascal(colName);
      // 枚举说明缺省回退列注释
      let comment: String = te["comment"];
      if (comment == null || comment.length == 0) {
        comment = "";
        for (f in param.fields) {
          if (f.name == colName) { comment = f.comment; }
        }
      }
      enums.append(buildEnumEntry(enumName, colName, comment, te["items"]));
    }
  }
  return enums;
}

/// @brief 把枚举原始选项加工成模板数据项（表级枚举与全局枚举共用）
/// @param enumName 枚举名（Go const 前缀，如 EnumShopStatus）
/// @param columnName 列名（注释定位用）
/// @param comment 枚举说明
/// @param rawItems 原始选项数组 [{key,label,value,valueType}]
/// @return {enumName, columnName, comment, mapKeyType, items:[{key,label,valueStr}]}
///   值字面量：valueType=number → 数字字面量（map 键 int）；其余 → 双引号字符串
export function buildEnumEntry(enumName: String, columnName: String, comment: String, rawItems: Object[]): Object {
  let items: Object[] = [];
  let mapKeyType: String = "string";
  let first: Bool = true;
  if (rawItems != null) {
    for (o in rawItems) {
      // 成员名：key 转帕斯卡，缺省按序号兜底（opt_1 / opt_2 ...）
      let itemKey: String = o["key"];
      if (itemKey == null || itemKey == "") {
        itemKey = "opt_" + (items.length + 1);
      }
      // 实际值（null 兜底为空串，防止拼接出 "null" 字样）
      let rawValue: String = "";
      if (o["value"] != null) {
        rawValue = "" + o["value"];
      }
      // 值字面量：number 类型不带引号，字符串带双引号（Go 转义）
      let valueStr: String = "\"" + escapeGoStr(rawValue) + "\"";
      if (o["valueType"] == "number") {
        valueStr = rawValue;
      }
      // map 键类型按首项取值类别判定
      if (first) {
        if (o["valueType"] == "number" && isNumericStr(rawValue)) {
          mapKeyType = "int";
        }
        first = false;
      }
      items.append({
        key: snakeToPascal(itemKey),
        label: sanitizeGoComment(o["label"]),
        valueStr: valueStr
      });
    }
  }
  return {
    enumName: enumName,
    columnName: columnName,
    comment: sanitizeGoComment(comment),
    mapKeyType: mapKeyType,
    items: items
  };
}

// ═══════════════════════════════════════════════════════════════════════════
// 分层布局（data/ + modules/admin/，生成件以 `_` 结尾）
// ----------------------------------------------------------------------------
// 由 .jsontable 触发的模块级新布局（data/ + modules/admin/），
// 所有 .jsontable 统一走此流程（开发期无旧格式，layout 门禁已移除）。
// 为保证生成结果与手写黄金文件逐字节一致，结构体/常量/map 的列对齐在这里
// 用 padTo 预渲染成行数组，模板只做逐行输出（不依赖外部 gofmt）。
// ═══════════════════════════════════════════════════════════════════════════

/// @brief 右侧补空格到指定宽度（go fmt 的 tabwriter 对齐用）
export function padTo(s: String, w: Number): String {
  let n: Number = w - s.length;
  if (n <= 0) {
    return s;
  }
  return s + " ".repeat(n);
}

/// @brief 实体结构体字段行（gorm tag + json tag + 注释，三列对齐）
/// 声明类型取 enDeclType（C 方案：普通列值类型，可空列指针）
export function buildEnFieldLines(fields: FieldDef[]): String[] {
  let maxName: Number = 0;
  let maxType: Number = 0;
  let maxTag: Number = 0;
  for (f in fields) {
    if (f.goName.length > maxName) { maxName = f.goName.length; }
    if (f.enDeclType.length > maxType) { maxType = f.enDeclType.length; }
    let tl: Number = ("`" + f.gormTag + " " + f.enJsonTag + "`").length;
    if (tl > maxTag) { maxTag = tl; }
  }
  let lines: String[] = [];
  for (f in fields) {
    let tag: String = "`" + f.gormTag + " " + f.enJsonTag + "`";
    lines.append(tabChar() + padTo(f.goName, maxName) + " " + padTo(f.enDeclType, maxType)
      + " " + padTo(tag, maxTag) + " // " + f.comment);
  }
  return lines;
}

/// @brief TakeSnapshot 的可空指针列深拷贝行
/// 值类型列由 `s := *e` 整体浅拷贝覆盖；指针列必须重新分配，
/// 否则业务就地 *e.X = v 修改会同时改到基线，diff 永远为空（漏写）。
export function buildSnapshotCloneLines(fields: FieldDef[]): String[] {
  let lines: String[] = [];
  for (f in fields) {
    if (!f.enIsPtr) { continue; }
    lines.append(tabChar() + "if e." + f.goName + " != nil {");
    lines.append(tabChar() + tabChar() + "v := *e." + f.goName);
    lines.append(tabChar() + tabChar() + "s." + f.goName + " = &v");
    lines.append(tabChar() + "}");
  }
  return lines;
}

/// @brief 生成"不相等"表达式（按 Go 类型分流，避免对不可比较类型用 ==）
/// time.Time 用 Equal()；coin.Coin 用 IsEqual()（内含 decimal，== 会误判）；
/// datatypes.JSON 是 []byte，转 string 再比；其余基础类型直接用 !=
/// @param lhs / rhs 表达式，如 "e.X"、"(*e.X)"、"*o.X"
export function notEqualExpr(f: FieldDef, lhs: String, rhs: String): String {
  if (f.goType == "time.Time") {
    return "!" + lhs + ".Equal(" + rhs + ")";
  }
  if (f.goType == "coin.Coin") {
    return "!" + lhs + ".IsEqual(" + rhs + ")";
  }
  if (f.goType == "datatypes.JSON") {
    return "string(" + lhs + ") != string(" + rhs + ")";
  }
  return lhs + " != " + rhs;
}

/// @brief changedColumns 的比较行（覆盖除主键外全部列，不做"可更新列"白名单）
/// 比较按字段类型分流：time.Time 用 Equal()、coin.Coin 用 IsEqual()（不能 ==）；
/// 可空指针列 nil 与 nil 相等，一方 nil 不等，都非 nil 再按类型比。
export function buildChangedLines(fields: FieldDef[], idName: String): String[] {
  let lines: String[] = [];
  for (f in fields) {
    if (f.goName == idName || f.isPrimary) { continue; }
    let lhs: String = "e." + f.goName;
    let rhs: String = "o." + f.goName;
    let col: String = "Col" + f.goName;
    if (f.enIsPtr) {
      // 可空列：nil 变为 nil 视为未改；变为 nil 时 map 里放 nil（GORM 写 SET col = NULL）
      lines.append(tabChar() + "if " + lhs + " == nil {");
      lines.append(tabChar() + tabChar() + "if " + rhs + " != nil {");
      lines.append(tabChar() + tabChar() + tabChar() + "m[" + col + "] = nil");
      lines.append(tabChar() + tabChar() + "}");
      lines.append(tabChar() + "} else if " + rhs + " == nil {");
      lines.append(tabChar() + tabChar() + "m[" + col + "] = *" + lhs);
      lines.append(tabChar() + "} else if " + notEqualExpr(f, "(*" + lhs + ")", "*" + rhs) + " {");
      lines.append(tabChar() + tabChar() + "m[" + col + "] = *" + lhs);
      lines.append(tabChar() + "}");
    } else {
      lines.append(tabChar() + "if " + notEqualExpr(f, lhs, rhs) + " {");
      lines.append(tabChar() + tabChar() + "m[" + col + "] = " + lhs);
      lines.append(tabChar() + "}");
    }
  }
  return lines;
}

/// @brief InUpd.ToEntity / ApplyTo 的行：只覆盖入参非 nil 的字段（nil = 本次不改）
/// 可空指针列：实体字段是 *T，必须新分配并拷贝值（不能共享入参指针，也不能用
///   cdb.CopyNonNil(&e.X, in.X)，那会要求入参是 **T）；
/// JSON 列：入参本身是值类型（无"未传"语义），直接赋值；
/// 其余值类型列：cdb.CopyNonNil(&e.X, in.X)。
export function buildApplyLines(fields: FieldDef[]): String[] {
  let lines: String[] = [];
  for (f in fields) {
    if (f.enIsPtr) {
      lines.append(tabChar() + "if in." + f.goName + " != nil {");
      lines.append(tabChar() + tabChar() + "v := *in." + f.goName);
      lines.append(tabChar() + tabChar() + "e." + f.goName + " = &v");
      lines.append(tabChar() + "}");
    } else if (f.ptrType == f.goType) {
      lines.append(tabChar() + "e." + f.goName + " = in." + f.goName);
    } else {
      lines.append(tabChar() + "cdb.CopyNonNil(&e." + f.goName + ", in." + f.goName + ")");
    }
  }
  return lines;
}

/// @brief InSel 结构体字段行（嵌入 BasePage + 全指针筛选 + Sort，三列对齐）
export function buildSelFieldLines(selFields: SelFieldDef[]): String[] {
  let baseName: String = "httpx.BasePage";
  let maxName: Number = baseName.length;
  let maxType: Number = 0;
  let maxTag: Number = 0;
  for (sf in selFields) {
    if (sf.goName.length > maxName) { maxName = sf.goName.length; }
    if (sf.declType.length > maxType) { maxType = sf.declType.length; }
    let tl: Number = ("`json:\"" + sf.name + "\"`").length;
    if (tl > maxTag) { maxTag = tl; }
  }
  // Sort 行参与宽度计算
  let sortTag: String = "`json:\"sort\"`";
  if ("Sort".length > maxName) { maxName = "Sort".length; }
  if ("[]string".length > maxType) { maxType = "[]string".length; }
  if (sortTag.length > maxTag) { maxTag = sortTag.length; }

  let lines: String[] = [];
  // 嵌入字段：gofmt 仍保留 type 列宽度，注释落在 type 列之后
  lines.append(tabChar() + padTo(baseName, maxName) + " " + padTo("", maxType) + " // 分页参数");
  for (sf in selFields) {
    let tag: String = "`json:\"" + sf.name + "\"`";
    lines.append(tabChar() + padTo(sf.goName, maxName) + " " + padTo(sf.declType, maxType)
      + " " + padTo(tag, maxTag) + " // " + sf.comment);
  }
  lines.append(tabChar() + padTo("Sort", maxName) + " " + padTo("[]string", maxType)
    + " " + padTo(sortTag, maxTag) + " // 排序字段名（方向由后端白名单写死）");
  return lines;
}

/// @brief InUpd 结构体字段行（Id 值类型 + 其余全指针，三列对齐）
export function buildUpdFieldLines(fields: FieldDef[], idName: String, idType: String): String[] {
  let idTag: String = "`json:\"id\"`";
  let maxName: Number = idName.length;
  let maxType: Number = idType.length;
  let maxTag: Number = idTag.length;
  for (f in fields) {
    if (f.goName.length > maxName) { maxName = f.goName.length; }
    if (f.ptrType.length > maxType) { maxType = f.ptrType.length; }
    let tl: Number = ("`" + f.jsonTag + "`").length;
    if (tl > maxTag) { maxTag = tl; }
  }
  let lines: String[] = [];
  lines.append(tabChar() + padTo(idName, maxName) + " " + padTo(idType, maxType)
    + " " + padTo(idTag, maxTag) + " // 主键：0=新增，>0=更新");
  for (f in fields) {
    let tag: String = "`" + f.jsonTag + "`";
    lines.append(tabChar() + padTo(f.goName, maxName) + " " + padTo(f.ptrType, maxType)
      + " " + padTo(tag, maxTag) + " // " + f.comment);
  }
  return lines;
}

/// @brief Col 常量块行（名称列对齐）
export function buildColLines(fields: FieldDef[]): String[] {
  let maxName: Number = 0;
  for (f in fields) {
    let n: String = "Col" + f.goName;
    if (n.length > maxName) { maxName = n.length; }
  }
  let lines: String[] = [];
  for (f in fields) {
    let n: String = "Col" + f.goName;
    lines.append(tabChar() + padTo(n, maxName) + " = \"" + f.name + "\"");
  }
  return lines;
}

/// @brief 取联表条目的输出列数组（Any → Object[]，供 for-in 类型检查）
export function joinColsOf(je: Object): Object[] {
  return je["cols"];
}

/// @brief 分层布局联表数据构建（.jsontable 表节点新键 joinTables）
/// ----------------------------------------------------------------------------
/// 配置形态（数组；未配置 = 无联表，生成物与单表版完全一致）：
///   "joinTables": [
///     { "table": "user_ext",           // 被联表名（∈ 本项目已扫描 .jsontable）
///       "type": "LEFT",                // LEFT / INNER，缺省 LEFT
///       "on": ["id", "user_id"],       // [主表列, 联表列]，表名由规格自带不重复写
///       "cols": [ { "col": "account" } ] } ]  // 联表输出列（∈ 联表列；只管列表输出）
/// 查询能力与主表列同源：查询视图 selColsEq/selColsLike 里引用输出别名
/// （如 "user_ext_account"）即生成对应筛选字段；cols[].filter 为旧写法仍兼容
/// 派生规则（与 shop_api 手写黄金样板逐字对齐）：
///   - 常量：col<表><列> = 真实列名；view<表><列> = 输出别名（统一 = 表名_列名）
///   - EnXxxView：匿名嵌入主表实体 + 联表列平铺（值类型，gorm/json tag = 输出别名）
///   - querySpec：Table + Joins + Order（排序白名单 = selColsSort）
///   - 入参字段：查询视图（selColsEq/Like）命中的输出别名 → InSelXxx 指针字段
///   - 条件行：querySpec.Where*（裸列名/输出别名由 QuerySpec.qualify 解析表限定）
/// @return { hasJoin, joinEntries, viewFields, joinConstLines, enViewFieldLines,
///           joinSpecBlock, joinSelFields, joinWhereLines }
export function buildLayeredJoinData(json: Object, param: Param, tablesByName: Object,
    sortCols: String[], sortDirs: String[]): Object {
  let result: Object = {
    hasJoin: false, joinEntries: [], viewFields: [], joinConstLines: [],
    enViewFieldLines: [], joinSpecBlock: "", joinSelFields: [], joinWhereLines: [],
    aliasMap: {}
  };
  let joinCfgs: Object[] = json["joinTables"];
  if (joinCfgs == null) {
    joinCfgs = [];
  }
  let joinEntries: Object[] = [];
  let usedAliasGo: Object = {};  // 输出字段 Go 名去重（同结构体字段/SQL 别名禁重复）
  for (jc in joinCfgs) {
    let tbl: String = jc["table"];
    if (tbl == null || tbl == "") {
      printError("错误：表 '" + param.tableName + "' 联表缺少 table，该条目已跳过");
      continue;
    }
    if (tbl == param.tableName) {
      printError("错误：表 '" + param.tableName + "' 联表目标不能是本表，该条目已跳过");
      continue;
    }
    let target: Object = tablesByName[tbl];
    if (target == null) {
      printError("错误：表 '" + param.tableName + "' 联表目标 '" + tbl +
                 "' 不在本项目已扫描的 .jsontable 中，该条目已跳过");
      continue;
    }
    let joinType: String = jc["type"];
    if (joinType == null || joinType == "") { joinType = "LEFT"; }
    if (joinType != "LEFT" && joinType != "INNER") {
      printError("错误：表 '" + param.tableName + "' 联表 '" + tbl + "' 的 type '" + joinType +
                 "' 仅支持 LEFT/INNER，该条目已跳过");
      continue;
    }
    let onArr: Object = jc["on"];
    if (onArr == null || onArr.length != 2) {
      printError("错误：表 '" + param.tableName + "' 联表 '" + tbl +
                 "' 的 on 须为 [主表列, 联表列]，该条目已跳过");
      continue;
    }
    let on0: String = onArr[0];
    let on1: String = onArr[1];
    let on0Field: FieldDef = null;
    for (f in param.fields) {
      if (f.name == on0) { on0Field = f; }
    }
    if (on0Field == null) {
      printError("错误：表 '" + param.tableName + "' 联表 '" + tbl + "' 的 on[0]('" +
                 (on0 == null ? "" : on0) + "') 不在主表列中，该条目已跳过");
      continue;
    }
    let tcols: Object[] = target["columns"];
    let on1Col: Object = null;
    if (tcols != null) {
      for (c in tcols) {
        if (c["name"] == on1) { on1Col = c; }
      }
    }
    if (on1Col == null) {
      printError("错误：表 '" + param.tableName + "' 联表 '" + tbl + "' 的 on[1]('" +
                 (on1 == null ? "" : on1) + "') 不在联表列中，该条目已跳过");
      continue;
    }
    // 输出列加工（filter 生效值：""=只输出 / like / eq；like 仅字符串列）
    let colEntries: Object[] = [];
    let colSeen: Object = {};
    let cfgCols: Object[] = jc["cols"];
    if (cfgCols != null) {
      for (cc in cfgCols) {
        let colName: String = cc["col"];
        if (colName == null || colName == "") {
          printError("错误：表 '" + param.tableName + "' 联表 '" + tbl +
                     "' 存在缺少 col 的输出列，已跳过该列");
          continue;
        }
        if (colSeen[colName] != null) { continue; }
        colSeen[colName] = true;
        let tcol: Object = null;
        for (c in tcols) {
          if (c["name"] == colName) { tcol = c; }
        }
        if (tcol == null) {
          printError("错误：表 '" + param.tableName + "' 联表 '" + tbl + "' 的输出列 '" +
                     colName + "' 不在联表列中，已跳过该列");
          continue;
        }
        let goType: String = mapTypeToGo(tcol["mysqlType"], tcol["unsigned"] == true);
        if (goType == "datatypes.JSON") {
          printLog("提示：联表 '" + tbl + "' 输出列 '" + colName +
                   "' 为 JSON 类型，不支持联表输出，已跳过该列");
          continue;
        }
        let filter: String = cc["filter"];
        if (filter == null) { filter = ""; }
        if (filter != "" && filter != "like" && filter != "eq") {
          printLog("提示：联表 '" + tbl + "' 输出列 '" + colName + "' 的 filter '" + filter +
                   "' 仅支持 like/eq，已按只输出处理");
          filter = "";
        }
        if (filter == "like" && goType != "string") {
          printLog("提示：联表输出列 '" + tbl + "." + colName + "' 非字符串，filter=like 已按 eq 生成");
          filter = "eq";
        }
        let alias: String = tbl + "_" + colName;
        let aliasGo: String = snakeToPascal(alias);
        let clash: Bool = false;
        for (f in param.fields) {
          if (f.goName == aliasGo) { clash = true; }
        }
        if (usedAliasGo[aliasGo] != null) { clash = true; }
        if (clash) {
          printError("错误：表 '" + param.tableName + "' 联表输出字段 '" + aliasGo +
                     "' 与主表列名/已有联表字段冲突，已跳过该列");
          continue;
        }
        usedAliasGo[aliasGo] = true;
        colEntries.append({
          col: colName,
          comment: sanitizeGoComment(tcol["comment"]),
          goType: goType,
          filter: filter,
          alias: alias,
          aliasGo: aliasGo,
          colConst: "col" + snakeToPascal(tbl) + snakeToPascal(colName),
          viewConst: "view" + aliasGo
        });
      }
    }
    joinEntries.append({
      table: tbl,
      joinType: joinType,
      on0: on0,
      on1: on1,
      on0Const: "Col" + on0Field.goName,
      on1Const: "col" + snakeToPascal(tbl) + snakeToPascal(on1),
      cols: colEntries
    });
  }
  // ── 联表列名常量（colXxx 真实列名 + viewXxx 输出别名；去重，ON/输出同列只一条）
  let constDefs: Object[] = [];
  for (je in joinEntries) {
    let onExists: Bool = false;
    for (cd in constDefs) {
      if (cd["name"] == je["on1Const"]) { onExists = true; }
    }
    if (!onExists) {
      constDefs.append({ name: je["on1Const"], value: je["on1"],
        comment: je["table"] + "." + je["on1"] + "（ON 条件用）" });
    }
    for (ce in joinColsOf(je)) {
      let isOn: Bool = (ce["col"] == je["on1"]);
      let cmt: String = je["table"] + "." + ce["col"] + (isOn ? "（ON 条件用）" : "（真实列名）");
      let colExists: Bool = false;
      for (cd in constDefs) {
        if (cd["name"] == ce["colConst"]) { colExists = true; }
      }
      if (!colExists) {
        constDefs.append({ name: ce["colConst"], value: ce["col"], comment: cmt });
      }
    }
  }
  for (je in joinEntries) {
    for (ce in joinColsOf(je)) {
      let viewExists: Bool = false;
      for (cd in constDefs) {
        if (cd["name"] == ce["viewConst"]) { viewExists = true; }
      }
      if (!viewExists) {
        constDefs.append({ name: ce["viewConst"], value: ce["alias"],
          comment: "输出别名 = 前端统一字段名（输出/入参/排序同名）" });
      }
    }
  }
  let tb: String = tabChar();
  let maxName: Number = 0;
  let maxValue: Number = 0;
  for (cd in constDefs) {
    if (cd["name"].length > maxName) { maxName = cd["name"].length; }
    let vl: Number = ("\"" + cd["value"] + "\"").length;
    if (vl > maxValue) { maxValue = vl; }
  }
  let joinConstLines: String[] = [];
  for (cd in constDefs) {
    let v: String = "\"" + cd["value"] + "\"";
    joinConstLines.append(tb + padTo(cd["name"], maxName) + " = " + padTo(v, maxValue)
      + " // " + cd["comment"]);
  }

  // ── EnXxxView 字段行（嵌入行 + 联表列平铺，gorm/json tag = 输出别名）──
  let viewFields: Object[] = [];
  for (je in joinEntries) {
    for (ce in joinColsOf(je)) {
      viewFields.append({ goName: ce["aliasGo"], goType: ce["goType"], alias: ce["alias"],
        comment: ce["comment"] + "（" + je["table"] + "." + ce["col"] + "）" });
    }
  }
  let maxVn: Number = 0;
  let maxVt: Number = 0;
  let maxVtag: Number = 0;
  for (vf in viewFields) {
    if (vf["goName"].length > maxVn) { maxVn = vf["goName"].length; }
    if (vf["goType"].length > maxVt) { maxVt = vf["goType"].length; }
    let tl: Number = ("`gorm:\"column:" + vf["alias"] + "\" json:\"" + vf["alias"] + "\"`").length;
    if (tl > maxVtag) { maxVtag = tl; }
  }
  let enViewFieldLines: String[] = [];
  enViewFieldLines.append(tb + param.enClass);
  for (vf in viewFields) {
    let tag: String = "`gorm:\"column:" + vf["alias"] + "\" json:\"" + vf["alias"] + "\"`";
    enViewFieldLines.append(tb + padTo(vf["goName"], maxVn) + " " + padTo(vf["goType"], maxVt)
      + " " + padTo(tag, maxVtag) + " // " + vf["comment"]);
  }

  // ── 查询字段来源（优先级：查询视图 selColsEq/Like 的输出别名 > cols[].filter 旧写法）──
  // aliasMap：输出别名 → true（generateLayeredTable 据此把别名 ref 从主查询字段剥离）
  let aliasMap: Object = {};
  for (je in joinEntries) {
    for (ce in joinColsOf(je)) {
      aliasMap[ce["alias"]] = true;
    }
  }
  // filterOf：输出别名 → like/eq（cols[].filter 先落底，查询视图按 eq 优先合并）
  let filterOf: Object = {};
  for (je in joinEntries) {
    for (ce in joinColsOf(je)) {
      if (ce["filter"] != "") { filterOf[ce["alias"]] = ce["filter"]; }
    }
  }
  let eqCfgs: Object[] = json["selColsEq"];
  if (eqCfgs != null) {
    for (qc in eqCfgs) {
      let ref: String = qc["ref"];
      if (ref != null && ref != "" && aliasMap[ref] != null) { filterOf[ref] = "eq"; }
    }
  }
  let likeCfgs: Object[] = json["selColsLike"];
  if (likeCfgs != null) {
    for (qc in likeCfgs) {
      let ref: String = qc["ref"];
      if (ref != null && ref != "" && aliasMap[ref] != null && filterOf[ref] == null) {
        filterOf[ref] = "like";
      }
    }
  }
  let gapCfgs: Object[] = json["selColsGap"];
  if (gapCfgs != null) {
    for (qc in gapCfgs) {
      let ref: String = qc["ref"];
      if (ref != null && ref != "" && aliasMap[ref] != null) {
        printLog("提示：联表输出列 '" + ref + "' 暂不支持范围查询，已跳过");
      }
    }
  }

  // ── 入参字段（查询视图/cols[].filter 命中的输出列 → InSel 指针字段，json = 输出别名）──
  let joinSelFields: SelFieldDef[] = [];
  let joinWhereLines: String[] = [];
  for (je in joinEntries) {
    for (ce in joinColsOf(je)) {
      let flt: String = filterOf[ce["alias"]];
      if (flt == null || flt == "") { continue; }
      let sf: SelFieldDef = new SelFieldDef();
      sf.name = ce["alias"];
      sf.baseName = ce["alias"];
      sf.comment = ce["comment"] + (flt == "like" ? "（模糊，联表 " : "（联表 ")
        + je["table"] + "）";
      sf.goType = ce["goType"];
      sf.goName = ce["aliasGo"];
      sf.kind = zeroKindOfGoType(ce["goType"]);
      sf.declType = "*" + ce["goType"];
      sf.isLike = (flt == "like");
      joinSelFields.append(sf);
      let val: String = "sel." + ce["aliasGo"];
      if (ce["goType"] != "time.Time") { val = "*" + val; }
      let fn: String = flt == "like" ? "querySpec.WhereLike" : "querySpec.WhereEq";
      joinWhereLines.append(tb + "if sel." + ce["aliasGo"] + " != nil {\n"
        + tb + tb + "db = " + fn + "(db, " + ce["viewConst"] + ", " + val + ")\n"
        + tb + "}");
    }
  }

  // ── querySpec 块（Table + Joins + Order；键对齐与 gofmt 一致）────────
  //      Order 的键用生成好的列常量（ColXxx / viewXxx），列名拼错编译期就报错；
  //      解析顺序与 QuerySpec.qualify 一致：联表输出列优先，其次主表列。
  let mainConstByRef: Object = {};
  for (f in param.fields) {
    mainConstByRef[f.name] = "Col" + f.goName;
  }
  let joinConstByRef: Object = {};
  for (je in joinEntries) {
    for (ce in joinColsOf(je)) {
      // 联表排序只认输出别名（前端统一字段名）；裸列名不作为 Order 键
      if (joinConstByRef[ce["alias"]] == null) {
        joinConstByRef[ce["alias"]] = ce["viewConst"];
      }
    }
  }
  let orderKeyExprs: String[] = [];
  let orderDirs: String[] = [];
  for (let i = 0; i < sortCols.length; i = i + 1) {
    let ref: String = sortCols[i];
    let keyExpr: String = joinConstByRef[ref];
    if (keyExpr == null) {
      keyExpr = mainConstByRef[ref];
    }
    if (keyExpr == null) {
      printError("错误：表 '" + param.tableName + "' 的 selColsSort 字段 '" + ref +
                 "' 不是主表列或联表输出别名，已跳过该排序项");
      continue;
    }
    orderKeyExprs.append(keyExpr);
    orderDirs.append(sortDirs[i]);
  }
  let orderEntryLines: String[] = [];
  let maxKey: Number = 0;
  for (let i = 0; i < orderKeyExprs.length; i = i + 1) {
    let k: String = orderKeyExprs[i] + ":";
    if (k.length > maxKey) { maxKey = k.length; }
  }
  for (let i = 0; i < orderKeyExprs.length; i = i + 1) {
    let k: String = orderKeyExprs[i] + ":";
    orderEntryLines.append(tb + tb + padTo(k, maxKey) + " \"" + orderDirs[i] + "\",");
  }
  let spec: String = "// querySpec 列表查询规格（" + param.tableName
    + ".jsontable 生成）：主表 + 排序白名单（有联表时附带 JOIN）\n";
  for (je in joinEntries) {
    let colList: String = "";
    for (ce in joinColsOf(je)) {
      colList = colList + (colList == "" ? "" : "、") + ce["col"];
    }
    if (colList == "") { colList = "无输出列"; }
    spec = spec + "// 联表 " + je["table"] + "：输出 " + colList + "；"
      + je["joinType"] + " JOIN 保证 " + je["table"] + " 无行时主表仍返回\n";
  }
  spec = spec + "var querySpec = cdb.QuerySpec{\n";
  spec = spec + tb + "Table: \"" + param.tableName + "\",\n";
  if (joinEntries.length > 0) {
    spec = spec + tb + "Joins: []cdb.Join{\n";
    for (je in joinEntries) {
      // Join 类型常量名：JoinLeft / JoinInner（配置大写 → Go 常量驼峰）
      let joinConst: String = je["joinType"] == "LEFT" ? "cdb.JoinLeft" : "cdb.JoinInner";
      let colsInline: String = "";
      for (ce in joinColsOf(je)) {
        colsInline = colsInline + (colsInline == "" ? "" : ", ")
          + "{Col: " + ce["colConst"] + ", Alias: " + ce["viewConst"] + "}";
      }
      spec = spec + tb + tb + "{\n";
      spec = spec + tb + tb + tb + "Table: \"" + je["table"] + "\",\n";
      spec = spec + tb + tb + tb + "Type:  " + joinConst + ",\n";
      spec = spec + tb + tb + tb + "On:    [2]string{" + je["on0Const"] + ", " + je["on1Const"] + "},\n";
      spec = spec + tb + tb + tb + "Cols:  []cdb.OutCol{" + colsInline + "},\n";
      spec = spec + tb + tb + "},\n";
    }
    spec = spec + tb + "},\n";
  }
  if (orderEntryLines.length == 0) {
    spec = spec + tb + "Order: map[string]string{},\n";
  } else {
    spec = spec + tb + "Order: map[string]string{\n";
    for (ol in orderEntryLines) {
      spec = spec + ol + "\n";
    }
    spec = spec + tb + "},\n";
  }
  spec = spec + "}";

  result["hasJoin"] = (joinEntries.length > 0);
  result["joinEntries"] = joinEntries;
  result["viewFields"] = viewFields;
  result["joinConstLines"] = joinConstLines;
  result["enViewFieldLines"] = enViewFieldLines;
  result["joinSpecBlock"] = spec;
  result["joinSelFields"] = joinSelFields;
  result["joinWhereLines"] = joinWhereLines;
  result["aliasMap"] = aliasMap;
  return result;
}

/// @brief 复制表配置并剥离查询视图里的联表输出别名 ref
/// （别名由 buildLayeredJoinData 的 joinSelFields 承接，避免主查询字段
///   生成端把它当本表列解析而报"不存在"警告）
export function stripJoinQueryRefs(json: Object, aliasMap: Object): Object {
  if (aliasMap == null) { aliasMap = {}; }
  let copy: Object = {};
  for (k in json) {
    copy[k] = json[k];
  }
  copy["selColsEq"] = filterJoinRefs(json["selColsEq"], aliasMap);
  copy["selColsLike"] = filterJoinRefs(json["selColsLike"], aliasMap);
  copy["selColsGap"] = filterJoinRefs(json["selColsGap"], aliasMap);
  return copy;
}

/// @brief 过滤查询列数组：剔除 ref 为联表输出别名的条目
export function filterJoinRefs(arr: Object, aliasMap: Object): Object[] {
  let out: Object[] = [];
  if (arr != null) {
    for (qc in arr) {
      let ref: String = qc["ref"];
      if (ref != null && aliasMap[ref] != null) { continue; }
      out.append(qc);
    }
  }
  return out;
}

/// @brief 生成一张分层布局的表（data/ + modules/admin/）
/// @return 实际写入文件数
export function generateLayeredTable(json: Object, goBasePath: String, moduleName: String,
    commonPath: String, middlewarePath: String, moduleDir: String, pkgName: String,
    globalEnumDefs: Object, emitted: Object, tablesByName: Object): Number {
  let tplDir: String = "../../crud_gin/template";
  let dbPath: String = commonPath + "/db";
  let coinPath: String = commonPath + "/coin";
  let httpxPath: String = commonPath + "/httpx";
  let redisxPath: String = commonPath + "/redisx";
  let tableName: String = json["tableName"];
  let param: Param = new Param();
  param.setTableData(json);
  if (param.primaryField == null) {
    printError("错误：表 '" + tableName + "' 未声明主键列（isPrimary），已跳过生成");
    return 0;
  }

  let dataDir: String = moduleDir;
  let dataPath: String = moduleName + "/data/" + dataDir;
  let dataAlias: String = "d" + pkgName;
  let idType: String = param.primaryField.goType;
  let idName: String = param.primaryField.goName;
  let idCol: String = param.primaryField.name;

  // ── i18n 多语言：主表 + 翻译表（如 shop + shop0）────────────────────
  //    翻译表依附主表：只在主表 data 包内生成 en_{翻译表}_.go（实体 + 列常量），
  //    翻译读写方法挂在主表 Repo 上；主表查询按 lang 平铺当前语言文本、
  //    缺失回退 defaultLang；详情附全语言 map；保存事务内 upsert 翻译行。
  let hasI18n: Bool = false;
  let i18nTable: String = "";
  let i18nDefaultLang: String = "zh";
  let i18nExtKey: String = "ext_id";
  let i18nLangKey: String = "lang";
  let i18nFlatFields: Object[] = [];
  let i18nTypeName: String = param.tableClass + "I18n";
  let i18nCfg: Object = json["i18n"];
  if (i18nCfg != null && i18nCfg["table"] != null && i18nCfg["table"].length > 0) {
    i18nTable = i18nCfg["table"];
    i18nDefaultLang = (i18nCfg["defaultLang"] == null || i18nCfg["defaultLang"] == "") ? "zh" : i18nCfg["defaultLang"];
    i18nExtKey = (i18nCfg["extKey"] == null || i18nCfg["extKey"] == "") ? "ext_id" : i18nCfg["extKey"];
    i18nLangKey = (i18nCfg["langKey"] == null || i18nCfg["langKey"] == "") ? "lang" : i18nCfg["langKey"];
    let i18nTcfg: Object = tablesByName[i18nTable];
    if (i18nTcfg == null) {
      printError("错误：i18n 翻译表 '" + i18nTable + "' 不存在（主表 " + tableName + " 的 i18n 已跳过）");
    } else if (!param.hasAutoIncPk) {
      printError("错误：i18n 只支持自增主键表（主表 " + tableName + " 无自增主键，i18n 已跳过）");
    } else {
      let i18nTCols: Object[] = i18nTcfg["columns"];
      let i18nValid: Bool = true;
      // extKey / langKey 必须存在于翻译表
      let extOk: Bool = false;
      let langOk: Bool = false;
      for (c in i18nTCols) {
        if (c["name"] == i18nExtKey) { extOk = true; }
        if (c["name"] == i18nLangKey) { langOk = true; }
      }
      if (!extOk || !langOk) {
        printError("错误：i18n 的 extKey('" + i18nExtKey + "') 或 langKey('" + i18nLangKey +
                   "') 在翻译表 " + i18nTable + " 中不存在，i18n 已跳过");
        i18nValid = false;
      }
      let i18nFields: String[] = i18nCfg["fields"];
      if (i18nFields == null || i18nFields.length == 0) {
        printError("错误：i18n.fields 为空（主表 " + tableName + " 的 i18n 已跳过）");
        i18nValid = false;
      } else if (i18nValid) {
        for (fn in i18nFields) {
          let tc: Object = null;
          for (c in i18nTCols) {
            if (c["name"] == fn) { tc = c; break; }
          }
          if (tc == null) {
            printError("错误：i18n.fields 中的列 '" + fn + "' 在翻译表 " + i18nTable + " 中不存在，i18n 已跳过");
            i18nValid = false;
            break;
          }
          // 与主表列重名时平铺会覆盖主表数据 → 报错跳过
          for (mf in param.fields) {
            if (mf.name == fn) {
              printError("错误：i18n.fields 中的列 '" + fn + "' 与主表 " + tableName + " 的列重名，i18n 已跳过");
              i18nValid = false;
              break;
            }
          }
          if (!i18nValid) { break; }
          let iff: Object = {};
          iff["name"] = fn;
          iff["goName"] = snakeToPascal(fn);
          iff["goType"] = mapTypeToGo(tc["mysqlType"], tc["unsigned"] == true);
          let fcomment: String = tc["comment"];
          if (fcomment == null || fcomment == "") { fcomment = fn; }
          iff["comment"] = fcomment;
          i18nFlatFields.append(iff);
        }
      }
      if (i18nValid) { hasI18n = true; }
    }
  }

  // 翻译实体（主表 data 包内生成，不单独成包）
  let i18nEnClass: String = "";
  let i18nTableComment: String = "";
  let i18nExtGoName: String = "";
  let i18nLangGoName: String = "";
  let i18nExtGoType: String = idType;
  let i18nEntityFieldLines: String[] = [];
  let i18nColLines: String[] = [];
  let i18nEntityNeedTime: Bool = false;
  let i18nUpdateCols: String = "";
  let i18nColPrefix: String = "";
  if (hasI18n) {
    let tcfg: Object = tablesByName[i18nTable];
    let tparam: Param = new Param();
    tparam.setTableData(tcfg);
    i18nEnClass = tparam.enClass;
    i18nColPrefix = "Col" + snakeToPascal(i18nTable);
    i18nTableComment = tcfg["tableComment"];
    if (i18nTableComment == null || i18nTableComment == "") { i18nTableComment = "多语言表"; }
    i18nExtGoName = snakeToPascal(i18nExtKey);
    i18nLangGoName = snakeToPascal(i18nLangKey);
    i18nEntityFieldLines = buildEnFieldLines(tparam.fields);
    // 列常量加翻译表前缀（ColShop0Id），避免与主表 ColId 等同名冲突
    let colMax: Number = 0;
    for (tf in tparam.fields) {
      let cn: String = i18nColPrefix + tf.goName;
      if (cn.length > colMax) { colMax = cn.length; }
    }
    for (tf in tparam.fields) {
      let cn: String = i18nColPrefix + tf.goName;
      i18nColLines.append(tabChar() + padTo(cn, colMax) + " = \"" + tf.name + "\"");
      if (tf.goType == "time.Time") { i18nEntityNeedTime = true; }
      if (tf.name == i18nExtKey) { i18nExtGoType = tf.goType; }
    }
    // upsert 命中冲突时更新翻译字段 + updated_at
    for (iff in i18nFlatFields) {
      if (i18nUpdateCols != "") { i18nUpdateCols = i18nUpdateCols + ", "; }
      i18nUpdateCols = i18nUpdateCols + i18nColPrefix + iff["goName"];
    }
    for (tf in tparam.fields) {
      if (tf.name == "updated_at") {
        if (i18nUpdateCols != "") { i18nUpdateCols = i18nUpdateCols + ", "; }
        i18nUpdateCols = i18nUpdateCols + i18nColPrefix + "UpdatedAt";
        break;
      }
    }
  }

  // ── 排序白名单：selColsSort 顺序（所有表统一进 querySpec.Order）────
  let sortCols: String[] = [];
  let sortDirs: String[] = [];
  let sortPairs: Object[] = json["selColsSort"];
  if (sortPairs != null) {
    for (pair in sortPairs) {
      let ref: String = pair[0];
      if (ref == null || ref == "" || ref.indexOf(".") > 0) { continue; }
      let dir: String = pair[1];
      if (dir == null || dir == "") { dir = "DESC"; }
      sortCols.append(ref);
      sortDirs.append(dir);
    }
  }

  // ── 联表（joinTables 新格式）：视图/常量/querySpec/入参字段/条件行 ──
  //      所有表统一走 querySpec 流水线（无联表时 Joins 为空），排序白名单
  //      一律进 querySpec.Order；SelectByIn 返回 EnXxxView（有联表）或 EnXxx。
  let jd: Object = buildLayeredJoinData(json, param, tablesByName, sortCols, sortDirs);
  let hasJoin: Bool = jd["hasJoin"];

  // ── 查询场景：过滤字段全指针 + 条件行（联表模式条件走 querySpec.Where*，
  //      主表裸列名由 QuerySpec 自动限定）────────────────────────────
  let qd: QueryData = new QueryData();
  qd.pointerMode = true;
  let aliasMap: Object = jd["aliasMap"];
  let mainSelFields: SelFieldDef[] = qd.buildSelFields(stripJoinQueryRefs(json, aliasMap), param, [], false);
  let selFields: SelFieldDef[] = mainSelFields;
  let joinSelFields: SelFieldDef[] = jd["joinSelFields"];
  for (jsf in joinSelFields) {
    selFields.append(jsf);
  }
  let whereConds: String[] = [];
  // 条件统一走 querySpec.Where*：裸列名由 QuerySpec.qualify 自动限定表名
  let rawConds: String[] = qd.buildWhereConditionsPointer(mainSelFields);
  for (c in rawConds) {
    whereConds.append(c.replace("cdb.Where", "querySpec.Where"));
  }
  let joinWhere: String[] = jd["joinWhereLines"];
  for (c in joinWhere) {
    whereConds.append(c);
  }

  // ── i18n 生成数据（实体虚拟字段 / InUpd map / repo 填充 / 出参）──────
  let i18nEntityFields: FieldDef[] = [];
  let i18nOutFields: FieldDef[] = [];
  let i18nTypeLines: String[] = [];
  let i18nTypeBlock: String = "";
  let i18nUpdField: FieldDef = null;
  let i18nFillAssignLines: String[] = [];
  let i18nDetailAssignLines: String[] = [];
  let i18nMapAssignLine: String = "";
  let i18nTransAssignLines: String[] = [];
  let i18nFillCall: String = "";
  let i18nDetailCall: String = "";
  if (hasI18n) {
    // 实体虚拟字段（gorm:"-"）：当前语言平铺 + 全语言 map（详情接口）
    for (iff in i18nFlatFields) {
      let vf: FieldDef = new FieldDef();
      vf.name = iff["name"];
      vf.goName = iff["goName"];
      vf.goType = iff["goType"];
      vf.enDeclType = iff["goType"];
      vf.gormTag = "gorm:\"-\"";
      vf.enJsonTag = "json:\"" + iff["name"] + "\"";
      vf.comment = iff["comment"] + "（当前语言）";
      i18nEntityFields.append(vf);
      i18nOutFields.append(vf);
    }
    let mapField: FieldDef = new FieldDef();
    mapField.name = "i18n";
    mapField.goName = "I18n";
    mapField.goType = "map";
    mapField.enDeclType = "map[string]" + i18nTypeName;
    mapField.gormTag = "gorm:\"-\"";
    mapField.enJsonTag = "json:\"i18n,omitempty\"";
    mapField.comment = "全语言翻译（详情接口返回）";
    i18nEntityFields.append(mapField);

    // 翻译数据类型（InUpd 的 i18n map value / 详情 map value）
    let typeMaxName: Number = 0;
    let typeMaxType: Number = 0;
    for (iff in i18nFlatFields) {
      if (iff["goName"].length > typeMaxName) { typeMaxName = iff["goName"].length; }
      if (iff["goType"].length > typeMaxType) { typeMaxType = iff["goType"].length; }
    }
    i18nTypeLines.append("// " + i18nTypeName + " 多语言翻译数据（翻译表 " + i18nTable +
                         " 的字段子集；ext/lang 由服务端维护）");
    i18nTypeLines.append("type " + i18nTypeName + " struct {");
    for (iff in i18nFlatFields) {
      i18nTypeLines.append(tabChar() + padTo(iff["goName"], typeMaxName) + " "
        + padTo(iff["goType"], typeMaxType) + " `json:\"" + iff["name"] + "\"` // " + iff["comment"]);
    }
    i18nTypeLines.append("}");
    for (l in i18nTypeLines) {
      if (i18nTypeBlock == "") { i18nTypeBlock = l; }
      else { i18nTypeBlock = i18nTypeBlock + "\n" + l; }
    }

    // InUpd 的 i18n map 字段（与普通列一起提交）
    let uf: FieldDef = new FieldDef();
    uf.name = "i18n";
    uf.goName = "I18n";
    uf.goType = "map";
    uf.ptrType = "map[string]" + dataAlias + "." + i18nTypeName;
    uf.jsonTag = "json:\"i18n\"";
    uf.comment = "多语言翻译：{ \"en\": {...} }（ext/lang 由服务端维护）";
    i18nUpdField = uf;

    // repo 填充赋值行（join 视图取内嵌实体）
    let fillTarget: String = hasJoin ? ("list[i]." + param.enClass + ".") : "list[i].";
    for (iff in i18nFlatFields) {
      i18nFillAssignLines.append(tabChar() + tabChar() + tabChar() + fillTarget + iff["goName"]
        + " = tr." + iff["goName"]);
      i18nDetailAssignLines.append(tabChar() + tabChar() + tabChar() + "e." + iff["goName"]
        + " = tr." + iff["goName"]);
      i18nTransAssignLines.append(tabChar() + tabChar() + "e." + iff["goName"] + " = tr." + iff["goName"]);
    }
    let initParts: String = "";
    for (iff in i18nFlatFields) {
      if (initParts != "") { initParts = initParts + ", "; }
      initParts = initParts + iff["goName"] + ": tr." + iff["goName"];
    }
    i18nMapAssignLine = tabChar() + tabChar() + "e.I18n[tr." + i18nLangGoName + "] = "
      + i18nTypeName + "{" + initParts + "}";

    i18nFillCall = tabChar() + "if err := r.fillI18n(list, sel.Lang); err != nil {\n"
      + tabChar() + tabChar() + "return nil, 0, err\n" + tabChar() + "}\n";
    i18nDetailCall = tabChar() + "if err := r.fillI18nDetail(&entity); err != nil {\n"
      + tabChar() + tabChar() + "return nil, err\n" + tabChar() + "}\n";
  }

  // ── 预渲染行（逐字节对齐）─────────────────────────────────────
  let enFieldsAll: FieldDef[] = [];
  for (f in param.fields) { enFieldsAll.append(f); }
  for (f in i18nEntityFields) { enFieldsAll.append(f); }
  let enFieldLines: String[] = buildEnFieldLines(enFieldsAll);
  // TakeSnapshot 的可空指针列深拷贝行（无指针列时为空，值类型浅拷贝即可）
  let enSnapshotLines: String[] = buildSnapshotCloneLines(param.fields);
  // changedColumns 的比较行：覆盖除主键外全部列（不做可更新列白名单）
  let enChangedLines: String[] = buildChangedLines(param.fields, idName);
  let enChangedCount: Number = 0;
  for (f in param.fields) {
    if (!f.isPrimary) { enChangedCount = enChangedCount + 1; }
  }
  let colLines: String[] = buildColLines(param.fields);
  // i18n：查询入参追加 lang（当前语言码；空=默认语言）
  if (hasI18n) {
    let lf: SelFieldDef = new SelFieldDef();
    lf.name = "lang";
    lf.baseName = "lang";
    lf.goName = "Lang";
    lf.goType = "string";
    lf.declType = "string";
    lf.comment = "语言码（空=默认语言 " + i18nDefaultLang + "）";
    selFields.append(lf);
  }
  let selFieldLines: String[] = buildSelFieldLines(selFields);
  // i18n：保存入参追加 i18n map（普通列仍全指针）
  let updFieldsAll: FieldDef[] = [];
  for (uf in param.updFields) { updFieldsAll.append(uf); }
  if (hasI18n && i18nUpdField != null) { updFieldsAll.append(i18nUpdField); }
  let updFieldLines: String[] = buildUpdFieldLines(updFieldsAll, idName, idType);
  // InUpd.ToEntity / ApplyTo 共用行：仅复制入参非 nil 的字段（nil = 本次不改）
  let applyToLines: String[] = buildApplyLines(param.updFields);
  // 主键零值/非法判断（自增主键实际为整数；字符串主键兜底空串）
  let idNumeric: Bool = idType.includes("int") || idType.includes("float") || idType == "coin.Coin";
  let idZeroExpr: String = idNumeric ? "0" : "\"\"";
  let idInvalidCond: String = idNumeric ? ("id <= " + idZeroExpr) : ("id == " + idZeroExpr);
  // Update(e) 的护栏：主键取自实体字段，条件表达式直接用 e.<主键>
  let idInvalidEntityCond: String = "e." + idName + (idNumeric ? (" <= " + idZeroExpr) : (" == " + idZeroExpr));
  let idInsertWithIdCond: String = "e." + idName + " != " + idZeroExpr;
  // service 结构体两列对齐（DB/Repo）
  let svcName1: String = "DB";
  let svcType1: String = "*gorm.DB";
  let svcName2: String = "Repo";
  let svcType2: String = "*" + dataAlias + "." + param.repoClass;
  let svcMaxName: Number = svcName1.length;
  if (svcName2.length > svcMaxName) { svcMaxName = svcName2.length; }
  let svcMaxType: Number = svcType1.length;
  if (svcType2.length > svcMaxType) { svcMaxType = svcType2.length; }
  let svcFieldLines: String[] = [];
  // 类型列是行尾（无 tag/注释），gofmt 不补尾随空格
  svcFieldLines.append(tabChar() + padTo(svcName1, svcMaxName) + " " + svcType1);
  svcFieldLines.append(tabChar() + padTo(svcName2, svcMaxName) + " " + svcType2);

  // ── import 块 ────────────────────────────────────────────────
  //      金额列（coin.Coin）只依赖架子 coin 包：repo/in_sel/in_upd
  //      与联表实体恒有 common，无需处理；仅单表实体原本无 common，需补
  let needTime: Bool = false;
  for (f in param.fields) {
    if (f.goType == "time.Time") { needTime = true; }
  }
  // InUpd 按 editCols 收敛后可能已无时间列；import 只看实际写入参数字段
  let updNeedTime: Bool = false;
  let updNeedCoin: Bool = false;
  for (uf in param.updFields) {
    if (uf.ptrType.includes("time.Time")) { updNeedTime = true; }
    if (uf.goType == "coin.Coin") { updNeedCoin = true; }
  }
  let selNeedTime: Bool = false;
  for (sf in selFields) {
    if (sf.goType == "time.Time") { selNeedTime = true; }
  }
  let tb: String = tabChar();
  let joinNeedTime: Bool = false;
  if (hasJoin) {
    // 联表模式：querySpec 引用 common；联表输出列为 time.Time 时需要 time 包
    let viewFieldList: Object[] = jd["viewFields"];
    for (vf in viewFieldList) {
      if (vf["goType"] == "time.Time") { joinNeedTime = true; }
    }
  }
  let enTime: Bool = (needTime || joinNeedTime);
  let enImports: String = "";
  let enStd: String[] = [];
  let enExt: String[] = [];
  // 实体文件固定带数据层错误常量（ErrNilEntity 等），统一需要 errors
  enStd.append("errors");
  if (enTime) { enStd.append("time"); }
  if (param.hasDecimalField) { enExt.append(coinPath); }
  // 所有表都生成 querySpec（无联表时 Joins 为空），实体文件必须引用 cdb
  enExt.append(dbPath);
  enImports = buildGoImports(enStd, enExt);

  let selImports: String = "";
  let selStd: String[] = [];
  let selExt: String[] = [];
  if (selNeedTime) { selStd.append("time"); }
  selExt.append(httpxPath);
  selImports = buildGoImports(selStd, selExt);

  let repoImports: String = buildGoImports([dbPath], ["gorm.io/gorm"]);

  // InUpd 里 cdb 只被 CopyNonNil 使用：全可空指针列 / JSON 列 / 无可写列时不需要
  let updNeedCdb: Bool = false;
  for (uf in param.updFields) {
    if (!uf.enIsPtr && uf.ptrType != uf.goType) { updNeedCdb = true; }
  }
  let updImports: String = "import (\n";
  if (updNeedTime) {
    updImports = updImports + tb + "\"time\"\n\n";
  }
  if (updNeedCoin) {
    updImports = updImports + tb + "\"" + coinPath + "\"\n";
  }
  if (updNeedCdb) {
    updImports = updImports + tb + "\"" + dbPath + "\"\n";
  }
  updImports = updImports + tb + dataAlias + " \"" + dataPath + "\"\n)";

  let hdlImports: String = "import (\n" + tb + "\"github.com/gin-gonic/gin\"\n\n" + tb + "\""
    + commonPath + "\"\n" + tb + "\"" + httpxPath + "\"\n" + tb + dataAlias
    + " \"" + dataPath + "\"\n)";
  // 新增路径必须显式填"NOT NULL 且无可依赖 DB 默认值"的创建时间列：
  // 值类型 time.Time 零值 0001-01-01 在 STRICT_TRANS_TABLES + NO_ZERO_DATE 下插入会报 1292。
  // 可空 *time.Time 的 created_at 由数据库默认值或业务显式赋值维护，不在此重复赋值。
  let svcCreateTimeLines: String[] = [];
  let svcNeedTime: Bool = false;
  for (cf in param.fields) {
    if (cf.isCreateDate && !cf.enIsPtr) {
      svcCreateTimeLines.append(tb + tb + "e." + cf.goName + " = time.Now()");
      svcNeedTime = true;
    }
  }
  let svcImports: String = "import (\n";
  // i18n 表的创建时间赋值在 svc_i18n_.go，主 service 不再需要 time
  if (svcNeedTime && !hasI18n) {
    svcImports = svcImports + tb + "\"time\"\n\n";
  }
  svcImports = svcImports + tb + "\"gorm.io/gorm\"\n\n" + tb + dataAlias
    + " \"" + dataPath + "\"\n)";
  // C 端只读 service 不写库，不需要 time（svcImports 可能因创建时间列带 time）
  let appSvcImports: String = "import (\n" + tb + "\"gorm.io/gorm\"\n\n" + tb + dataAlias
    + " \"" + dataPath + "\"\n)";
  let routerImports: String = "import (\n" + tb + "\"github.com/gin-gonic/gin\"\n\n" + tb + "\""
    + dbPath + "\"\n" + tb + "\"" + middlewarePath + "\"\n)";

  // ── C 端模块（modules/app）配置 ──────────────────────────────
  //      appQuery 缺省 false；appAuth 缺省 user（宁可漏开放、不可误开放）；
  //      appQueryMode 缺省=只读查询，"empty"=空接口（仅骨架，不生成只读接口）
  let appQuery: Bool = (json["appQuery"] == true);
  let appEmpty: Bool = (appQuery && json["appQueryMode"] == "empty");
  let appAuth: String = json["appAuth"];
  if (appAuth == null || appAuth == "") {
    appAuth = "user";
  }
  let appIsPublic: Bool = (appAuth == "public");
  // C 端出参白名单（appOutCols）：空=直接回实体；非空生成 out_<表>_.go
  let appOutCols: Object[] = json["appOutCols"];
  let appHasOut: Bool = appQuery && appOutCols != null && appOutCols.length > 0;
  let appOutFields: Object[] = [];
  if (appHasOut) {
    // 按 appOutCols 的配置顺序输出，出参 JSON 字段顺序与配置一致
    for (oc in appOutCols) {
      for (f in param.fields) {
        // 「输出」未勾选的列即使出现在白名单也不输出（与实体 json:"-" 双保险）
        if (oc == f.name && f.hidden != true) {
          appOutFields.append(f);
        }
      }
    }
    // 白名单命中的列全部被标记「不输出」→ 回退完整实体（隐藏列仍由 json:"-" 挡住）
    if (appOutFields.length == 0) {
      appHasOut = false;
    }
  }
  // i18n：出参在白名单列之后平铺当前语言文本（实体已按 lang 填充）
  if (appHasOut && hasI18n) {
    for (vf in i18nOutFields) {
      appOutFields.append(vf);
    }
  }
  let appOutClass: String = appHasOut ? ("Out" + param.tableClass) : (dataAlias + "." + param.enClass);
  // 出参字段行预对齐（gofmt 格式）
  // C 方案：实体普通列已是值类型，出参直接赋值，无需解引用兜底；
  // 仅数据库可空列仍是 *T，出参声明类型同步取 enDeclType（JSON 输出 null）
  let appOutFieldLines: String[] = [];
  let appOutAssignLines: String[] = [];
  let appOutNeedTime: Bool = false;
  let appOutNeedCoin: Bool = false;
  let appOutNeedJson: Bool = false;
  if (appHasOut) {
    let outMaxName: Number = 0;
    let outMaxType: Number = 0;
    for (f in appOutFields) {
      if (f.goName.length > outMaxName) { outMaxName = f.goName.length; }
      if (f.enDeclType.length > outMaxType) { outMaxType = f.enDeclType.length; }
    }
    for (f in appOutFields) {
      let tag: String = "`json:\"" + f.name + "\"`";
      appOutFieldLines.append(tabChar() + padTo(f.goName, outMaxName) + " "
        + padTo(f.enDeclType, outMaxType) + " " + tag);
      appOutAssignLines.append(tabChar() + tabChar() + padTo(f.goName + ":", outMaxName + 1)
        + " e." + f.goName + ",");
      if (f.goType == "time.Time") { appOutNeedTime = true; }
      if (f.goType == "coin.Coin") { appOutNeedCoin = true; }
      if (f.goType == "datatypes.JSON") { appOutNeedJson = true; }
    }
  }
  let appOutImports: String = "";
  if (appHasOut) {
    let outStd: String[] = [];
    let outExt: String[] = [];
    if (appOutNeedTime) { outStd.append("time"); }
    if (appOutNeedCoin) { outExt.append(coinPath); }
    if (appOutNeedJson) { outExt.append("gorm.io/datatypes"); }
    outExt.append(dataAlias + " \"" + dataPath + "\"");
    appOutImports = "import (\n";
    for (s in outStd) { appOutImports = appOutImports + tb + "\"" + s + "\"\n"; }
    if (outStd.length > 0) { appOutImports = appOutImports + "\n"; }
    for (e in outExt) {
      appOutImports = appOutImports + tb + (e.indexOf(" ") > 0 ? e : ("\"" + e + "\"")) + "\n";
    }
    appOutImports = appOutImports + ")";
  }
  let appPkgComment: String = json["appPkgComment"];
  if (appPkgComment == null || appPkgComment == "") {
    appPkgComment = param.tableDesc
      + (appEmpty ? " C 端模块（空接口，自定义接口写扩展件）"
                  : (appIsPublic ? " C 端模块（公开只读查询）" : " C 端模块（需登录只读查询）"));
  }
  let appRouterMountNote: String = appIsPublic
    ? "本模块生成配置为公开浏览，故不挂 UserAuth。"
    : "本模块生成配置为需登录，已挂 UserAuth。";
  let appRouterAuthNote: String = appIsPublic
    ? "生成配置：公开浏览，未挂 UserAuth"
    : "生成配置：需登录，已挂 UserAuth";
  let appRouterImports: String = "";
  if (appIsPublic) {
    appRouterImports = "import (\n" + tb + "\"github.com/gin-gonic/gin\"\n\n" + tb
      + "\"" + dbPath + "\"\n)";
  } else {
    appRouterImports = "import (\n" + tb + "\"github.com/gin-gonic/gin\"\n\n" + tb
      + "\"" + dbPath + "\"\n" + tb + "\"" + middlewarePath + "\"\n)";
  }

  // ── 表缓存骨架（data 层手写件）────────────────────────────────
  //      genCache 缺省 false：仅对读多写少、且本表是缓存主数据源的表勾选；
  //      生成 data/<前缀>/<表>/<表>_cache.go（fileExists 守卫，仅首次骨架不覆盖）
  let genCache: Bool = (json["genCache"] == true);

  // ── 包注释文案（表级配置，缺省按表注释兜底）───────────────────
  let dataPkgComment: String = json["dataPkgComment"];
  if (dataPkgComment == null || dataPkgComment == "") {
    dataPkgComment = param.tableDesc + "共享数据层（admin 端与 app 端复用）";
  }
  let adminPkgComment: String = json["adminPkgComment"];
  if (adminPkgComment == null || adminPkgComment == "") {
    adminPkgComment = param.tableDesc + "管理端模块（CRUD）";
  }

  // ── 枚举（表级 enums + globalEnumCols；与旧链同一加工器）────────
  let enums: Object[] = buildTableEnums(json, param, globalEnumDefs, emitted, pkgName);
  let hasEnums: Bool = (enums.length > 0);

  // ── tplData ──────────────────────────────────────────────────
  let tplData: Object = {};
  tplData["moduleName"] = moduleName;
  tplData["tableName"] = param.tableName;
  tplData["tableComment"] = param.tableDesc;
  tplData["dataDir"] = dataDir;
  tplData["pkgName"] = pkgName;
  tplData["dataPath"] = dataPath;
  tplData["dataAlias"] = dataAlias;
  tplData["commonPath"] = commonPath;
  tplData["dbPath"] = dbPath;
  tplData["coinPath"] = coinPath;
  tplData["httpxPath"] = httpxPath;
  tplData["redisxPath"] = redisxPath;
  tplData["middlewarePath"] = middlewarePath;
  tplData["dataPkgComment"] = dataPkgComment;
  tplData["adminPkgComment"] = adminPkgComment;
  tplData["tableClass"] = param.tableClass;
  tplData["enClass"] = param.enClass;
  tplData["selClass"] = param.selClass;
  tplData["updClass"] = param.updClass;
  tplData["repoClass"] = param.repoClass;
  tplData["serviceClass"] = param.serviceClass;
  tplData["handlerClass"] = param.handlerClass;
  tplData["idGoType"] = idType;
  tplData["idGoName"] = idName;
  tplData["idColName"] = idCol;
  tplData["idZeroExpr"] = idZeroExpr;
  tplData["idInvalidCond"] = idInvalidCond;
  tplData["hasAutoIncPk"] = param.hasAutoIncPk;
  tplData["hasNullableField"] = param.hasNullableField;
  tplData["permPrefix"] = tableName;
  tplData["enFieldLines"] = enFieldLines;
  tplData["enSnapshotLines"] = enSnapshotLines;
  tplData["enChangedLines"] = enChangedLines;
  tplData["enChangedCount"] = enChangedCount;
  tplData["colLines"] = colLines;
  tplData["selFieldLines"] = selFieldLines;
  tplData["updFieldLines"] = updFieldLines;
  // ── i18n 模板数据 ─────────────────────────────────────────────
  tplData["hasI18n"] = hasI18n;
  tplData["i18nTypeBlock"] = i18nTypeBlock;
  tplData["i18nTypeName"] = i18nTypeName;
  tplData["i18nDefaultLang"] = i18nDefaultLang;
  tplData["i18nEnClass"] = i18nEnClass;
  tplData["i18nTable"] = i18nTable;
  tplData["i18nTableComment"] = i18nTableComment;
  tplData["i18nEntityFieldLines"] = i18nEntityFieldLines;
  tplData["i18nColLines"] = i18nColLines;
  tplData["i18nEntityNeedTime"] = i18nEntityNeedTime;
  tplData["i18nExtGoName"] = i18nExtGoName;
  tplData["i18nLangGoName"] = i18nLangGoName;
  tplData["i18nExtGoType"] = i18nExtGoType;
  tplData["i18nColPrefix"] = i18nColPrefix;
  tplData["i18nUpdateCols"] = i18nUpdateCols;
  tplData["i18nFillCall"] = i18nFillCall;
  tplData["i18nDetailCall"] = i18nDetailCall;
  tplData["i18nAssignLines"] = i18nFillAssignLines;
  tplData["i18nDetailAssignLines"] = i18nDetailAssignLines;
  tplData["i18nMapAssignLine"] = i18nMapAssignLine;
  tplData["i18nTransAssignLines"] = i18nTransAssignLines;
  tplData["i18nNeedTime"] = svcNeedTime;
  // saveI18n 的创建时间赋值在 if 块内，需比主 service 多一级缩进
  let i18nCreateTimeLines: String[] = [];
  for (ctl in svcCreateTimeLines) { i18nCreateTimeLines.append(tabChar() + ctl); }
  tplData["i18nCreateTimeLines"] = i18nCreateTimeLines;
  tplData["i18nIdExpr"] = hasJoin ? ("list[i]." + param.enClass + "." + idName) : ("list[i]." + idName);
  tplData["applyToLines"] = applyToLines;
  tplData["idInvalidEntityCond"] = idInvalidEntityCond;
  tplData["idInsertWithIdCond"] = idInsertWithIdCond;
  tplData["svcFieldLines"] = svcFieldLines;
  tplData["whereConditions"] = whereConds;
  let listType: String = param.enClass;
  if (hasJoin) {
    listType = param.enClass + "View";
  }
  tplData["listType"] = listType;
  tplData["enImports"] = enImports;
  tplData["selImports"] = selImports;
  tplData["repoImports"] = repoImports;
  tplData["updImports"] = updImports;
  tplData["hdlImports"] = hdlImports;
  tplData["svcImports"] = svcImports;
  tplData["appSvcImports"] = appSvcImports;
  tplData["svcCreateTimeLines"] = svcCreateTimeLines;
  tplData["routerImports"] = routerImports;
  tplData["appQuery"] = appQuery;
  tplData["appHasOut"] = appHasOut;
  tplData["appOutClass"] = appOutClass;
  tplData["appOutFields"] = appOutFields;
  tplData["appOutFieldLines"] = appOutFieldLines;
  tplData["appOutAssignLines"] = appOutAssignLines;
  tplData["appOutImports"] = appOutImports;
  tplData["appEmpty"] = appEmpty;
  // app 空接口：handler 生成件只剩 struct + New（同包类型），无 gin/common/实体
  // 引用 → import 必须为空。用独立键 appHdlImports：若直接清空 hdlImports，
  // admin handler 生成件（共用该键）会一起丢掉 import 而编译失败
  tplData["appHdlImports"] = appEmpty ? "" : hdlImports;
  tplData["appIsPublic"] = appIsPublic;
  tplData["appPkgComment"] = appPkgComment;
  tplData["appRouterMountNote"] = appRouterMountNote;
  tplData["appRouterAuthNote"] = appRouterAuthNote;
  tplData["appRouterImports"] = appRouterImports;
  tplData["hasEnums"] = hasEnums;
  tplData["enums"] = enums;

  // ── 联表（joinTables）模板数据 ─────────────────────────────────
  tplData["hasJoin"] = hasJoin;
  tplData["joinConstLines"] = jd["joinConstLines"];
  tplData["enViewFieldLines"] = jd["enViewFieldLines"];
  tplData["joinSpecBlock"] = jd["joinSpecBlock"];
  tplData["listType"] = hasJoin ? param.enClass + "View" : param.enClass;
  let selComment: String = "分页查询列表数据，返回数据列表和总记录数";
  if (hasJoin) {
    let joinEntryList: Object[] = jd["joinEntries"];
    let jl: String = "";
    for (je in joinEntryList) {
      jl = jl + (jl == "" ? "" : " + ") + je["table"];
    }
    selComment = "分页联表查询列表数据（" + param.tableName + " + " + jl + "），返回视图列表和总记录数";
  }
  tplData["selComment"] = selComment;

  // ── 模板清单（data 读面 → admin 写面；repo_ext 为手写扩展首次骨架）──
  //     i18n 翻译表（_i18nTable）只生成 data 层：实体 + 查询入参 + 仓储
  let templates: TemplateConfig[] = [
    { tpl: tplDir + "/model/entity.tpl",  out: "{goBasePath}/data/{dataDir}/en_{tableName}_.go" },
    { tpl: tplDir + "/model/in_sel.tpl",  out: "{goBasePath}/data/{dataDir}/in_sel_{tableName}_.go" },
    { tpl: tplDir + "/repo/repo.tpl",     out: "{goBasePath}/data/{dataDir}/{tableName}_repo_.go" }
  ];
  // i18n：翻译实体（主表 data 包内 en_{翻译表}_.go）+ 仓储填充 + 保存事务
  if (hasI18n) {
    templates.append({ tpl: tplDir + "/model/entity_i18n.tpl",
      out: "{goBasePath}/data/{dataDir}/en_{i18nTable}_.go" });
    templates.append({ tpl: tplDir + "/repo/i18n_repo.tpl",
      out: "{goBasePath}/data/{dataDir}/{tableName}_repo_i18n_.go" });
  }
  // repo 手写扩展件（首次骨架，fileExists 守卫）：自定义查询/统计方法写这里
  // （生成件不调用其中的方法，无编译契约；service 写路径已并入 *_service_.go 覆盖件）
  templates.append({ tpl: tplDir + "/repo/repo_ext.tpl",
    out: "{goBasePath}/data/{dataDir}/{tableName}_repo.go" });
  templates.append({ tpl: tplDir + "/model/in_upd.tpl",
    out: "{goBasePath}/modules/admin/{dataDir}/in_upd_{tableName}_.go" });
  templates.append({ tpl: tplDir + "/handler/hdl.tpl",
    out: "{goBasePath}/modules/admin/{dataDir}/{tableName}_handler_.go" });
  templates.append({ tpl: tplDir + "/service/svc.tpl",
    out: "{goBasePath}/modules/admin/{dataDir}/{tableName}_service_.go" });
  if (hasI18n) {
    templates.append({ tpl: tplDir + "/service/svc_i18n.tpl",
      out: "{goBasePath}/modules/admin/{dataDir}/{tableName}_service_i18n_.go" });
  }
  // 手写扩展三件套（首次骨架，fileExists 守卫）：自定义业务/接口写这里；
  // 命名约定 = 生成覆盖件去尾下划线（与 *_repo.go 一致）；
  // {tableName}_router.go 的 RegisterExtRoutes 由下方 router_.go 生成件调用（须先生成）
  templates.append({ tpl: tplDir + "/service/svc_ext.tpl",
    out: "{goBasePath}/modules/admin/{dataDir}/{tableName}_service.go" });
  templates.append({ tpl: tplDir + "/handler/hdl_ext.tpl",
    out: "{goBasePath}/modules/admin/{dataDir}/{tableName}_handler.go" });
  templates.append({ tpl: tplDir + "/router_ext.tpl",
    out: "{goBasePath}/modules/admin/{dataDir}/{tableName}_router.go" });
  templates.append({ tpl: tplDir + "/router.tpl",
    out: "{goBasePath}/modules/admin/{dataDir}/{tableName}_router_.go" });

  // 表缓存骨架（opt-in，genCache=true）：data 层手写件，仅首次生成，存在即跳过
  if (genCache) {
    templates.append({ tpl: tplDir + "/cache.tpl",
      out: "{goBasePath}/data/{dataDir}/{tableName}_cache.go" });
  }

  // C 端只读模块：只生成 selectByIn/selectById 三件（service/handler/router），
  // 永不生成写接口；路由是否挂 UserAuth 由 appAuth 决定
  if (appQuery) {
    templates.append({ tpl: tplDir + "/app/svc.tpl",
      out: "{goBasePath}/modules/app/{dataDir}/{tableName}_service_.go" });
    templates.append({ tpl: tplDir + "/app/hdl.tpl",
      out: "{goBasePath}/modules/app/{dataDir}/{tableName}_handler_.go" });
    templates.append({ tpl: tplDir + "/app/router.tpl",
      out: "{goBasePath}/modules/app/{dataDir}/{tableName}_router_.go" });
    // C 端出参白名单（appOutCols 非空时生成 out_<表>_.go）
    if (appHasOut) {
      templates.append({ tpl: tplDir + "/app/out.tpl",
        out: "{goBasePath}/modules/app/{dataDir}/out_{tableName}_.go" });
    }
    // C 端手写扩展三件套（首次骨架；{tableName}_router.go 的 RegisterExtRoutes
    // 由 app router_.go 调用；命名约定同 admin 侧）
    templates.append({ tpl: tplDir + "/app/svc_ext.tpl",
      out: "{goBasePath}/modules/app/{dataDir}/{tableName}_service.go" });
    templates.append({ tpl: tplDir + "/app/hdl_ext.tpl",
      out: "{goBasePath}/modules/app/{dataDir}/{tableName}_handler.go" });
    templates.append({ tpl: tplDir + "/app/router_ext.tpl",
      out: "{goBasePath}/modules/app/{dataDir}/{tableName}_router.go" });
  }

  let count: Number = 0;
  for (cfg in templates) {
    let outPath: String = formatPath(cfg.out, {
      goBasePath: goBasePath,
      dataDir: dataDir,
      tableName: param.tableName,
      moduleDir: moduleDir,
      i18nTable: i18nTable
    });
    tplData["outputPath"] = outPath;
    let result = renderTpl(cfg.tpl, tplData);
    if (result) {
      if (canOverwriteGenerated(outPath)) {
        if (writeFile(outPath, result)) {
          count = count + 1;
        }
        printLog("生成文件: " + outPath);
      }
    }
  }

  // ── 枚举文件（data 层，无枚举不生成）──────────────────────────
  if (hasEnums) {
    let enumOutPath: String = formatPath("{goBasePath}/data/{dataDir}/enum_{tableName}_.go", {
      goBasePath: goBasePath,
      dataDir: dataDir,
      tableName: param.tableName
    });
    let enumResult = renderTpl(tplDir + "/model/enum.tpl", tplData);
    if (enumResult) {
      if (canOverwriteGenerated(enumOutPath)) {
        if (writeFile(enumOutPath, enumResult)) {
          count = count + 1;
        }
        printLog("生成文件: " + enumOutPath);
      }
    }
  }

  printLog("[" + tableName + "] 分层布局：data/" + dataDir + " + modules/admin/" + dataDir);
  return count;
}
