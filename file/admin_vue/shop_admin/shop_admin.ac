// ============================================================================
//shop_admin.ac — 后台管理界面代码生成入口脚本
// ----------------------------------------------------------------------------
// 本脚本只包含 "shop_admin 项目" 相关的参数配置，
// 具体的代码生成逻辑（.jsonvue 解析、数据加工、模板渲染）统一放在
//   ../template/main_admin.ac 的 generateAdminMain() 中。
//
// 流程：
//   1. 配置 HTTP 通用参数（可视化编辑器"生成"按钮使用）
//   2. 配置输出根目录
//   3. 调用 generateAdminMain() 生成 Vue 文件
// ============================================================================
import { generateAdminMain } from "../template/main_admin.ac";

main {
  // ── 1. 输出文件的根目录 ──────────────────────────────────────────
  let basePath: String = "D:/work/github/shop_admin";
  //测试目录：d:/work/github/auto_code/build/outtest
  //let basePath: String = "d:/work/github/auto_code/build/outtest";
  // ── 2. 组装项目参数并调用通用生成逻辑 ────────────────────────────
  //     projectApiPath 指向对应后端 API 项目目录（可选）：全局枚举生成时
  //     会收集其下全部 *.jsonglobalenum 作为项目级配置（就近覆盖平台级）
  //     genGlobalEnum: false 可跳过全局枚*.jsonglobalenum的代码生成（缺省生成global_enum_.ts）；
  //     枚举定义稳定、无需每次重写 global_enum_.ts 时使用
  let projectApiPath: String = "D:/work/github/auto_code/file/crud_nest/shop_api";
  let params: Object = { 
    basePath: basePath,
    projectApiPath: projectApiPath,
    genGlobalEnum: true
  };
  generateAdminMain(params);

  printLog("--- shop_admin 生成结束 ---");
}