/// @file main_admin.ac — 通用 Vue3 后台管理界面代码生成主逻辑
/// ----------------------------------------------------------------------------
/// 说明：
///   本文件是 admin_vue 前端界面代码生成的**通用主逻辑**，
///   不包含任何项目相关的参数（输出路径、模板配置）。
///   项目入口脚本（如 erp_admin.ac）只需定义项目参数并调用 generateAdminMain()。
///
///   数据加工逻辑已提取到 ./core/admin_data.ac 的 buildAdminTplData() 中，
///   本文件只负责 ：读取配置 → 调用加工器 → 渲染模板。
///
///   整体流程（从 .jsonvue 配置到 Vue 文件）：
///     ┌───────────────┐   readJson   ┌──────────────┐   tplData   ┌────────────┐
///     │ .jsonvue 文件  │ ──────────►  │ admin_data   │ ──────────► │  模板渲染   │
///     │ (config_g等)  │   配置数据    │ (数据加工器) │   模板数据   │  index.tpl │
///     └───────────────┘              └──────────────┘             │  write.tpl │
///                                                                └────────────┘
///   - 不连接数据库，所有数据来自 .jsonvue 配置文件
///   - 生成的是 Vue3 前端代码而非 TypeScript 后端代码
///
/// 接收的项目参数（params 对象）：
///   - basePath  输出文件根目录
///   - templates 可选，模板配置数组（省略时使用本文件默认模板）
///   - genGlobalEnum 可选，false 跳过全局枚举数据源同步（缺省/true 同步）
///   - projectApiPath 可选，对应后端 API 项目目录（如 file/crud_nest/shop_api），
///     其下全部 *.jsonglobalenum 作为项目级枚举参与合并（就近覆盖）
/// ----------------------------------------------------------------------------

import { buildAdminTplData, buildSourceTplData } from "./core/admin_data.ac";
import { findGlobalEnumFiles, mergeGlobalEnumFiles, buildGlobalEnumJsonSource } from "../../tool/tool_global_enum.ac";

/// @brief 模板配置（一个模板对应一个生成的代码文件）
class TemplateConfig {
  let tpl: String = "";  // 模板文件路径（相对脚本目录）
  let out: String = "";  // 输出文件路径模板，用 {key} 占位符从 tplData 取值
}

/// @brief 生成 Vue3 后台管理界面代码
/// @param params 项目参数对象（见文件头说明）
export function generateAdminMain(params: Object): Void {
  // 统计实际写入磁盘的文件数量（writeFile 成功时 +1），结束日志汇总输出
  let generatedFileCount = 0;

  // ── 1. 输出文件的根目录 ──────────────────────────────────────────
  let basePath: String = params["basePath"];

  // ── 2. 模板配置：一个模板对应一个生成的代码文件 ───────────────────
  //    字段说明：
  //      tpl  - 模板文件路径（相对脚本目录）
  //      out  - 输出文件路径模板，用 {key} 占位符从 tplData 取值
  //             支持的占位符：{basePath}、{pagePath}
  let templates: TemplateConfig[] = params["templates"];
  if (templates == null) {
    templates = [
      { tpl: "../template/index.tpl",  out: "{basePath}/src/views/{pagePath}/{pageName}.vue" },
      { tpl: "../template/write.tpl", out: "{basePath}/src/views/{pagePath}/components/write.vue" },
      { tpl: "../template/api.tpl", out: "{basePath}/src/api/{apiModule}/{pageName}.ts" },
    ];
  }

  // ── 2.1 数据源模板配置：勾选的 .jsonsource 文件 → 数据源 api 文件 ──
  //    out 支持的占位符：{basePath}、{sourceName}（.jsonsource 文件基名）
  //    生成的 api 供各 vue 界面下拉框引用（write.vue 的 optionApi 调用）
  let sourceTemplates: TemplateConfig[] = params["sourceTemplates"];
  if (sourceTemplates == null) {
    sourceTemplates = [
      { tpl: "../template/source.tpl", out: "{basePath}/src/api/source/{sourceName}.ts" },
    ];
  }

  let apiSelectSuffix: String = "selectByIn"; //查询api的后缀
  let apiUpdateSuffix: String = "update"; //修改api的后缀
  let apiDeleteSuffix: String = "delete"; //删除api的后缀

  // ── 3. 读取所有打勾的 .jsonvue 配置文件 ──────────────────────────
  //    传入 scriptDir() 确保只处理本项目下的勾选文件，
  //    其它项目的勾选文件即使被选中也不会被执行
  let files = getCheckedFiles(scriptDir());
  let filesLen = files.length;
  printLog("files count: " + filesLen);

  // ── 3.1 收集勾选的 .jsonsource / .jsonupload 配置文件真实路径 ─────
  //    供 buildAdminTplData 在 jsonvue 引用路径过期（文件被移动）时按文件名匹配
  let sourceFiles: String[] = [];
  let uploadFiles: String[] = [];
  for (file in files) {
    if (file.endsWith(".jsonsource")) {
      sourceFiles.push(file);
    } else if (file.endsWith(".jsonupload")) {
      uploadFiles.push(file);
    }
  }

  // ── 3.2 检查勾选文件是否同名不同路径（文件重复）────────────────
  //      两个 basename 相同的文件（如 user/user.jsonvue 与 vip/user.jsonvue）
  //      同时勾选会导致生成结果互相覆盖或混淆，应报错并中止生成
  let seenBases: String[] = [];
  let dupFiles: String[] = [];
  for (chk in files) {
    let base = basename(chk);
    let seen = false;
    for (sb in seenBases) {
      if (sb == base) { seen = true; }
    }
    if (seen) {
      dupFiles.push(base);
    } else {
      seenBases.push(base);
    }
  }
  if (dupFiles.length > 0) {
    printError("错误：勾选文件存在同名不同路径（文件重复），请取消勾选其中一个后重新执行：");
    for (d in dupFiles) {
      printError("  - " + d);
    }
    return;
  }

  // ── 3.5 全局枚举同步：.jsonglobalenum → 本项目 api/global_enum.jsonsource ──
  //      两级作用域收集合并（就近在前）：
  //        1. params.projectApiPath 指定的后端 API 项目目录（可选，项目级枚举；
  //           前端目录树够不到后端项目子目录，用显式传参建立对应关系）
  //        2. 查找链上的共享层配置（如 file/crud_nest/*.jsonglobalenum）
  //      合并后转成与 .jsonsource 同构的静态数据源写回本项目 api/ 目录
  //      （自动生成，勿手改）：
  //        1. 供 jsonvue「选择数据源」面板发现引用（id 与配置文件一致）
  //        2. 直接走 source.tpl 链路渲染 {basePath}/src/api/source/global_enum.ts
  //           （不依赖用户是否勾选该文件；勾选时循环内重复生成同样结果）
  //      同名枚举项目级覆盖平台级（就近优先）；无任何配置时跳过（不影响页面生成）
  //      params.genGlobalEnum 显式为 false 时跳过（缺省/true 同步）：
  //      枚举定义稳定、无需每次重写产物时使用
  if (params["genGlobalEnum"] != false) {
    let geFiles: String[] = [];
    let projDir: String = params["projectApiPath"];
    if (projDir != null && projDir != "") {
      if (fileExists(projDir)) {
        // 目录下全部 *.jsonglobalenum（按文件名序）作为项目级配置收集
        let projNames: String[] = listFiles(projDir, ".jsonglobalenum");
        let pnLen = projNames.length;
        for (let pi = 0; pi < pnLen; pi = pi + 1) {
          geFiles.append(projDir.replace("\\", "/") + "/" + projNames[pi]);
        }
      } else {
        printLog("警告：projectApiPath 不存在: " + projDir);
      }
    }
    let sharedFiles: String[] = findGlobalEnumFiles(scriptDir());
    for (let sf: String in sharedFiles) {
      geFiles.append(sf);
    }
    if (geFiles.length > 0) {
      printLog("global enum files: " + geFiles.length + " 份（就近优先合并）");
      let geJson: Object = mergeGlobalEnumFiles(geFiles);
      let srcObj = buildGlobalEnumJsonSource(geJson);
      let srcList: Object[] = srcObj["sources"];
      if (srcList != null && srcList.length > 0) {
        let jsonSourcePath = scriptDir() + "/api/global_enum.jsonsource";
        let writeOk = writeFile(jsonSourcePath, toJsonString(srcObj));
        if (writeOk) {
          printLog("同步全局枚举数据源: " + jsonSourcePath);
          // 纳入数据源处理列表：jsonvue 引用（boolSourceFile/selectSourceFile 存
          // 基名 global_enum.jsonsource）在 admin_data.ac 按 basename 匹配时命中
          sourceFiles.append(jsonSourcePath);
        }
        // 渲染 source 链路（与勾选 .jsonsource 的处理逻辑一致）
        let srcData = buildSourceTplData(srcObj, jsonSourcePath);
        for (cfg in sourceTemplates) {
          let outPath = formatPath(cfg.out, {
            basePath: basePath,
            sourceName: srcData["sourceName"]
          });
          let result = renderTpl(cfg.tpl, srcData);
          if (result) {
            let srcWriteOk = writeFile(outPath, result);
            if (srcWriteOk) {
              generatedFileCount = generatedFileCount + 1;
            }
            printLog("生成文件: " + outPath);
          }
        }
      } else {
        printLog("全局枚举配置为空，跳过数据源同步");
      }
    } else {
      printLog("未找到 global_enum.jsonglobalenum，跳过全局枚举数据源同步");
    }
  } else {
    printLog("genGlobalEnum=false，跳过全局枚举数据源同步");
  }

  // ── 4. 对每个勾选文件执行生成流程（.jsonvue 页面 / .jsonsource 数据源）──
  for (file in files) {

    // ── 4.0 .jsonsource 数据源文件：渲染 source 模板生成数据源 api ──
    //      每个 .jsonsource 文件生成一个 api 文件（默认 src/api/source/{sourceName}.ts），
    //      供各 vue 界面下拉框 import 引用
    if (file.endsWith(".jsonsource")) {
      //printLog("processing source: " + file);
      let srcJson = readJson(file);
      let srcData = buildSourceTplData(srcJson, file);
      for (cfg in sourceTemplates) {
        let outPath = formatPath(cfg.out, {
          basePath: basePath,
          sourceName: srcData["sourceName"]
        });
        let result = renderTpl(cfg.tpl, srcData);
        if (result) {
          let writeOk = writeFile(outPath, result);
          if (writeOk) {
            generatedFileCount = generatedFileCount + 1;
          }
          printLog("生成文件: " + outPath);
        }
      }
      continue;
    }

    printLog("processing: " + file);

    // ── 4.1 读取 .jsonvue 配置并调用通用数据加工器 ─────────────────
    //      buildAdminTplData 完成全部数据加工，返回完整 tplData：
    //        pagePath/apiModule - 页面路径与 API 模块名
    //        apiImports         - API 导入列表字符串
    //        columns/queryFields- 列与查询字段数组
    //        buttons 及分组      - 自定义按钮及行为分组
    //        各派生标记          - 排序、默认值、隐藏/只读字段等
    let json = readJson(file);

    // 引用 .jsonsource / .jsonupload 的路径匹配由 buildAdminTplData 内部按文件名
    // 从 sourceFiles / uploadFiles（勾选的真实路径）解析，无需修改 jsonvue 数据
    let tplData = buildAdminTplData(json, file, {
      "select": apiSelectSuffix,
      "update": apiUpdateSuffix,
      "delete": apiDeleteSuffix
    }, sourceFiles, uploadFiles);
    let pagePath: String = tplData["pagePath"];

    // ── 4.2 遍历模板配置，逐个渲染并写入文件 ─────────────────────
    for (cfg in templates) {
      printLog("tpl path: " + cfg.tpl);

      // 用 formatPath 替换 {basePath}/{pagePath}/{apiModule}/{pageName} 等占位符，得到输出文件路径
      let outPath = formatPath(cfg.out, {
        basePath: basePath,
        pagePath: pagePath,
        apiModule: tplData["apiModule"],
        pageName: tplData["pageName"]
      });
      tplData["outputPath"] = outPath;  // 供模板内的 fileExists(outputPath) 守卫使用

      // 核心：调用模板引擎，把 tpl 中的 ${变量名} 替换为实际值
      let result = renderTpl(cfg.tpl, tplData);
      printLog("result length: " + result.length);

      // 渲染成功 → 写入磁盘
      if (result) {
        let writeOk = writeFile(outPath, result);
        if (writeOk) {
          generatedFileCount = generatedFileCount + 1;
        }
        printLog("生成文件: " + outPath);
      }
    }
  }

  printLog("--- Vue 代码生成结束，共生成 " + generatedFileCount + " 个文件 ---");
}