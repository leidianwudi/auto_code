// ============================================================================
// admin_data.ac — admin_vue .jsonvue 配置数据加工器
// ----------------------------------------------------------------------------
// 说明：
//   本文件封装 Vue3 后台管理界面代码生成所需的全部数据加工逻辑，
//   把 .jsonvue 原始配置转换为模板友好的结构（tplData）。
//   main_admin.ac 只负责读取配置、调用本模块、渲染模板。
//
//   整体职责：
//     1. derivePage        - 从文件路径推导页面路径 / API 模块名
//     2. processColumns    - 加工列配置 → 模板友好列数组
//     3. processQueryFields- 加工查询字段 → 模板友好查询字段数组
//     4. processButtons    - 加工自定义按钮 → 按钮数组 + 行为分组 + 额外 API
//     5. buildApiImports   - 拼接 API 导入列表字符串
//     6. buildAdminTplData - 汇总以上结果，生成完整 tplData
// ============================================================================

import { escapeJsStr, snakeToPascal, snakeToCamel, isNumericStr } from "../../../tool/tool_str.ac";

// ---------------------------------------------------------------------------
// 0) 通用辅助
// ---------------------------------------------------------------------------
// 判断值是否非空字符串（null / 空字符串 均视为空）。
// 避免缺失字段（null）与 "" 比较时被误判为非空。
export function isNotEmpty(v: Any): Bool {
  if (v == null) { return false; }
  return (v != "");
}

// ---------------------------------------------------------------------------
// 1) 从文件路径推导页面路径 / API 模块名
//    文件路径示例：.../erp_admin/setting/config_g.jsonvue
//    推导结果：pagePath = "setting/config_g"，apiModule = "setting"
// ---------------------------------------------------------------------------
export function derivePage(file: String): Object {
  let fullName = fileName(file);              // config_g.jsonvue
  let pageName = fullName.replace(".jsonvue", "");  // config_g

  // 统一路径分隔符为 /
  let normPath = file.replace("\\", "/");
  // 去掉文件名，得到目录路径
  let dirPath = normPath.replace("/" + fullName, "");
  // 获取目录路径的最后一级非空目录名
  let dirParts = dirPath.split("/");
  let dirName = "";
  let dirPartsLen = dirParts.length;
  for (let i = dirPartsLen - 1; i >= 0; i = i - 1) {
    if (dirParts[i] != "") {
      dirName = dirParts[i];
      break;
    }
  }
  let pagePath = dirName + "/" + pageName;     // setting/config_g
  // 从 pagePath 提取 API 模块名（第一级目录）
  let pathParts = pagePath.split("/");
  let apiModule = pathParts[0];                // setting
  return {
    pagePath: pagePath,
    pageName: pageName,
    apiModule: apiModule
  };
}

// ---------------------------------------------------------------------------
// 1.5) 图片上传预设辅助：响应提取路径 → 可选链表达式
//    "data.url" → "res?.data?.url"；段名不合法（非 [A-Za-z0-9_]）时回退默认值，
//    防止注入非法 JS 标识符导致生成的代码语法错误
// ---------------------------------------------------------------------------
export function isValidIdent(s: String): Bool {
  if (s == null || s.length == 0) {
    return false;
  }
  let n = s.length;
  for (let i = 0; i < n; i = i + 1) {
    let c = s[i];
    let isDigit = (c >= "0" && c <= "9");
    let isLower = (c >= "a" && c <= "z");
    let isUpper = (c >= "A" && c <= "Z");
    if (!isDigit && !isLower && !isUpper && c != "_") {
      return false;
    }
  }
  // 首字符不能是数字
  let c0 = s[0];
  if (c0 >= "0" && c0 <= "9") {
    return false;
  }
  return true;
}

export function buildResChain(responsePath: String): String {
  let path: String = isNotEmpty(responsePath) ? responsePath : "data.url";
  let segs: String[] = path.split(".");
  let chain = "res";
  let segsLen = segs.length;
  for (let i = 0; i < segsLen; i = i + 1) {
    let seg = segs[i];
    if (!isValidIdent(seg)) {
      return "res?.data?.url";
    }
    chain = chain + "?." + seg;
  }
  return chain;
}

// ---------------------------------------------------------------------------
// 2) 加工列配置数据 → 模板友好列数组
//    sourceMap 为 .jsonsource 数据源引用查找表（键 "文件路径#数据源id"，
//    值为 processSources 加工后的数据源对象），可为 null（无引用时）；
//    uploadMap 为 .jsonupload 上传预设引用查找表（键 "文件路径#预设id"，
//    值为原始预设对象），可为 null（无引用时）
// ---------------------------------------------------------------------------
export function processColumns(rawColumns: Object[], sourceMap: Object,
                               uploadMap: Object): Object[] {
  let columns: Object[] = [];
  let rawColsLen = rawColumns.length;
  for (let i = 0; i < rawColsLen; i = i + 1) {
    let rawCol: Object = rawColumns[i];
    let col: Object = {};
    col["dataName"] = rawCol.dataName;
    // 标题（列表页列标题与编辑页标签已合并为同一值）
    col["label"] = rawCol.queryName;
    if (col["label"] == "") {
      col["label"] = rawCol.editName;
    }
    col["editName"] = col["label"];
    // 可见性控制
    col["queryVisible"] = rawCol.queryVisible;
    col["editVisible"] = rawCol.editVisible;
    // 可编辑性控制
    col["editEditable"] = rawCol.editEditable;
    col["switchEditable"] = rawCol.switchEditable;

    // 判断是否为开关样式：(displayType == "boolean" || "tag") && switchEditable
    let isSwitch = false;
    if ((rawCol.displayType == "boolean" || rawCol.displayType == "tag") && rawCol.switchEditable) {
      isSwitch = true;
    }
    col["isSwitch"] = isSwitch;

    // 区分开关子类型：boolean 开关 vs tag 开关
    let isBooleanSwitch = false;
    let isTagSwitch = false;
    if (isSwitch) {
      if (rawCol.displayType == "boolean") {
        isBooleanSwitch = true;
      } else if (rawCol.displayType == "tag") {
        isTagSwitch = true;
      }
    }
    col["isBooleanSwitch"] = isBooleanSwitch;
    col["isTagSwitch"] = isTagSwitch;

    // ── 布尔列引用 .jsonsource 静态数据源 ────────────────────────
    // 显示样式 boolean 的列（开关 switchEditable=true 或纯文本显示
    // switchEditable=false）都可引用恰好 2 项的静态数据源（boolSourceFile/
    // boolSourceId）：write.vue 的 Select 用 optionApi 调 source api 函数，
    // user.vue 的开关/文字用 boolSwitchTexts 运行时读取，都不写死文字；
    // 数据源文字修改后只需重新生成 source.ts
    let boolApiName = "";
    if (rawCol.displayType == "boolean" && sourceMap != null) {
      let boolRefFile: String = rawCol.boolSourceFile;
      if (isNotEmpty(boolRefFile)) {
        let boolRef: Object = sourceMap[boolRefFile + "#" + rawCol.boolSourceId];
        if (boolRef != null && boolRef["isStatic"]) {
          boolApiName = boolRef["funcName"];
          col["sourceRefFile"] = boolRef["sourceName"];
        }
      }
    }
    col["boolApiName"] = boolApiName;
    col["hasBoolApi"] = (boolApiName != "");

    // 开关禁用字符串（基于 editEditable，不可编辑的列开关也应禁用）
    col["switchDisabledStr"] = isSwitch ? (rawCol.editEditable ? "false" : "true") : "false";

    // 开关的激活/非激活值与文字（供模板 ElSwitch 使用）
    let switchActiveValue = "1";
    let switchInactiveValue = "0";
    let switchActiveText = "启用";
    let switchInactiveText = "禁用";
    if (rawCol.displayType == "boolean") {
      switchActiveValue = "1";
      switchInactiveValue = "0";
      if (rawCol.boolTrueText != "") {
        switchActiveText = rawCol.boolTrueText;
      }
      if (rawCol.boolFalseText != "") {
        switchInactiveText = rawCol.boolFalseText;
      }
    } else if (isTagSwitch) {
      // 从 tagItems 获取开关值和文字
      let rawTagItems2: Object[] = [];
      if (rawCol.tagItems != null) {
        rawTagItems2 = rawCol.tagItems;
      }
      if (rawTagItems2.length >= 2) {
        switchInactiveValue = rawTagItems2[0].value;
        switchInactiveText = rawTagItems2[0].text;
        switchActiveValue = rawTagItems2[1].value;
        switchActiveText = rawTagItems2[1].text;
      } else if (rawTagItems2.length == 1) {
        switchActiveValue = rawTagItems2[0].value;
        switchActiveText = rawTagItems2[0].text;
      }
    }
    col["switchActiveValue"] = escapeJsStr(switchActiveValue);
    col["switchInactiveValue"] = escapeJsStr(switchInactiveValue);
    col["switchActiveText"] = escapeJsStr(switchActiveText);
    col["switchInactiveText"] = escapeJsStr(switchInactiveText);

    // 开关文字表达式（index.tpl 的 ElSwitch 使用）：
    //   引用静态数据源 → 运行时响应式变量 boolSwitchTexts['字段'].active/inactive
    //   （index.vue 顶部异步加载数据源文字，避免写死）；
    //   未引用 → 配置文字字面量（带双引号字符串）
    let switchActiveTextExpr: String = "\"" + escapeJsStr(switchActiveText) + "\"";
    let switchInactiveTextExpr: String = "\"" + escapeJsStr(switchInactiveText) + "\"";
    if (boolApiName != "") {
      switchActiveTextExpr = "boolSwitchTexts['" + escapeJsStr(col["dataName"]) + "'].active";
      switchInactiveTextExpr = "boolSwitchTexts['" + escapeJsStr(col["dataName"]) + "'].inactive";
    }
    col["switchActiveTextExpr"] = switchActiveTextExpr;
    col["switchInactiveTextExpr"] = switchInactiveTextExpr;

    // 判断是否为多行文本
    let isTextArea = false;
    if (rawCol.editStyle == "textarea") {
      isTextArea = true;
    }
    col["isTextArea"] = isTextArea;

    // 判断是否为远程下拉框
    let isSelect = false;
    if (rawCol.editStyle == "select") {
      isSelect = true;
    }
    col["isSelect"] = isSelect;

    // ── 引用 .jsonsource 数据源 ────────────────────────────────────
    // 从查找表取数据源信息：函数名（funcName）与 source.tpl 生成保持一致，
    // url / 字段以数据源文件的最新配置为准（jsonvue 里可能保存的是旧值）
    let sourceRef: Object = null;
    let refFile: String = rawCol.selectSourceFile;
    if (isNotEmpty(refFile) && sourceMap != null) {
      sourceRef = sourceMap[refFile + "#" + rawCol.selectSourceId];
    }
    let hasSourceRef = (sourceRef != null);
    col["hasSourceRef"] = hasSourceRef;

    // 生效 url：引用数据源时取数据源 url（已补前导斜杠）
    let effUrl: String = rawCol.selectUrl;
    if (hasSourceRef) {
      effUrl = sourceRef["url"];
      // 引用文件基名（write.tpl 生成 import '@/api/source/{sourceRefFile}' 用）
      col["sourceRefFile"] = sourceRef["sourceName"];
    }
    col["selectUrl"] = effUrl;

    // 生效显示/实际值字段：引用数据源时未覆盖则回填数据源配置；
    // 静态数据源选项固定为 { label, value } 结构
    let effValueField: String = rawCol.selectValueField;
    let effLabelField: String = rawCol.selectLabelField;
    if (hasSourceRef) {
      if (sourceRef["isStatic"]) {
        effValueField = "value";
        effLabelField = "label";
      } else {
        if (!isNotEmpty(effValueField)) {
          effValueField = sourceRef["valueField"];
        }
        if (!isNotEmpty(effLabelField)) {
          effLabelField = sourceRef["labelField"];
        }
      }
    }
    col["selectValueField"] = effValueField;
    col["selectLabelField"] = effLabelField;
    // 查询分页加载配置（仅 select 样式有意义）
    col["selectPaged"] = (rawCol.selectPaged == true);
    col["selectPageKey"] = isNotEmpty(rawCol.selectPageKey) ? rawCol.selectPageKey : "page";
    col["selectPageSizeKey"] = isNotEmpty(rawCol.selectPageSizeKey) ? rawCol.selectPageSizeKey : "pageSize";
    col["selectPageSize"] = (rawCol.selectPageSize != null) ? rawCol.selectPageSize : 20;
    col["selectSearchTitle"] = rawCol.selectSearchTitle || "";
    col["selectSearchField"] = rawCol.selectSearchField || "";
    col["selectMethod"] = isNotEmpty(rawCol.selectMethod) ? rawCol.selectMethod : "POST";

    // 下拉框接口推导：
    //   引用数据源 → 函数名取 source.tpl 生成的 funcName（url 全路径驼峰），
    //               地址取数据源 url（已补前导斜杠）
    //   手动配置   → 从 selectUrl 提取接口函数名与完整请求地址
    // 例：selectUrl="vipprice/getTimeTypeRecords" →
    //   selectApiName="getTimeTypeRecords"（取路径最后一段）
    //   selectApiUrl="/vipprice/getTimeTypeRecords"（补前导斜杠）
    let selectApiName = "";
    let selectApiUrl = "";
    if (hasSourceRef) {
      selectApiName = sourceRef["funcName"];
      selectApiUrl = effUrl;
    } else if (isSelect && isNotEmpty(rawCol.selectUrl)) {
      let selUrlParts: String[] = rawCol.selectUrl.split("/");
      let selUrlPartsLen: Int = selUrlParts.length;
      for (let si = selUrlPartsLen - 1; si >= 0; si = si - 1) {
        if (selUrlParts[si] != "") {
          selectApiName = selUrlParts[si];
          break;
        }
      }
      if (rawCol.selectUrl.startsWith("/")) {
        selectApiUrl = rawCol.selectUrl;
      } else {
        selectApiUrl = "/" + rawCol.selectUrl;
      }
    }
    col["selectApiName"] = selectApiName;
    col["selectApiUrl"] = selectApiUrl;
    col["hasSelectApi"] = (selectApiName != "");
    // 下拉框错误提示文本（数据名去下划线，供 optionApi 的 console.error 使用）
    col["selectErrorText"] = rawCol.dataName;

    // 根据 editStyle 决定编辑界面 Vue 组件名（字典映射，避免深层 if/else 嵌套）
    let editCompMap: Object = {
      "select": "ApiSelect",
      "int": "InputNumber",
      "float": "InputNumber",
      "money": "InputNumber",
      "date": "DatePicker",
      "tag": "Select",
      "boolean": "Select"
    };
    let styleKey: String = rawCol.editStyle;
    let editComp: String = editCompMap[styleKey] || "Input";
    col["editComponent"] = editComp;

    // 样式标记（供模板条件判断）
    col["isText"] = (rawCol.editStyle == "text");
    col["isInt"] = (rawCol.editStyle == "int");
    col["isFloat"] = (rawCol.editStyle == "float");
    col["isMoney"] = (rawCol.editStyle == "money");
    col["isDate"] = (rawCol.editStyle == "date");
    col["isTime"] = (rawCol.editStyle == "date" && rawCol.dateFormat == "time");
    col["isTagEdit"] = (rawCol.editStyle == "tag");
    col["isBooleanEdit"] = (rawCol.editStyle == "boolean");
    col["isImageEdit"] = (rawCol.editStyle == "image");
    // 字段名帕斯卡形式（上传函数名后缀，如 goodsImg → GoodsImg）
    col["dataNamePascal"] = snakeToPascal(rawCol.dataName);

    // ── 图片上传预设引用 ──────────────────────────────────────────
    // editStyle==image 且引用了 .jsonupload 上传预设（uploadSourceFile/
    // uploadSourceId）时，编辑页生成上传组件：axios 上传（form-data）+
    // 响应提取路径写回表单字段，路径随表单 JSON 提交；
    // 未引用 → hasUpload=false，保持旧行为（图片 URL 手工输入）
    let uploadRef: Object = null;
    if (rawCol.editStyle == "image" && isNotEmpty(rawCol.uploadSourceFile) && uploadMap != null) {
      uploadRef = uploadMap[rawCol.uploadSourceFile + "#" + rawCol.uploadSourceId];
    }
    let hasUpload = (uploadRef != null);
    if (!hasUpload && rawCol.editStyle == "image" && isNotEmpty(rawCol.uploadSourceFile)) {
      // 引用了预设但 .jsonupload 文件/预设 id 找不到（文件被移动或预设被删）→ 警告并回退
      printError("警告：字段 '" + rawCol.dataName + "' 引用的上传预设不存在（" +
                 rawCol.uploadSourceFile + "#" + rawCol.uploadSourceId +
                 "），已回退为普通 URL 输入，请检查 .jsonupload 文件是否勾选");
    }
    col["hasUpload"] = hasUpload;
    if (hasUpload) {
      // 上传地址（补前导斜杠，与 selectApiUrl 归一规则一致）
      let upUrl: String = uploadRef["url"];
      if (isNotEmpty(upUrl) && !upUrl.startsWith("/")) {
        upUrl = "/" + upUrl;
      }
      col["uploadAction"] = upUrl;
      // form-data 文件字段名（预设未填时默认 file）
      col["uploadFileField"] = isNotEmpty(uploadRef["fileField"]) ? uploadRef["fileField"] : "file";
      // 最多张数（1=单图 / >1=多图）
      let upLimit: Int = 1;
      if (uploadRef["maxCount"] != null && uploadRef["maxCount"] > 0) {
        upLimit = uploadRef["maxCount"];
      }
      col["uploadLimit"] = upLimit;
      // 多图判定：valueType=="array" 显式声明，或未声明时按 maxCount>1 推导；
      // valueType=="string" 显式声明单图
      let upMulti: Bool = false;
      if (uploadRef["valueType"] == "array") {
        upMulti = true;
      } else if (uploadRef["valueType"] != "string" && upLimit > 1) {
        upMulti = true;
      }
      col["uploadMulti"] = upMulti;
      // 预设说明（生成注释用）
      col["uploadLabel"] = isNotEmpty(uploadRef["remark"]) ? uploadRef["remark"] : "";
      col["hasUploadLabel"] = isNotEmpty(uploadRef["remark"]);
      // remove 后写回的表达式：多图=剩余数组映射，单图=空字符串
      if (upMulti) {
        col["uploadRemoveValueExpr"] = rawCol.dataName + "FileList.map((f: any) => f.url)";
      } else {
        col["uploadRemoveValueExpr"] = "''";
      }
      // 附加 form 参数片段：fd.append('type', 0);（数字字面量不加引号，字符串加引号）
      let paramsArr: Object[] = [];
      if (uploadRef["params"] != null) {
        paramsArr = uploadRef["params"];
      }
      let paramsStr = "";
      let pLen = paramsArr.length;
      for (let pi = 0; pi < pLen; pi = pi + 1) {
        let p: Object = paramsArr[pi];
        if (!isNotEmpty(p.name)) {
          continue;
        }
        let lit: String = "";
        if (p.valueType == "number" && isNumericStr(p.value)) {
          lit = p.value;
        } else {
          lit = "'" + escapeJsStr(p.value) + "'";
        }
        paramsStr = paramsStr + "    fd.append('" + escapeJsStr(p.name) + "', " + lit + ");\n";
      }
      col["uploadParamsStr"] = paramsStr;
      // 响应提取路径：点分段 → res?.data?.url 可选链（不合法段名时 buildResChain 回退默认）
      col["uploadResChain"] = buildResChain(uploadRef["responsePath"]);
    }

    // 样式特定配置值
    col["placeholder"] = rawCol.placeholder;
    col["maxlength"] = rawCol.maxlength;
    col["minValue"] = rawCol.minValue;
    col["maxValue"] = rawCol.maxValue;
    col["precision"] = rawCol.precision;
    col["dateFormat"] = rawCol.dateFormat;
    col["textareaRows"] = rawCol.textareaRows;

    // 通用配置（3-1~3-4）
    col["required"] = rawCol.required;
    col["columnWidth"] = rawCol.columnWidth;
    col["columnFixed"] = rawCol.columnFixed;
    col["formatter"] = rawCol.formatter;
    col["formSpan"] = rawCol.formSpan;

    // 表格列显示样式（3-5）
    col["displayType"] = rawCol.displayType;
    col["boolTrueText"] = rawCol.boolTrueText;
    col["boolFalseText"] = rawCol.boolFalseText;
    // 显示样式标记（基于 displayType，与 isSwitch 互斥）
    let isMoneyDisplay = false;
    let isTagDisplay = false;
    let isBooleanDisplay = false;
    let isImageDisplay = false;
    let isSelectDisplay = false;
    let hasDisplayType = false;
    if (!isSwitch) {
      isMoneyDisplay = (rawCol.displayType == "money");
      isTagDisplay = (rawCol.displayType == "tag");
      isBooleanDisplay = (rawCol.displayType == "boolean");
      isImageDisplay = (rawCol.displayType == "image");
      // 下拉框显示：列表单元格按数据源把值映射为文字（数据源与编辑/查询共享）
      isSelectDisplay = (rawCol.displayType == "select");
      hasDisplayType = isNotEmpty(rawCol.displayType);
    }
    col["isMoneyDisplay"] = isMoneyDisplay;
    col["isTagDisplay"] = isTagDisplay;
    col["isBooleanDisplay"] = isBooleanDisplay;
    col["isImageDisplay"] = isImageDisplay;
    col["isSelectDisplay"] = isSelectDisplay;
    col["hasDisplayType"] = hasDisplayType;

    // tagItems 转换为模板友好的格式（数组 + 映射字符串）
    let rawTagItems: Object[] = [];
    if (rawCol.tagItems != null) {
      rawTagItems = rawCol.tagItems;
    }
    let tagItemsList: Object[] = [];
    let tagItemsMapStr = "{";
    let tagItemsMapFirst = true;
    let rawTagItemsLen = rawTagItems.length;
    for (let ti = 0; ti < rawTagItemsLen; ti = ti + 1) {
      let rawTi: Object = rawTagItems[ti];
      let ti2: Object = {};
      ti2["value"] = rawTi.value;
      ti2["text"] = rawTi.text;
      ti2["color"] = rawTi.color;
      // 转义后的值（供模板中单引号字符串使用）
      ti2["valueEsc"] = escapeJsStr(rawTi.value);
      ti2["textEsc"] = escapeJsStr(rawTi.text);
      tagItemsList.push(ti2);
      // 构建 JS 对象映射字符串: {"0":{text:"关闭",color:"info"},...}
      if (!tagItemsMapFirst) {
        tagItemsMapStr = tagItemsMapStr + ", ";
      }
      let escVal = escapeJsStr(rawTi.value);
      let escText = escapeJsStr(rawTi.text);
      let escColor = escapeJsStr(rawTi.color);
      tagItemsMapStr = tagItemsMapStr + "'" + escVal + "': { text: '" + escText + "', color: '" + escColor + "' }";
      tagItemsMapFirst = false;
    }
    tagItemsMapStr = tagItemsMapStr + "}";
    col["tagItems"] = tagItemsList;
    col["tagItemsMapStr"] = tagItemsMapStr;
    col["hasTagItems"] = (tagItemsList.length > 0);

    // 通用配置（3-6）
    col["defaultValue"] = rawCol.defaultValue;
    col["defaultSort"] = rawCol.defaultSort;
    col["hasDefaultValue"] = isNotEmpty(rawCol.defaultValue);
    col["hasDefaultSort"] = isNotEmpty(rawCol.defaultSort);
    // 数值类型默认值不加引号，其它类型加引号（避免 InputNumber 收到字符串）
    if (isNotEmpty(rawCol.defaultValue)) {
      if (rawCol.editStyle == "int" || rawCol.editStyle == "float" || rawCol.editStyle == "money") {
        col["defaultValueLiteral"] = rawCol.defaultValue;
      } else {
        col["defaultValueLiteral"] = "'" + escapeJsStr(rawCol.defaultValue) + "'";
      }
    }

    // 预计算布尔标记（避免模板中做字符串比较）
    col["hasPlaceholder"] = isNotEmpty(rawCol.placeholder);
    col["hasMaxlength"] = (rawCol.maxlength > 0);
    col["hasMinValue"] = (rawCol.minValue != null && rawCol.minValue != 0);
    col["hasMaxValue"] = (rawCol.maxValue != null && rawCol.maxValue != 0);
    col["hasDateFormat"] = isNotEmpty(rawCol.dateFormat);
    col["hasColumnWidth"] = (rawCol.columnWidth > 0);
    col["hasColumnFixed"] = isNotEmpty(rawCol.columnFixed);
    col["hasFormatter"] = isNotEmpty(rawCol.formatter);
    col["isFormatterDate"] = (rawCol.formatter == "date");
    col["isFormatterStatus"] = (rawCol.formatter == "status");
    col["isFormatterCurrency"] = (rawCol.formatter == "currency");
    // 表单栅格：整行(24)/三分之一(8) 显式输出 colProps；半行(12) 为框架默认，无需输出
    col["hasFormSpan"] = (rawCol.formSpan != null && rawCol.formSpan != 12);
    columns.push(col);
  }
  return columns;
}

// ---------------------------------------------------------------------------
// 3) 加工查询字段数据 → 模板友好查询字段数组
// ---------------------------------------------------------------------------
export function processQueryFields(rawQueryFields: Object[], columnMap: Object): Object[] {
  let queryFields: Object[] = [];
  let rawQfLen = rawQueryFields.length;
  for (let i = 0; i < rawQfLen; i = i + 1) {
    let rawQf: Object = rawQueryFields[i];
    let qf: Object = {};
    qf["displayName"] = rawQf.displayName;
    qf["dataName"] = rawQf.dataName;

    // 判断是否为远程下拉框
    let isSelect = false;
    if (rawQf.inputStyle == "select") {
      isSelect = true;
    }
    qf["isSelect"] = isSelect;
    qf["selectUrl"] = rawQf.selectUrl;
    qf["selectValueField"] = rawQf.selectValueField;
    qf["selectLabelField"] = rawQf.selectLabelField;
    // 查询分页加载配置（仅 select 样式有意义）
    qf["selectPaged"] = (rawQf.selectPaged == true);
    qf["selectPageKey"] = isNotEmpty(rawQf.selectPageKey) ? rawQf.selectPageKey : "page";
    qf["selectPageSizeKey"] = isNotEmpty(rawQf.selectPageSizeKey) ? rawQf.selectPageSizeKey : "pageSize";
    qf["selectPageSize"] = (rawQf.selectPageSize != null) ? rawQf.selectPageSize : 20;
    qf["selectSearchTitle"] = rawQf.selectSearchTitle || "";
    qf["selectSearchField"] = rawQf.selectSearchField || "";
    qf["selectMethod"] = isNotEmpty(rawQf.selectMethod) ? rawQf.selectMethod : "POST";

    // ── 下拉接口函数推导（查询字段复用列表列的数据源，三处共享）──
    //   列已配置下拉数据源（selectApiName 非空）→ 直接复用列的函数/字段；
    //   否则从查询字段自己的 selectUrl 推导（旧数据兼容，函数在本页 api）
    let qfApiName: String = "";
    let qfHasSourceRef: Bool = false;
    let qfSourceRefFile: String = "";
    let srcCol: Object = null;
    if (columnMap != null) {
      srcCol = columnMap[rawQf.dataName];
    }
    if (srcCol != null && srcCol["selectApiName"] != "") {
      qfApiName = srcCol["selectApiName"];
      qf["selectUrl"] = srcCol["selectUrl"];
      qf["selectValueField"] = srcCol["selectValueField"];
      qf["selectLabelField"] = srcCol["selectLabelField"];
      qfHasSourceRef = (srcCol["hasSourceRef"] == true);
      if (qfHasSourceRef) {
        qfSourceRefFile = srcCol["sourceRefFile"];
      }
    } else if (isSelect && isNotEmpty(rawQf.selectUrl)) {
      let selUrlParts: String[] = rawQf.selectUrl.split("/");
      let selUrlPartsLen: Int = selUrlParts.length;
      for (let si = selUrlPartsLen - 1; si >= 0; si = si - 1) {
        if (selUrlParts[si] != "") {
          qfApiName = selUrlParts[si];
          break;
        }
      }
    }
    qf["selectApiName"] = qfApiName;
    qf["hasSourceRef"] = qfHasSourceRef;
    qf["sourceRefFile"] = qfSourceRefFile;

    let comp = "Input";
    if (isSelect) {
      comp = "Select";
    } else {
      if (rawQf.inputStyle == "date") {
        comp = "DatePicker";
      }
    }
    qf["component"] = comp;

    // 样式标记
    qf["isDate"] = (rawQf.inputStyle == "date");

    // 查询关系：范围（生成开始/结束两个控件）
    let isRange = (rawQf.relation == "range");
    qf["isRange"] = isRange;
    let rangeComp: String = "Input";
    if (rawQf.inputStyle == "date") {
      rangeComp = "DatePicker";
    }
    qf["rangeComp"] = rangeComp;

    // 样式特定配置值
    qf["placeholder"] = rawQf.placeholder;
    qf["dateFormat"] = rawQf.dateFormat;

    // 预计算布尔标记
    qf["hasPlaceholder"] = isNotEmpty(rawQf.placeholder);
    qf["hasDateFormat"] = isNotEmpty(rawQf.dateFormat);

    queryFields.push(qf);
  }
  return queryFields;
}

// ---------------------------------------------------------------------------
// 4) 加工自定义按钮数据 → 按钮数组 + 行为分组 + 额外 API
//    返回对象包含：
//      buttons / rowButtons / toolbarButtons / ajaxButtons / confirmButtons /
//      dialogButtons / linkButtons / extraApiList
// ---------------------------------------------------------------------------
export function processButtons(rawButtons: Object[]): Object {
  let buttons: Object[] = [];
  let rowButtons: Object[] = [];
  let toolbarButtons: Object[] = [];
  let ajaxButtons: Object[] = [];
  let confirmButtons: Object[] = [];
  let dialogButtons: Object[] = [];
  let linkButtons: Object[] = [];
  // 收集自定义按钮需要的额外 API（Ajax/Confirm → apiName，Dialog → dialogApi）
  let extraApiSet: Object = {};
  let extraApiList: String[] = [];
  let rawBtnsLen = rawButtons.length;
  for (let i = 0; i < rawBtnsLen; i = i + 1) {
    let rawBtn: Object = rawButtons[i];
    let actionType: String = rawBtn.actionType;
    // Ajax / Confirm 行为使用 apiName
    if (actionType == "ajax" || actionType == "confirm") {
      let api: String = rawBtn.apiName;
      if (api != "" && extraApiSet[api] == null) {
        extraApiSet[api] = true;
        extraApiList.push(api);
      }
    }
    // Dialog 行为使用 dialogApi
    if (actionType == "dialog") {
      let api: String = rawBtn.dialogApi;
      if (api != "" && extraApiSet[api] == null) {
        extraApiSet[api] = true;
        extraApiList.push(api);
      }
    }

    let btn: Object = {};
    btn["key"] = rawBtn.actionKey;
    btn["label"] = rawBtn.label;
    btn["icon"] = rawBtn.icon;
    btn["type"] = rawBtn.buttonType;
    btn["position"] = rawBtn.position;
    btn["actionType"] = rawBtn.actionType;
    btn["apiName"] = rawBtn.apiName;
    btn["confirmText"] = rawBtn.confirmText;
    btn["dialogTitle"] = rawBtn.dialogTitle;
    btn["dialogApi"] = rawBtn.dialogApi;
    // Dialog 行为：加工 dialogFields（添加布尔标记，供模板生成 formSchema 用）
    let processedDialogFields: Object[] = [];
    let rawDialogFields: Object[] = [];
    if (rawBtn.dialogFields != null) {
      rawDialogFields = rawBtn.dialogFields;
    }
    let rawDialogFieldsLen = rawDialogFields.length;
    for (let j = 0; j < rawDialogFieldsLen; j = j + 1) {
      let rawF: Object = rawDialogFields[j];
      let f: Object = {};
      f["fieldName"] = rawF.fieldName;
      f["label"] = rawF.label;
      f["editStyle"] = rawF.editStyle;
      f["required"] = rawF.required;
      // 样式标记
      f["isText"] = (rawF.editStyle == "text");
      f["isInt"] = (rawF.editStyle == "int");
      f["isFloat"] = (rawF.editStyle == "float");
      f["isDate"] = (rawF.editStyle == "date");
      f["isSelect"] = (rawF.editStyle == "select");
      f["isTextArea"] = (rawF.editStyle == "textarea");
      // 样式特定配置值
      f["placeholder"] = rawF.placeholder;
      f["maxlength"] = rawF.maxlength;
      f["minValue"] = rawF.minValue;
      f["maxValue"] = rawF.maxValue;
      f["precision"] = rawF.precision;
      f["dateFormat"] = rawF.dateFormat;
      f["textareaRows"] = rawF.textareaRows;
      f["selectUrl"] = rawF.selectUrl;
      f["selectValueField"] = rawF.selectValueField;
      f["selectLabelField"] = rawF.selectLabelField;
      // 查询分页加载配置（仅 select 样式有意义）
      f["selectPaged"] = (rawF.selectPaged == true);
      f["selectPageKey"] = isNotEmpty(rawF.selectPageKey) ? rawF.selectPageKey : "page";
      f["selectPageSizeKey"] = isNotEmpty(rawF.selectPageSizeKey) ? rawF.selectPageSizeKey : "pageSize";
      f["selectPageSize"] = (rawF.selectPageSize != null) ? rawF.selectPageSize : 20;
      f["selectSearchTitle"] = rawF.selectSearchTitle || "";
      f["selectSearchField"] = rawF.selectSearchField || "";
      f["selectMethod"] = isNotEmpty(rawF.selectMethod) ? rawF.selectMethod : "POST";
      // 预计算布尔标记（避免模板中做字符串/数值比较）
      f["hasPlaceholder"] = (rawF.placeholder != "");
      f["hasMaxlength"] = (rawF.maxlength > 0);
      f["hasMinValue"] = (rawF.minValue != 0);
      f["hasMaxValue"] = (rawF.maxValue != 0);
      f["hasDateFormat"] = (rawF.dateFormat != "");

      // 预计算 Vue 组件名（模板直接引用，避免在模板中做条件判断）
      let comp = "Input";
      if (f["isSelect"]) {
        comp = "ApiSelect";
      }
      if (f["isInt"]) {
        comp = "InputNumber";
      }
      if (f["isFloat"]) {
        comp = "InputNumber";
      }
      if (f["isDate"]) {
        comp = "DatePicker";
      }
      f["component"] = comp;

      // 预计算 componentProps 字符串（模板直接插入，避免复杂条件渲染）
      let propsStr = "";
      if (f["isSelect"]) {
        propsStr = "url: '" + f["selectUrl"] + "', valueField: '" +
                   f["selectValueField"] + "', labelField: '" + f["selectLabelField"] +
                   "', method: '" + f["selectMethod"] + "'";
        // 查询分页加载：追加页码/页大小参数
        if (f["selectPaged"]) {
          propsStr += ", pageKey: '" + f["selectPageKey"] + "', pageSizeKey: '" +
                      f["selectPageSizeKey"] + "', pageSize: " + f["selectPageSize"];
          if (f["selectSearchTitle"]) {
            propsStr += ", searchTitle: '" + f["selectSearchTitle"] + "'";
          }
          if (f["selectSearchField"]) {
            propsStr += ", searchField: '" + f["selectSearchField"] + "'";
          }
        }
      }
      if (f["isDate"]) {
        if (f["hasDateFormat"]) {
          propsStr = "type: '" + f["dateFormat"] + "'";
        }
      }
      if (f["isTextArea"]) {
        propsStr = "type: 'textarea', rows: " + f["textareaRows"];
        if (f["hasPlaceholder"]) {
          propsStr = propsStr + ", placeholder: '" + f["placeholder"] + "'";
        }
      }
      if (f["isInt"]) {
        if (f["hasMinValue"]) {
          propsStr = "min: " + f["minValue"];
        }
        if (f["hasMaxValue"]) {
          if (propsStr != "") {
            propsStr = propsStr + ", ";
          }
          propsStr = propsStr + "max: " + f["maxValue"];
        }
      }
      if (f["isFloat"]) {
        propsStr = "precision: " + f["precision"];
        if (f["hasMinValue"]) {
          propsStr = propsStr + ", min: " + f["minValue"];
        }
        if (f["hasMaxValue"]) {
          propsStr = propsStr + ", max: " + f["maxValue"];
        }
      }
      if (f["isText"]) {
        if (f["hasPlaceholder"]) {
          propsStr = "placeholder: '" + f["placeholder"] + "'";
        }
        if (f["hasMaxlength"]) {
          if (propsStr != "") {
            propsStr = propsStr + ", ";
          }
          propsStr = propsStr + "maxlength: " + f["maxlength"];
        }
      }
      f["componentPropsStr"] = propsStr;
      f["hasProps"] = (propsStr != "");
      if (f["required"]) {
        f["requiredStr"] = ",\n    required: true";
      } else {
        f["requiredStr"] = "";
      }

      processedDialogFields.push(f);
    }
    btn["dialogFields"] = processedDialogFields;
    btn["linkPath"] = rawBtn.linkPath;

    // 预计算布尔标记（避免模板中做字符串比较）
    let isRow = (rawBtn.position == "row");
    let isToolbar = (rawBtn.position == "toolbar");
    let isAjax = (rawBtn.actionType == "ajax");
    let isConfirm = (rawBtn.actionType == "confirm");
    let isDialog = (rawBtn.actionType == "dialog");
    let isLink = (rawBtn.actionType == "link");
    btn["isRow"] = isRow;
    btn["isToolbar"] = isToolbar;
    btn["isAjax"] = isAjax;
    btn["isConfirm"] = isConfirm;
    btn["isDialog"] = isDialog;
    btn["isLink"] = isLink;
    btn["hasIcon"] = (rawBtn.icon != "");
    btn["hasType"] = (rawBtn.buttonType != "");

    buttons.push(btn);
    // 按位置分组
    if (isRow) {
      rowButtons.push(btn);
    }
    if (isToolbar) {
      toolbarButtons.push(btn);
    }
    // 按行为分组
    if (isAjax) {
      ajaxButtons.push(btn);
    }
    if (isConfirm) {
      confirmButtons.push(btn);
    }
    if (isDialog) {
      dialogButtons.push(btn);
    }
    if (isLink) {
      linkButtons.push(btn);
    }
  }
  return {
    buttons: buttons,
    rowButtons: rowButtons,
    toolbarButtons: toolbarButtons,
    ajaxButtons: ajaxButtons,
    confirmButtons: confirmButtons,
    dialogButtons: dialogButtons,
    linkButtons: linkButtons,
    extraApiList: extraApiList
  };
}

// ---------------------------------------------------------------------------
// 5) 拼接 API 导入列表字符串
//    基础：queryApi（必含），noDelete/noEdit 时排除 deleteApi/updateApi
//    追加：自定义按钮的额外 API（extraApiList）
// ---------------------------------------------------------------------------
export function buildApiImports(queryApi: String, deleteApi: String, updateApi: String,
                         noDelete: Bool, noEdit: Bool, extraApiList: String[]): String {
  let apiImports = queryApi;
  if (!noDelete) {
    apiImports = apiImports + ", " + deleteApi;
  }
  if (!noEdit) {
    apiImports = apiImports + ", " + updateApi;
  }
  let extraLen = extraApiList.length;
  for (let i = 0; i < extraLen; i = i + 1) {
    apiImports = apiImports + ", " + extraApiList[i];
  }
  return apiImports;
}

// ---------------------------------------------------------------------------
// 5-1c) 生成静态选项的 value 字面量
//   valueType 由 .jsonsource 配置界面选择（""=字符串 / "number"=数字）：
//     数字类型 → 数字字面量（如 1），保持与布尔开关内联 options（value: 0/1
//     数字）提交类型一致，避免表单显示成 0/1 而非文字；
//     字符串/未配置 → 带单引号的字符串字面量（如 '1' / 'abc'）
// ---------------------------------------------------------------------------
export function makeValueLiteral(v: Any, vt: Any): String {
  if (vt == "number") {
    return v;
  }
  return "'" + escapeJsStr(v) + "'";
}

// ---------------------------------------------------------------------------
// 5-1) 数据源 url → 请求函数名（全路径驼峰）
//   "vipprice/getTimeTypeRecords" → "vippriceGetTimeTypeRecords"（跨模块不冲突）
//   "getTimeTypeRecords"          → "getTimeTypeRecords"（单段与原 selectApiName 规则一致）
//   source.tpl 的函数生成与 jsonvue 引用列的函数调用统一使用本函数，保证一致
// ---------------------------------------------------------------------------
export function urlToFuncName(url: String): String {
  if (url == null || url == "") {
    return "";
  }
  let norm = url.replace("\\", "/");
  let parts: String[] = norm.split("/");
  let res = "";
  let first = true;
  let partsLen = parts.length;
  for (let i = 0; i < partsLen; i = i + 1) {
    let seg: String = parts[i];
    if (seg == "") {
      continue;
    }
    if (first) {
      res = snakeToCamel(seg);
      first = false;
    } else {
      res = res + snakeToPascal(seg);
    }
  }
  return res;
}

// ---------------------------------------------------------------------------
// 5-2) 加工 .jsonsource 数据源数组 → 模板友好数据源数组
//   统一推导每个数据源的函数名（funcName），source.tpl 生成与 jsonvue 引用共用
// ---------------------------------------------------------------------------
export function processSources(rawSources: Object[], sourceName: String): Object[] {
  let sources: Object[] = [];
  let nameSet: Object = {};
  let staticIndex = 0;
  let sourceCamel = snakeToCamel(sourceName);
  let len = rawSources.length;
  for (let i = 0; i < len; i = i + 1) {
    let raw: Object = rawSources[i];
    let src: Object = {};
    // 说明（空则按序号命名）
    let remark: String = raw.remark;
    if (remark == null || remark == "") {
      remark = "数据源" + (i + 1);
    }
    src["remark"] = remark;
    // 类型
    let isStatic = (raw.type == "static");
    src["isStatic"] = isStatic;
    src["isDynamic"] = !isStatic;
    // 请求方式（动态）
    let method: String = raw.method;
    if (method == null || method == "") {
      method = "POST";
    }
    src["methodLower"] = method.toLowerCase();
    // 请求地址（补前导斜杠）
    let url: String = raw.url;
    if (url == null) {
      url = "";
    }
    if (url != "" && !url.startsWith("/")) {
      url = "/" + url;
    }
    src["url"] = url;
    // 显示/实际值字段（供 jsonvue 引用列在未覆盖时回填）
    src["labelField"] = raw.labelField;
    src["valueField"] = raw.valueField;
    // 静态选项
    let items: Object[] = [];
    if (raw.options != null) {
      let rawOpts: Object[] = raw.options;
      let olen = rawOpts.length;
      for (let j = 0; j < olen; j = j + 1) {
        items.push({
          labelEsc: escapeJsStr(rawOpts[j].label),
          valueLiteral: makeValueLiteral(rawOpts[j].value, rawOpts[j].valueType)
        });
      }
    }
    src["items"] = items;
    src["hasItems"] = (items.length > 0);
    // 列表页下拉框显示的 tag 样式映射（值→success/primary/...）
    let tagsList: Object[] = [];
    if (raw.tags != null) {
      let rawTags: Object[] = raw.tags;
      let tlen = rawTags.length;
      for (let tj = 0; tj < tlen; tj = tj + 1) {
        let rawTag: Object = rawTags[tj];
        tagsList.push({
          value: escapeJsStr(rawTag.value),
          color: escapeJsStr(rawTag.color)
        });
      }
    }
    src["tagsList"] = tagsList;
    src["hasTags"] = (tagsList.length > 0);
    // id 与来源文件基名（jsonvue 引用查找表使用）
    src["id"] = raw.id;
    src["sourceName"] = sourceName;
    // 函数名：动态取 url 全路径驼峰（跨模块不冲突）；
    // 静态取 文件名驼峰 + Static + url名（如 booleanStaticEnableState）；
    // 为空或重复时兜底去重
    let funcName: String = "";
    if (isStatic) {
      // 静态数据源函数名 = 文件名Static + url名（url 由配置界面必填），
      // url 名转帕斯卡（首字母大写），如 boolean.jsonsource 的 url=enableState
      // → booleanStaticEnableState；旧数据无 url 时退回序号（兼容）
      staticIndex = staticIndex + 1;
      let urlName = urlToFuncName(raw.url);
      if (urlName != "") {
        urlName = urlName.substring(0, 1).toUpperCase() + urlName.substring(1);
        funcName = sourceCamel + "Static" + urlName;
      } else {
        funcName = sourceCamel + "Static" + staticIndex;
      }
    } else {
      funcName = urlToFuncName(raw.url);
    }
    if (funcName == "") {
      funcName = sourceCamel + "Source" + (i + 1);
    }
    if (nameSet[funcName] != null) {
      let n = 2;
      while (nameSet[funcName + n] != null) {
        n = n + 1;
      }
      funcName = funcName + n;
    }
    nameSet[funcName] = true;
    src["funcName"] = funcName;
    sources.push(src);
  }
  return sources;
}

// ---------------------------------------------------------------------------
// 5-3) 汇总加工：把单个 .jsonsource 配置转换为 source.tpl 的 tplData
// ---------------------------------------------------------------------------
export function buildSourceTplData(json: Object, file: String): Object {
  let sourceName = basename(file);  // .jsonsource 文件基名（import 路径使用）
  let rawSources: Object[] = [];
  if (json != null && json.sources != null) {
    rawSources = json.sources;
  }
  let sources = processSources(rawSources, sourceName);
  let tplData: Object = {};
  tplData["sourceName"] = sourceName;          // ${sourceName} 文件基名
  tplData["sources"] = sources;                // ${each src in sources} 数据源循环
  tplData["hasSources"] = (sources.length > 0);
  return tplData;
}

// ============================================================================
// 6) 汇总加工：把单个 .jsonvue 配置转换为完整 tplData
// ----------------------------------------------------------------------------
// 输入：json   - readJson(file) 返回的 .jsonvue 配置对象
//       file   - 配置文件绝对路径
// 输出：完整 tplData 对象（含页面路径、API 导入、列、查询字段、按钮及各派生标记）
// ============================================================================

// 从来源 URL 推导接口基名：取 URL 第一个路径段。
// 例如 "systemtask/selectByIn" → "systemtask"
export function deriveApiBaseFromUrl(dataUrl: String): String {
  if (dataUrl == null || dataUrl == "") {
    return "";
  }
  let parts = dataUrl.split("/");
  let partsLen = parts.length;
  for (let i = 0; i < partsLen; i = i + 1) {
    if (parts[i] != "") {
      return parts[i];
    }
  }
  return "";
}

export function buildAdminTplData(json: Object, file: String, suffixes: Object,
                                  sourceFiles: String[], uploadFiles: String[]): Object {
  // ── meta 与原始数据 ──────────────────────────────────────────────
  let meta: Object = json.meta;
  let rawColumns: Object[] = json.columns;
  let rawQueryFields: Object[] = json.queryFields;
  if (rawQueryFields == null) {
    rawQueryFields = [];
  }
  // buttons 可能为空（旧 .jsonvue 文件没有此字段），需防御性处理
  let rawButtons: Object[] = [];
  if (json.buttons != null) {
    rawButtons = json.buttons;
  }

  // ── 页面路径 ────────────────────────────────────────────────────
  let page = derivePage(file);

  // ── API 配置 ────────────────────────────────────────────────────
  // 接口函数名直接取自 meta（jsonvue 中显式配置，可靠）
  // 备选：meta 为空时由来源 URL 推导（"systemtask/selectByIn" → systemtaskSelect）
  let apiBase = deriveApiBaseFromUrl(meta.dataUrl);
  let queryApi: String = meta.queryApi;
  let updateApi: String = meta.updateApi;
  let deleteApi: String = meta.deleteApi;
  if (queryApi == "" || queryApi == null) { queryApi = apiBase + "Select"; }
  if (updateApi == "" || updateApi == null) { updateApi = apiBase + "Update"; }
  if (deleteApi == "" || deleteApi == null) { deleteApi = apiBase + "Delete"; }
  let noDelete: Bool = meta.noDelete;
  let noEdit: Bool = meta.noEdit;
  let noDetail: Bool = meta.noDetail;
  // API 请求地址（供 api.tpl 生成 .ts 使用）："/" + 接口基名 + "/" + 请求后缀
  // 请求后缀由 main_admin.ac 传入（apiSelect/apiUpdate/apiDelete），缺省为默认值
  let selSuffix: String = "selectByIn";
  let updSuffix: String = "update";
  let delSuffix: String = "delete";
  if (suffixes != null) {
    if (suffixes["select"] != "" && suffixes["select"] != null) { selSuffix = suffixes["select"]; }
    if (suffixes["update"] != "" && suffixes["update"] != null) { updSuffix = suffixes["update"]; }
    if (suffixes["delete"] != "" && suffixes["delete"] != null) { delSuffix = suffixes["delete"]; }
  }
  let selectUrl = "/" + apiBase + "/" + selSuffix;
  let updateUrl = "/" + apiBase + "/" + updSuffix;
  let deleteUrl = "/" + apiBase + "/" + delSuffix;

  // ── 数据源引用查找表 ────────────────────────────────────────────
  // 收集引用 .jsonsource 数据源的列，读取对应文件建立 "文件路径#数据源id" 映射。
  // 数据源函数名由 processSources 统一推导，与 source.tpl 生成保持一致
  let sourceMap: Object = {};
  if (rawColumns != null) {
    let sourceFileSet: Object = {};
    let preLen = rawColumns.length;
    for (let i = 0; i < preLen; i = i + 1) {
      // 同时收集 select 引用（selectSourceFile）与布尔开关引用（boolSourceFile）
      let sfList: String[] = [];
      if (isNotEmpty(rawColumns[i].selectSourceFile)) {
        sfList.push(rawColumns[i].selectSourceFile);
      }
      if (isNotEmpty(rawColumns[i].boolSourceFile)) {
        sfList.push(rawColumns[i].boolSourceFile);
      }
      let sfLen = sfList.length;
      for (let k = 0; k < sfLen; k = k + 1) {
        let sfPre: String = sfList[k];
        if (sourceFileSet[sfPre] != null) {
          continue;
        }
        sourceFileSet[sfPre] = true;
        // 引用路径匹配：jsonvue 里存的是选择时的绝对路径，文件被移动后会过期。
        // 勾选的 .jsonsource 文件都在脚本同父路径下，按文件名匹配真实路径；
        // 未匹配到时退回 jsonvue 里存的路径
        let readPath: String = sfPre;
        if (sourceFiles != null) {
          let sfBase: String = basename(sfPre);
          let sfsLen = sourceFiles.length;
          for (let m = 0; m < sfsLen; m = m + 1) {
            if (basename(sourceFiles[m]) == sfBase) {
              readPath = sourceFiles[m];
              break;
            }
          }
        }
        let srcJson: Object = readJson(readPath);
        let rawSources: Object[] = [];
        if (srcJson != null && srcJson.sources != null) {
          rawSources = srcJson.sources;
        }
        let processed = processSources(rawSources, basename(sfPre));
        let procLen = processed.length;
        for (let j = 0; j < procLen; j = j + 1) {
          sourceMap[sfPre + "#" + processed[j]["id"]] = processed[j];
        }
      }
    }
  }

  // ── 上传预设引用查找表 ──────────────────────────────────────────
  // 收集引用 .jsonupload 上传预设的列（uploadSourceFile），读取对应文件建立
  // "文件路径#预设id" 映射。上传预设字段以 .jsonupload 文件的最新配置为准
  // （jsonvue 里可能保存的是旧值）
  let uploadMap: Object = {};
  if (rawColumns != null) {
    let uploadFileSet: Object = {};
    let rawColsLen2 = rawColumns.length;
    for (let i = 0; i < rawColsLen2; i = i + 1) {
      if (!isNotEmpty(rawColumns[i].uploadSourceFile)) {
        continue;
      }
      let ufPre: String = rawColumns[i].uploadSourceFile;
      if (uploadFileSet[ufPre] != null) {
        continue;
      }
      uploadFileSet[ufPre] = true;
      // 引用路径匹配：jsonvue 里存的是选择时的绝对路径，文件被移动后会过期。
      // 勾选的 .jsonupload 文件都在脚本同父路径下，按文件名匹配真实路径；
      // 未匹配到时退回 jsonvue 里存的路径
      let upReadPath: String = ufPre;
      if (uploadFiles != null) {
        let ufBase: String = basename(ufPre);
        let ufsLen = uploadFiles.length;
        for (let m = 0; m < ufsLen; m = m + 1) {
          if (basename(uploadFiles[m]) == ufBase) {
            upReadPath = uploadFiles[m];
            break;
          }
        }
      }
      let upJson: Object = readJson(upReadPath);
      if (upJson != null && upJson.uploads != null) {
        let rawUploads: Object[] = upJson.uploads;
        let upLen = rawUploads.length;
        for (let j = 0; j < upLen; j = j + 1) {
          uploadMap[ufPre + "#" + rawUploads[j]["id"]] = rawUploads[j];
        }
      }
    }
  }

  // ── 数据加工 ────────────────────────────────────────────────────
  let btnResult = processButtons(rawButtons);
  let apiImports = buildApiImports(queryApi, deleteApi, updateApi, noDelete, noEdit,
                                   btnResult["extraApiList"]);
  let columns = processColumns(rawColumns, sourceMap, uploadMap);
  // 列 dataName → 列 映射（查询字段复用列的下拉数据源时查表用）
  let columnMap: Object = {};
  let colMapLen = columns.length;
  for (let i = 0; i < colMapLen; i = i + 1) {
    columnMap[columns[i]["dataName"]] = columns[i];
  }
  let queryFields = processQueryFields(rawQueryFields, columnMap);

  // ── 下拉框数据接口：汇总各 select 列的接口函数 ───────────────────
  // 手动 url 列：本页 api.tpl 追加生成（selectApiStr）并导入（selectApiImports）。
  // 引用 .jsonsource 列：函数在 source api 文件中（source.tpl 生成），
  // 本页不重复生成，仅按文件分组生成导入行（sourceImportLines）。
  let selectApiStr = "";
  let selectApiNameSet: Object = {};
  let selectApiImports: String = "";
  let selectApiCount = 0;
  let sourceFileMap: Object = {};      // jsonsource 文件基名 → 函数名列表（逗号分隔）
  let sourceFileOrder: String[] = [];  // 文件出现顺序（保证 import 行稳定）
  let sourceNameSet: Object = {};      // 数据源函数名去重（多个列可引用同一数据源）
  // 布尔列引用（index.tpl 使用）：收集 boolean 显示列（开关或纯文本）引用的静态数据源函数
  let boolSourceFileMap: Object = {};
  let boolSourceFileOrder: String[] = [];
  let boolSourceNameSet: Object = {};
  let hasBoolApiColumns = false;       // 是否存在引用静态数据源的布尔开关列
  let hasSelectApiColumns = false;     // 是否存在下拉框显示列（index.tpl 加载选项映射用）
  let colsSelLen = columns.length;
  for (let i = 0; i < colsSelLen; i = i + 1) {
    let colSel: Object = columns[i];
    // 布尔开关引用静态数据源（write.vue 的 optionApi 使用，函数来自 source api）
    let isBoolRef: Bool = (colSel["hasBoolApi"] == true);
    // 下拉框显示列（列表单元格按数据源显示文字，与编辑/查询共享数据源）
    let isSelectDisplayRef: Bool = (colSel["isSelectDisplay"] == true);
    if (!colSel["hasSelectApi"] && !isBoolRef) {
      continue;
    }
    let selName: String = colSel["selectApiName"];
    if (isBoolRef) {
      selName = colSel["boolApiName"];
      hasBoolApiColumns = true;
    }
    if (isSelectDisplayRef) {
      hasSelectApiColumns = true;
    }
    if (colSel["hasSourceRef"] || isBoolRef) {
      // 引用数据源：按文件分组收集 import（函数本体由 source.tpl 生成）
      if (sourceNameSet[selName] == null) {
        sourceNameSet[selName] = true;
        let refBase: String = colSel["sourceRefFile"];
        if (sourceFileMap[refBase] == null) {
          sourceFileMap[refBase] = selName;
          sourceFileOrder.push(refBase);
        } else {
          sourceFileMap[refBase] = sourceFileMap[refBase] + ", " + selName;
        }
      }
      // 布尔/下拉显示列引用额外收集到独立分组（index.tpl 只导入这些函数）
      if ((isBoolRef || isSelectDisplayRef) && boolSourceNameSet[selName] == null) {
        boolSourceNameSet[selName] = true;
        let refBase2: String = colSel["sourceRefFile"];
        if (boolSourceFileMap[refBase2] == null) {
          boolSourceFileMap[refBase2] = selName;
          boolSourceFileOrder.push(refBase2);
        } else {
          boolSourceFileMap[refBase2] = boolSourceFileMap[refBase2] + ", " + selName;
        }
      }
    } else if (selectApiNameSet[selName] == null) {
      selectApiNameSet[selName] = true;
      selectApiCount = selectApiCount + 1;
      if (selectApiImports != "") {
        selectApiImports = selectApiImports + ", ";
      }
      selectApiImports = selectApiImports + selName;
      // 每个接口函数一段（前导空行与删除接口分隔，供 api.tpl 追加）
      selectApiStr = selectApiStr + "\n//查询" + colSel["editName"] +
                     "\nexport const " + selName + " = () => {\n" +
                     "  return request.post({ url: '" + colSel["selectApiUrl"] + "' })\n}";
    }
  }

  // 查询字段下拉引用收集（index.tpl 的 searchSchema optionApi 使用）：
  //   引用 source 文件 → 并入 boolSourceFileMap（index import source api）；
  //   手动 url       → 并入 selectApiImports（index import 本页 api）
  let qfLen2 = queryFields.length;
  for (let i = 0; i < qfLen2; i = i + 1) {
    let qfSel: Object = queryFields[i];
    if (!qfSel["isSelect"] || qfSel["selectApiName"] == "") {
      continue;
    }
    let qfName2: String = qfSel["selectApiName"];
    if (qfSel["hasSourceRef"]) {
      if (boolSourceNameSet[qfName2] == null) {
        boolSourceNameSet[qfName2] = true;
        let refBase3: String = qfSel["sourceRefFile"];
        if (boolSourceFileMap[refBase3] == null) {
          boolSourceFileMap[refBase3] = qfName2;
          boolSourceFileOrder.push(refBase3);
        } else {
          boolSourceFileMap[refBase3] = boolSourceFileMap[refBase3] + ", " + qfName2;
        }
      }
    } else if (selectApiNameSet[qfName2] == null) {
      selectApiNameSet[qfName2] = true;
      selectApiCount = selectApiCount + 1;
      if (selectApiImports != "") {
        selectApiImports = selectApiImports + ", ";
      }
      selectApiImports = selectApiImports + qfName2;
      // 查询字段手动 url 的函数体（供 api.tpl 追加生成）
      let qfUrl2: String = qfSel["selectUrl"];
      if (qfUrl2 != "" && !qfUrl2.startsWith("/")) {
        qfUrl2 = "/" + qfUrl2;
      }
      selectApiStr = selectApiStr + "\n//查询" + qfSel["dataName"] +
                     "\nexport const " + qfName2 + " = () => {\n" +
                     "  return request.post({ url: '" + qfUrl2 + "' })\n}";
    }
  }
  let hasSelectApi = (selectApiCount > 0);

  // 是否存在使用 optionApi 的下拉字段（write.tpl 需 import onceSelect 做并发去重）
  let hasSelectFields = false;
  let hsfLen = columns.length;
  for (let i = 0; i < hsfLen; i = i + 1) {
    let hsfCol: Object = columns[i];
    if (hsfCol["isSelect"] ||
        (hsfCol["isBooleanSwitch"] && hsfCol["hasBoolApi"]) ||
        (hsfCol["isBooleanEdit"] && hsfCol["hasBoolApi"])) {
      hasSelectFields = true;
      break;
    }
  }

  // source api 导入行（每个 .jsonsource 文件一行 import，供 write.tpl 使用）
  let sourceImportLines = "";
  let sfoLen = sourceFileOrder.length;
  for (let i = 0; i < sfoLen; i = i + 1) {
    let fb: String = sourceFileOrder[i];
    if (sourceImportLines != "") {
      sourceImportLines = sourceImportLines + "\n";
    }
    sourceImportLines = sourceImportLines + "import { " + sourceFileMap[fb] +
                        " } from '@/api/source/" + fb + "';";
  }
  let hasSourceImports = (sourceImportLines != "");

  // 布尔/下拉显示列 source api 导入行（index.tpl 使用，只含引用了数据源的开关/下拉显示函数）
  let boolSourceImportLines = "";
  let bsfoLen = boolSourceFileOrder.length;
  for (let i = 0; i < bsfoLen; i = i + 1) {
    let fb: String = boolSourceFileOrder[i];
    if (boolSourceImportLines != "") {
      boolSourceImportLines = boolSourceImportLines + "\n";
    }
    boolSourceImportLines = boolSourceImportLines + "import { " + boolSourceFileMap[fb] +
                            " } from '@/api/source/" + fb + "';";
  }
  let hasBoolSourceImports = (boolSourceImportLines != "");

  let buttons: Object[] = btnResult["buttons"];
  let rowButtons: Object[] = btnResult["rowButtons"];
  let toolbarButtons: Object[] = btnResult["toolbarButtons"];
  let ajaxButtons: Object[] = btnResult["ajaxButtons"];
  let confirmButtons: Object[] = btnResult["confirmButtons"];
  let dialogButtons: Object[] = btnResult["dialogButtons"];
  let linkButtons: Object[] = btnResult["linkButtons"];

  // ── 操作列宽度（每个按钮约 60px，含间距）────────────────────────
  let baseActionCount = 0;
  if (!noDetail) { baseActionCount = baseActionCount + 1; }
  if (!noEdit) { baseActionCount = baseActionCount + 1; }
  if (!noDelete) { baseActionCount = baseActionCount + 1; }
  let actionColumnWidth: Int = (baseActionCount + rowButtons.length) * 60;
  if (actionColumnWidth < 120) {
    actionColumnWidth = 120;  // 最小宽度兜底
  }
  let hasCustomButtons = (buttons.length > 0);

  // ── 检查是否有 tag / image 类型的列（需要导入 ElTag / ElImage）──
  let hasTagColumns = false;
  let hasImageColumns = false;
  let colsLen2 = columns.length;
  for (let i = 0; i < colsLen2; i = i + 1) {
    if (columns[i]["isTagDisplay"]) {
      hasTagColumns = true;
    }
    if (columns[i]["isImageDisplay"]) {
      hasImageColumns = true;
    }
  }
  // 下拉框显示列也可能按数据源 tag 样式用 ElTag 渲染（hasSelectApiColumns 时）
  let needsElTag = (hasTagColumns || hasSelectApiColumns);

  // ── 表格默认排序字段（取第一个配置了 defaultSort 的列）──────────
  let defaultSortField = "";
  let defaultSortOrder = "";
  for (let i = 0; i < colsLen2; i = i + 1) {
    if (columns[i]["hasDefaultSort"]) {
      defaultSortField = columns[i]["dataName"];
      let rawSort: String = columns[i]["defaultSort"];
      if (rawSort == "asc") {
        defaultSortOrder = "ascending";
      } else if (rawSort == "desc") {
        defaultSortOrder = "descending";
      }
      break;
    }
  }
  let hasTableDefaultSort = (defaultSortField != "");

  // ── 是否有列配置了默认值（新增记录时使用）──────────────────────
  let hasDefaultValues = false;
  for (let i = 0; i < colsLen2; i = i + 1) {
    if (columns[i]["hasDefaultValue"]) {
      hasDefaultValues = true;
      break;
    }
  }

  // ── 是否有引用上传预设的图片字段（write.tpl 生成上传组件区）────
  let hasUploadFields = false;
  for (let i = 0; i < colsLen2; i = i + 1) {
    if (columns[i]["hasUpload"] && columns[i]["editVisible"]) {
      hasUploadFields = true;
      break;
    }
  }
  // watch 导入条件：默认值注入或上传字段回显（避免重复 import watch）
  let hasWatch = (hasDefaultValues || hasUploadFields);

  // ── 编辑表单中只读的字段（editEditable=false）──
  // 注：editVisible=false 的字段已由 write.tpl 通过 ${if col.editVisible} 过滤，不再生成，
  //     因此无需 hiddenFields（隐藏字段列表）。
  let disabledFieldsStr = "";
  for (let i = 0; i < colsLen2; i = i + 1) {
    if (!columns[i]["editEditable"]) {
      disabledFieldsStr = disabledFieldsStr + "'" + columns[i]["dataName"] + "', ";
    }
  }
  let hasHiddenFields = false;
  let hasDisabledFields = (disabledFieldsStr != "");

  // ── 注解标题：优先用界面说明（description），为空则回退到页面文件名 ──
  let commentTitle: String = page["pageName"];
  if (meta.description != "" && meta.description != null) {
    commentTitle = meta.description;
  }

  // ── 组装 tplData（模板中的所有 ${变量名} 从这里取值）────────────
  let tplData: Object = {};
  tplData["pagePath"] = page["pagePath"];          // ${pagePath} 输出路径占位
  tplData["apiModule"] = page["apiModule"];        // ${apiModule} API 模块路径
  tplData["pageName"] = page["pageName"];          // ${pageName} jsonvue 文件名（不含扩展名）
  tplData["apiImports"] = apiImports;              // ${apiImports} API 导入列表
  tplData["queryApi"] = queryApi;                  // ${queryApi} 查询接口名
  tplData["deleteApi"] = deleteApi;                // ${deleteApi} 删除接口名
  tplData["updateApi"] = updateApi;                // ${updateApi} 修改接口名
  tplData["apiBase"] = apiBase;                    // ${apiBase} 来源 URL 接口基名
  tplData["selectUrl"] = selectUrl;                // ${selectUrl} 查询请求地址
  tplData["updateUrl"] = updateUrl;                // ${updateUrl} 更新请求地址
  tplData["deleteUrl"] = deleteUrl;                // ${deleteUrl} 删除请求地址
  tplData["commentTitle"] = commentTitle;            // ${commentTitle} 注解标题
  tplData["hasSelectApi"] = hasSelectApi;          // ${if hasSelectApi} 是否有下拉框接口
  tplData["hasSelectFields"] = hasSelectFields;    // ${if hasSelectFields} 是否有 optionApi 下拉字段
  tplData["selectApiStr"] = selectApiStr;          // ${selectApiStr} 下拉框接口函数字符串
  tplData["selectApiImports"] = selectApiImports;  // ${selectApiImports} 下拉框接口导入列表
  tplData["hasSourceImports"] = hasSourceImports;    // ${if hasSourceImports} 是否导入 source api
  tplData["sourceImportLines"] = sourceImportLines;  // ${sourceImportLines} source api 导入行
  // 布尔开关引用静态数据源（index.tpl 使用）
  tplData["hasBoolApiColumns"] = hasBoolApiColumns;  // ${if hasBoolApiColumns} 是否有布尔开关引用数据源
  tplData["hasSelectApiColumns"] = hasSelectApiColumns;  // ${if hasSelectApiColumns} 是否有下拉框显示列
  tplData["boolSourceImportLines"] = boolSourceImportLines;  // ${boolSourceImportLines} 布尔/下拉显示列 source import 行
  tplData["hasBoolSourceImports"] = hasBoolSourceImports;  // ${if hasBoolSourceImports} 是否导入 source api
  tplData["noDelete"] = noDelete;                  // ${if !noDelete} 不可删除
  tplData["noEdit"] = noEdit;                      // ${if !noEdit} 不可编辑
  tplData["noDetail"] = noDetail;                  // ${if !noDetail} 不可查看详情
  tplData["columns"] = columns;                    // ${each col in columns} 列循环
  tplData["queryFields"] = queryFields;            // ${each q in queryFields} 查询字段循环
  // 自定义按钮相关数据
  tplData["hasCustomButtons"] = hasCustomButtons;  // ${if hasCustomButtons} 是否有自定义按钮
  tplData["hasAjaxButtons"] = (ajaxButtons.length > 0);
  tplData["hasConfirmButtons"] = (confirmButtons.length > 0);
  tplData["hasDialogButtons"] = (dialogButtons.length > 0);
  tplData["hasLinkButtons"] = (linkButtons.length > 0);
  tplData["hasTagColumns"] = hasTagColumns;        // ${if hasTagColumns} 需要导入 ElTag
  tplData["needsElTag"] = needsElTag;              // ${if needsElTag} 需要导入 ElTag（tag 显示列或下拉显示列）
  tplData["hasImageColumns"] = hasImageColumns;    // ${if hasImageColumns} 需要导入 ElImage
  tplData["rowButtons"] = rowButtons;              // ${each btn in rowButtons} 行操作列按钮
  tplData["toolbarButtons"] = toolbarButtons;      // ${each btn in toolbarButtons} 顶部工具栏按钮
  tplData["ajaxButtons"] = ajaxButtons;            // Ajax 行为按钮（生成处理函数用）
  tplData["confirmButtons"] = confirmButtons;      // Confirm 行为按钮
  tplData["dialogButtons"] = dialogButtons;        // Dialog 行为按钮
  tplData["linkButtons"] = linkButtons;            // Link 行为按钮
  tplData["actionColumnWidth"] = actionColumnWidth;  // 操作列宽度（自适应）
  // 表格默认排序
  tplData["hasTableDefaultSort"] = hasTableDefaultSort;
  tplData["defaultSortField"] = defaultSortField;
  tplData["defaultSortOrder"] = defaultSortOrder;
  // 新增记录默认值
  tplData["hasDefaultValues"] = hasDefaultValues;
  // 图片上传预设（write.tpl 上传组件区）
  tplData["hasUploadFields"] = hasUploadFields;
  tplData["hasWatch"] = hasWatch;
  // 编辑表单隐藏/只读字段
  tplData["hasHiddenFields"] = hasHiddenFields;
  tplData["hiddenFieldsStr"] = "";
  tplData["hasDisabledFields"] = hasDisabledFields;
  tplData["disabledFieldsStr"] = disabledFieldsStr;

  return tplData;
}