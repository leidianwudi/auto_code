/// @file tool_str.ac — 字符串通用工具函数
/// @brief 供各项目 .ac 脚本复用的字符串处理函数
///
/// 公共工具函数集中存放在本目录（file/tool/），
/// 命名采用 tool_<类别>.ac 的形式。各项目入口脚本通过 import 引用。

/// @brief 转义 JS 字符串中的单引号和反斜杠（用于生成 JS 对象字面量）
/// @param s 原始字符串
/// @return 转义后的字符串（单引号 ' → \'，反斜杠 \ → \\）
export function escapeJsStr(s: String): String {
  if (s == null) {
    return "";
  }
  let result = "";
  let len = s.length;
  for (let i = 0; i < len; i = i + 1) {
    let c = s[i];
    if (c == "'") {
      result = result + "\\'";
    } else if (c == "\\") {
      result = result + "\\\\";
    } else {
      result = result + c;
    }
  }
  return result;
}

/// @brief 首字母大写
/// @param s 原始字符串
/// @return 首字母大写后的字符串（如 "user" → "User"）
export function capitalizeFirst(s: String): String {
  if (s == null || s.length == 0) {
    return s;
  }
  return s[0].toUpperCase() + s.substring(1);
}

/// @brief 下划线命名 → 帕斯卡命名（PascalCase）
/// @param str 下划线字符串，如 "user_role"
/// @return 帕斯卡命名，如 "user_role" → "UserRole"
export function snakeToPascal(str: String): String {
  let arr: String[] = str.split("_");
  let res = "";
  for (let i = 0; i < arr.length; i++) {
    // 每段首字母大写
    res += arr[i].substring(0, 1).toUpperCase() + arr[i].substring(1);
  }
  return res;
}

/// @brief 下划线命名 → 小驼峰命名（camelCase）
/// @param str 下划线字符串，如 "sport_score_type"
/// @return 小驼峰命名，如 "sport_score_type" → "sportScoreType"
export function snakeToCamel(str: String): String {
  let pascal = snakeToPascal(str);
  if (pascal.length == 0) {
    return pascal;
  }
  return pascal.substring(0, 1).toLowerCase() + pascal.substring(1);
}

/// @brief 判断字符串是否为纯数值（整数/小数，可带正负号）
/// @param s 待判断字符串
/// @return 数值字符串返回 true（如 "0"、"1"、"-1.5"），其它（如 "Normal"、""）返回 false
///   用逐字符判断而非 v*1==v：后者对字符串值（如 DB 读出的 "1"）存在
///   Number 与 String 比较类型不匹配的问题，行为不可靠
export function isNumericStr(s: String): Bool {
  if (s == null || s.length == 0) {
    return false;
  }
  let hasDigit = false;
  for (let i = 0; i < s.length; i = i + 1) {
    let c = s[i];
    if (c >= "0" && c <= "9") {
      hasDigit = true;
    } else if (i == 0 && (c == "-" || c == "+")) {
      // 允许首字符为符号
    } else if (c == ".") {
      // 允许小数点
    } else {
      return false;
    }
  }
  return hasDigit;
}