// ============================================================================
// tool_jsontable.ac — jsontable 单表新格式共享辅助（双端生成链共用）
// ----------------------------------------------------------------------------
// 一文件一表改造后，共享 meta 抽到同目录 project.acproj（项目根标记 + meta）；
// main_api.ac / main_admin.ac 经本模块定位项目配置文件。
// ============================================================================

/// 取路径的目录部分（兼容 \ 与 / 分隔；无分隔符返回空串）
export function dirnameOf(path: String): String {
  let idx: Number = path.lastIndexOf("/");
  let bakIdx: Number = path.lastIndexOf("\\");
  if (bakIdx > idx) { idx = bakIdx; }
  if (idx < 0) { return ""; }
  return path.substring(0, idx);
}

/// 从 dir 起向上查找 project.acproj（含 dir 本身，最多 maxUpLevels 级）；
/// 未找到返回 ""
export function findProjPath(dir: String, maxUpLevels: Number): String {
  let cur: String = dir;
  for (let i = 0; i <= maxUpLevels; i = i + 1) {
    let candidate: String = cur + "/project.acproj";
    if (fileExists(candidate)) {
      return candidate;
    }
    if (cur == "" ) { break; }
    // 上一级目录
    let idx: Number = cur.lastIndexOf("/");
    let bakIdx: Number = cur.lastIndexOf("\\");
    if (bakIdx > idx) { idx = bakIdx; }
    if (idx < 0) { break; }
    cur = cur.substring(0, idx);
  }
  return "";
}

/// .jsontable 文件相对扫描根（入口脚本目录）的目录段——「目录结构 = 模块结构」。
/// file 在 baseDir 之下时返回中间目录段（如 "user"、"app/user"，多层全保留）；
/// 不在 baseDir 之下（显式传外部路径）或非法时返回 ""（调用方回退旧缺省）
export function relDirUnder(file: String, baseDir: String): String {
  let f: String = file.replace("\\", "/");
  let idx: Number = f.lastIndexOf("/");
  f = idx < 0 ? "" : f.substring(0, idx);  // 去文件名 → 所在目录
  let b: String = baseDir.replace("\\", "/");
  while (b.endsWith("/") && b.length > 1) { b = b.substring(0, b.length - 1); }
  if (b == "" || f.startsWith(b + "/") == false) { return ""; }
  let rel: String = f.substring(b.length + 1);
  while (rel.startsWith("/")) { rel = rel.substring(1); }
  while (rel.endsWith("/") && rel.length > 1) { rel = rel.substring(0, rel.length - 1); }
  if (rel == "" || rel.indexOf("..") >= 0) { return ""; }
  return rel;
}

/// 收集参与生成的 .jsontable 清单（Go / Admin 两条链的唯一实现）。
/// @param explicit 显式清单（params.jsonTablePaths / jsonTablePath 归并后的数组）：
///                 非空时原样返回——定向再生成只处理指定表，不自动追加基础表
/// @param baseDir  扫描根：缺省 = 入口脚本目录（project.acproj 与入口脚本同目录，
///                 即项目根）。只收集该目录下 tree.config 勾选的 .jsontable
/// 多语言惯例（逐项目识别，无需开关变量）：
///   - 项目根存在 base/base_lang.jsontable → 基础语言表固定参与生成（不依赖勾选），
///     勾选到的同名重复项被排除；判定只看该文件，base/ 目录里放其它表配置不算
///   - 无该文件但表内配了 i18n → 明确报错（多半漏拷 base/，避免基础表静默缺失）
export function collectTablePaths(explicit: String[], baseDir?: String): String[] {
  let files: String[] = [];
  let eLen = explicit.length;
  for (let i = 0; i < eLen; i = i + 1) {
    files.append(explicit[i].replace("\\", "/"));
  }
  if (files.length > 0) { return files; }

  let root: String = (baseDir != null && baseDir != "") ? baseDir : scriptDir();
  root = root.replace("\\", "/");
  let checked: String[] = getCheckedFiles(root);
  let baseLangFile: String = root + "/base/base_lang.jsontable";
  let i18nEnabled: Bool = fileExists(baseLangFile);
  let baseLangName: String = basename(baseLangFile);
  for (f in checked) {
    if (!fileExists(f)) { continue; }
    // 只收表配置；勾选的 .jsonupload/.jsonsource/.jsonvue 由各链按后缀自行收集
    if (!f.endsWith(".jsontable")) { continue; }
    if (i18nEnabled && basename(f) == baseLangName) { continue; }
    files.append(f.replace("\\", "/"));
  }
  if (i18nEnabled) {
    // 基础语言表：后台语言清单 / C端 lang 校验的数据源，基础设施固定参与生成
    files.append(baseLangFile);
    return files;
  }
  // 安全网：表里配了 i18n 却无可用的基础语言表 → 报错终止，避免"只生成了半套"
  for (f in checked) {
    if (!f.endsWith(".jsontable")) { continue; }
    let j: Object = readJson(f);
    if (j == null) { continue; }
    let t: Object = j["table"];
    if (t == null) { continue; }
    assert(t["i18n"] == null,
           "检测到表内 i18n 配置但缺少基础语言表：" + baseLangFile +
           "（应放置该文件，或移除表内 i18n 配置）");
  }
  return files;
}

/// 读取同项目的关联定义及公共枚举上下文；返回清单不能直接用作生成目标。
/// 已选文件优先，其余配置只补充联表、翻译表和公共字典所需的元数据。
export function collectTableContextPaths(selected: String[], projPath: String): String[] {
  let files: String[] = [];
  let seen: Object = {};
  for (path in selected) {
    let normalized: String = path.replace("\\", "/");
    if (seen[normalized] != true) { files.append(normalized); seen[normalized] = true; }
  }
  if (projPath == null || projPath == "") { return files; }
  let root: String = dirnameOf(projPath).replace("\\", "/");
  let relatives: String[] = listFilesDeep(root, ".jsontable");
  for (relative in relatives) {
    let path: String = root + "/" + relative;
    if (seen[path] != true) { files.append(path); seen[path] = true; }
  }
  return files;
}
