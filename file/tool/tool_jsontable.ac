// ============================================================================
// tool_jsontable.ac — jsontable 单表新格式共享辅助（双端生成链共用）
// ----------------------------------------------------------------------------
// 一文件一表改造后，共享 meta 抽到同目录 project.acproj（项目根标记 + meta）；
// main_api.ac / main_admin.ac 经本模块定位项目配置文件。
// ============================================================================

/// 取路径的目录部分（兼容 \ 与 / 分隔；无分隔符返回空串）
export function dirnameOf(path: String): String {
  let idx: Number = path.lastIndexOf("/");
  let bakIdx: Number = path.lastIndexOf("\\");
  if (bakIdx > idx) { idx = bakIdx; }
  if (idx < 0) { return ""; }
  return path.substring(0, idx);
}

/// 从 dir 起向上查找 project.acproj（含 dir 本身，最多 maxUpLevels 级）；
/// 未找到返回 ""
export function findProjPath(dir: String, maxUpLevels: Number): String {
  let cur: String = dir;
  for (let i = 0; i <= maxUpLevels; i = i + 1) {
    let candidate: String = cur + "/project.acproj";
    if (fileExists(candidate)) {
      return candidate;
    }
    if (cur == "" ) { break; }
    // 上一级目录
    let idx: Number = cur.lastIndexOf("/");
    let bakIdx: Number = cur.lastIndexOf("\\");
    if (bakIdx > idx) { idx = bakIdx; }
    if (idx < 0) { break; }
    cur = cur.substring(0, idx);
  }
  return "";
}

/// .jsontable 文件相对扫描根（入口脚本目录）的目录段——「目录结构 = 模块结构」。
/// file 在 baseDir 之下时返回中间目录段（如 "user"、"app/user"，多层全保留）；
/// 不在 baseDir 之下（显式传外部路径）或非法时返回 ""（调用方回退旧缺省）
export function relDirUnder(file: String, baseDir: String): String {
  let f: String = file.replace("\\", "/");
  let idx: Number = f.lastIndexOf("/");
  f = idx < 0 ? "" : f.substring(0, idx);  // 去文件名 → 所在目录
  let b: String = baseDir.replace("\\", "/");
  while (b.endsWith("/") && b.length > 1) { b = b.substring(0, b.length - 1); }
  if (b == "" || f.startsWith(b + "/") == false) { return ""; }
  let rel: String = f.substring(b.length + 1);
  while (rel.startsWith("/")) { rel = rel.substring(1); }
  while (rel.endsWith("/") && rel.length > 1) { rel = rel.substring(0, rel.length - 1); }
  if (rel == "" || rel.indexOf("..") >= 0) { return ""; }
  return rel;
}
