// ----------------------------------------------------------------------------
// 一文件一表改造后，共享 meta 抽到同目录 project.jsontableproj；
// main_api.ac / main_admin.ac 经本模块定位项目 meta 文件。
// ============================================================================

/// 取路径的目录部分（兼容 \ 与 / 分隔；无分隔符返回空串）
export function dirnameOf(path: String): String {
  let idx: Number = path.lastIndexOf("/");
  let bakIdx: Number = path.lastIndexOf("\\");
  if (bakIdx > idx) { idx = bakIdx; }
  if (idx < 0) { return ""; }
  return path.substring(0, idx);
}

/// 从 dir 起向上查找 project.jsontableproj（含 dir 本身，最多 maxUpLevels 级）；
/// 未找到返回 ""
export function findProjPath(dir: String, maxUpLevels: Number): String {
  let cur: String = dir;
  for (let i = 0; i <= maxUpLevels; i = i + 1) {
    let candidate: String = cur + "/project.jsontableproj";
    if (fileExists(candidate)) {
      return candidate;
    }
    if (cur == "" ) { break; }
    // 上一级目录
    let idx: Number = cur.lastIndexOf("/");
    let bakIdx: Number = cur.lastIndexOf("\\");
    if (bakIdx > idx) { idx = bakIdx; }
    if (idx < 0) { break; }
    cur = cur.substring(0, idx);
  }
  return "";
}
