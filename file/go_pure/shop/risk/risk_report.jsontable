{
  "table": {
    "tableName": "risk_report",
    "modelName": "risk_report",
    "tableComment": "独立用户举报",
    "columns": [
      {
        "name": "id",
        "mysqlType": "bigint",
        "comment": "独立用户举报记录主键",
        "title": "举报ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": true,
        "isAutoInc": true
      },
      {
        "name": "user_id",
        "mysqlType": "bigint",
        "comment": "关联user.id",
        "title": "用户ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "report_no",
        "mysqlType": "varchar(64)",
        "comment": "唯一举报号",
        "title": "举报编号",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "request_key",
        "mysqlType": "varchar(64)",
        "comment": "提交幂等号",
        "title": "幂等编号",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "target_type",
        "mysqlType": "varchar(32)",
        "comment": "goods/shop/user/account/external目标",
        "title": "对象类型",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "target_id",
        "mysqlType": "bigint",
        "comment": "内部目标ID，外部线索为0",
        "title": "对象ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "target_snapshot",
        "mysqlType": "json",
        "comment": "目标公开内容或外部线索快照",
        "title": "对象快照",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "order_id",
        "mysqlType": "bigint",
        "comment": "关联trade_order.id",
        "title": "订单ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "reason",
        "mysqlType": "varchar(64)",
        "comment": "原因编码",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "description",
        "mysqlType": "varchar(4000)",
        "comment": "事实说明",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "evidence_ids",
        "mysqlType": "json",
        "comment": "私有证据ID列表",
        "title": "证据附件",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "case_id",
        "mysqlType": "bigint",
        "comment": "关联risk_case.id",
        "title": "案件ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "status",
        "mysqlType": "varchar(32)",
        "comment": "业务状态：pending待核查/processing核查/closed反馈",
        "title": "状态",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "pending"
      },
      {
        "name": "feedback",
        "mysqlType": "varchar(2000)",
        "comment": "可披露给举报人的反馈",
        "title": "处理反馈",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "created_at",
        "mysqlType": "datetime",
        "comment": "记录创建时间",
        "title": "创建时间",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "CURRENT_TIMESTAMP"
      },
      {
        "name": "updated_at",
        "mysqlType": "datetime",
        "comment": "记录最后更新时间",
        "title": "更新时间",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "CURRENT_TIMESTAMP"
      }
    ],
    "indexes": [
      {
        "name": "uk_report_no",
        "cols": [
          "report_no"
        ],
        "unique": true
      },
      {
