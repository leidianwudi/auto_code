{
  "table": {
    "tableName": "biz_outbox",
    "modelName": "biz_outbox",
    "tableComment": "事务提交后业务任务",
    "columns": [
      {
        "name": "id",
        "mysqlType": "bigint",
        "comment": "事务提交后业务任务记录主键",
        "nullable": false,
        "unsigned": false,
        "isPrimary": true,
        "isAutoInc": true
      },
      {
        "name": "event_key",
        "mysqlType": "varchar(128)",
        "comment": "事件唯一幂等键",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "kind",
        "mysqlType": "varchar(64)",
        "comment": "消息推送或业务通知类型",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "payload",
        "mysqlType": "json",
        "comment": "业务引用数据，不存秘密明文",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "status",
        "mysqlType": "varchar(32)",
        "comment": "业务状态：pending待执行/processing执行/done完成/failed失败",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "pending"
      },
      {
        "name": "attempts",
        "mysqlType": "bigint",
        "comment": "执行次数",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "available_at",
        "mysqlType": "datetime",
        "comment": "下次执行时间",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "locked_until",
        "mysqlType": "datetime",
        "comment": "认领租约到期时间",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "error",
        "mysqlType": "varchar(1000)",
        "comment": "失败摘要，不含凭据",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "created_at",
        "mysqlType": "datetime",
        "comment": "记录创建时间",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "CURRENT_TIMESTAMP"
      },
      {
        "name": "updated_at",
