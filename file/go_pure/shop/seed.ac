/// @file seed.ac — shop 本地库种子数据（幂等，可重复执行）
/// ----------------------------------------------------------------------------
/// 数据库：127.0.0.1:3306/shop（与 project.jsontableproj meta.db 一致，勿指向 103 旧库）
/// 内容：
///   1. 超级管理员角色（sys_role，按名称幂等）
///   2. admin 账号（密码 123456，bcrypt 哈希由 shop_api/cmd/genpass 生成，按账号幂等）
///   3. 店铺/用户页面菜单（sys_menu，按标题+父级幂等；component 为 views 下
///      相对路径，前端 router/utils.ts 用 includes 匹配模块路径）
///   4. 全部菜单分配给超级管理员（sys_role_menu，唯一键 uk_role_menu 幂等）
/// 执行：auto_code --run file/go_pure/shop/seed.ac
/// ----------------------------------------------------------------------------

main {
  let db = new DB({
    host: "127.0.0.1",
    port: 3306,
    user: "root",
    password: "123456",
    database: "shop"
  });

  // ── 1. 超级管理员角色 ─────────────────────────────────────────────
  let roleId: Number = 0;
  let roleRows = db.query({sql: "SELECT id FROM sys_role WHERE name = '超级管理员' LIMIT 1"});
  if (roleRows.length > 0) {
    roleId = roleRows[0].id;
    printLog("角色已存在: 超级管理员 (id=" + roleId + ")");
  } else {
    db.exec({sql: "INSERT INTO sys_role (name, remark, sort, status) VALUES ('超级管理员', '内置角色，拥有全部菜单', 1, 1)"});
    let r2 = db.query({sql: "SELECT id FROM sys_role WHERE name = '超级管理员' LIMIT 1"});
    roleId = r2[0].id;
    printLog("角色已创建: 超级管理员 (id=" + roleId + ")");
  }

  // ── 2. admin 账号（密码 123456）───────────────────────────────────
  let adminRows = db.query({sql: "SELECT id FROM admin WHERE account = 'admin' LIMIT 1"});
  if (adminRows.length > 0) {
    printLog("管理员已存在: admin (id=" + adminRows[0].id + ")");
  } else {
    db.exec({sql: "INSERT INTO admin (account, password, nick, role_id, enable, ip) VALUES ('admin', '$2a$10$P.cpY2OLAx88.1SKoAnHwOPeL8dkyHZUl8lu6s6Tek25AU.1ad.g.', '超级管理员', " + roleId + ", 1, '')"});
    printLog("管理员已创建: admin（密码 123456）");
  }

  // ── 3. 店铺/用户页面菜单 ─────────────────────────────────────────
  //    系统管理（管理员/角色/菜单）菜单一般已随架子建好，这里只补生成页；
  //    父目录 component 留空，叶子页 component 指向 .vue 相对路径
  let shopDirId: Number = ensureMenu(db, "店铺管理", 0, "/shop", "", "ep:shop", 10);
  ensureMenu(db, "店铺列表", shopDirId, "/shop/list", "shop/shop/shop.vue", "ep:shop", 1);
  ensureMenu(db, "用户列表", shopDirId, "/shop/user", "user/user/user.vue", "ep:user", 2);

  // ── 4. 全部菜单分配给超级管理员 ──────────────────────────────────
  db.exec({sql: "INSERT INTO sys_role_menu (role_id, menu_id) SELECT " + roleId + ", id FROM sys_menu WHERE id NOT IN (SELECT menu_id FROM sys_role_menu WHERE role_id = " + roleId + ")"});
  printLog("菜单已全部分配给角色 id=" + roleId);

  db.disconnect();
  printLog("--- 种子数据完成 ---");
}

/// @brief 幂等插入一条菜单，返回菜单 id
/// @param db 已连接的 DB 实例
/// @param title 菜单标题（与 pid 联合判重）
/// @param pid 父菜单 id（0=顶级）
/// @param path 路由路径
/// @param component 组件相对路径（views 下；目录留空）
/// @param icon iconify 图标名
/// @param sort 排序（越小越靠前）
export function ensureMenu(db: DB, title: String, pid: Number, path: String, component: String, icon: String, sort: Number): Number {
  let rows = db.query({sql: "SELECT id FROM sys_menu WHERE title = '" + title + "' AND pid = " + pid + " LIMIT 1"});
  if (rows.length > 0) {
    printLog("菜单已存在: " + title + " (id=" + rows[0].id + ")");
    return rows[0].id;
  }
  db.exec({sql: "INSERT INTO sys_menu (pid, title, type, path, component, icon, sort, perm, visible) VALUES (" + pid + ", '" + title + "', 1, '" + path + "', '" + component + "', '" + icon + "', " + sort + ", '', 1)"});
  let r2 = db.query({sql: "SELECT id FROM sys_menu WHERE title = '" + title + "' AND pid = " + pid + " LIMIT 1"});
  printLog("菜单已创建: " + title + " (id=" + r2[0].id + ")");
  return r2[0].id;
}
