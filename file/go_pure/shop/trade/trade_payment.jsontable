{
  "table": {
    "tableName": "trade_payment",
    "modelName": "trade_payment",
    "tableComment": "余额支付记录",
    "columns": [
      {
        "name": "id",
        "mysqlType": "bigint",
        "comment": "余额支付记录记录主键",
        "title": "支付ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": true,
        "isAutoInc": true
      },
      {
        "name": "order_id",
        "mysqlType": "bigint",
        "comment": "关联trade_order.id",
        "title": "订单ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "payment_no",
        "mysqlType": "varchar(64)",
        "comment": "唯一支付号",
        "title": "支付编号",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "buyer_id",
        "mysqlType": "bigint",
        "comment": "关联user.id",
        "title": "买家ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "seller_id",
        "mysqlType": "bigint",
        "comment": "关联user.id",
        "title": "卖家ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "amount",
        "mysqlType": "decimal(20,2)",
        "comment": "余额扣款金额",
        "title": "支付金额",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0.00"
      },
      {
        "name": "pending_amount",
        "mysqlType": "decimal(20,2)",
        "comment": "未结算商户货款",
        "title": "待结算金额",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0.00"
      },
      {
        "name": "refunded_amount",
        "mysqlType": "decimal(20,2)",
        "comment": "累计退款",
        "title": "已退款金额",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0.00"
      },
      {
        "name": "settlement_days",
        "mysqlType": "bigint",
        "comment": "结算天数快照",
        "title": "结算等待（天）",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "settle_at",
        "mysqlType": "datetime",
        "comment": "到期结算时间",
        "title": "预计结算时间",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "status",
        "mysqlType": "varchar(32)",
        "comment": "业务状态：paid已付/settled结算/refunded已退",
        "title": "状态",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "paid"
      },
      {
        "name": "rule_snapshot",
        "mysqlType": "json",
        "comment": "佣金、售后和结算来源版本",
        "title": "规则快照",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "created_at",
        "mysqlType": "datetime",
        "comment": "记录创建时间",
        "title": "创建时间",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "CURRENT_TIMESTAMP"
      },
      {
        "name": "updated_at",
        "mysqlType": "datetime",
        "comment": "记录最后更新时间",
        "title": "更新时间",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "CURRENT_TIMESTAMP"
      }
    ],
    "indexes": [
      {
        "name": "uk_order_id",
        "cols": [
          "order_id"
        ],
        "unique": true
      },
      {
        "name": "uk_payment_no",
        "cols": [
