{
  "table": {
    "tableName": "trade_refund",
    "modelName": "trade_refund",
    "tableComment": "订单售后退款",
    "columns": [
      {
        "name": "id",
        "mysqlType": "bigint",
        "comment": "订单售后退款记录主键",
        "nullable": false,
        "unsigned": false,
        "isPrimary": true,
        "isAutoInc": true
      },
      {
        "name": "order_id",
        "mysqlType": "bigint",
        "comment": "关联trade_order.id",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "buyer_id",
        "mysqlType": "bigint",
        "comment": "关联user.id",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "refund_no",
        "mysqlType": "varchar(64)",
        "comment": "唯一售后号",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "request_key",
        "mysqlType": "varchar(64)",
        "comment": "提交售后幂等号",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "amount",
        "mysqlType": "decimal(20,2)",
        "comment": "申请退款额",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0.00"
      },
      {
        "name": "approved_amount",
        "mysqlType": "decimal(20,2)",
        "comment": "核准退款额",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0.00"
      },
      {
        "name": "reason",
        "mysqlType": "varchar(64)",
        "comment": "原因编码",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "description",
        "mysqlType": "varchar(2000)",
        "comment": "买家说明",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "evidence_ids",
        "mysqlType": "json",
        "comment": "私有证据ID列表",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "status",
        "mysqlType": "varchar(32)",
        "comment": "业务状态：pending待卖家/seller_rejected卖家拒绝/platform平台/approved核准/refunded已退/rejected驳回/cancelled撤销/awaiting_funds待补款",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "pending"
      },
      {
        "name": "seller_note",
        "mysqlType": "varchar(2000)",
        "comment": "卖家答复",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "admin_id",
        "mysqlType": "bigint",
        "comment": "关联admin.id",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "decision_note",
        "mysqlType": "varchar(2000)",
        "comment": "裁定依据",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "reply_deadline",
        "mysqlType": "datetime",
        "comment": "答复截止时间",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "decided_at",
        "mysqlType": "datetime",
        "comment": "裁定时间",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "refunded_at",
        "mysqlType": "datetime",
        "comment": "退款时间",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "created_at",
