{
  "table": {
    "tableName": "goods",
    "modelName": "goods",
    "tableComment": "商店的商品",
    "columns": [
      {
        "name": "id",
        "mysqlType": "int",
        "comment": "主键",
        "nullable": false,
        "unsigned": false,
        "isPrimary": true,
        "isAutoInc": true,
        "title": "商品ID"
      },
      {
        "name": "shop_id",
        "mysqlType": "int",
        "comment": "商店id。shop.id",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0",
        "title": "店铺ID"
      },
      {
        "name": "goods_img",
        "mysqlType": "varchar(512)",
        "comment": "公开商品封面路径",
        "title": "商品封面",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "name",
        "mysqlType": "varchar(128)",
        "unsigned": false,
        "nullable": false,
        "isPrimary": false,
        "isAutoInc": false,
        "comment": "商品名称",
        "default": ""
      },
      {
        "name": "intro",
        "mysqlType": "varchar(512)",
        "unsigned": false,
        "nullable": false,
        "isPrimary": false,
        "isAutoInc": false,
        "comment": "简介",
        "default": ""
      },
      {
        "name": "is_show",
        "mysqlType": "int",
        "comment": "是否展示",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0",
        "title": "是否上架"
      },
      {
        "name": "enable",
        "mysqlType": "int",
        "comment": "是否启用",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0",
        "title": "启用状态"
      },
      {
        "name": "game_id",
        "mysqlType": "bigint",
        "comment": "关联game.id",
        "title": "游戏ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "release_id",
        "mysqlType": "bigint",
        "comment": "关联game_release.id",
        "title": "版本ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "server_id",
        "mysqlType": "bigint",
        "comment": "关联game_server.id",
        "title": "区服ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "category_id",
        "mysqlType": "bigint",
        "comment": "关联goods_category.id",
        "title": "分类ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "form_id",
        "mysqlType": "bigint",
        "comment": "关联goods_form.id",
        "title": "资料模板ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "kind",
        "mysqlType": "varchar(32)",
        "comment": "topup代充/item装备/account账号",
        "title": "商品类型",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "images",
        "mysqlType": "json",
        "comment": "公开商品图片路径列表",
        "title": "商品图片",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "attributes",
        "mysqlType": "json",
        "comment": "非秘密商品属性和绑定说明",
        "title": "商品属性",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "delivery_rules",
        "mysqlType": "json",
        "comment": "交付方式、承诺及验收项",
        "title": "交付规则",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "status",
        "mysqlType": "varchar(32)",
        "comment": "业务状态：draft草稿/pending审核/approved通过/rejected拒绝",
        "title": "审核状态",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "draft"
      },
      {
        "name": "revision",
        "mysqlType": "bigint",
        "comment": "商品审核版本",
        "title": "审核版本",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "1"
      },
      {
        "name": "sales",
        "mysqlType": "bigint",
        "comment": "已完成销售数量",
        "title": "销量",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "delivery_hours",
        "mysqlType": "bigint",
        "comment": "交付承诺小时数",
        "title": "交付时限（小时）",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "24"
      },
      {
        "name": "auto_receive_hours",
        "mysqlType": "bigint",
        "comment": "自动收货小时数，0关闭",
        "title": "自动收货（小时）",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "review_note",
        "mysqlType": "varchar(512)",
        "comment": "审核意见",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "created_at",
        "mysqlType": "datetime",
        "comment": "记录创建时间",
        "title": "创建时间",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "CURRENT_TIMESTAMP"
      },
      {
        "name": "updated_at",
        "mysqlType": "datetime",
        "comment": "记录最后更新时间",
        "title": "更新时间",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "CURRENT_TIMESTAMP"
      },
      {
        "name": "request_key",
        "mysqlType": "varchar(64)",
        "comment": "商户创建商品幂等号",
        "title": "幂等编号",
        "nullable": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "",
        "unsigned": false
      }
    ],
