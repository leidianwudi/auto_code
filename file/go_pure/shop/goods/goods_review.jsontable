{
  "table": {
    "tableName": "goods_review",
    "modelName": "goods_review",
    "tableComment": "商品审核记录",
    "columns": [
      {
        "name": "id",
        "mysqlType": "bigint",
        "comment": "商品审核记录记录主键",
        "title": "审核ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": true,
        "isAutoInc": true
      },
      {
        "name": "goods_id",
        "mysqlType": "bigint",
        "comment": "关联goods.id",
        "title": "商品ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "revision",
        "mysqlType": "bigint",
        "comment": "审核商品版本",
        "title": "版本",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "snapshot",
        "mysqlType": "json",
        "comment": "商品、SKU及全部翻译快照",
        "title": "审核快照",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "status",
        "mysqlType": "varchar(32)",
        "comment": "业务状态：draft草稿/pending审核/approved通过/rejected拒绝",
        "title": "审核状态",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "pending"
      },
      {
        "name": "admin_id",
        "mysqlType": "bigint",
        "comment": "关联admin.id",
        "title": "管理员ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "note",
        "mysqlType": "varchar(1000)",
        "comment": "审核理由",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "reviewed_at",
        "mysqlType": "datetime",
        "comment": "审核完成时间",
        "title": "审核时间",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "created_at",
        "mysqlType": "datetime",
        "comment": "记录创建时间",
        "title": "创建时间",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "CURRENT_TIMESTAMP"
      },
      {
        "name": "updated_at",
        "mysqlType": "datetime",
        "comment": "记录最后更新时间",
        "title": "更新时间",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "CURRENT_TIMESTAMP"
      }
    ],
