{
  "table": {
    "tableName": "goods0",
    "modelName": "goods0",
    "tableComment": "商品多语言翻译表",
    "frontend": false,
    "adminQueryMode": "empty",
    "appQuery": false,
    "columns": [
      {
        "name": "id",
        "mysqlType": "int",
        "comment": "自增主键",
