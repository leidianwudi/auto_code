        "isPrimary": true,
        "isAutoInc": true,
        "title": "翻译ID",
        "unsigned": false
      },
      {
        "name": "ext_id",
        "mysqlType": "bigint",
        "comment": "关联goods.id",
        "title": "商品ID",
        "nullable": false,
        "default": "0",
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "lang",
        "mysqlType": "varchar(64)",
        "comment": "语言编码，对应base_lang.lang",
        "title": "语言编码",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "name",
        "mysqlType": "varchar(255)",
        "comment": "商品名称",
        "nullable": false,
        "default": "",
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "intro",
        "mysqlType": "text",
        "comment": "商品介绍，不包含游戏登录秘密",
        "title": "商品介绍",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "desc",
        "mysqlType": "varchar(128)",
        "unsigned": false,
        "nullable": false,
        "isPrimary": false,
        "isAutoInc": false,
        "comment": "备注",
        "default": ""
      },
      {
        "name": "created_at",
        "mysqlType": "datetime",
        "comment": "记录创建时间",
        "nullable": true,
        "title": "创建时间",
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "CURRENT_TIMESTAMP"
      },
      {
        "name": "updated_at",
        "mysqlType": "datetime",
        "comment": "记录最后更新时间",
        "nullable": true,
        "title": "更新时间",
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "CURRENT_TIMESTAMP"
      }
    ],
    "indexes": [{"name":"uk_ext_id_lang","cols":["ext_id","lang"],"unique":true}]
  }
