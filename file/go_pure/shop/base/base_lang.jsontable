{
  table: {
    tableName: 'base_lang',
    modelName: 'base_lang',
    tableComment: '语言配置表',
    adminPkgComment: '语言配置管理端模块（CRUD）',
    dataPkgComment: '语言配置共享数据层（admin 端与 app 端复用）',
    columns: [
      {
        name: 'id',
        mysqlType: 'int',
        unsigned: true,
        nullable: false,
        isPrimary: true,
        isAutoInc: true,
        comment: '主键',
      },
      {
        name: 'sort',
        mysqlType: 'int',
        unsigned: false,
        nullable: false,
        default: '0',
        comment: '排序，越小越靠前',
      },
      {
        name: 'lang',
        mysqlType: 'varchar(16)',
        unsigned: false,
        nullable: false,
        comment: '语言码，如 zh / en',
      },
      {
        name: 'name',
        mysqlType: 'varchar(32)',
        unsigned: false,
        nullable: false,
        comment: '语言名称，如 中文 / English',
      },
      {
        name: 'enable',
        mysqlType: 'int',
        unsigned: false,
        nullable: false,
        default: '1',
        comment: '是否启用：1=启用；0=停用',
      },
      {
        name: 'desc',
        mysqlType: 'varchar(255)',
        unsigned: false,
        nullable: false,
        comment: '备注',
      },
      {
        name: 'created_at',
        mysqlType: 'datetime',
        unsigned: false,
        nullable: true,
        comment: '创建时间',
      },
    ],
    indexes: [
      {
        name: 'uk_lang',
        cols: ['lang'],
        unique: true,
      },
    ],
    selCols: [
      { ref: 'sort', label: '排序' },
      { ref: 'lang', label: '语言码' },
      { ref: 'name', label: '语言名称' },
      { ref: 'enable', label: '启用' },
      { ref: 'desc', label: '备注' },
      { ref: 'created_at', label: '创建时间' },
    ],
    selColsEq: [{ ref: 'lang' }, { ref: 'enable' }],
    selColsLike: [{ ref: 'name' }],
    selColsSort: [['sort', 'ASC']],
    editCols: [
      { ref: 'sort', widget: 'number', required: true },
      { ref: 'lang', widget: 'input', required: true },
      { ref: 'name', widget: 'input', required: true },
      { ref: 'enable', widget: 'boolean' },
      { ref: 'desc', widget: 'textarea' },
    ],
  },
}
