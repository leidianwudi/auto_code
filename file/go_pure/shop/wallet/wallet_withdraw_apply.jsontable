        "title": "创建时间",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "CURRENT_TIMESTAMP"
      },
      {
        "name": "updated_at",
        "mysqlType": "datetime",
