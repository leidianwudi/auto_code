{
  "table": {
    "tableName": "wallet_withdraw_apply",
    "modelName": "wallet_withdraw_apply",
    "tableComment": "商户提现申请",
    "columns": [
      {
        "name": "id",
        "mysqlType": "bigint",
        "comment": "商户提现申请记录主键",
        "title": "提现申请ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": true,
        "isAutoInc": true
      },
      {
        "name": "user_id",
        "mysqlType": "bigint",
        "comment": "关联user.id",
        "title": "用户ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "shop_id",
        "mysqlType": "bigint",
        "comment": "关联shop.id",
        "title": "店铺ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "account_id",
        "mysqlType": "bigint",
        "comment": "关联wallet_payout_account.id",
        "title": "收款账户ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "withdraw_no",
        "mysqlType": "varchar(64)",
        "comment": "唯一提现号",
        "title": "提现编号",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "request_key",
        "mysqlType": "varchar(64)",
        "comment": "申请幂等号",
        "title": "幂等编号",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "amount",
        "mysqlType": "decimal(20,2)",
        "comment": "申请冻结额",
        "title": "提现金额",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0.00"
      },
      {
        "name": "account_snapshot_ciphertext",
        "mysqlType": "text",
        "comment": "加密不可变收款快照",
        "title": "加密收款快照",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "hidden": true
      },
      {
        "name": "masked_account",
        "mysqlType": "varchar(128)",
        "comment": "脱敏收款快照",
        "title": "收款账号（脱敏）",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "kind",
        "mysqlType": "varchar(32)",
        "comment": "收款方式快照",
        "title": "收款方式",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "status",
        "mysqlType": "varchar(32)",
        "comment": "业务状态：pending审核/approved待付/processing付款/unknown待核实/paid已付/rejected拒绝/cancelled撤销/failed确认未付",
        "title": "状态",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "pending"
      },
      {
        "name": "admin_id",
        "mysqlType": "bigint",
        "comment": "关联admin.id",
        "title": "管理员ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "payment_admin_id",
        "mysqlType": "bigint",
        "comment": "关联admin.id",
        "title": "付款管理员ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "review_note",
        "mysqlType": "varchar(1000)",
        "comment": "审核撤回依据",
        "title": "审核意见",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "reviewed_at",
        "mysqlType": "datetime",
        "comment": "审核时间",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "paid_at",
        "mysqlType": "datetime",
        "comment": "付款确认时间",
