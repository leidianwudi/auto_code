      "mysqlType": "bigint",
      "comment": "关联wallet_recharge_apply.id",
      "title": "充值申请ID",
      "nullable": false,
      "default": "0",
      "unsigned": false,
      "isPrimary": false,
      "isAutoInc": false
    },
    {
      "name": "actor_type",
      "mysqlType": "varchar(16)",
      "comment": "操作主体user或admin",
