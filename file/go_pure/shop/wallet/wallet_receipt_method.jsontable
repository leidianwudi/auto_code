{
  "table": {
    "tableName": "wallet_receipt_method",
    "modelName": "wallet_receipt_method",
    "tableComment": "平台收款渠道",
    "columns": [
      {
        "name": "id",
        "mysqlType": "bigint",
        "comment": "平台收款渠道记录主键",
        "title": "渠道ID",
        "nullable": false,
        "unsigned": false,
        "isPrimary": true,
        "isAutoInc": true
      },
      {
        "name": "code",
        "mysqlType": "varchar(64)",
        "comment": "渠道唯一编码",
        "title": "渠道编码",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "kind",
        "mysqlType": "varchar(32)",
        "comment": "wechat/alipay/bank方式",
        "title": "收款方式",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "name",
        "mysqlType": "varchar(128)",
