        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0.00"
      },
      {
        "name": "max_amount",
        "mysqlType": "decimal(20,2)",
        "comment": "最高充值额，0不限制",
        "title": "最高充值额",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0.00"
      },
      {
        "name": "version",
