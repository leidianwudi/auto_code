{
  "table": {
    "tableName": "wallet_recharge_apply",
    "modelName": "wallet_recharge_apply",
    "tableComment": "用户充值申请",
    "columns": [
      {
        "name": "id",
        "mysqlType": "bigint",
        "comment": "用户充值申请记录主键",
        "nullable": false,
        "unsigned": false,
        "isPrimary": true,
        "isAutoInc": true
      },
      {
        "name": "user_id",
        "mysqlType": "bigint",
        "comment": "关联user.id",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "method_id",
        "mysqlType": "bigint",
        "comment": "关联wallet_receipt_method.id",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "apply_no",
        "mysqlType": "varchar(64)",
        "comment": "唯一申请号",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "request_key",
        "mysqlType": "varchar(64)",
        "comment": "充值提交幂等号",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "amount",
        "mysqlType": "decimal(20,2)",
        "comment": "申请和应付额，不加随机尾数",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0.00"
      },
      {
        "name": "method_snapshot",
        "mysqlType": "json",
        "comment": "平台收款渠道及版本快照",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "evidence_ids",
        "mysqlType": "json",
        "comment": "私有充值凭证ID列表",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "reference",
        "mysqlType": "varchar(256)",
        "comment": "转账流水或备注",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "status",
        "mysqlType": "varchar(32)",
        "comment": "业务状态：draft待凭证/pending待审/needs_proof补证/approved入账/rejected拒绝/cancelled撤销",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "pending"
      },
      {
        "name": "admin_id",
        "mysqlType": "bigint",
        "comment": "关联admin.id",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "0"
      },
      {
        "name": "review_note",
        "mysqlType": "varchar(1000)",
        "comment": "审核或补证理由",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": ""
      },
      {
        "name": "reviewed_at",
        "mysqlType": "datetime",
        "comment": "审核时间",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "expires_at",
        "mysqlType": "datetime",
        "comment": "申请到期时间",
        "nullable": true,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false
      },
      {
        "name": "created_at",
        "mysqlType": "datetime",
        "comment": "记录创建时间",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
        "default": "CURRENT_TIMESTAMP"
      },
      {
        "name": "updated_at",
        "mysqlType": "datetime",
        "comment": "记录最后更新时间",
        "nullable": false,
        "unsigned": false,
        "isPrimary": false,
        "isAutoInc": false,
