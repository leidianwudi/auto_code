// ============================================================================
// shop.ac — shop 项目双端代码生成入口脚本（Go + vue-pure-admin 新框架）
// ----------------------------------------------------------------------------
// 本脚本只包含 "shop 项目" 相关的参数配置，具体生成逻辑在：
//   ../../crud_gin/template/main_api.ac     → Go 后端（gin+gorm）
//   ../../admin_pure/template/main_admin.ac → pure-admin 前端
//
// 配置事实源：shop.jsontable（同目录）——表结构 + 字段前端角色只配一遍，
// 一次执行同时生成两端；生成期不连数据库。
//
// 流程：
//   1. 配置 .jsontable 路径与双端项目根目录
//   2. generateApiMain()   生成 Go 后端代码
//   3. generateAdminMain() 生成 pure-admin 前端代码
// ============================================================================
import { generateApiMain } from "../../crud_gin/template/main_api.ac";
import { generateAdminMain } from "../../admin_pure/template/main_admin.ac";

main {

  // ── 1. 统一配置文件（表结构 + 前端角色，双端共用的事实源）────────
  let jsonTablePath: String = scriptDir() + "/shop.jsontable";

  // ── 2. 目标项目根目录（父目录分组：D:/work/github/shop/{shop_api, shop_admin}）
  //      与 shop.jsontable meta 中的 goBasePath/webBasePath 一致（显式传入优先）──
  let goBasePath: String = "D:/work/github/shop/shop_api";
  let webBasePath: String = "D:/work/github/shop/shop_admin";

  // ── 3. Go 后端生成 ────────────────────────────────────────────────
  //     genGlobalEnum: false 可跳过全局枚举生成（缺省生成）
  let apiParams: Object = {
    jsonTablePath: jsonTablePath,
    goBasePath: goBasePath,
    genGlobalEnum: true
  };
  generateApiMain(apiParams);

  // ── 4. pure-admin 前端生成 ────────────────────────────────────────
  //     双轨制：目标页面目录存在同名 .jsonvue 则按高级页生成，
  //     否则从 shop.jsontable 的列角色合成标准页
  //     模板路径相对本脚本目录（入口在 go_pure/<项目>/，故用 ../../）──
  let tplDir: String = "../../admin_pure/template";
  let adminParams: Object = {
    jsonTablePath: jsonTablePath,
    webBasePath: webBasePath,
    templates: [
      { tpl: tplDir + "/index.tpl", out: "{basePath}/src/views/{pagePath}/{pageName}.vue" },
      { tpl: tplDir + "/write.tpl", out: "{basePath}/src/views/{pagePath}/components/write.vue" },
      { tpl: tplDir + "/api.tpl", out: "{basePath}/src/api/{apiModule}/{pageName}.ts" }
    ],
    sourceTemplates: [
      { tpl: tplDir + "/source.tpl", out: "{basePath}/src/api/source/{sourceName}.ts" }
    ],
    uploadTemplates: [
      { tpl: tplDir + "/upload.tpl", out: "{basePath}/src/api/upload/{uploadName}.ts" }
    ]
  };
  generateAdminMain(adminParams);

  printLog("--- shop 双端生成结束 ---");
}
