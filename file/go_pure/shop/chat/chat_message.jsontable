{
  "table": {
    "tableName": "chat_message",
    "modelName": "chat_message",
    "tableComment": "服务端持久化聊天消息",
    "columns": [
      {
        "name": "id",
        "mysqlType": "bigint",
        "comment": "服务端持久化聊天消息记录主键",
        "nullable": false,
        "unsigned": false,
        "isPrimary": true,
        "isAutoInc": true
      },
