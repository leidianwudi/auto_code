/// @file go_unique_errors_test.ac — 验证唯一索引元数据及模板，不连接数据库或重写 ERP。
import { uniqueFieldLabel, uniqueIndexLines, uniqueIndexBlock } from "../crud_gin/template/core/unique_errors.ac";
import { tabChar } from "../crud_gin/template/core/param_go.ac";

main {
  let tb: String = tabChar();
  let table: Object = {
    tableName: "sample",
    columns: [
      {name: "id", comment: "编号", isPrimary: true},
      {name: "card_id", comment: "身份证;唯一"},
      {name: "name", comment: "姓名"},
      {name: "tel", comment: "手机号；联系号码"}
    ],
    editCols: [{ref: "name", label: "人员姓名"}],
    indexes: [
      {name: "uk_card", cols: ["card_id"], unique: true},
      {name: "uk_person", cols: ["name", "tel"], unique: true},
      {name: "ordinary_name", cols: ["name"], unique: false}
    ]
  };
  assert(uniqueFieldLabel(table, "name") == "人员姓名", "应采用表单实际字段名");
  assert(uniqueFieldLabel(table, "card_id") == "身份证", "应去除注释中的枚举说明");
  assert(uniqueFieldLabel(table, "tel") == "手机号", "应识别中文分号");
  assert(uniqueFieldLabel(table, "unknown") == "unknown", "无标签字段应保留字段名");
  let lines: String[] = uniqueIndexLines(table);
  assert(lines.length == 3, "仅生成主键和唯一索引，普通索引不能被当作唯一规则");
  let content: String = uniqueIndexBlock(table);
  assert(content.includes("Name: \"PRIMARY\""), "应生成主键提示");
  assert(content.includes("Fields: []string{\"身份证\"}"), "应生成单字段提示");
  assert(content.includes("Fields: []string{\"人员姓名\", \"手机号\"}"), "应保留联合索引字段顺序");
  assert(!content.includes("ordinary_name"), "普通索引不应生成提示");
  let quoted: Object = {
    columns: [{name: "code", comment: "编码"}],
    editCols: [{ref: "code", label: "编码\"标识"}],
    indexes: [{name: "uk_\"code", cols: ["code"], unique: true}]
  };
  let escaped: String = uniqueIndexLines(quoted).join("\n");
  let escapedQuote: String = "\\" + "\"";
  assert(escaped.includes("uk_" + escapedQuote + "code"), "索引名应转义为有效 Go 字符串");
  assert(escaped.includes("编码" + escapedQuote + "标识"), "中文标签应安全转义");

  // 正常实体模板与翻译实体模板都应使用同一注册块。
  let entity: String = renderTpl("../crud_gin/template/model/entity.tpl", {
    pkgName: "sample", dataPkgComment: "示例共享数据层", enClass: "EnSample",
    tableComment: "示例表", tableName: "sample", enImports: "import (\n" + tb + "\"errors\"\n" + tb + "\"sample/common/db\"\n)",
    enFieldLines: [tb + "Id int64"], hasAutoIncPk: true, hasNullableField: false,
    enSnapshotLines: [], enChangedLines: [], enChangedCount: 0, colLines: [tb + "ColId = \"id\""],
    hasI18n: false, hasJoin: false, joinSpecBlock: "", uniqueIndexBlock: content
  });
  assert(entity.includes(content), "正常生成必须把注册块写进实体");
  let translated: String = renderTpl("../crud_gin/template/model/entity_i18n.tpl", {
    pkgName: "sample", tableName: "sample", i18nTable: "sample0", i18nEnClass: "EnSample0",
    i18nTableComment: "翻译表", i18nEntityNeedTime: false, dbPath: "sample/common/db",
    i18nEntityFieldLines: [tb + "Id int64"], i18nColLines: [], i18nUniqueIndexBlock: content
  });
  assert(translated.includes("\"sample/common/db\""), "翻译实体注册需要导入 cdb");
  assert(translated.includes(content), "翻译实体也必须内嵌索引提示");
  printLog("唯一索引生成测试通过");
}
