// 一、生成覆盖守卫（防手写文件被误覆盖）
// ═══════════════════════════════════════════════════════════════════════════

/// @brief 生成覆盖守卫：目标文件已存在但缺少 AutoCode 生成标记时跳过覆盖
/// @param path 输出文件路径
/// @return true=可写入（文件不存在，或内容含生成标记属于本生成器产物）；
///         false=跳过写入（已输出红字提示，疑似用户手写文件）
/// 检测标记取两条生成链模板头注释的公共子串：
///   vue 链"//此文件为AutoCode编译器生成，请勿手动修改"、
///   Go 链"// 此代码为AutoCode编译器生成，请勿手动修改"
export function canOverwriteGenerated(path: String): Bool {
  if (!fileExists(path)) {
    return true;
  }
  let old: String = readFile(path);
  if (old.indexOf("AutoCode编译器生成") >= 0) {
    return true;
  }
  printError("跳过覆盖: " + path + "（已存在但缺少 AutoCode 生成标记，疑似手写文件；确认要覆盖请先删除该文件再重新生成）");
  return false;
}

// 二、.jsontable → jsonvue 形状合成（plan 3.3 双轨制·标准页）
// ═══════════════════════════════════════════════════════════════════════════

/// @brief MySQL 类型 → 前端日期控件格式推导
/// @param mysqlType MySQL 类型（如 datetime/date/time/timestamp/varchar(64)）
/// @return "datetime" / "date" / "time"，非时间类型返回 ""
export function deriveDateFormat(mysqlType: String): String {
  let t: String = mysqlType.toLowerCase();
  if (t.startsWith("datetime") || t.startsWith("timestamp")) {
    return "datetime";
  }
  if (t.startsWith("date")) {
    return "date";
  }
  if (t.startsWith("time")) {
    return "time";
  }
  return "";
}

/// @brief .jsontable 列 → jsonvue 列对象（表单角色 → editStyle 映射）
/// @param rawCol .jsontable 列对象（name/mysqlType/comment/form/required；
///        列表显隐由表级 selCols 决定，本函数缺省 queryVisible=true，
///        由 buildJsonvueFromTable 按 selCols 收敛）
/// @return jsonvue 形状的列对象（喂给共用加工器的 processColumns）
///   映射表（form 角色 → editStyle / displayType）：
///     input    → text
///     textarea → textarea（rows=4）
///     number   → int
///     date     → date（dateFormat 由 mysqlType 推导）
///     boolean  → boolean + displayType=boolean（列表开关 + 编辑 0/1 下拉）
///     image    → image + displayType=image（列表缩略图；上传预设需配
///                .jsonvue 高级页引用 .jsonupload，标准页回退 URL 手输）
///     select/upload → 降级 text 并 printLog 提示（引用型数据需配 .jsonvue
///                高级页引用 .jsonsource/.jsonupload 才有下拉/上传，双轨兜底）
/// @brief 标签颜色轮转（表内枚举合成 tagItems 时按选项序号取色）
/// @param idx 选项序号（0 起）
/// @return ElTag 颜色名（与 index.tpl 的标签渲染约定一致）
export function tagColorOf(idx: Number): String {
  let colors: String[] = ["primary", "success", "info", "warning", "danger"];
  return colors[idx % colors.length];
}

/// @brief .jsontable 列 → jsonvue 列对象（editCols 驱动编辑样式映射）
/// @param rawCol .jsontable 列对象（name/mysqlType/comment；列级 form/required 已退役）
/// @param enumDef 表内枚举定义（enums[].column 命中时非 null → tag 渲染/编辑）
/// @param editCol 编辑视图配置（ref/label/visible/widget/required；null=不进编辑表单）
///        widget 已由调用方推导（显式配置 > joinFk 下拉 > mysqlType 推导）
/// @return jsonvue 形状的列对象（喂给共用加工器的 processColumns）
///   widget → editStyle 映射：
///     input→text、textarea→textarea、number→int、date→date、boolean→boolean
///     （displayType=boolean 列表开关）、image→image（displayType=image）、
///     select→select（配合调用方注入 domainType=remote 远程取值域）、
///     upload→降级 text 并提示（上传预设需配 .jsonvue 高级页引用 .jsonupload）
export function buildJsonvueColumn(rawCol: Object, enumDef: Object, editCol: Object): Object {
  let name: String = rawCol["name"];
  let comment: String = rawCol["comment"];
  if (comment == null || comment == "") {
    comment = name;
  }

  // 列基础键（jsonvue 编辑器保存的全键形状，避免加工器读到 null）
  // queryVisible 缺省 true：未配 selCols 时全列展示；配置后由调用方按 selCols 收敛。
  // editVisible/editStyle/required 缺省 false/text/false：由 editCol 收敛（调用方注入）
  let col: Object = {
    dataName: name,
    queryName: comment,
    editName: comment,
    queryVisible: true,
    editVisible: false,
    editEditable: true,
    switchEditable: false,
    required: false,
    formSpan: 12,
    columnWidth: 0,
    maxlength: 0,
    placeholder: "",
    textareaRows: 4,
    boolTrueText: "启用",
    boolFalseText: "禁用",
    tagItems: [],
    dateFormat: "",
    editStyle: "text"
  };

  let mysqlType: String = rawCol["mysqlType"];
  if (mysqlType == null) {
    mysqlType = "";
  }
  let timeFormat: String = deriveDateFormat(mysqlType);

  // 编辑视图收敛（editCol 非空才进编辑表单；widget 由调用方推导）
  if (editCol != null) {
    let widget: String =
        (editCol["widget"] != null && editCol["widget"] != "") ? editCol["widget"] : "input";
    col["editVisible"] = (editCol["visible"] != false);
    // 编辑时可编辑（editCols.editEditable，false=表单内只读展示；缺省 true）
    col["editEditable"] = (editCol["editEditable"] != false);
    col["required"] = (editCol["required"] == true);
    if (widget == "textarea") {
      col["editStyle"] = "textarea";
    } else if (widget == "number") {
      col["editStyle"] = "int";
    } else if (widget == "date") {
      col["editStyle"] = "date";
      col["dateFormat"] = (timeFormat != "" ? timeFormat : "date");
    } else if (widget == "boolean") {
      col["editStyle"] = "boolean";
      col["displayType"] = "boolean";
      col["switchEditable"] = true;
    } else if (widget == "image") {
      col["editStyle"] = "image";
      col["displayType"] = "image";
    } else if (widget == "upload") {
      // 上传预设降级：标准页没有 .jsonupload 引用通道，按文本生成并提示
      col["editStyle"] = "text";
      printLog("提示：字段 '" + name + "' 编辑控件为 upload，标准页按文本输入生成；" +
               "如需上传，请配置同名 .jsonvue 高级页（双轨制）");
    } else {
      // input / select（select 配合 domainType=remote 远程取值域）
      col["editStyle"] = (widget == "select" ? "select" : "text");
    }
  }

  // 表内枚举命中（enums[].column == 列名）：列表标签显示 + 编辑下拉。
  // tagItems 通道无需数据源文件（加工器 isTagEdit/isTagSwitch 分支直接消费），
  // 覆盖 widget 的编辑样式映射——枚举值域封闭，下拉比 number/input 更合理
  if (enumDef != null) {
    col["editStyle"] = "tag";
    col["displayType"] = "tag";
    col["switchEditable"] = false;
    let items: Object[] = [];
    let opts: Object[] = enumDef["items"];
    if (opts != null) {
      let oLen = opts.length;
      for (let oi = 0; oi < oLen; oi = oi + 1) {
        let opt: Object = opts[oi];
        let item: Object = {
          value: opt["value"],
          text: opt["label"],
          color: tagColorOf(oi)
        };
        items.append(item);
      }
    }
    col["tagItems"] = items;
  }
  return col;
}

/// @brief .jsontable 表 → jsonvue 形状对象（标准页合成，殊途同归进 buildAdminTplData）
/// @param table .jsontable 表对象（tableName/modelName/tableComment/columns[]/
///              joinTable[]/selCols[]/selColsEq/selColsGap/selColsLike/selColsSort/
///              enums[]/globalEnumCols）
/// @param globalEnumNames 全局枚举名集合（name → true，供 globalEnumCols 引用校验；
///              null/缺省 = 全局枚举链未启用，globalEnumCols 按未命中处理）
/// @param joinContext 联表上下文（引用名 → {tableName, comments: 列名→注释,
///              types: 列名→mysqlType}，由主流程按 joinTable 预构造；
///              null/缺省 = 无联表，联表 ref 查询字段按文本输入合成）
/// @return {meta, columns, queryFields} 形状对象
///   meta 约定（与 admin_vue .jsonvue 实例同构，如 shop.jsonvue 的 POST 风格）：
///   dataUrl="{modelName}/selectByIn"（首段经 deriveApiBaseFromUrl 消费为
///   apiBase=modelName）、queryApi="get{Pascal}List"、updateApi="upd{Pascal}List"
///   （POST /update 承接，无 id 新增/有 id 更新）、deleteApi="del{Pascal}List"；
///   读模型合成（列级 list/search 角色已退役，全部由表级读模型键驱动）：
///   - 列表列：selCols[].ref 命中 → queryVisible=true（未配 selCols 全列展示）；
///     联表 ref（pro.col）→ 虚拟列 dataName=别名 pro_col，只读（editVisible=false）
///   - 查询字段：selColsEq（精确，时间→日期选择）/ selColsGap（范围 range）/
///     selColsLike（文本）→ queryFields；联表 ref 的查询参数名 = 别名 pro_col，
///     与后端 SelectParams/返回键对齐
///   - globalEnumCols 命中列 → 全局枚举取值域（domainType=enum，三处共享）
/// @brief 查询字段参数名（联表 ref pro.col → 别名 pro_col，与后端返回键对齐）
export function qfNameOf(ref: String): String {
  if (ref.indexOf(".") > 0) {
    let d: Number = ref.indexOf(".");
    return ref.substring(0, d) + "_" + ref.substring(d + 1);
  }
  return ref;
}

/// @brief 查询字段显示名（selCols label > 联表输出别名标题(title)>别名注释 >
///        联表目标列注释 > 本表列注释 > ref 原样）
export function qfLabelOf(ref: String, selLabelOf: Object, joinContext: Object, rawCols: Object[],
                   aliasMeta: Object): String {
  if (selLabelOf[ref] != null && selLabelOf[ref] != "") {
    return selLabelOf[ref];
  }
  if (aliasMeta != null && aliasMeta[ref] != null) {
    if (aliasMeta[ref]["title"] != null && aliasMeta[ref]["title"] != "") {
      return aliasMeta[ref]["title"];
    }
    if (aliasMeta[ref]["comment"] != null && aliasMeta[ref]["comment"] != "") {
      return aliasMeta[ref]["comment"];
    }
  }
  if (ref.indexOf(".") > 0) {
    let d: Number = ref.indexOf(".");
    let pro: String = ref.substring(0, d);
    let cn: String = ref.substring(d + 1);
    let ctx: Object = null;
    if (joinContext != null) { ctx = joinContext[pro]; }
    if (ctx != null && ctx["comments"] != null && ctx["comments"][cn] != null) {
      return ctx["comments"][cn];
    }
    return pro + "_" + cn;
  }
  // 本表列：回退列注释
  let rcLen = rawCols.length;
  for (let ri = 0; ri < rcLen; ri = ri + 1) {
    if (rawCols[ri]["name"] == ref && rawCols[ri]["comment"] != null && rawCols[ri]["comment"] != "") {
      return rawCols[ri]["comment"];
    }
  }
  return ref;
}

/// @brief 查询字段是否日期控件（本表列按 mysqlType 推导；联表 ref 一律文本输入）
export function qfIsDate(ref: String, rawCols: Object[]): Bool {
  if (ref.indexOf(".") > 0) {
    return false;  // 联表 ref 查询一律文本输入（时间联表列场景少，后续按需扩展）
  }
  let rcLen = rawCols.length;
  for (let ri = 0; ri < rcLen; ri = ri + 1) {
    if (rawCols[ri]["name"] == ref) {
      return deriveDateFormat(rawCols[ri]["mysqlType"]) != "";
    }
  }
  return false;
}

/// @brief 查询字段日期格式（本表列按 mysqlType 推导，非时间列返回空串）
export function qfDateFmt(ref: String, rawCols: Object[]): String {
  let rcLen = rawCols.length;
  for (let ri = 0; ri < rcLen; ri = ri + 1) {
    if (rawCols[ri]["name"] == ref) {
      return deriveDateFormat(rawCols[ri]["mysqlType"]);
    }
  }
  return "";
}

/// @brief 构造查询字段对象（控件自动推导：联表 ref/外键列/全局枚举列 → select）
/// @param relation "=" 精确与模糊 / "range" 范围
/// @param isDate 本表时间列（调用方按 ref 推导；联表 ref 恒 false）
/// @param dateFmt 日期格式（非时间列空串）
export function makeQueryField(ref: String, relation: String, selLabelOf: Object, joinContext: Object,
                        rawCols: Object[], geSet: Object, fkMap: Object,
                        isDate: Bool, dateFmt: String, aliasMeta: Object): Object {
  let qf: Object = {
    dataName: qfNameOf(ref),
    displayName: qfLabelOf(ref, selLabelOf, joinContext, rawCols, aliasMeta),
    inputStyle: "text",
    relation: (relation == "range" ? "range" : "=")
  };
  if (ref.indexOf(".") > 0) {
    // 联表 ref → 远程下拉（选项 = 目标表列表接口，显示列按目标表推导）
    let d: Number = ref.indexOf(".");
    let pro: String = ref.substring(0, d);
    let ctx: Object = null;
    if (joinContext != null) { ctx = joinContext[pro]; }
    if (ctx != null) {
      qf["inputStyle"] = "select";
      qf["selectUrl"] = "/" + ctx["tableName"] + "/selectByIn";
      qf["selectValueField"] = (ctx["pk"] != null && ctx["pk"] != "" ? ctx["pk"] : "id");
      qf["selectLabelField"] = labelColOfTarget(ctx["types"]);
    }
    return qf;
  }
  if (fkMap[ref] != null) {
    // 本表外键列 → 远程下拉（与编辑页外键下拉同源）
    let fk: Object = fkMap[ref];
    qf["inputStyle"] = "select";
    qf["selectUrl"] = "/" + fk["targetTable"] + "/selectByIn";
    qf["selectValueField"] = fk["pk"];
    qf["selectLabelField"] = labelColOfTarget(
        joinContext != null ? joinContext[fk["pro"]]["types"] : null);
    return qf;
  }
  if (geSet[ref] == true) {
    // 全局枚举列 → select（列合成已带 domainType=enum，查询域继承出静态选项分支）
    qf["inputStyle"] = "select";
    return qf;
  }
  if (isDate) {
    qf["inputStyle"] = "date";
    qf["dateFormat"] = dateFmt;
  }
  return qf;
}

/// @brief 编辑控件类型缺省推导（editCols.widget 显式配置优先，此为兜底）
export function widgetFromMysqlType(mysqlType: String): String {
  let t: String = (mysqlType == null ? "" : mysqlType.toLowerCase());
  if (t.indexOf("datetime") >= 0 || t.indexOf("timestamp") >= 0) {
    return "date";
  }
  if (t.indexOf("tinyint(1)") >= 0) {
    return "boolean";
  }
  if (t.indexOf("int") >= 0 || t.indexOf("decimal") >= 0 || t.indexOf("float") >= 0 ||
      t.indexOf("double") >= 0) {
    return "number";
  }
  return "input";
}

/// @brief 联表目标表显示列推导（第一个 varchar/char 列，缺省 name）
export function labelColOfTarget(types: Object): String {
  for (colName in types) {
    let t: String = types[colName];
    if (t != null && (t.indexOf("varchar") >= 0 || t.indexOf("char") >= 0 || t.indexOf("text") >= 0)) {
      return colName;
    }
  }
  return "name";
}

export function buildJsonvueFromTable(table: Object, globalEnumNames: Object, joinContext: Object,
                               aliasMeta: Object): Object {
  let modelName: String = table["modelName"];
  if (modelName == null || modelName == "") {
    modelName = table["tableName"];
  }
  let tableComment: String = table["tableComment"];
  if (tableComment == null || tableComment == "") {
    tableComment = modelName;
  }

  // 表内枚举按列名索引（列名 → 枚举定义）
  let tableEnums: Object[] = [];
  if (table["enums"] != null) {
    tableEnums = table["enums"];
  }
  // ── 读模型键集合（[{ref,visible}]；ref = 本表列名 或 联表路径 pro.col）──
  let eqRefs: Object[] = [];
  let gapRefs: Object[] = [];
  let likeRefs: Object[] = [];
  if (table["selColsEq"] != null) {
    eqRefs = table["selColsEq"];
  }
  if (table["selColsGap"] != null) {
    gapRefs = table["selColsGap"];
  }
  if (table["selColsLike"] != null) {
    likeRefs = table["selColsLike"];
  }
  // selCols 列表读模型（ref → label；联表 ref 单独收集）
  let selColCfgs: Object[] = [];
  if (table["selCols"] != null) {
    selColCfgs = table["selCols"];
  }
  let selRefSet: Object = {};      // 本表列 ref（queryVisible 收敛用）
  let selJoinRefs: String[] = [];  // 联表 ref（旧格式 pro.col，虚拟列生成用）
  let selAliasRefs: String[] = []; // 联表输出别名（新格式 表名_列名，虚拟列生成用）
  let selLabelOf: Object = {};     // ref → 显示名
  for (sc in selColCfgs) {
    let r: String = sc["ref"];
    if (r == null || r == "") { continue; }
    selLabelOf[r] = sc["label"];
    if (r.indexOf(".") > 0) {
      selJoinRefs.append(r);
    } else if (aliasMeta != null && aliasMeta[r] != null) {
      selAliasRefs.append(r);
    } else {
      selRefSet[r] = true;
    }
  }
  let hasSelCols: Bool = (selColCfgs.length > 0);
  // selCols 元数据（本表列 ref → {label, width, displayType, listThumb*}：
  // 标题/列宽收敛 + 列表展示类型/缩略图注入）
  let selMeta: Object = {};
  for (sc2 in selColCfgs) {
    if (sc2["ref"] == null || sc2["ref"] == "" || sc2["ref"].indexOf(".") > 0) { continue; }
    selMeta[sc2["ref"]] = { label: sc2["label"], width: sc2["width"],
                            displayType: sc2["displayType"],
                            listThumbWidth: sc2["listThumbWidth"],
                            listThumbHeight: sc2["listThumbHeight"],
                            tagItems: (sc2["tagItems"] != null ? sc2["tagItems"] : []) };
  }
  // ── 编辑视图（editCols：显式列出=进表单）──
  let editColCfgs: Object[] = [];
  if (table["editCols"] != null) {
    editColCfgs = table["editCols"];
  }
  let editColMap: Object = {};
  for (ec0 in editColCfgs) {
    if (ec0["ref"] != null && ec0["ref"] != "") {
      editColMap[ec0["ref"]] = ec0;
    }
  }
  let hasEditCols: Bool = (editColCfgs.length > 0);
  // ── 联表外键列自动下拉推导（fkMap：本表外键列 → 目标表信息）──
  let fkMap: Object = {};
  if (joinContext != null) {
    for (pro0 in joinContext) {
      let jctx: Object = joinContext[pro0];
      if (jctx["fk"] != null && jctx["fk"] != "") {
        fkMap[jctx["fk"]] = {
          targetTable: jctx["tableName"],
          pk: (jctx["pk"] != null && jctx["pk"] != "" ? jctx["pk"] : "id"),
          pro: pro0
        };
      }
    }
  }
  // ── 全局枚举列集合（查询自动 select：域继承走列的 enum 取值域）──
  let geSet: Object = {};
  let geRaw: String[] = [];
  if (table["globalEnumCols"] != null) {
    geRaw = table["globalEnumCols"];
  }
  for (g0 in geRaw) { geSet[g0] = true; }
  let manualUpdate: Bool = (table["manualUpdateTime"] == true);

  let cols: Object[] = [];
  let queryFields: Object[] = [];
  let handled: Object = {};  // 已生成查询字段的 ref（gap 优先 range，like 普通输入即可）
  let rawCols: Object[] = [];
  if (table["columns"] != null) {
    rawCols = table["columns"];
  }
  // 列级标题（columns[].title）：字段呈现标题列的持久化落点，列表/查询/编辑
  // 三视图共用。回退链：selCols.label > title > 列注释 > ref（此处只补缺不覆盖）
  let rcLenT: Number = rawCols.length;
  for (let ti = 0; ti < rcLenT; ti = ti + 1) {
    let rcT: Object = rawCols[ti];
    let colTitle: String = rcT["title"];
    if (colTitle != null && colTitle != "" && selLabelOf[rcT["name"]] == null) {
      selLabelOf[rcT["name"]] = colTitle;
    }
  }
  let rcLen = rawCols.length;
  for (let i = 0; i < rcLen; i = i + 1) {
    let rc: Object = rawCols[i];
    let colName: String = rc["name"];
    // 表内枚举命中该列？（enums[].column == 列名）
    let enumDef: Object = null;
    let eLen = tableEnums.length;
    for (let ei = 0; ei < eLen; ei = ei + 1) {
      if (tableEnums[ei]["column"] == colName) {
        enumDef = tableEnums[ei];
        break;
      }
    }

    // ── 编辑视图收敛：显式配置 > 外键下拉 > mysqlType 推导 ──
    let ec: Object = editColMap[colName];
    let widget: String = "";
    if (ec != null && ec["widget"] != null && ec["widget"] != "") {
      widget = ec["widget"];
    } else {
      widget = widgetFromMysqlType(rc["mysqlType"]);
    }
    // 联表外键列 → 自动下拉（joinTable 红利：编辑不再手填外键数字）
    let fkInfo: Object = fkMap[colName];
    if (fkInfo != null && widget != "boolean" && widget != "date" && widget != "image") {
      widget = "select";
    }
    let editCol: Object = null;
    if (ec != null) {
      editCol = {
        widget: widget,
        visible: (ec["visible"] != false),
        required: (ec["required"] == true)
      };
    } else if (!hasEditCols) {
      // 零配置缺省：非主键/非自增/非自动维护时间列全部进表单（等价旧 form 行为）
      let mt: String = rc["mysqlType"] ?? "";
      let mtLow: String = mt.toLowerCase();
      let isDateTime: Bool = (mtLow.indexOf("datetime") >= 0 || mtLow.indexOf("timestamp") >= 0);
      let isAutoTimeCol: Bool =
          (isDateTime && (colName == "create_time" || (colName == "update_time" && !manualUpdate)));
      if (!rc["isPrimary"] && !rc["isAutoInc"] && !isAutoTimeCol) {
        editCol = { widget: widget, visible: true, required: false };
      }
    }
    let col: Object = buildJsonvueColumn(rc, enumDef, editCol);
    // 列级标题：唯一来源 = 「字段呈现」的标题列（空=回退列注释）。
    // queryName 与 editName 必须同时赋值：加工器 processColumns 里
    // editName 由 queryName 派生，只改 editName 会被覆盖回列注释。
    // 列表选中时下方 selCols 收敛会再用 selCols.label（同样来自标题列）覆盖，
    // 未选中时（仅编辑/查询用）则以此处 title 为准。
    if (rc["title"] != null && rc["title"] != "") {
      col["queryName"] = rc["title"];
      col["editName"] = rc["title"];
    }
    // 列级取值域（方案 B 中心化：物理列声明一次，列渲染/编辑/查询三处共享；
    // 联表虚拟列无列定义不涉及。声明优先于外键自动推导，见下方 guard）
    if (rc["domainType"] != null && rc["domainType"] != "") {
      col["domainType"] = rc["domainType"];
      if (rc["domainSourceFile"] != null) { col["domainSourceFile"] = rc["domainSourceFile"]; }
      if (rc["domainSourceId"] != null) { col["domainSourceId"] = rc["domainSourceId"]; }
      if (rc["domainUrl"] != null) { col["domainUrl"] = rc["domainUrl"]; }
    }
    // 编辑表单上传绑定与编辑缩略图（editCols 级键，image/upload 控件生效）
    if (ec != null) {
      if (ec["uploadSourceFile"] != null && ec["uploadSourceFile"] != "") {
        col["uploadSourceFile"] = ec["uploadSourceFile"];
      }
      if (ec["uploadSourceId"] != null && ec["uploadSourceId"] != "") {
        col["uploadSourceId"] = ec["uploadSourceId"];
      }
      if (ec["editThumbWidth"] != null && ec["editThumbWidth"] > 0) {
        col["editThumbWidth"] = ec["editThumbWidth"];
      }
      if (ec["editThumbHeight"] != null && ec["editThumbHeight"] > 0) {
        col["editThumbHeight"] = ec["editThumbHeight"];
      }
      // 编辑表单精细参数（键名与 .jsonvue 一致；write.tpl 按控件类型消费）
      if (ec["placeholder"] != null && ec["placeholder"] != "") {
        col["placeholder"] = ec["placeholder"];
      }
      if (ec["maxlength"] != null && ec["maxlength"] > 0) {
        col["maxlength"] = ec["maxlength"];
      }
      if (ec["textareaRows"] != null && ec["textareaRows"] > 0) {
        col["textareaRows"] = ec["textareaRows"];
      }
      if (ec["minValue"] != null && ec["minValue"] != 0) {
        col["minValue"] = ec["minValue"];
      }
      if (ec["maxValue"] != null && ec["maxValue"] != 0) {
        col["maxValue"] = ec["maxValue"];
      }
      if (ec["precision"] != null && ec["precision"] > 0) {
        col["precision"] = ec["precision"];
      }
      if (ec["dateFormat"] != null && ec["dateFormat"] != "") {
        col["dateFormat"] = ec["dateFormat"];
      }
      if (ec["formSpan"] != null && ec["formSpan"] > 0) {
        col["formSpan"] = ec["formSpan"];
      }
      if (ec["defaultValue"] != null && ec["defaultValue"] != "") {
        col["defaultValue"] = ec["defaultValue"];
      }
    }
    // 联表外键列 → 自动下拉（列级取值域已声明时尊重用户配置，不覆盖）
    if (fkInfo != null && col["editStyle"] == "select" &&
        (col["domainType"] == null || col["domainType"] == "")) {
      col["domainType"] = "remote";
      col["domainUrl"] = "/" + fkInfo["targetTable"] + "/selectByIn";
      col["selectValueField"] = fkInfo["pk"];
      col["selectLabelField"] = labelColOfTarget(
          joinContext != null ? joinContext[fkInfo["pro"]]["types"] : null);
    }
    cols.append(col);
  }
  // 列表收敛：配了 selCols 时，未命中的本表列 queryVisible=false；
  // 命中列应用 selCols 的 label（标题）、width（列宽）与 displayType/listThumb*
  if (hasSelCols) {
    let cLen2 = cols.length;
    for (let ci = 0; ci < cLen2; ci = ci + 1) {
      let cn: Object = cols[ci];
      let meta: Object = selMeta[cn["dataName"]];
      if (meta == null) {
        cn["queryVisible"] = false;
      } else {
        if (meta["label"] != null && meta["label"] != "") {
          cn["queryName"] = meta["label"];
        }
        if (meta["width"] != null && meta["width"] > 0) {
          cn["columnWidth"] = meta["width"];
        }
        // 列表展示类型/缩略图（显式配置覆盖 buildJsonvueColumn 的按控件推导）
        if (meta["displayType"] != null && meta["displayType"] != "") {
          cn["displayType"] = meta["displayType"];
        }
        // 方案 1：selCols 手工标签映射（优先级最高，覆盖表内枚举/取值域/
        // displayType 推导；映射隐含 tag 展示）
        if (meta["tagItems"] != null && meta["tagItems"].length > 0) {
          cn["displayType"] = "tag";
          cn["tagItems"] = meta["tagItems"];
        }
        if (meta["listThumbWidth"] != null && meta["listThumbWidth"] > 0) {
          cn["listThumbWidth"] = meta["listThumbWidth"];
        }
        if (meta["listThumbHeight"] != null && meta["listThumbHeight"] > 0) {
          cn["listThumbHeight"] = meta["listThumbHeight"];
        }
      }
      cols[ci] = cn;
    }
  }
  // 联表 ref → 虚拟列（dataName=别名 pro_col，只读不进编辑表单；label>注释>别名）
  for (jr in selJoinRefs) {
    let dot: Number = jr.indexOf(".");
    let pro: String = jr.substring(0, dot);
    let tcolName: String = jr.substring(dot + 1);
    let alias: String = pro + "_" + tcolName;
    let label: String = selLabelOf[jr];
    if (label == null || label == "") {
      let ctx: Object = null;
      if (joinContext != null) { ctx = joinContext[pro]; }
      if (ctx != null && ctx["comments"] != null && ctx["comments"][tcolName] != null) {
        label = ctx["comments"][tcolName];
      } else {
        label = alias;
      }
    }
    cols.push({
      dataName: alias,
      queryName: label,
      editName: label,
      queryVisible: true,
      editVisible: false,
      editEditable: false,
      switchEditable: false,
      required: false,
      formSpan: 12,
      columnWidth: 0,
      maxlength: 0,
      placeholder: "",
      textareaRows: 4,
      boolTrueText: "启用",
      boolFalseText: "禁用",
      tagItems: [],
      dateFormat: "",
      editStyle: "text"
    });
  }

  // 联表输出别名（joinTables 新格式）→ 虚拟列（dataName=表名_列名，与后端
  // EnXxxView 返回键对齐；编辑列勾选时进编辑表单但固定只读展示（editEditable=false）；
  // label>目标列标题(title)>目标列注释>别名；tag 样式 = selCols 手工映射（方案 1）
  // 优先，否则自动继承目标表内枚举（方案 3，零配置））
  for (ar in selAliasRefs) {
    let am: Object = aliasMeta != null ? aliasMeta[ar] : null;
    let label2: String = selLabelOf[ar];
    if (label2 == null || label2 == "") {
      if (am != null && am["title"] != null && am["title"] != "") {
        label2 = am["title"];
      } else if (am != null && am["comment"] != null && am["comment"] != "") {
        label2 = am["comment"];
      } else {
        label2 = ar;
      }
    }
    // 编辑列勾选（editCols 命中别名）→ 编辑表单内只读展示
    let aec: Object = editColMap[ar];
    let aEditVisible: Bool = (aec != null && aec["visible"] != false);
    // ── tag 样式推导（方案 1 手工映射优先，方案 3 自动继承兜底）──
    let vTagItems: Object[] = [];
    let vMeta: Object = selMeta[ar];
    if (vMeta != null && vMeta["tagItems"] != null && vMeta["tagItems"].length > 0) {
      vTagItems = vMeta["tagItems"];
    } else if (am != null && am["enumItems"] != null && am["enumItems"].length > 0) {
      let eis: Object[] = am["enumItems"];
      let eisLen = eis.length;
      for (let eix = 0; eix < eisLen; eix = eix + 1) {
        vTagItems.append({ value: eis[eix]["value"], text: eis[eix]["label"],
                           color: tagColorOf(eix) });
      }
    }
    cols.push({
      dataName: ar,
      queryName: label2,
      editName: label2,
      queryVisible: true,
      editVisible: aEditVisible,
      editEditable: false,
      switchEditable: false,
      required: false,
      formSpan: 12,
      columnWidth: 0,
      maxlength: 0,
      placeholder: "",
      textareaRows: 4,
      boolTrueText: "启用",
      boolFalseText: "禁用",
      tagItems: vTagItems,
      displayType: (vTagItems.length > 0 ? "tag" : ""),
      dateFormat: "",
      editStyle: "text"
    });
  }

  // ── 列顺序收敛：配了 selCols 时，列表列按「字段呈现」勾选顺序输出 ──────
  //  物理列原按 columns[]（字段页）顺序生成、联表别名固定垫尾，此处统一重排；
  //  未勾选列表的列追加在后（仅编辑/查询用，不影响列表列序）
  if (hasSelCols) {
    let orderedCols: Object[] = [];
    for (sc3 in selColCfgs) {
      let r5: String = sc3["ref"];
      if (r5 == null || r5 == "") { continue; }
      let found3: Bool = false;
      let cLen3 = cols.length;
      for (let oi = 0; oi < cLen3; oi = oi + 1) {
        if (cols[oi]["dataName"] == r5) {
          orderedCols.append(cols[oi]);
          found3 = true;
          break;
        }
      }
      if (!found3) {
        printLog("提示：列表列 '" + r5 + "' 无法生成（非本表字段/联表输出别名），已跳过");
      }
    }
    let cLen4 = cols.length;
    for (let oi2 = 0; oi2 < cLen4; oi2 = oi2 + 1) {
      let cn2: Object = cols[oi2];
      let inSel: Bool = false;
      for (sc4 in selColCfgs) {
        if (sc4["ref"] != null && sc4["ref"] == cn2["dataName"]) { inSel = true; break; }
      }
      if (!inSel) { orderedCols.append(cn2); }
    }
    cols = orderedCols;
  }

  // ── 查询字段合成（ref 通用流程；联表 ref 参数名=别名，与后端对齐）──────
  //  精确 selColsEq：本表时间列 → 日期选择；范围 selColsGap → relation=range；
  //  模糊 selColsLike → 文本。控件自动推导：
  //    - globalEnumCols 命中列 / 联表 ref / 本表外键列 → select（域继承或远程）
  //    - visible=false 的条件只生成后端，前端不渲染（此处 continue）
  // 精确查询（selColsEq）
  for (qc0 in eqRefs) {
    let r2: String = qc0["ref"];
    if (r2 == null || r2 == "" || handled[r2] == true) { continue; }
    handled[r2] = true;
    if (qc0["visible"] == false) { continue; }  // 仅后端生成条件，前端不渲染
    queryFields.push(makeQueryField(r2, "eq", selLabelOf, joinContext, rawCols, geSet,
                                    fkMap, qfIsDate(r2, rawCols), qfDateFmt(r2, rawCols), aliasMeta));
  }
  // 范围查询（selColsGap → relation=range，前端生成 _min/_max 两个输入）
  for (qc1 in gapRefs) {
    let r3: String = qc1["ref"];
    if (r3 == null || r3 == "" || handled[r3] == true) { continue; }
    handled[r3] = true;
    if (qc1["visible"] == false) { continue; }
    queryFields.push(makeQueryField(r3, "range", selLabelOf, joinContext, rawCols, geSet,
                                    fkMap, qfIsDate(r3, rawCols), qfDateFmt(r3, rawCols), aliasMeta));
  }
  // 模糊查询（selColsLike → 文本输入；联表/枚举/外键命中同样自动下拉）
  for (qc2 in likeRefs) {
    let r4: String = qc2["ref"];
    if (r4 == null || r4 == "" || handled[r4] == true) { continue; }
    handled[r4] = true;
    if (qc2["visible"] == false) { continue; }
    queryFields.push(makeQueryField(r4, "eq", selLabelOf, joinContext, rawCols, geSet,
                                    fkMap, false, "", aliasMeta));
  }

  // globalEnumCols 命中列 → 全局枚举取值域（domainType=enum，列渲染/编辑/查询三处共享）。
  // 引用键固定基名 global_enum.jsonsource + 枚举名（与 .jsonvue 高级页同构，路径无关）。
  // 列级取值域已声明（方案 B 中心化）时 globalEnumCols 仅作回退，不覆盖
  let geCols: String[] = [];
  if (table["globalEnumCols"] != null) {
    geCols = table["globalEnumCols"];
  }
  let geLen = geCols.length;
  for (let gi = 0; gi < geLen; gi = gi + 1) {
    let geName: String = geCols[gi];
    let matched: Bool = false;
    let cLen = cols.length;
    for (let ci = 0; ci < cLen; ci = ci + 1) {
      if (cols[ci]["dataName"] == geName) {
        matched = true;
        if (cols[ci]["domainType"] != null && cols[ci]["domainType"] != "") {
          break;  // 列级域声明优先
        }
        if (globalEnumNames != null && globalEnumNames[geName] == true) {
          // AC 不支持链式下标赋值（cols[ci]["k"]=v）→ 局部变量中转；
          // AcJsonValue 值拷贝 + 写时分离，改完必须显式写回数组元素
          let hitCol: Object = cols[ci];
          hitCol["domainType"] = "enum";
          hitCol["domainSourceFile"] = "global_enum.jsonsource";
          hitCol["domainSourceId"] = geName;
          cols[ci] = hitCol;
        } else {
          printLog("提示：列 '" + geName +
                   "' 引用的全局枚举未找到（globalEnumCols 需与 .jsonglobalenum 的枚举 name 一致），标准页按无取值域生成");
        }
        break;
      }
    }
    if (matched == false) {
      printLog("提示：globalEnumCols 中的 '" + geName + "' 不在本表字段中，已忽略");
    }
  }

  let pascal: String = snakeToPascal(modelName);
  return {
    meta: {
      // dataUrl 首段经 deriveApiBaseFromUrl 消费为 apiBase=modelName，带
      // /selectByIn 后缀与 admin_vue .jsonvue 实例（如 shop.jsonvue）同构，
      // 加工器据此拼出 POST 后缀式 URL（/shop/selectByIn|update|delete）
      dataUrl: modelName + "/selectByIn",
      // 接口函数名沿用 admin_vue 链约定：get/upd/del + Pascal + List
      queryApi: "get" + pascal + "List",
      updateApi: "upd" + pascal + "List",
      deleteApi: "del" + pascal + "List",
      // 基础按钮开关：jsontable 正向 gen*（缺省 true；缺失键=null 时按生成处理）
      // 取反为加工器约定的 no* 否定键
      noAdd: (table["genAdd"] == false),
      noDelete: (table["genDelete"] == false),
      noEdit: (table["genEdit"] == false),
      noDetail: (table["genDetail"] == false),
      description: tableComment
    },
    columns: cols,
    queryFields: queryFields,
    // 操作按钮（键名与 .jsonvue buttons 完全一致；无按钮时为 null，
    // 加工器 processButtons 对空/缺失键防御性处理）
    buttons: table["buttons"]
  };
}

// ═══════════════════════════════════════════════════════════════════════════
// 二、pure-admin 派生标记补全（渲染前的最后一跳，模板便捷键）
// ═══════════════════════════════════════════════════════════════════════════

/// @brief 为 tplData 补充 pure-admin 模板专用派生键（不改动共用加工器）
/// @param tplData buildAdminTplData 返回的完整模板数据（原地补全）
///   补充内容：
///   - 列级：isDatetimeFormat（日期 value-format 分支）、金额/浮点 precision
///     缺省兜底 2、textarea rows 缺省兜底 4、开关文字表达式改单引号字面量
///     （模板属性双引号内安全的 JS 表达式）
///   - 查询字段级：isDatetimeFormat、dataNameCamel（选项加载函数名合法标识）
///   - 弹窗按钮级：keyPascal、字段 fieldNameCamel、select url 归一与方法小写
///   - 顶层：hasQueryFields/hasMoneyDisplay/hasRemoteDialogSelect/needMessageBox
export function enrichPureTplData(tplData: Object): Object {
  // 注意：ac 的 Object 传参是 COW 值拷贝（AcJsonValue 写时分离），函数内
  // 对 tplData 的 set 不会写回外部——必须 return tplData 并在调用点接收
  let cols: Object[] = tplData["columns"];
  let hasMoneyDisplay: Bool = false;
  let colsLen = cols.length;
  for (let i = 0; i < colsLen; i = i + 1) {
    let col: Object = cols[i];
    // 日期选择器 value-format 分支（datetime 带时分秒，date 仅日期）
    col["isDatetimeFormat"] = (col["dateFormat"] == "datetime");
    // 金额/浮点 precision 缺省兜底（避免生成 minimumFractionDigits: 空参语法错误）
    if (col["isMoneyDisplay"] == true) {
      hasMoneyDisplay = true;
      if (col["precision"] == null) {
        col["precision"] = 2;
      }
    }
    if ((col["isMoney"] == true || col["isFloat"] == true) && col["precision"] == null) {
      col["precision"] = 2;
    }
    // 多行文本 rows 缺省兜底
    if (col["isTextArea"] == true && col["textareaRows"] == null) {
      col["textareaRows"] = 4;
    }
    // 开关文字表达式改单引号字面量（未引用数据源时）：
    // 引用静态数据源的表达式（boolSwitchTexts['x'].active）保持不变
    if (col["hasBoolApi"] != true) {
      col["switchActiveTextExpr"] = "'" + escapeJsStr(col["switchActiveText"]) + "'";
      col["switchInactiveTextExpr"] = "'" + escapeJsStr(col["switchInactiveText"]) + "'";
    }
  }
  tplData["hasMoneyDisplay"] = hasMoneyDisplay;

  // ── 查询字段级派生 ──
  let queryFields: Object[] = tplData["queryFields"];
  let qfLen = queryFields.length;
  for (let j = 0; j < qfLen; j = j + 1) {
    let qf: Object = queryFields[j];
    qf["isDatetimeFormat"] = (qf["dateFormat"] == "datetime");
    // 远程下拉选项加载函数名需要合法标识（dataName 可能是 snake_case）
    qf["dataNameCamel"] = snakeToCamel(qf["dataName"]);
  }
  tplData["hasQueryFields"] = (qfLen > 0);

  // ── 弹窗按钮字段级派生（自定义 Dialog 按钮的远程下拉支持）──
  let dialogBtns: Object[] = tplData["dialogButtons"];
  let hasRemoteDialogSelect: Bool = false;
  let btnLen = dialogBtns.length;
  for (let b = 0; b < btnLen; b = b + 1) {
    let btn: Object = dialogBtns[b];
    btn["keyPascal"] = snakeToPascal(btn["key"]);
    let fields: Object[] = btn["dialogFields"];
    let fieldLen = fields.length;
    for (let k = 0; k < fieldLen; k = k + 1) {
      let df: Object = fields[k];
      df["fieldNameCamel"] = snakeToCamel(df["fieldName"]);
      if (df["isSelect"] == true) {
        // select url 归一（补前导斜杠）+ 请求方法小写（http.request 用）
        let selUrl: String = df["selectUrl"];
        if (selUrl != null && selUrl != "" && selUrl.startsWith("/") == false) {
          df["selectUrl"] = "/" + selUrl;
        }
        let selMethod: String = df["selectMethod"];
        if (selMethod == null || selMethod == "") {
          selMethod = "POST";
        }
        df["selectMethodLower"] = selMethod.toLowerCase();
        hasRemoteDialogSelect = true;
      }
    }
  }
  tplData["hasRemoteDialogSelect"] = hasRemoteDialogSelect;
  // ElMessageBox 导入条件：删除确认或 Confirm 行为按钮（模板 ${if} 不支持 ||，
  // 在脚本侧预计算合并标记）
  tplData["needMessageBox"] =
    ((tplData["noDelete"] != true) || (tplData["hasConfirmButtons"] == true));
  // COW：必须返回补全后的对象，调用点接收
  return tplData;
}

// ═══════════════════════════════════════════════════════════════════════════
// 三、双轨判定：解析某表的 .jsonvue 高级页路径
// ═══════════════════════════════════════════════════════════════════════════

/// @brief 双轨判定（plan 3.3）：命中 .jsonvue → 高级页；未命中 → 标准页合成
/// @param pageName 页面名（= modelName）
/// @param webBasePath pure-admin 项目根
/// @param checkedVueFiles 可用的 .jsonvue 候选（树勾选 + params.checkedPages，已归一）
/// @return 命中的 .jsonvue 绝对路径；无（走标准页合成）返回 ""
///   解析顺序：
///     1. 候选列表中基名 == 页面名的 .jsonvue（显式指定/项目树勾选，admin_vue 同交互）
///     2. webBasePath/src/views/{pageName}/{pageName}/{pageName}.jsonvue（页面目录同名）
///     3. webBasePath/src/views/{pageName}/{pageName}.jsonvue（页面目录）
///   路径 2/3 经 derivePage 推导的 pagePath 均为 "{pageName}/{pageName}"，
///   与标准页合成的虚拟路径一致，两种来源输出位置完全相同
export function resolveJsonvuePath(pageName: String, webBasePath: String,
                                   checkedVueFiles: String[]): String {
  let found: String = "";
  // 1) 候选列表同名 .jsonvue（先到先得，文件名全项目应唯一）
  let vueLen = checkedVueFiles.length;
  for (let i = 0; i < vueLen; i = i + 1) {
    let p: String = checkedVueFiles[i];
    if (found == "" && basename(p) == pageName) {
      found = p;
    }
  }
  if (found != "") {
    return found;
  }
  // 2) pure-admin 页面目录同名（与生成产物同目录）
  let pageDir: String = webBasePath + "/src/views/" + pageName + "/" + pageName;
  let p2: String = pageDir + "/" + pageName + ".jsonvue";
  if (fileExists(p2)) {
    return p2;
  }
  // 3) 页面目录上级（.jsonvue 与页面目录平级放置）
  let p3: String = webBasePath + "/src/views/" + pageName + "/" + pageName + ".jsonvue";
  if (fileExists(p3)) {
    return p3;
  }
  return "";
}

// ═══════════════════════════════════════════════════════════════════════════
// 四、生成主入口
// ═══════════════════════════════════════════════════════════════════════════

/// @brief 生成 vue-pure-admin 后台管理界面代码
/// @param params 项目参数对象（见文件头说明）
export function generateAdminMain(params: Object): Void {
  // 统计实际写入磁盘的文件数量（writeFile 成功时 +1），结束日志汇总输出
  let generatedFileCount = 0;

  // ── 1. 输出根目录（pure-admin 项目根）：params.webBasePath，
  //      缺省回退 project.acproj 的 meta.webBasePath（见 1.2 节）──
  let basePath: String = params["webBasePath"];
  if (basePath != null) {
    basePath = basePath.replace("\\", "/");
  }

  // ── 1.1 .jsontable 配置文件收集（多文件支持）──────────────────────
  //    优先级：params.jsonTablePaths（文件数组）> params.jsonTablePath（单文件）
  //          > 收集勾选文件中的 .jsontable（与 Go 链对称）
  let jsontableFiles: String[] = [];
  let jtpArr: String[] = params["jsonTablePaths"];
  if (jtpArr != null) {
    let jaLen = jtpArr.length;
    for (let ja = 0; ja < jaLen; ja = ja + 1) {
      jsontableFiles.append(jtpArr[ja].replace("\\", "/"));
    }
  }
  let jtpSingle: String = params["jsonTablePath"];
  if (jsontableFiles.length == 0 && jtpSingle != null && jtpSingle != "") {
    jsontableFiles.append(jtpSingle.replace("\\", "/"));
  }
  if (jsontableFiles.length == 0) {
    let checkedAll: String[] = getCheckedFiles(scriptDir());
    let caLen = checkedAll.length;
    for (let ca = 0; ca < caLen; ca = ca + 1) {
      let cf: String = checkedAll[ca].replace("\\", "/");
      if (cf.endsWith(".jsontable")) {
        jsontableFiles.append(cf);
      }
    }
  }
  if (jsontableFiles.length == 0) {
    printError("错误：未找到 .jsontable 配置（请配置 params.jsonTablePaths / jsonTablePath，或在项目目录勾选 .jsontable 文件）");
    return;
  }
  printLog("jsontable files: " + jsontableFiles.length + " 份");

  //  ── 1.2 项目配置（project.acproj）：webBasePath 回退来源 ────
  //    params.projPath 显式指定优先，否则从第一份 .jsontable 所在目录向上查找
  let metaWebBasePath: String = "";
  let projPath: String = params["projPath"];
  if (projPath == null || projPath.length == 0) {
    projPath = findProjPath(dirnameOf(jsontableFiles[0]), 3);
  }
  if (projPath != null && projPath.length > 0) {
    let projJson: Object = readJson(projPath);
    if (projJson == null) {
      printError("错误：项目 meta 文件读取失败: " + projPath);
      return;
    }
    let projMeta: Object = projJson["meta"];
    if (projMeta != null && projMeta["webBasePath"] != null) {
      metaWebBasePath = projMeta["webBasePath"];
    }
    printLog("项目 meta: " + projPath);
  }

  // webBasePath：params 优先，回退项目 meta
  if (basePath == null || basePath == "") {
    basePath = metaWebBasePath;
  }
  if (basePath == null || basePath == "") {
    printError("错误：未配置 webBasePath（params.webBasePath 与 project.acproj meta.webBasePath 均为空）");
    return;
  }
  basePath = basePath.replace("\\", "/");

  // ── 2. 模板配置：一个模板对应一个生成的代码文件 ───────────────────
  //    字段说明：
  //      tpl  - 模板文件路径（相对入口脚本目录，即 scriptDir()）
  //      out  - 输出文件路径模板，用 {key} 占位符从 tplData 取值
  //             支持的占位符：{basePath}、{pagePath}、{apiModule}、{pageName}
  let templates: TemplateConfig[] = params["templates"];
  if (templates == null) {
    templates = [
      { tpl: "../template/index.tpl", out: "{basePath}/src/views/{pagePath}/index.vue" },
      { tpl: "../template/write.tpl", out: "{basePath}/src/views/{pagePath}/components/write.vue" },
      { tpl: "../template/api.tpl", out: "{basePath}/src/api/{apiModule}/{pageName}.ts" }
    ];
  }

  // ── 2.1 数据源模板配置：勾选的 .jsonsource 文件 → 数据源 api 文件 ──
  //    out 支持的占位符：{basePath}、{sourceName}（.jsonsource 文件基名）
  let sourceTemplates: TemplateConfig[] = params["sourceTemplates"];
  if (sourceTemplates == null) {
    sourceTemplates = [
      { tpl: "../template/source.tpl", out: "{basePath}/src/api/source/{sourceName}.ts" }
    ];
  }

  // ── 2.2 上传预设模板配置：勾选的 .jsonupload 文件 → 共享上传 api 文件 ──
  //    out 支持的占位符：{basePath}、{uploadName}（.jsonupload 文件基名）
  let uploadTemplates: TemplateConfig[] = params["uploadTemplates"];
  if (uploadTemplates == null) {
    uploadTemplates = [
      { tpl: "../template/upload.tpl", out: "{basePath}/src/api/upload/{uploadName}.ts" }
    ];
  }

  // ── 3. 读取多份 .jsontable：单表新格式逐文件收集（事实源，不连库）──
  //    一文件一表：{ table: {...} }，翻译表内嵌在表的 i18n 配置；
  //    旧多表格式（tables 键）明确报错指路拆分脚本；
  //    单文件失败即中止（配置不完整时生成的双端代码会互相矛盾）；
  //    跨文件重复 modelName 由下方统一检查拦截
  let tables: Object[] = [];
  let jtfLen = jsontableFiles.length;
  for (let tj = 0; tj < jtfLen; tj = tj + 1) {
    let jtf: String = jsontableFiles[tj];
    let tableJson: Object = readJson(jtf);
    if (tableJson == null) {
      printError("错误：.jsontable 配置读取失败：" + jtf);
      return;
    }
    if (tableJson["tables"] != null) {
      printError("错误：旧多表格式（含 tables 键）：" + jtf);
      printError("      请先运行 file/tools/split_jsontable.ac 拆分为一文件一表新格式");
      return;
    }
    let t: Object = tableJson["table"];
    if (t == null) {
      printError("错误：.jsontable 缺少顶层 table 键：" + jtf);
      return;
    }
    // 目录结构 = 模块结构：记录相对扫描根（入口脚本目录）的目录段，
    // 供标准页 pagePath/apiModule 推导；不在扫描根下时为 ""（回退旧行为）
    t["_relDir"] = relDirUnder(jtf, scriptDir());
    tables.append(t);
    printLog("jsontable: " + jtf + "（" + t["tableName"] + "）");
  }
  printLog("jsontable tables count: " + tables.length);

  // 同名表检查：两个 modelName 相同会生成到同一目录互相覆盖
  let seenModels: Object = {};
  let tblLen = tables.length;
  for (let tc = 0; tc < tblLen; tc = tc + 1) {
    let m: String = tables[tc]["modelName"];
    if (m == null || m == "") {
      m = tables[tc]["tableName"];
    }
    if (seenModels[m] == true) {
      printError("错误：.jsontable 存在重复 modelName（" + m +
                 "），生成结果会互相覆盖，请修正后重新执行");
      return;
    }
    seenModels[m] = true;
  }

  // ── 3.1 联表上下文（joinContext）：引用名 → {tableName, comments, types} ──
  //    供标准页合成虚拟列与查询字段时解析联表 ref（pro.col → 目标列注释/类型）；
  //    joinEnClass 按modelName 线性定位目标表，未声明/未启用条目不进上下文
  let joinContext: Object = {};
  for (let jc = 0; jc < tblLen; jc = jc + 1) {
    let jtCfgs: Object[] = tables[jc]["joinTable"];
    if (jtCfgs == null) { continue; }
    for (jci in jtCfgs) {
      if (jci["isJoinRelations"] == false) { continue; }
      let jtp: String = jci["joinType"];
      if (jtp == null || jtp == "") { jtp = "ManyToOne"; }
      if (jtp != "ManyToOne") { continue; }  // OneToMany 详情聚合 v1 未支持
      let pro: String = jci["joinEnClassPro"];
      let cls: String = jci["joinEnClass"];
      if (pro == null || pro == "" || cls == null || cls == "") { continue; }
      let target: Object = null;
      for (let tk = 0; tk < tblLen; tk = tk + 1) {
        let tm: String = tables[tk]["modelName"];
        if (tm == null || tm == "") { tm = tables[tk]["tableName"]; }
        if (tm == cls) { target = tables[tk]; break; }
      }
      if (target == null) {
        printLog("提示：表联表 '" + pro + "' 的目标 '" + cls + "' 不在 tables[] 中，标准页按无上下文合成");
        continue;
      }
      let comments: Object = {};
      let types: Object = {};
      let tCols: Object[] = target["columns"];
      for (tcol in tCols) {
        comments[tcol["name"]] = tcol["comment"];
        types[tcol["name"]] = tcol["mysqlType"];
      }
      // fk/pk：本表外键列与目标主键列（供编辑/查询外键列自动下拉推导）
      let jFk: String = jci["joinFk"];
      let jPk: String = (jci["joinPk"] != null && jci["joinPk"] != "") ? jci["joinPk"] : "id";
      joinContext[pro] = {
        tableName: target["tableName"],
        fk: jFk,
        pk: jPk,
        comments: comments,
        types: types
      };
    }
  }

  // ── 联表输出别名上下文（joinTables 新格式）：别名 → {comment, mysqlType, ──
  //    title, enumItems}。目标表按 tableName 定位；与旧 joinContext 并存。
  //    title/enumItems 供方案 3 自动继承：目标列标题补显示名、目标表内枚举
  //    推导列表 tag 样式（零配置），均取自目标表配置，无额外解析
  let aliasMeta: Object = {};
  for (let jz = 0; jz < tblLen; jz = jz + 1) {
    let jtSpecs: Object[] = tables[jz]["joinTables"];
    if (jtSpecs == null) { continue; }
    for (js in jtSpecs) {
      let jtName: String = js["table"];
      if (jtName == null || jtName == "") { continue; }
      let target2: Object = null;
      for (let tk2 = 0; tk2 < tblLen; tk2 = tk2 + 1) {
        if (tables[tk2]["tableName"] == jtName) { target2 = tables[tk2]; break; }
      }
      if (target2 == null) {
        printLog("提示：联表 '" + jtName + "' 的目标不在 tables[] 中，别名上下文跳过");
        continue;
      }
      // 目标表内枚举索引（column → items）：方案 3 自动继承的数据源
      let jtEnums: Object = {};
      let tgtEnums: Object[] = target2["enums"];
      if (tgtEnums != null) {
        for (te in tgtEnums) {
          if (te["column"] != null && te["column"] != "" && te["items"] != null) {
            jtEnums[te["column"]] = te["items"];
          }
        }
      }
      let colsSpec: Object[] = js["cols"];
      if (colsSpec == null) { continue; }
      for (cs in colsSpec) {
        let cn: String = cs["col"];
        if (cn == null || cn == "") { continue; }
        let cm: String = "";
        let mt: String = "";
        let tt: String = "";
        let tCols2: Object[] = target2["columns"];
        for (tcol2 in tCols2) {
          if (tcol2["name"] == cn) {
            cm = tcol2["comment"];
            mt = tcol2["mysqlType"];
            tt = tcol2["title"];
            break;
          }
        }
        aliasMeta[jtName + "_" + cn] = { comment: cm, mysqlType: mt, title: tt,
                                         enumItems: jtEnums[cn] };
      }
    }
  }

  // ── 4. 收集勾选文件（.jsonvue 高级页 / .jsonsource / .jsonupload）──
  //    传入 scriptDir() 确保只处理本项目下的勾选文件，
  //    其它项目的勾选文件即使被选中也不会被执行
  let rawFiles: String[] = getCheckedFiles(scriptDir());
  let allFiles: String[] = [];
  let rfLen = rawFiles.length;
  for (let fi = 0; fi < rfLen; fi = fi + 1) {
    allFiles.append(rawFiles[fi].replace("\\", "/"));
  }
  // params.checkedPages：显式指定的 .jsonvue 高级页（与项目树勾选合并去重）
  let checkedPages: String[] = params["checkedPages"];
  if (checkedPages == null) {
    checkedPages = [];
  }
  let cpLen = checkedPages.length;
  for (let ci = 0; ci < cpLen; ci = ci + 1) {
    let cpNorm: String = checkedPages[ci].replace("\\", "/");
    let seenCp: Bool = false;
    let afLen = allFiles.length;
    for (let cj = 0; cj < afLen; cj = cj + 1) {
      if (allFiles[cj] == cpNorm) {
        seenCp = true;
      }
    }
    if (seenCp == false) {
      allFiles.push(cpNorm);
    }
  }

  // 按后缀分组：.jsonvue 高级页 / .jsonsource 数据源 / .jsonupload 上传预设
  let checkedVueFiles: String[] = [];
  let sourceFiles: String[] = [];
  let uploadFiles: String[] = [];
  let afLen2 = allFiles.length;
  for (let fk = 0; fk < afLen2; fk = fk + 1) {
    let f: String = allFiles[fk];
    if (f.endsWith(".jsonvue")) {
      checkedVueFiles.push(f);
    } else if (f.endsWith(".jsonsource")) {
      sourceFiles.push(f);
    } else if (f.endsWith(".jsonupload")) {
      uploadFiles.push(f);
    }
  }

  // ── 4.1 检查勾选文件是否同名不同路径（文件重复）────────────────
  //    两个 basename 相同的文件同时存在会导致数据源查找/生成结果互相覆盖
  let seenBases: String[] = [];
  let dupFiles: String[] = [];
  let abLen = allFiles.length;
  for (let di = 0; di < abLen; di = di + 1) {
    let base: String = basename(allFiles[di]);
    let seen: Bool = false;
    let sbLen = seenBases.length;
    for (let dj = 0; dj < sbLen; dj = dj + 1) {
      if (seenBases[dj] == base) {
        seen = true;
      }
    }
    if (seen == true) {
      dupFiles.push(base);
    } else {
      seenBases.push(base);
    }
  }
  if (dupFiles.length > 0) {
    printError("错误：勾选文件存在同名不同路径（文件重复），请取消勾选其中一个后重新执行：");
    let dupLen = dupFiles.length;
    for (let dn = 0; dn < dupLen; dn = dn + 1) {
      printError("  - " + dupFiles[dn]);
    }
    return;
  }

  // ── 5. 全局枚举同步（沿用 admin_vue 链路，方案 B：内存转换不落盘）──
  //    两级作用域收集合并（就近在前）：
  //      1. params.projectApiPath 指定的后端 API 项目目录（可选，项目级枚举；
  //         如 file/crud_gin/<项目>，前端目录树够不到后端项目子目录）
  //      2. 查找链上的共享层配置（如 file/crud_nest/*.jsonglobalenum）
  //    合并后转成与 .jsonsource 同构的静态数据源：既播种 sourceMap（页面
  //    枚举列引用），也照常渲染 src/api/source/global_enum.ts
  let globalEnumSources: Object[] = null;
  if (params["genGlobalEnum"] != false) {
    let geFiles: String[] = [];
    let projDir: String = params["projectApiPath"];
    if (projDir != null && projDir != "") {
      if (fileExists(projDir)) {
        // 目录下全部 *.jsonglobalenum（按文件名序）作为项目级配置收集
        let projNames: String[] = listFiles(projDir, ".jsonglobalenum");
        let pnLen = projNames.length;
        for (let pi = 0; pi < pnLen; pi = pi + 1) {
          geFiles.append(projDir.replace("\\", "/") + "/" + projNames[pi]);
        }
      } else {
        printLog("警告：projectApiPath 不存在: " + projDir);
      }
    }
    let sharedFiles: String[] = findGlobalEnumFiles(scriptDir());
    let shLen = sharedFiles.length;
    for (let si = 0; si < shLen; si = si + 1) {
      geFiles.append(sharedFiles[si]);
    }
    if (geFiles.length > 0) {
      printLog("global enum files: " + geFiles.length + " 份（就近优先合并）");
      let geJson: Object = mergeGlobalEnumFiles(geFiles);
      let srcObj: Object = buildGlobalEnumJsonSource(geJson);
      let srcList: Object[] = srcObj["sources"];
      if (srcList != null && srcList.length > 0) {
        // 方案 B 不落盘：枚举源仅在内存中转换为统一静态源格式，
        // jsonSourcePath 是虚拟路径（仅供 basename 推导 sourceName=global_enum）
        let srcData: Object = buildSourceTplData(srcObj, scriptDir() + "/api/global_enum.jsonsource");
        globalEnumSources = srcData["sources"];
        // 渲染 source 链路（与勾选 .jsonsource 的处理一致）→ src/api/source/global_enum.ts
        let stLen = sourceTemplates.length;
        for (let gi = 0; gi < stLen; gi = gi + 1) {
          let geOutPath: String = formatPath(sourceTemplates[gi].out, {
            basePath: basePath,
            sourceName: srcData["sourceName"]
          });
          let geResult: String = renderTpl(sourceTemplates[gi].tpl, srcData);
          if (geResult) {
            if (canOverwriteGenerated(geOutPath)) {
              let geWriteOk: Bool = writeFile(geOutPath, geResult);
              if (geWriteOk == true) {
                generatedFileCount = generatedFileCount + 1;
              }
              printLog("生成文件: " + geOutPath);
            }
          }
        }
      } else {
        printLog("全局枚举配置为空，跳过数据源同步");
      }
    } else {
      printLog("未找到 global_enum.jsonglobalenum，跳过全局枚举数据源同步");
    }
  } else {
    printLog("genGlobalEnum=false，跳过全局枚举数据源同步");
  }

  // ── 5.1 全局枚举名集合（供标准页合成 globalEnumCols 引用校验）────────
  let globalEnumNames: Object = {};
  if (globalEnumSources != null) {
    let gesLen = globalEnumSources.length;
    for (let gn = 0; gn < gesLen; gn = gn + 1) {
      globalEnumNames[globalEnumSources[gn]["id"]] = true;
    }
  }

  // ── 6. 渲染勾选的 .jsonsource / .jsonupload（数据源/上传 api 文件）──
  //    每个 .jsonsource 生成一个 api 文件（src/api/source/{sourceName}.ts），
  //    每个 .jsonupload 生成一个共享上传文件（src/api/upload/{uploadName}.ts），
  //    供各页面下拉框/上传组件 import 引用
  let fileLen = allFiles.length;
  for (let ui = 0; ui < fileLen; ui = ui + 1) {
    let file: String = allFiles[ui];
    if (file.endsWith(".jsonsource")) {
      let srcJson: Object = readJson(file);
      let srcData: Object = buildSourceTplData(srcJson, file);
      let stLen2 = sourceTemplates.length;
      for (let sj = 0; sj < stLen2; sj = sj + 1) {
        let srcOutPath: String = formatPath(sourceTemplates[sj].out, {
          basePath: basePath,
          sourceName: srcData["sourceName"]
        });
        let srcResult: String = renderTpl(sourceTemplates[sj].tpl, srcData);
        if (srcResult) {
          if (canOverwriteGenerated(srcOutPath)) {
            let srcWriteOk: Bool = writeFile(srcOutPath, srcResult);
            if (srcWriteOk == true) {
              generatedFileCount = generatedFileCount + 1;
            }
            printLog("生成文件: " + srcOutPath);
          }
        }
      }
      continue;
    }
    if (file.endsWith(".jsonupload")) {
      let upJson: Object = readJson(file);
      let upData: Object = buildUploadTplData(upJson, file);
      let utLen = uploadTemplates.length;
      for (let uj = 0; uj < utLen; uj = uj + 1) {
        let upOutPath: String = formatPath(uploadTemplates[uj].out, {
          basePath: basePath,
          uploadName: upData["uploadName"]
        });
        let upResult: String = renderTpl(uploadTemplates[uj].tpl, upData);
        if (upResult) {
          if (canOverwriteGenerated(upOutPath)) {
            let upWriteOk: Bool = writeFile(upOutPath, upResult);
            if (upWriteOk == true) {
              generatedFileCount = generatedFileCount + 1;
            }
            printLog("生成文件: " + upOutPath);
          }
        }
      }
      continue;
    }
  }

  // ── 7. 每表双轨判定，收集待渲染页面 ─────────────────────────────
  //    .jsonvue 存在 → 高级页（读文件）；不存在 → 标准页（合成 jsonvue 形状）。
  //    合成页用"虚拟 .jsonvue 路径"喂给加工器：derivePage 从路径推导
  //    pagePath/apiModule/pageName，与真实 .jsonvue 命中时的推导结果一致，
  //    保证两种来源输出位置相同（src/views/{module}/{pageName}/）
  let pages: Object[] = [];
  let consumedVue: Object = {};
  // 先收集全部 i18n 翻译表名（与 crud_gin 同规则）：翻译表只随主表实体/接口联动，
  // 不生成独立管理页
  let i18nTables: Object = {};
  let tblLen1 = tables.length;
  for (let ti0 = 0; ti0 < tblLen1; ti0 = ti0 + 1) {
    let t0: Object = tables[ti0];
    let i18nNode: Object = t0["i18n"];
    if (i18nNode != null) {
      let i18nTbl: String = i18nNode["table"];
      if (i18nTbl != null && i18nTbl != "") {
        i18nTables[i18nTbl] = true;
      }
    }
  }
  let tblLen2 = tables.length;
  for (let ti = 0; ti < tblLen2; ti = ti + 1) {
    let table: Object = tables[ti];
    let modelName: String = table["modelName"];
    if (modelName == null || modelName == "") {
      modelName = table["tableName"];
    }
    // 翻译表跳过页面生成（printLog 说明，与后端"只生成实体"对齐）
    if (i18nTables[table["tableName"]] == true) {
      printLog("表 '" + table["tableName"] + "' 为 i18n 翻译表（被引用），跳过页面生成");
      continue;
    }
    // 纯 API 模块开关：frontend 仅显式 false 生效（键缺失=null ≠ false，缺省生成）；
    // 后端链照常生成 API，这里只裁剪前端产物
    if (table["frontend"] == false) {
      printLog("表 '" + table["tableName"] + "' frontend=false（纯 API 模块），跳过页面生成");
      continue;
    }
    let vuePath: String = resolveJsonvuePath(modelName, basePath, checkedVueFiles);
    let pageJson: Object = null;
    let filePath: String = "";
    if (vuePath != "") {
      // 双轨·高级页：同名 .jsonvue 存在，完全按 .jsonvue 走（可视化编辑全能力）
      pageJson = readJson(vuePath);
      filePath = vuePath;
      consumedVue[vuePath] = true;
      printLog("高级页（.jsonvue 双轨）：" + vuePath);
    } else {
      // 双轨·标准页：从 .jsontable 读模型合成 jsonvue 形状（零额外配置）
      pageJson = buildJsonvueFromTable(table, globalEnumNames, joinContext, aliasMeta);
      filePath = basePath + "/src/views/" + modelName + "/" + modelName + "/" + modelName + ".jsonvue";
      printLog("标准页（.jsontable 合成）：" + modelName);
    }
    if (pageJson == null) {
      printError("错误：页面配置读取失败，跳过：" + filePath);
      continue;
    }
    pages.push({
      filePath: filePath,
      json: pageJson,
      permPrefix: table["tableName"],
      // 相对扫描根目录段（目录结构 = 模块结构）：合成页 pagePath/apiModule 覆盖用；
      // 高级页（.jsonvue 命中）不带，保持按 .jsonvue 所在目录推导的既有行为
      relDir: table["_relDir"]
    });
  }

  // 未对应任何表的勾选 .jsonvue：按其所在目录推导输出路径（与 admin_vue 对等，
  // 保证非 .jsontable 管理的页面也能在新框架下生成）
  let cvLen = checkedVueFiles.length;
  for (let vi = 0; vi < cvLen; vi = vi + 1) {
    let cvPath: String = checkedVueFiles[vi];
    if (consumedVue[cvPath] == true) {
      continue;
    }
    let cvJson: Object = readJson(cvPath);
    if (cvJson == null) {
      printError("错误：.jsonvue 读取失败，跳过：" + cvPath);
      continue;
    }
    printLog("高级页（.jsonvue 独立勾选，未对应 .jsontable 表）：" + cvPath);
    pages.push({
      filePath: cvPath,
      json: cvJson,
      permPrefix: basename(cvPath)
    });
  }

  // ── 8. 统一渲染：buildAdminTplData → enrichPureTplData → 三模板写盘 ──
  //    请求后缀供加工器拼后缀式 URL（selectUrl/updateUrl/deleteUrl），与
  //    admin_vue 主链的 apiSelectSuffix/apiUpdateSuffix/apiDeleteSuffix 一致；
  //    api.tpl 与 admin_vue 同样消费这三个 URL 键（仅 http 层换 pure-admin 写法）
  //    （逐键赋值而非字面量，避开 delete 保留字作字面量键名）
  let suffixes: Object = {};
  suffixes["select"] = "selectByIn";
  suffixes["update"] = "update";
  suffixes["delete"] = "delete";
  // apiPrefix：请求 URL 前缀（params 传入，如 go_pure 后端 "/api" 路由组）；
  // 缺省不加前缀（与 admin_vue 旧链行为一致）
  if (params["apiPrefix"] != null) {
    suffixes["prefix"] = params["apiPrefix"];
  }
  let pgLen = pages.length;
  for (let pg = 0; pg < pgLen; pg = pg + 1) {
    let tplData: Object = buildAdminTplData(pages[pg]["json"], pages[pg]["filePath"],
                                            suffixes, sourceFiles, uploadFiles,
                                            globalEnumSources);
    // pure-admin 专用派生键补全（isDatetimeFormat/needMessageBox 等）
    // 注意：ac 的 Object 是 COW 语义，必须接收返回值，否则补全全部丢失
    tplData = enrichPureTplData(tplData);
    // 按钮权限前缀：与后端 RequirePerm 的 "<表>:edit/delete" 保持一致
    tplData["permPrefix"] = pages[pg]["permPrefix"];
    // 目录结构 = 模块结构：合成页用 .jsontable 相对扫描根的目录段覆盖
    // pagePath（views 分组目录）与 apiModule（api 一级目录）；
    // 高级页/独立 .jsonvue 无 relDir，保持按 .jsonvue 所在目录推导
    let rel: String = pages[pg]["relDir"];
    if (rel != null && rel != "") {
      let ppSegs: String[] = tplData["pagePath"].split("/");
      tplData["pagePath"] = rel + "/" + ppSegs[ppSegs.length - 1];
      let relSegs: String[] = rel.split("/");
      tplData["apiModule"] = relSegs[0];
    }
    let pagePath: String = tplData["pagePath"];
    printLog("processing page: " + pagePath);

    let tplLen = templates.length;
    for (let ct = 0; ct < tplLen; ct = ct + 1) {
      // 用 formatPath 替换 {basePath}/{pagePath}/{apiModule}/{pageName} 占位符
      let outPath: String = formatPath(templates[ct].out, {
        basePath: basePath,
        pagePath: pagePath,
        apiModule: tplData["apiModule"],
        pageName: tplData["pageName"]
      });
      tplData["outputPath"] = outPath;  // 供模板内的 fileExists(outputPath) 守卫使用

      // 核心：调用模板引擎，把 tpl 中的 ${变量名} 替换为实际值
      let result: String = renderTpl(templates[ct].tpl, tplData);
      if (result) {
        if (canOverwriteGenerated(outPath)) {
          let writeOk: Bool = writeFile(outPath, result);
          if (writeOk == true) {
            generatedFileCount = generatedFileCount + 1;
          }
          printLog("生成文件: " + outPath);
        }
      }
    }
  }

  printLog("--- pure-admin 代码生成结束，共生成 " + generatedFileCount + " 个文件 ---");
}
