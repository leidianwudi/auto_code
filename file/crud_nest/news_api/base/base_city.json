{
  $schema: "/crud_nest/template/tool/param.schema.json",
  tables: [
    {
      modelName: "base\\base_city",//模块名，包含路径
      tableName: "base_city",//表名
      selCols: [ "code"],// 精确查询
      //like查询
      selColsLike: ["name_zh", "name_en"],
      //排序
      selColsSort: {
        code: "ASC", name_zh: "ASC", name_en: "ASC"
      }
    }
  ]
}
