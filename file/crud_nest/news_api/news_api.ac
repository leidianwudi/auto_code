// ============================================================================
// news_api.ac — news 项目后端 API 代码生成入口脚本
// ----------------------------------------------------------------------------
// 本脚本只包含 "news 项目" 相关的参数配置，
// 具体的代码生成逻辑（数据库读取、数据加工、模板渲染）统一放在
//   ../template/main_api.ac 的 generateApiMain() 中。
//
// 流程：
//   1. 配置数据库连接（news 库）
//   2. 配置输出根目录
//   3. 调用 generateApiMain() 生成 TypeScript 后端代码
// ============================================================================
import { generateApiMain } from "../template/main_api.ac";

main {

  // ── 1. 数据库连接配置（news 项目专用）─────────────────────────────
  let dbConfig: Object = {
    host: "192.168.5.103",
    port: 3306,
    user: "root",
    password: "123456",
    database: "news"
  };

  // ── 2. 输出文件的根目录 ──────────────────────────────────────────
  let basePath: String = "D:/output";

  // ── 3. 组装项目参数并调用通用生成逻辑 ────────────────────────────
  //     如需自定义模板，可在此传入 templates（见 main_api.ac 文件头说明）
  let params: Object = {
    dbConfig: dbConfig,
    basePath: basePath
  };
  generateApiMain(params);

  printLog("--- news_api 生成结束 ---");
}