{
  // 指定 schema 文件，用于智能提示与校验
  // 以 / 开头的路径基于项目根目录（file/），所有 json 文件均可复制此行
  $schema: '/crud_nest/template/tool/param.schema.json',
  // 多表配置示例：一个 JSON 文件可配置多张表，每项都是单表配置对象
  // 每个表配 置支持：tableName、modelName、selCols、selColsLike、selColsSort、joinTable 等字段
  tables: [
    {
      // 榜单统计维度字典参数， 区分运动类型与球员/球队积分
      modelName: 'sport\\sport_score_type',
      selCols: [
        'sport_id',
        'type',
        'enable',
      ],
      selColsLike: [
        'name_zh',
        'name_en',
      ],
      selColsSort: {
        id: 'ASC',
      },
      // 设置生成表内数据枚举
      tableEnum: {
        comment: 'name_zh', //说明在表的列名
        key: 'code', //枚举key在表的列名
        value: 'id',
      },
      tableName: 'sport_score_type',
      joinTable: [
        {
          inverseJoinEnClassPro: 'sportScoreTypes',
          isJoinRelations: true,
          joinColumn: {
            name: 'sport_id',
            referencedColumnName: 'id',
          },
          joinEnClass: 'EnSportType',
          joinEnClassPro: 'sportType',
          joinEnClass_Url: 'src/sport/sport_type/entities/en_sport_type',
          joinType: 'ManyToOne',
        },
        {
          inverseJoinEnClassPro: 'scoreType',
          isJoinRelations: false,
          joinEnClass: 'EnSportScorePlayer',
          joinEnClassPro: 'sportScorePlayers',
          joinEnClass_Url: 'src/sport/sport_score_player/entities/en_sport_score_player',
          joinType: 'OneToMany',
        },
        {
          inverseJoinEnClassPro: 'scoreType',
          isJoinRelations: false,
          joinEnClass: 'EnSportScoreTeam',
          joinEnClassPro: 'sportScoreTeams',
          joinEnClass_Url: 'src/sport/sport_score_team/entities/en_sport_score_team',
          joinType: 'OneToMany',
        },
      ],
    },
  ],
},