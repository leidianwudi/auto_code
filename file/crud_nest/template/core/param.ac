// ============================================================================
// 数据类型定义 — 字段和关联关系的强类型结构
// ============================================================================

import { snakeToPascal } from "../../../tool/tool_str.ac";
import { mapTypeToTs, mapTypeToOrm, isPrimaryKey, isAutoIncrement, isCoinType } from "../../../tool/tool_db.ac";

/// @brief 数据库列 schema（db.tableSchema() 返回的原始列信息）
export class ColumnSchema {
  let name: String = "";         // 字段名
  let type: String = "";         // MySQL 类型，如 "varchar(100)"
  let key: String = "";          // 列索引类型 ("PRI" = 主键，"" = 普通)
  let extra: String = "";        // 附加信息 ("auto_increment" = 自增)
  let comment: String = "";      // 字段注释（DDL 中的 COMMENT）
  let defaultValue: String = ""; // 默认值
}

/// @brief 关联表信息（JSON 配置中的 joinTable 数组元素）
export class JoinTableInfo {
  let joinEnClass: String = "";           // 关联实体类名，如 EnNewsCategory
  let joinEnClass_Url: String = "";       // 关联实体 import 路径
  let joinType: String = "";              // 关系类型：OneToMany / ManyToOne / OneToOne / ManyToMany
  let joinEnClassPro: String = "";        // 本端属性名，如 category
  let inverseJoinEnClassPro: String = ""; // 对方属性名，如 newsList
  let joinColumn: Object = null;           // ManyToOne 所在表的外键列配置
  let isJoinRelations: Bool = false;      // 是否启用联表查询
}

/// @brief 字段定义（加工后的数据库列信息）
export class FieldDef {
  let name: String = "";           // 字段名（原样）
  let comment: String = "";        // 字段注释（@ApiProperty 的描述）
  let colType: String = "";        // 原始 MySQL 类型，如 "varchar(100)"
  let colKey: String = "";         // 列索引类型 ("PRI" = 主键)
  let colDefault: String = "";     // 列默认值
  let extra: String = "";          // 列附加信息 ("auto_increment" = 自增)
  let tsType: String = "";         // TypeScript 类型（number/string/Date/boolean/Coin）
  let isPrimary: Bool = false;     // 是否主键
  let isAutoInc: Bool = false;     // 是否自增
  let isCoin: Bool = false;        // 是否金额类型
  let columnOptions: String = "";  // @Column 的完整参数字符串
}

/// @brief 关联关系配置（TypeORM 关系装饰器参数）
export class RelationDef {
  let decoratorType: String = "";    // 装饰器类型：OneToMany / ManyToOne / OneToOne / ManyToMany
  let targetEntity: String = "";     // 目标实体类名，如 EnNewsCategory
  let propertyName: String = "";     // 本端属性名，如 category
  let inverseProperty: String = "";  // 对方属性名，如 newsList
  let isArray: Bool = false;          // OneToMany、ManyToMany 在本端表示实体数组
  let hasJoinColumn: Bool = false;    // ManyToOne 的外键列是否由配置显式指定
  let joinColumnName: String = "";   // 当前表外键列名
  let referencedColumnName: String = ""; // 目标实体的被引用列名
  let isJoinRelations: Bool = false; // 是否启用联表查询
}

/// @brief 表 schema 数据（传给 Param.setTableData 的参数）
export class TableSchemaData {
  let tableName: String = "";               // 数据库表名
  let tableDesc: String = "";               // 表说明文字
  let modelName: String = "";               // 模型路径，如 "news\news"
  let columns: ColumnSchema[] = [];         // 字段数组（来自 db.tableSchema()）
  let joinTable: JoinTableInfo[] = [];      // 关联表信息（可选）
}

// ============================================================================
// Param 类 — 数据库 schema → 模板数据结构的转换器
// ----------------------------------------------------------------------------
// 作用：
//   news_main.ac 从数据库拿到的 schema 是原始格式（列名、类型、是否主键等），
//   模板引擎需要的是"已加工好"的数据（tsType、isPrimary、columnOptions 等）。
//   本类负责完成这个中间层转换，模板只需要直接取值输出。
//
// 核心流程：
//   db.tableSchema() → Param.setTableData() 加工 → entity.tpl 直接取值渲染
//
// 说明：
//   类型映射（mapType/mapTypeToOrm/isPrimaryKey/isAutoIncrement/isCoinType）
//   与 snakeToPascal 已提取到 file/tool/ 供多项目复用，本类直接调用。
// ============================================================================
export class Param {
  let entityClass: String = "";        // 生成的 TS 实体类名，如 EnUser (由 user 派生)
  let tableName: String = "";          // 数据库表名，如 user
  let tableDesc: String = "";          // 表说明文字，用于 TS 文件中的注释
  let fields: FieldDef[] = [];         // 加工后的字段数组
  let imports: String[] = [];          // 额外的 import 语句字符串（用于关联表）
  let relations: RelationDef[] = [];   // 关联关系配置 (OneToMany / ManyToOne 等)

  // --------------------------------------------------------------------------
  // 生成 @Column 装饰器的参数字符串
  //   例如："{ type: 'varchar', default: '' }"
  //   例如："{ type: 'decimal', default: 0.00, precision: 18, scale: 2, transformer: new CoinTransformer() }"
  //
  // 输入：field 对象 (包含 colType / colKey / colDefault / extra 等)
  // 输出：字符串，会被模板直接嵌入 @Column() 中
  // --------------------------------------------------------------------------
  function getColumnOptions(field: FieldDef): String {
    let colType = field.colType;
    let colDefault = field.colDefault;

    // 先映射到 TypeORM 的 type 值（varchar / int / decimal / datetime / boolean）
    let ormType = mapTypeToOrm(colType);
    let options = "{ type: '" + ormType + "'";

      // 非主键字段需要设置默认值（主键一般是自增，不需要 default）
      if (!isPrimaryKey(field.colKey)) {
        if (isCoinType(colType)) {
          // decimal 金额字段：默认 0.00，精度和缩放用全局常量统一管理
          options += ", default: 0.00, precision: COIN_PRECISION, scale: COIN_SCALE, transformer: new CoinTransformer()";
        } else if (colType.includes("varchar") || colType.includes("char")) {
          // 字符串字段：优先用 DB 列默认值（如 code 列默认 '0'），无默认值时用空字符串
          if (colDefault != null && colDefault != "") {
            options += ", default: '" + colDefault + "'";
          } else {
            options += ", default: ''";
          }
        } else if (colType.includes("int") && !isAutoIncrement(field.extra)) {
          // 非自增的整数字段：优先用 DB 列默认值，无默认值时用 0
          if (colDefault != null && colDefault != "") {
            options += ", default: " + colDefault;
          } else {
            options += ", default: 0";
          }
        }
      }

      options += " }";
    return options;
  }

  // --------------------------------------------------------------------------
  // 主入口：处理整张表的数据，生成模板所需的完整数据结构
  //
  // 输入 data 对象的典型结构（由 news_main.ac 中 merge(json, schema) 生成）：
  //   {
  //     tableName: "news",            // 表名
  //     modelName: "news\\news",      // 模型路径，用于派生实体类名
  //     columns: [                    // 字段数组，来自 db.tableSchema()
  //       { name: "id", type: "int", key: "PRI", extra: "auto_increment", comment: "主键", default: null },
  //       { name: "title", type: "varchar(100)", key: "", extra: "", comment: "标题", default: "" },
  //       { name: "price", type: "decimal(10,2)", key: "", extra: "", comment: "价格", default: "0.00" },
  //       ...
  //     ],
  //     joinTable: [                  // 关联表信息（可选）
  //       { joinEnClass: "EnCategory", joinEnClass_Url: "./en_category",
  //         joinType: "ManyToOne", joinEnClassPro: "category",
  //         inverseJoinEnClassPro: "newsList", isJoinRelations: true },
  //       ...
  //     ]
  //   }
  //
  // 输出：本实例的 fields / imports / relations 被填充，entity.tpl 可以直接取值
  // --------------------------------------------------------------------------

  function setTableData(data: TableSchemaData): Void {
    this.tableName = data.tableName;
    this.tableDesc = data.tableDesc;

    // ── 从 modelName 派生实体类名 ──────────────────────────────────────
    //   规则：取路径最后一级 + "En" 前缀 + 首字母大写
    //   例如 "news\\news" → "news" → 首字母大写 → "EnNews"
    let parts = data.modelName.split("\\");
    let lastPart = parts[parts.length - 1];
    this.entityClass = "En" + snakeToPascal(this.tableName);

    // ── 处理字段：把原始 schema 列转换成模板需要的结构 ────────────────
    this.fields = [];
    for (col in data.columns) {
      let field = new FieldDef();
      field.name = col.name;                                     // 字段名（原样）
      field.comment = col.comment;                               // 字段注释（@ApiProperty 的描述）
      field.colType = col.type;                                  // 原始 MySQL 类型，如 "varchar(100)"
      field.colKey = col.key;                                    // 列索引类型 ("PRI" = 主键)
      field.colDefault = col["default"];                        // 列默认值（"default" 是 AC 关键字，用方括号访问）
      field.extra = col.extra;                                   // 列附加信息 ("auto_increment" = 自增)
      field.tsType = mapTypeToTs(col.type);                      // → TypeScript 类型
      field.isPrimary = isPrimaryKey(col.key);                   // → 是否主键
      field.isAutoInc = isAutoIncrement(col.extra);              // → 是否自增
      field.isCoin = isCoinType(col.type);                       // → 是否金额类型
      field.columnOptions = this.getColumnOptions(field);        // → @Column 的完整参数字符串
      this.fields.append(field);
    }

    // ── 处理关联表 ────────────────────────────────────────────────────
    //   对每个 joinTable 做两件事：
    //   1) 生成一条 import 语句，让当前实体能 import 关联实体
    //   2) 生成关系配置对象（decoratorType、targetEntity 等），模板循环生成 @OneToMany 等
    this.imports = [];
    this.relations = [];
    if (data.joinTable) {
      for (jt in data.joinTable) {
        // 生成：import { EnNewsCategory } from './en_news_category'
        let imp = "import { " + jt.joinEnClass + " } from '" + jt.joinEnClass_Url + "'";
        this.imports.append(imp);

        // 生成关系配置，对应 TypeORM 的关系装饰器
        let rel = new RelationDef();
        rel.decoratorType = jt.joinType;               // 装饰器类型：OneToMany / ManyToOne / OneToOne / ManyToMany
        rel.targetEntity = jt.joinEnClass;             // 目标实体类名，如 EnNewsCategory
        rel.propertyName = jt.joinEnClassPro;          // 本端属性名，如 category
        rel.inverseProperty = jt.inverseJoinEnClassPro; // 对方属性名，如 newsList
        rel.isArray = jt.joinType == "OneToMany" || jt.joinType == "ManyToMany";
        if (jt.joinType == "ManyToOne" && jt.joinColumn != null) {
          rel.hasJoinColumn = true;
          rel.joinColumnName = jt.joinColumn.name;
          rel.referencedColumnName = jt.joinColumn.referencedColumnName;
        }
        rel.isJoinRelations = jt.isJoinRelations;      // 是否启用联表查询
        this.relations.append(rel);
      }
    }
  }
}
