/// @file main_api.ac — 通用 TypeScript(后端 API) 代码生成主逻辑
/// ----------------------------------------------------------------------------
/// 说明：
///   本文件是 crud_nest 后端 API 代码生成的**通用主逻辑**，
///   不包含任何项目相关的参数（数据库连接、输出路径、模板配置）。
///   项目入口脚本（如 news_api.ac）只需定义项目参数并调用 generateApiMain()。
///
///   整体流程（从数据库到 TypeScript 文件）：
///     ┌─────────────┐   schema   ┌──────────┐   fields[]   ┌────────────┐
///     │ MySQL 数据库 │ ──────►    │ Param    │ ──────────►  │ entity.tpl │
///     │             │    列信息   │ (加工器)  │   关联信息     │  (模板)     │
///     └─────────────┘            └──────────┘   imports[]  └────────────┘
///                                                               │
///                                     renderTpl()               ▼
///                                                      生成 xxx.entity.ts
///
/// 接收的项目参数（params 对象）：
///   - dbConfig  数据库连接配置 {host, port, user, password, database}
///   - basePath  输出文件根目录
///   - templates 可选，模板配置数组（省略时使用本文件默认模板）
/// ----------------------------------------------------------------------------

import { Param, FieldDef } from "./core/param.ac";
import { QueryData } from "./core/query_data.ac";
import { updateAppModule } from "./app_module.ac";
import { escapeJsStr, snakeToCamel, snakeToPascal, isNumericStr } from "../../tool/tool_str.ac";

/// @brief 模板配置（一个模板对应一个生成的代码文件）
class TemplateConfig {
  let tpl: String = "";  // 模板文件路径（相对脚本目录）
  let out: String = "";  // 输出文件路径模板，用 {key} 占位符从 tplData 取值
}

/// @brief 生成后端 API 代码
/// @param params 项目参数对象（见文件头说明）
export function generateApiMain(params: Object): Number {
  // 统计实际写入磁盘的文件数量（writeFile 成功时 +1），返回给入口脚本汇总输出
  let generatedFileCount = 0;

  // ── 1. 数据库连接配置 ──────────────────────────────────────────────
  let db = new DB(params["dbConfig"]);
 
  // ── 2. 输出文件的根目录（所有代码文件都写到这个目录下）──────────
  let basePath: String = params["basePath"];

  // 统计不存在的表数量（表存在性检查失败时 +1，结束时报错汇总）
  let missingTableCount = 0;

  // ── 3. 模板配置：一个模板对应一个生成的代码文件 ─────────────────
  //    字段说明：
  //      tpl  - 模板文件路径（相对脚本目录）
  //      out  - 输出文件路径模板，用 {key} 占位符从 tplData 取值
  //             支持的占位符：{basePath}、{modelName}、{name}、{tableName} 等
  //    以后要新增 service/controller/dto 只需在这个数组里加配置即可
  let templates: TemplateConfig[] = params["templates"];
  if (templates == null) {
    templates = [
      { tpl: "../template/entities/en.tpl",      out: "{basePath}/{modelName}/entities/en_{tableName}.ts" },
      { tpl: "../template/entities/enum.tpl",    out: "{basePath}/{modelName}/entities/enum_{tableName}.ts" },
      { tpl: "../template/out/out_enum.tpl",     out: "{basePath}/{modelName}/out/out_enum_{tableName}.ts" },
      { tpl: "../template/in/in_ins.tpl",        out: "{basePath}/{modelName}/in/in_ins_{tableName}.ts" },
      { tpl: "../template/in/in_sel.tpl",        out: "{basePath}/{modelName}/in/in_sel_{tableName}.ts" },
      { tpl: "../template/out/out_page.tpl",     out: "{basePath}/{modelName}/out/out_page_{tableName}.ts" },
      { tpl: "../template/model/db_.tpl",        out: "{basePath}/{modelName}/model/{dbBaseClassFile}.ts" },
      { tpl: "../template/model/db.tpl",         out: "{basePath}/{modelName}/model/{dbClassFile}.ts" },
      { tpl: "../template/service_.tpl",         out: "{basePath}/{modelName}/{serviceBaseClassFile}.ts" },
      { tpl: "../template/service.tpl",          out: "{basePath}/{modelName}/{serviceClassFile}.ts" },
      { tpl: "../template/controller_.tpl",      out: "{basePath}/{modelName}/{controllerBaseClassFile}.ts" },
      { tpl: "../template/controller.tpl",       out: "{basePath}/{modelName}/{controllerClassFile}.ts" },
      { tpl: "../template/module.tpl",           out: "{basePath}/{modelName}/{moduleClassFile}.ts" },
    ];
  }

  // ── 4. 读取所有 JSON 配置文件（文件路径由外部配置提供）────────
  //    传入 scriptDir() 确保只处理本项目下的勾选文件，
  //    其它项目的勾选文件即使被选中也不会被执行
  let files = getCheckedFiles(scriptDir());
  let filesLen = files.length;
  printLog("files count: " + filesLen);

  // 收集成功生成的业务模块信息，全部表生成完后增量注册进 app.module.ts
  // （每项：{moduleClass, moduleClassFile, modelName}，见 app_module.ac）
  let generatedModules: Object[] = [];

  // ── 4.5 检查勾选文件是否同名不同路径（文件重复）────────────────
  //      两个 basename 相同的文件（如 user/user.json 与 vip/user.json）
  //      同时勾选会导致生成结果互相覆盖或混淆，应报错并中止生成
  let seenBases: String[] = [];
  let dupFiles: String[] = [];
  for (chk in files) {
    let base = basename(chk);
    let seen = false;
    for (sb in seenBases) {
      if (sb == base) { seen = true; }
    }
    if (seen) {
      dupFiles.push(base);
    } else {
      seenBases.push(base);
    }
  }
  if (dupFiles.length > 0) {
    printError("错误：勾选文件存在同名不同路径（文件重复），请取消勾选其中一个后重新执行：");
    for (d in dupFiles) {
      printError("  - " + d);
    }
    return;
  }

  // ── 5. 对每张表（每个 JSON 文件）执行一次完整的生成流程 ────────
  //      JSON 文件支持两种格式：
  //        1) 单表对象：{ tableName: 'user', modelName: 'user\\user', ... }
  //        2) 多表数组：{ tables: [ {...}, {...} ] }
  //      多表格式下，tables 数组中每项都是单表配置对象
  for (file in files) {

    // ── 5.1 读取 JSON 配置 ───────────────────────────────────────
    //      readJson 返回对象，若存在 tables 字段则按数组遍历，否则当作单表
    let fileJson = readJson(file);
    // 归一化为表配置数组：单表直接包一层数组，多表取 tables 字段
    let tableConfigs: Object[] = [];
    if (fileJson["tables"] != null) {
      tableConfigs = fileJson["tables"];
    } else {
      tableConfigs.append(fileJson);
    }
    let tableConfigsLen = tableConfigs.length;
    printLog("[" + file + "] tables count: " + tableConfigsLen);

    for (json in tableConfigs) {
      //printLog("json: " + json);

    // ── 5.2 从数据库读取这张表的 schema 结构 ─────────────────────
    //      db.tableSchema() 返回 columns 数组，每列包含：
    //        name   - 字段名
    //        type   - MySQL 类型（如 "varchar(100)"）
    //        key    - 索引类型（"PRI" = 主键，"" = 普通）
    //        extra  - 附加信息（"auto_increment" = 自增）
    //        comment- 字段注释（DDL 中的 COMMENT 内容）
    //        default- 默认值
    let schema = db.tableSchema({ table: json.tableName });
    let schemaLen = schema.length;

    // ── 5.2a 表存在性检查 ───────────────────────────────────────
    //      db.tableSchema() 用 INFORMATION_SCHEMA.COLUMNS 查询列，
    //      表不存在时返回空数组。此时继续生成会产出基于空字段的无意义
    //      代码，应输出红色错误提示并跳过该表（多表配置不影响其它表）。
    if (schemaLen == 0) {
      printError("错误：表不存在或无列: '" + json.tableName + "'（配置文件: " + basename(file) + "）");
      missingTableCount = missingTableCount + 1;
      continue;  // 跳过这张表，继续处理下一张
    }
    printLog("schema count: " + schemaLen);
 
    // ── 5.2b 获取表的元信息（表注释、引擎等）──────────────────────
    //      db.tableInfo() 返回 { comment: "用户表", engine: "InnoDB" }
    //      表注释来自 DDL 中的 COMMENT '用户表'
    let tblInfo = db.tableInfo({ table: json.tableName });
    printLog("table comment: " + tblInfo.comment);

    // ── 5.3 合并 JSON 配置和 schema ─
    //      merge() 只能合并对象，schema 是数组会被 toObject() 丢弃，
    //      所以需要单独把 schema 列数组挂到 combined["columns"] 上供 Param 读取
    let combined: Object = json;
    combined["columns"] = schema;                 // 表字段信息
    combined["tableDesc"] = tblInfo.comment;      // 表说明（从 DDL COMMENT 取）

    // ── 5.4 用 Param 类把原始数据加工成模板可直接使用的结构 ─────
    //      核心转换：
    //        - MySQL "int"           →  tsType "number"
    //        - MySQL "decimal(10,2)" →  tsType "Coin" + columnOptions
    //        - colKey "PRI"          →  isPrimary true
    //        - 每列字段都会生成完整的 @Column(...) 参数字符串
    let param = new Param();
    param.setTableData(combined);
    //printLog("param: " + param);//输出所有参数

    let fields = param.fields;
    let fieldsLen = fields.length;
    printLog("fields count: " + fieldsLen);

    // ── 调试输出：打印第一个字段的加工结果，验证转换是否正确 ─────
    if (fieldsLen > 0) {
      let firstField = fields[0];
      printLog("first field columnOptions: " + firstField.columnOptions);
      printLog("first field colType: " + firstField.colType);
      printLog("first field tsType: " + firstField.tsType);
    }

    // ── 5.5 用 QueryData 构建查询场景数据 ──────────────────────
    //      selFields       - InSel 查询字段列表（主键+selCols+selColsLike）
    //      sortInfo        - 排序信息（sortDesc、orderByDef、defaultOrder）
    //      whereConditions - getWhereByIn 中的条件语句
    let queryData = new QueryData();
    let selFields = queryData.buildSelFields(json, param);
    let sortInfo = queryData.buildSortInfo(json);
    let whereConditions = queryData.buildWhereConditions(selFields);

    // ── 5.5b 查询枚举数据（来自 crud_api_enum 表）────────────
    //      从 crud_api_enum 表读取当前表的枚举值配置，按 column_name 分组
    //      构建成模板所需的 {enumName, columnName, columnComment, items[]} 结构
    let enums: Object[] = [];
    let hasEnums = false;
    // apiEnums - 仅含 crud_api_enum 来源的枚举（isTableEnum=false）。
    //   tableEnum 整表枚举只生成枚举定义（enum.tpl），
    //   不生成 StringKeyOutEnum 记录（out_enum.tpl）和 getCodeRecords 接口（controller_.tpl）
    let apiEnums: Object[] = [];
    let hasApiEnums = false;
    {
      // crud_api_enum 表结构：table, column, key, value, desc, sort
      let enumRows = db.query({sql: "SELECT * FROM crud_api_enum WHERE `table` = '" + json.tableName + "' ORDER BY `column`, `sort`"});
      let enumRowsLen = enumRows.length;
      printLog("enum rows count: " + enumRowsLen);
      if (enumRowsLen > 0) {
        hasEnums = true;
        hasApiEnums = true;
        let currentCol = "";
        let currentEnum = null;
        for (er in enumRows) {
          let colName = er["column"];
          if (colName != currentCol) {
            // 新列，先把上一个枚举处理完再 append
            if (currentEnum != null) {
              // key 类型判断：valueStr 由数值判断生成（数值无引号/字符串带引号），
              // 首项带单引号 → StringKeyOutEnum，否则 NumberKeyOutEnum。
              // 不直接对 value 做算术判断：Object 标注参与 * 运算会被类型检查拒绝
              if (currentEnum.items.length > 0) {
                let vs0: String = currentEnum.items[0].valueStr;
                if (vs0.startsWith("'")) {
                  currentEnum.outEnumType = "StringKeyOutEnum";
                } else {
                  currentEnum.outEnumType = "NumberKeyOutEnum";
                }
              }
              enums.append(currentEnum);
              apiEnums.append(currentEnum);
            }
            currentCol = colName;
            // 从 schema 中查找列注释
            let colComment = "";
            for (col in schema) {
              if (col.name == currentCol) {
                colComment = col.comment;
              }
            }
            // 构建枚举名：Enum + 实体类名(去En前缀) + 列名转帕斯卡（如 in_out_type → InOutType）
            let modelBaseName = param.entityClass.substring(2);
            let colNameCap = snakeToPascal(colName);
            let enumName = "Enum" + modelBaseName + colNameCap;
            // recordsName: 从 enumName 去掉 "Enum" + modelBaseName 前缀，加 "Records"
            let recordsName = enumName.substring(4 + modelBaseName.length) + "Records";
            let methodName = "get" + recordsName;
            let enumDesc = json.tableName + " 表的 " + colNameCap + " 属性枚举";
            currentEnum = {
              columnName: currentCol,
              columnNameCap: colNameCap,
              enumName: enumName,
              columnComment: colComment,
              enumDesc: enumDesc,
              recordsName: recordsName,
              methodName: methodName,
              isTableEnum: false,
              items: []
            };
          }
          {
            // value 为数值型时去掉引号（如 "0" → 0），字符串型保留引号（如 "Normal" → 'Normal'）。
            // 用 isNumericStr 逐字符判断：v*1==v 对 DB 读出的字符串值（如 "1"）存在
            // Number 与 String 比较类型不匹配问题，导致本应无引号的数值被误判为字符串
            let v = er["value"];
            let valueStr = "'" + v + "'";
            if (isNumericStr("" + v)) {
              valueStr = "" + v;
            }
            currentEnum.items.append({
              key: snakeToPascal(er["key"]),
              value: v,
              valueStr: valueStr,
              label: er["desc"]
            });
          }
        }
        // 处理最后一个枚举再 append
        if (currentEnum != null) {
          // key 类型判断（同上：按首项 valueStr 引号判断）
          if (currentEnum.items.length > 0) {
            let vs0: String = currentEnum.items[0].valueStr;
            if (vs0.startsWith("'")) {
              currentEnum.outEnumType = "StringKeyOutEnum";
            } else {
              currentEnum.outEnumType = "NumberKeyOutEnum";
            }
          }
          enums.append(currentEnum);
          apiEnums.append(currentEnum);
        }
      }
    }

    // ── 5.5c 查询整表枚举数据（来自 JSON 的 tableEnum 配置）──────────
    //      当 JSON 配置了 tableEnum 时，直接查询源表的所有行，
    //      按 {comment, key, value} 列构建整表枚举
    //      tableEnum 格式：{ comment: 'name_zh', key: 'code', value: 'id' }
    //        comment - 用作枚举项说明的列名
    //        key     - 用作枚举键名的列名
    //        value   - 用作枚举值的列名（通常为数值型主键）
    let tableEnum: Object = json["tableEnum"];
    if (tableEnum != null) {
      let commentCol: String = tableEnum["comment"];
      let keyCol: String = tableEnum["key"];
      let valueCol: String = tableEnum["value"];

      // 查询源表所有行
      let tableRows = db.query({sql: "SELECT * FROM `" + json.tableName + "`"});
      let tableRowsLen = tableRows.length;
      printLog("tableEnum rows count: " + tableRowsLen);
      if (tableRowsLen > 0) {
        hasEnums = true;
        // 从 schema 中查找 key 列的注释
        let keyColComment = "";
        for (col in schema) {
          if (col.name == keyCol) {
            keyColComment = col.comment;
          }
        }
        // 构建枚举名：列名转帕斯卡（如 in_out_type → InOutType）
        let modelBase = param.entityClass.substring(2);
        let keyColCap: String = snakeToPascal(keyCol);
        let enumName = "Enum" + modelBase + keyColCap;
        let recordsName = keyColCap + "Records";
        let methodName = "get" + recordsName;
        let enumDesc = "从 " + json.tableName + " 表的 " + keyColCap + " 属性生成的整表枚举";
        let tableEnumObj: Object = {
          columnName: keyCol,
          columnNameCap: keyColCap,
          enumName: enumName,
          columnComment: keyColComment,
          enumDesc: enumDesc,
          recordsName: recordsName,
          methodName: methodName,
          isTableEnum: true,
          items: []
        };
        for (row in tableRows) {
          // value 为数值型时去引号（如 "1" → 1），字符串型保留引号（如 "day" → 'day'）
          // 用 isNumericStr 判断，不能用固定拼接：value 列可能是 varchar（字符串）也可能是 int
          let tv: Object = row[valueCol];
          let tvStr = "'" + tv + "'";
          if (isNumericStr("" + tv)) {
            tvStr = "" + tv;
          }
          tableEnumObj.items.append({
            key: snakeToPascal(row[keyCol]),
            value: tv,
            valueStr: tvStr,
            label: row[commentCol]
          });
        }
        // tableEnum 枚举只生成枚举定义（enum.tpl），不生成 records/接口，
        // 无需 outEnumType（模板中 ${enum.outEnumType} 仅出现在 apiEnums 循环内）
        enums.append(tableEnumObj);
      }
    }

    // 构建 enum import 名称字符串（如 "TypeRecords, VipStatusRecords"）
    // 构建 enum 枚举名列表字符串（如 "EnumUserType, EnumUserVipStatus"）
    // 仅含 apiEnums（crud_api_enum 来源）：tableEnum 整表枚举不生成 records，
    // 其 recordsName 不得出现在 import 中（out_enum 文件里已无对应导出）
    let enumImportNames = "";
    let enumNames = "";
    if (hasApiEnums) {
      let firstEnum = true;
      for (e in apiEnums) {
        if (firstEnum) {
          enumImportNames = e.recordsName;
          enumNames = e.enumName;
          firstEnum = false;
        } else {
          enumImportNames = enumImportNames + ", " + e.recordsName;
          enumNames = enumNames + ", " + e.enumName;
        }
      }
    }

    // ── 5.6 组装传给模板的数据对象 tplData ────────────────────
    //      模板中的所有 ${变量名} 都从这里取值
    let tplData: Object = {};
    tplData["entityClass"]      = param.entityClass;   // ${entityClass} 实体类名，如 EnUser
    tplData["insClass"]         = "InIns" + param.entityClass.substring(2);  // ${insClass} InIns类名，如 InInsUser
    tplData["selClass"]         = "InSel" + param.entityClass.substring(2);  // ${selClass} InSel类名，如 InSelUser
    tplData["entityClassFile"]  = "en_" + param.tableName;  // ${entityClassFile} 实体文件名，如 en_user
    tplData["tableName"]        = param.tableName;     // ${tableName}
    tplData["tableDesc"]        = combined["tableDesc"]; // ${tableDesc}
    tplData["fields"]           = param.fields;         // ${each field in fields} 循环
    tplData["insFields"]        = param.insFields;      // ${each field in insFields} 循环（in_ins 用，排除自动维护的时间列）
    tplData["imports"]          = param.imports;        // ${each imp in imports} 循环
    tplData["relations"]        = param.relations;      // ${each rel in relations} 循环
    // 联表查询属性名列表（isJoinRelations=true 的关联），如 "'sportType'"，用于 db_.tpl 的 relations
    let joinRelationNames: String[] = [];
    for (rel in param.relations) {
      if (rel.isJoinRelations) {
        joinRelationNames.append("'" + rel.propertyName + "'");
      }
    }
    tplData["relationsForQuery"] = joinRelationNames.join(", "); // ${relationsForQuery}
    // 枚举数据（来自 crud_api_enum 表）
    tplData["enums"]            = enums;                // ${each enum in enums} 循环（enum.tpl 枚举定义，含 tableEnum）
    tplData["hasEnums"]         = hasEnums;             // ${hasEnums} 是否有枚举定义
    // apiEnums - 生成 StringKeyOutEnum 记录与 getCodeRecords 接口的枚举（不含 tableEnum）
    tplData["apiEnums"]         = apiEnums;             // ${each enum in apiEnums} 循环（out_enum.tpl / controller_.tpl）
    tplData["hasApiEnums"]      = hasApiEnums;          // ${hasApiEnums} 是否有需要生成 records/接口的枚举
    tplData["enumImportNames"]  = enumImportNames;      // ${enumImportNames} import 名称列表
    tplData["enumNames"]        = enumNames;            // ${enumNames} 枚举名列表
    // 查询场景数据（由 QueryData 构建）
    tplData["selFields"]        = selFields;            // ${each field in selFields} InSel 字段循环
    tplData["sortDesc"]         = sortInfo.sortDesc;    // ${sortDesc} 排序描述
    tplData["whereConditions"]  = whereConditions;      // ${each cond in whereConditions} where 条件循环
    tplData["orderByDef"]       = sortInfo.orderByDef;  // ${orderByDef} 排序对象字面量
    tplData["defaultOrderField"] = sortInfo.defaultOrderField;  // ${defaultOrderField} 默认排序字段
    tplData["defaultOrderDir"]  = sortInfo.defaultOrderDir;     // ${defaultOrderDir} 默认排序方向
    // Db 模型类名
    let modelBaseName = param.entityClass.substring(2);  // 如 "User"
    tplData["dbBaseClass"]      = modelBaseName + "Db_"; // ${dbBaseClass} 如 UserDb_
    tplData["dbClass"]          = modelBaseName + "Db";  // ${dbClass} 如 UserDb
    tplData["dbBaseClassFile"]  = param.tableName + ".db_";  // ${dbBaseClassFile} 如 user.db_
    tplData["dbClassFile"]      = param.tableName + ".db";   // ${dbClassFile} 如 user.db
    // 变量名用小驼峰（snakeToCamel）：sport_score_type → sportScoreType
    tplData["dbVarName"]        = snakeToCamel(param.tableName) + "Db";    // ${dbVarName} 如 sportScoreTypeDb
    // OutPage 类名
    tplData["outPageClass"]     = "OutPage" + modelBaseName; // ${outPageClass} 如 OutPageUser
    // Service 类名
    tplData["serviceBaseClass"] = modelBaseName + "Service_"; // ${serviceBaseClass} 如 UserService_
    tplData["serviceClass"]     = modelBaseName + "Service";  // ${serviceClass} 如 UserService
    tplData["serviceBaseClassFile"] = param.tableName + ".service_"; // ${serviceBaseClassFile} 如 user.service_
    tplData["serviceClassFile"]     = param.tableName + ".service";  // ${serviceClassFile} 如 user.service
    tplData["serviceVarName"]       = snakeToCamel(param.tableName) + "Service";   // ${serviceVarName} 如 sportScoreTypeService
    // Controller 类名
    tplData["controllerBaseClass"] = modelBaseName + "Controller_"; // ${controllerBaseClass} 如 UserController_
    tplData["controllerClass"]     = modelBaseName + "Controller";  // ${controllerClass} 如 UserController
    tplData["controllerBaseClassFile"] = param.tableName + ".controller_"; // ${controllerBaseClassFile} 如 user.controller_
    tplData["controllerClassFile"]     = param.tableName + ".controller";  // ${controllerClassFile} 如 user.controller
    tplData["modelBaseName"]       = modelBaseName;  // ${modelBaseName} 如 User（供 ApiTags/Module 使用）
    tplData["controllerPath"]      = modelBaseName.toLowerCase(); // ${controllerPath} 控制器路由，如 user / sportscoretype（表名去下划线）
    // Module 类名
    tplData["moduleClassFile"]     = param.tableName + ".module"; // ${moduleClassFile} 如 user.module

    // ── 5.6b i18n 多语言配置处理 ─────────────────────────────────
    //      json 配置 i18n 节点时，生成"主表 + 翻译表"多语言 API：
    //        - 翻译表实体单文件生成（仅 en.tpl，不生成 in/out/service/controller/module）
    //        - 查询平铺当前语言文本（缺失回退 defaultLang），详情附全语言 map
    //        - 写入事务内 upsert 翻译行（依赖翻译表 uk(extKey, langKey) 唯一键）
    //      i18n 格式：{ table: 'shop0', extKey: 'ext_id', langKey: 'lang',
    //                   fields: ['name','intro'], defaultLang: 'zh', langFrom: 'body' }
    let hasI18n: Bool = false;
    let i18nEntityClass: String = "";
    let i18nEntityClassFile: String = "";
    let i18nExtKey: String = "";
    let i18nLangKey: String = "";
    let i18nDefaultLang: String = "zh";
    let i18nFlatFields: FieldDef[] = [];  // 平铺进主表返回结构的翻译字段
    let i18nCfg: Object = json["i18n"];
    if (i18nCfg != null) {
      let i18nTable: String = i18nCfg["table"];
      let i18nSchema = db.tableSchema({ table: i18nTable });
      if (i18nSchema.length == 0) {
        printError("错误：i18n 翻译表不存在: '" + i18nTable + "'（主表 " + json.tableName + " 的 i18n 配置被跳过）");
      } else {
        // 用 Param 加工翻译表 schema（复用全部字段映射逻辑，得 EnShop0 与字段/tsType）
        let iParam = new Param();
        let iCombined: Object = {};
        iCombined["tableName"] = i18nTable;
        iCombined["modelName"] = json.modelName;
        iCombined["columns"] = i18nSchema;
        let iTblInfo = db.tableInfo({ table: i18nTable });
        iCombined["tableDesc"] = iTblInfo.comment;
        iParam.setTableData(iCombined);
        i18nEntityClass = iParam.entityClass;
        i18nEntityClassFile = "en_" + i18nTable;

        // extKey / langKey 列存在性校验（写入与查询都依赖这两列）
        i18nExtKey = i18nCfg["extKey"];
        i18nLangKey = i18nCfg["langKey"];
        let extKeyOk = false;
        let langKeyOk = false;
        for (icol in i18nSchema) {
          if (icol.name == i18nExtKey) { extKeyOk = true; }
          if (icol.name == i18nLangKey) { langKeyOk = true; }
        }
        if (!extKeyOk || !langKeyOk) {
          printError("错误：i18n 配置的 extKey('" + i18nExtKey + "') 或 langKey('" + i18nLangKey +
                     "') 列在翻译表 " + i18nTable + " 中不存在，i18n 配置被跳过");
        } else {
          // defaultLang：语言回退目标（查询不到当前语言时用它的文本）
          if (i18nCfg["defaultLang"] != null && i18nCfg["defaultLang"] != "") {
            i18nDefaultLang = i18nCfg["defaultLang"];
          }
          // langFrom：v1 仅支持 body（语言码放请求体），配 header 时提示
          let langFrom: String = i18nCfg["langFrom"];
          if (langFrom == "header") {
            printLog("提示：i18n.langFrom=header 第一版未支持，已按 body.lang 生成（语言码放请求体）");
          }

          // 平铺字段收集：fields 中每列必须在翻译表中存在，且不与主表列重名
          //   与主表重名时平铺会覆盖主表数据 → 报错跳过 i18n
          let fieldCfg: String[] = i18nCfg["fields"];
          let fieldCfgLen = fieldCfg.length;
          let i18nInvalid = false;
          for (let fi = 0; fi < fieldCfgLen; fi = fi + 1) {
            let fname: String = fieldCfg[fi];
            let found: FieldDef = null;
            for (f in iParam.fields) {
              if (f.name == fname) { found = f; break; }
            }
            if (found == null) {
              printError("错误：i18n.fields 中的列 '" + fname + "' 在翻译表 " + i18nTable + " 中不存在，i18n 配置被跳过");
              i18nInvalid = true;
              break;
            }
            for (mf in param.fields) {
              if (mf.name == fname) {
                printError("错误：i18n.fields 中的列 '" + fname + "' 与主表 " + json.tableName +
                           " 的列重名，平铺会覆盖主表数据，i18n 配置被跳过");
                i18nInvalid = true;
                break;
              }
            }
            if (i18nInvalid) { break; }
            let ff = new FieldDef();
            ff.name = found.name;
            ff.comment = found.comment;
            ff.tsType = found.tsType;
            i18nFlatFields.append(ff);
          }

          if (!i18nInvalid) {
            hasI18n = true;
          }

          // 翻译实体：只渲染 en.tpl（无 in/out/service/controller/module），
          // 输出到主表模块的 entities 目录（en_{i18nTable}.ts）
          let iTplData: Object = {};
          iTplData["entityClass"] = iParam.entityClass;
          iTplData["tableName"] = iParam.tableName;
          iTplData["tableDesc"] = iCombined["tableDesc"];
          iTplData["fields"] = iParam.fields;
          iTplData["imports"] = iParam.imports;
          iTplData["relations"] = iParam.relations;
          iTplData["hasI18n"] = false;  // 翻译实体自身无 i18n 块
          let iOutPath = formatPath("{basePath}/{modelName}/entities/en_{tableName}.ts", {
            basePath: basePath,
            modelName: json.modelName,
            tableName: i18nTable
          });
          let iResult = renderTpl("../template/entities/en.tpl", iTplData);
          if (iResult) {
            let iOk = writeFile(iOutPath, iResult);
            if (iOk) {
              generatedFileCount = generatedFileCount + 1;
            }
            printLog("生成文件: " + iOutPath);
          }
        }
      }
    }
    // i18n fields 字面量串（"'name', 'intro'"）与自定义默认语言行（与枚举默认 zh 一致时省略，
    // 缺省回退由公共层 tool_i18n.ts 用 EnumBaseLangLang.Zh 枚举兜底）
    let i18nFieldsStr: String = "";
    let i18nFirstField = true;
    for (iff in i18nFlatFields) {
      if (i18nFirstField) {
        i18nFirstField = false;
      } else {
        i18nFieldsStr = i18nFieldsStr + ", ";
      }
      i18nFieldsStr = i18nFieldsStr + "'" + iff.name + "'";
    }
    let i18nDefaultLangLine: String = "";
    if (i18nDefaultLang != "zh") {
      i18nDefaultLangLine = "    defaultLang: '" + i18nDefaultLang + "',\n";
    }
    tplData["hasI18n"]              = hasI18n;              // ${if hasI18n} 是否配置了 i18n 多语言
    tplData["i18nEntityClass"]      = i18nEntityClass;      // ${i18nEntityClass} 翻译实体类名，如 EnShop0
    tplData["i18nEntityClassFile"]  = i18nEntityClassFile;  // ${i18nEntityClassFile} 翻译实体文件名，如 en_shop0
    tplData["i18nExtKey"]           = i18nExtKey;           // ${i18nExtKey} 翻译表外键列（关联主表 id）
    tplData["i18nLangKey"]          = i18nLangKey;          // ${i18nLangKey} 翻译表语言码列
    tplData["i18nDefaultLang"]      = i18nDefaultLang;      // ${i18nDefaultLang} 默认语言（回退目标）
    tplData["i18nFlatFields"]       = i18nFlatFields;       // ${each f in i18nFlatFields} 平铺字段循环
    tplData["i18nFieldsStr"]        = i18nFieldsStr;        // ${i18nFieldsStr} i18nOpt.fields 字面量串
    tplData["i18nDefaultLangLine"]  = i18nDefaultLangLine;  // ${i18nDefaultLangLine} i18nOpt 自定义默认语言行（空 = 用枚举兜底）

    // ── 5.7 基础路径数据（供 formatPath 占位符替换）────────────
    let name = basename(file);

    // ── 5.8 遍历模板配置，逐个渲染并写入文件 ───────────────────
    //      每个模板 cfg 的输出路径由 cfg.out 模板 + formatPath 替换得到
    let moduleOutPath: String = "";  // 本表 module 文件的输出路径（生成后用于 app.module.ts 注册）
    for (cfg in templates) {
      //printLog("tpl path: " + cfg.tpl);

      // 用 formatPath 替换 {basePath}/{name} 等占位符，得到输出文件路径
      let outPath = formatPath(cfg.out, {
        basePath: basePath,
        modelName: json.modelName,
        name: name,
        tableName: json.tableName,
        entityClass: param.entityClass,
        insClass: tplData["insClass"],
        selClass: tplData["selClass"],
        dbBaseClassFile: tplData["dbBaseClassFile"],
        dbClassFile: tplData["dbClassFile"],
        serviceBaseClassFile: tplData["serviceBaseClassFile"],
        serviceClassFile: tplData["serviceClassFile"],
        controllerBaseClassFile: tplData["controllerBaseClassFile"],
        controllerClassFile: tplData["controllerClassFile"],
        moduleClassFile: tplData["moduleClassFile"]
      });
      tplData["outputPath"] = outPath;  // 供模板内的 fileExists(outputPath) 守卫使用

      // 记录 module 模板的输出路径（表处理完后检查文件是否存在 → 决定是否注册）
      if (cfg.tpl.indexOf("module.tpl") >= 0) {
        moduleOutPath = outPath;
      }

      // 核心：调用模板引擎，把 tpl 中的 ${变量名} 替换为实际值，
      //      ${if ...} / ${each ...} 做条件判断和循环
      let result = renderTpl(cfg.tpl, tplData);
      let resultLen = result.length;
      //printLog("result length: " + resultLen);

      // 渲染成功 → 写入磁盘
      if (result) {
        let writeOk = writeFile(outPath, result);
        if (writeOk) {
          generatedFileCount = generatedFileCount + 1;
        }
        printLog("长度:" + resultLen + "; 生成文件: " + outPath);
      }
    }

    // ── 5.9 收集本表模块（文件存在 = 新生成或此前已生成）──────────
    //      moduleClass 命名与 module.tpl 一致：modelBaseName + "Module"；
    //      实体类一并传递（注册进 app.module.ts 的全局 entities 数组）；
    //      extraEntities - i18n 翻译实体（如 EnShop0），随主模块一并注册
    if (moduleOutPath != "" && fileExists(moduleOutPath)) {
      let extraEntities: Object[] = [];
      if (hasI18n) {
        extraEntities.push({
          entityClass: i18nEntityClass,
          entityClassFile: i18nEntityClassFile
        });
      }
      generatedModules.push({
        moduleClass: modelBaseName + "Module",
        moduleClassFile: tplData["moduleClassFile"],
        modelName: json.modelName,
        entityClass: param.entityClass,
        entityClassFile: tplData["entityClassFile"],
        extraEntities: extraEntities
      });
    }
    }  // end for (json in tableConfigs)
  }  // end for (file in files)

  // ── 6. 收尾：断开数据库连接 ─────────────────────────────────────
  db.disconnect();

  // ── 6.5 app.module.ts 增量注册 ──────────────────────────────────
  //      把本次生成的模块写入 app.module.ts 的 needle 标记区（幂等，
  //      已注册的自动跳过）；appModulePath 未配置时内部自行跳过
  updateAppModule(params["appModulePath"], generatedModules);

  // 表存在性检查汇总：有表不存在时输出红色错误提示
  if (missingTableCount > 0) {
    printError("警告：共 " + missingTableCount + " 张表不存在，已跳过生成（请检查表名/数据库是否已建表）");
  }

  printLog("--- 代码生成结束，共生成 " + generatedFileCount + " 个文件 ---");
  return generatedFileCount;  // 返回实际生成文件个数，供入口脚本自行汇总输出
}
