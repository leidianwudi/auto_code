{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build RelWithDebInfo",
            "type": "shell",
            "command": "${workspaceFolder}/.trae/build.bat",
            "args": [
                "RelWithDebInfo"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Run RelWithDebInfo",
            "type": "shell",
            "command": "${workspaceFolder}/build/RelWithDebInfo/auto_code.exe",
            "dependsOn": [
                "Build RelWithDebInfo"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        },
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "${workspaceFolder}/.trae/build.bat",
            "args": [
                "Debug"
            ],
            "group": "build",
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "${workspaceFolder}/.trae/build.bat",
            "args": [
                "Release"
            ],
            "group": "build",
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
